---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import JobsWorkbenchDemo from '../../components/living/JobsWorkbenchDemo.astro';
import EssayJobsMap from '../../components/living/EssayJobsMap.astro';
import PaperCta from '../../components/ui/PaperCta.astro';
import { Content as Opening, getHeadings as openingHeadings } from '../../editorial/the-work-we-want-to-keep-opening.md';
import { Content as WorkingKnowledge, getHeadings as workingHeadings } from '../../editorial/the-work-we-want-to-keep-working-knowledge.md';
import { Content as BeforeReview, getHeadings as beforeHeadings } from '../../editorial/the-work-we-want-to-keep-before-review.md';
import { Content as AfterReview, getHeadings as afterHeadings } from '../../editorial/the-work-we-want-to-keep-after-review.md';
import { FLAGSHIP_ESSAY as essay, ESSAYS } from '../../data/essays';
import { SITE, PERSON, PUBLISHER } from '../../data/seo';
import { ogMeta } from '../../data/og';
import '../../styles/living-base.css';
import '../../styles/essays.css';

const title = 'The Work We Want to Keep: AI Documents and Human Judgment | Orionfold';
const og = ogMeta(essay.href);
const headings = [...openingHeadings(), ...workingHeadings(), ...beforeHeadings(), ...afterHeadings()].filter(heading => heading.depth === 2);
const published = `${essay.date}T00:00:00.000Z`;
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Article',
    headline: essay.title, description: essay.description,
    datePublished: published, dateModified: published,
    timeRequired: `PT${essay.minutes}M`,
    author: PERSON, publisher: PUBLISHER,
    mainEntityOfPage: `${SITE.url}${essay.href}`,
    image: `${SITE.url}${og.image}`,
    isPartOf: { '@type': 'CollectionPage', name: 'Orionfold Essays', url: `${SITE.url}/essays/` },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Essays', item: `${SITE.url}/essays/` },
      { '@type': 'ListItem', position: 2, name: essay.title, item: `${SITE.url}${essay.href}` },
    ],
  },
];
---
<Layout title={title} description={essay.description} ogImage={og.image} ogImageAlt={og.alt} ogType="article" bodyClass="ls ed-page ed-article-page" jsonLd={schema} article={{ datePublished: essay.date, dateModified: essay.date, author: 'Manav Sehgal', section: 'Personal AI', tags: ['Living Documents', 'Flow Jobs', 'Human judgment', 'Working knowledge'] }}>
  <Nav />
  <main id="main" class="ls-main">
    <header class="ed-article-hero ls-container">
      <div class="ed-article-kicker"><a href="/essays/">← Essays</a><span>02 / PERSONAL AI &amp; WORKING KNOWLEDGE</span></div>
      <h1>The Work<br />We Want <em>to Keep.</em></h1>
      <p class="ed-article-dek">{essay.subtitle}</p>
      <div class="ed-hero-bottom"><div class="ed-meta"><a href="/about/">By Manav Sehgal</a><time datetime={essay.date}>{essay.dateLabel}</time><span>{essay.minutes} minute read</span></div><div class="ed-reading-links"><a href="#essay-first-job" class="ed-download-link">See a document at work ↓</a><a href={essay.download} download class="ed-download-link">Save the essay ↓</a></div></div>
      <img class="ed-article-paper" src="/assets/living-systems/hero-flow-paper-planes.webp" alt="" width="1642" height="958" decoding="async" />
    </header>

    <div class="ed-reading-layout ls-container">
      <aside class="ed-contents" aria-label="Essay contents">
        <details open>
          <summary>IN THIS ESSAY</summary>
          <nav aria-label="Essay chapters">
            {headings.map((heading, index) => <a href={`#${heading.slug}`}><span>{String(index + 1).padStart(2, '0')}</span>{heading.text}</a>)}
          </nav>
        </details>
        <a class="ed-contents-series" href="/essay/"><span>THE FIRST ESSAY</span>Room for a Renaissance ↗</a>
      </aside>
      <article class="ed-prose" aria-label={essay.title}>
        <Opening />
        <section id="essay-first-job" class="ed-product-scene" aria-labelledby="essay-first-job-heading" data-essay-illustration>
          <div class="ed-scene-intro"><p class="ls-eyebrow">01 / GIVE THE WORK A PLACE TO CONTINUE</p><h2 id="essay-first-job-heading">One new interview.<br /><em>A brief you can return to.</em><sup><a href="#essay-illustration-note" aria-label="About the product illustrations">*</a></sup></h2><p>Add an interview, run the saved Job, then inspect what changed in the chart and finding table.</p></div>
          <JobsWorkbenchDemo scenario="customer" instanceId="essay-first-job" disclosure={false} />
          <p id="essay-illustration-note" class="ed-illustration-note" role="note"><span aria-hidden="true">*</span> Product illustrations use fictional Customer Research data. They explain Flow’s workflow; interactions here do not change your files.</p>
        </section>
        <PaperCta layout="article" class="ed-paper-cta"
          source="essay-work-we-want-to-keep-workshop" headingId="essay-cta-workshop"
          heading="Give one document a job." eyebrow="START WITH USEFUL WORK"
          description="Open Customer Research in Flow, make your own copy and inspect its saved Jobs. Begin with one question you already want to answer." />
        <WorkingKnowledge />
        <section id="essay-jobs-map" class="ed-product-scene ed-product-scene--map" aria-labelledby="essay-jobs-map-heading" data-essay-illustration>
          <div class="ed-scene-intro"><p class="ls-eyebrow">02 / KEEP THE REASONS WITH THE RESULT</p><h2 id="essay-jobs-map-heading">A clear route<br /><em>back to the source.</em></h2><p>The input, the saved calculation and the document that uses its result belong to one piece of work.</p></div>
          <EssayJobsMap />
        </section>
        <BeforeReview />
        <section id="essay-review-decision" class="ed-product-scene" aria-labelledby="essay-review-decision-heading" data-essay-illustration>
          <div class="ed-scene-intro"><p class="ls-eyebrow">03 / DECIDE WHAT STAYS</p><h2 id="essay-review-decision-heading">The numbers changed.<br /><em>The decision is yours.</em></h2><p>Two changes are applied to the brief. Inspect either part, keep or revert it, or leave the decision for later.</p></div>
          <JobsWorkbenchDemo scenario="customer" mode="review" instanceId="essay-review-decision" disclosure={false} />
          <a href="/flow/#jobs-workbench" class="ed-link">Explore Jobs in Flow <span aria-hidden="true">↗</span></a>
        </section>
        <PaperCta layout="article" class="ed-paper-cta"
          source="essay-work-we-want-to-keep-first-job" headingId="essay-cta-first-job"
          heading="Return to work you understand." eyebrow="YOUR FILES. YOUR JUDGMENT."
          description="Keep the sources, the work and the next decision together. Start with a Living Document on your Mac." />
        <AfterReview />
        <div class="ed-endmark" aria-hidden="true">◆</div>
        <PaperCta layout="article" class="ed-paper-cta"
          source="essay-work-we-want-to-keep-closing" headingId="essay-cta-closing"
          heading="Make your next document a living one."
          description="Bring one piece of work you want to return to. Give it clear inputs, inspect its results, and keep what you learn." />
        <section class="ed-author-bio" aria-label="About the author">
          <p><strong>Manav Sehgal</strong> builds Orionfold Flow and researches practical AI systems. His work spans document systems, risk analytics, cloud architecture and AI products.</p>
          <a href="/story/why-i-folded-orionfold/">Read the founding story ↗</a>
          <a href="/essays/the-work-we-want-to-keep/notes/">Research notes and evidence ↗</a>
        </section>
      </article>
    </div>

    <section class="ed-next-essay ls-container" aria-labelledby="companion-title">
      <div><p class="ls-eyebrow">THE COMPANION ESSAY / 01</p><h2 id="companion-title"><a href="/essay/">Room for<br /><em>a Renaissance.</em></a></h2></div>
      <div><p>{ESSAYS[1].subtitle}</p><a href="/essay/" class="ed-link">Return to the first argument <span aria-hidden="true">↗</span></a><a href="/essays/" class="ed-all-link">All essays →</a></div>
    </section>
  </main>
  <Footer showDownload={false} />
</Layout>
