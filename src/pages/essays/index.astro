---
import PaperLayout from '../../layouts/PaperLayout.astro';
import Panel from '../../components/paper/Panel.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { ESSAYS } from '../../data/essays';
import { SITE, PERSON } from '../../data/seo';
import { ogMeta } from '../../data/og';
import '../../styles/paper-bridge-essays.css';

// The kicker over each essay, in series order on the page (latest first).
const KICKER: Record<string, string> = { '02': 'The latest essay', '01': 'Where the argument began', '03': 'The eighteen ideas' };
const title = 'Essays on Personal AI and Working Knowledge | Orionfold';
const description = 'Essays by Manav Sehgal on personal AI, Living Documents, and a working life with more room for inquiry, ownership, and human judgment.';
const og = ogMeta('/essays/');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Essays on personal AI and working knowledge',
  description,
  url: `${SITE.url}/essays/`,
  author: PERSON,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: ESSAYS.map((essay, index) => ({
      '@type': 'ListItem', position: index + 1,
      item: { '@type': 'Article', name: essay.title, url: `${SITE.url}${essay.href}` },
    })),
  },
};
---
<PaperLayout title={title} description={description} ogImage={og.image} ogImageAlt={og.alt} jsonLd={schema}>
  <Nav />
  <main id="main" class="pp-page">
    <section class="pp-hero pp-hero--inner pp-hero--solo" aria-labelledby="essays-title">
      <div class="pp-hero-copy">
        <span class="pp-kicker">Essays / Manav Sehgal</span>
        <h1 id="essays-title" class="pp-h1">Ideas worth<br /><em>carrying forward.</em></h1>
        <p class="pp-sub">On personal AI, working knowledge, and the freedom to decide what our tools should do for us.</p>
      </div>
    </section>

    <Panel seam="Three essays" fold="atlas">
      <ul class="pp-cells pp-cells--3 ls-essay-cells">
        {ESSAYS.map((essay) => (
          <li aria-labelledby={`essay-${essay.number}-heading`}>
            <small>Essay {essay.number} · {KICKER[essay.number]}</small>
            <h2 id={`essay-${essay.number}-heading`}><a href={essay.href}>{essay.title}</a></h2>
            <span>{essay.subtitle}</span>
            <small><time datetime={essay.date}>{essay.dateLabel}</time> · {essay.minutes} minute read</small>
            <a class="ls-essay-read" href={essay.href}>Read essay {essay.number} →</a>
          </li>
        ))}
      </ul>
    </Panel>

    <Panel seam="The person behind the work" tinted title="A personal desk.<br /><em>A larger possibility.</em>">
      <div class="ls-essays-author">
        <p>I’m Manav Sehgal, founder of Orionfold. My work has taken me through document systems, risk analytics, cloud architecture and AI products. These essays ask what useful intelligence should make possible for the person at the desk.</p>
        <p>The essays develop the argument. <a href="/manifesto/">The Researcher, Writer and Builder in You</a> names the principles. <a href="/flow/">Flow</a> puts them to work.</p>
        <p><a href="/story/why-i-folded-orionfold/">Read the founding story →</a></p>
      </div>
    </Panel>
  </main>
  <Footer showDownload={false} />
</PaperLayout>
