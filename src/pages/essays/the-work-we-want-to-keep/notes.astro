---
import PaperLayout from '../../../layouts/PaperLayout.astro';
import PaperLongform from '../../../components/paper/PaperLongform.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { Content, getHeadings } from '../../../editorial/the-work-we-want-to-keep-research-notes.md';
import { FLAGSHIP_ESSAY as essay } from '../../../data/essays';
import { SITE, PERSON } from '../../../data/seo';
import { ogMeta } from '../../../data/og';
import '../../../styles/living-base.css';
import '../../../styles/essays.css';
import '../../../styles/living-in-paper.css';
import '../../../styles/paper-bridge-essays.css';

const title = 'Research Notes · The Work We Want to Keep | Orionfold';
const description = 'Sources, research boundaries and measured product examples behind The Work We Want to Keep, an essay on personal AI, working knowledge and human judgment.';
const path = `${essay.href}notes/`;
const headings = getHeadings();
const og = ogMeta(essay.href);
const schema = [{
  '@context': 'https://schema.org', '@type': 'WebPage',
  name: title, description, url: `${SITE.url}${path}`,
  datePublished: `${essay.date}T00:00:00.000Z`, dateModified: `${essay.date}T00:00:00.000Z`, author: PERSON,
  isPartOf: { '@type': 'Article', name: essay.title, url: `${SITE.url}${essay.href}` },
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Essays', item: `${SITE.url}/essays/` },
    { '@type': 'ListItem', position: 2, name: essay.title, item: `${SITE.url}${essay.href}` },
    { '@type': 'ListItem', position: 3, name: 'Research notes', item: `${SITE.url}${path}` },
  ],
}];
---
<PaperLayout title={title} description={description} ogImage={og.image} ogImageAlt={og.alt} jsonLd={schema}>
  <Nav />
  <main id="main" class="pp-page">
    <PaperLongform crumb={{ href: essay.href, label: 'The Work We Want to Keep' }} kicker="Sources and research notes" title="The evidence behind the argument." dek="Research, measurements and their limits. A companion to the essay, for a closer look at what each source supports." published={new Date(`${essay.date}T00:00:00.000Z`)} headings={headings} bodyClass="ls-work-in-paper" magnet={false}>
      <Content />
      <a href={essay.href} class="ed-link ed-notes-return">Return to The Work We Want to Keep <span aria-hidden="true">↗</span></a>
      <a slot="rail" class="pp-rail-link" href={essay.href}>Return to the essay →</a>
    </PaperLongform>
  </main>
  <Footer showDownload={false} />
</PaperLayout>
