---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ogMeta } from '../data/og';
import { SITE, PERSON } from '../data/seo';
import '../styles/living-base.css';
import '../styles/living-flow.css';
import faqs from '../data/living-faq.json';
import FlowHero from '../components/living/FlowHero.astro';
import FlowNavigation from '../components/living/FlowNavigation.astro';
import FlowRhythm from '../components/living/FlowRhythm.astro';
import FlowRhythmNote from '../components/living/FlowRhythmNote.astro';
import FlowDataDefinition from '../components/living/FlowDataDefinition.astro';
import FlowDocumentAnchors from '../components/living/FlowDocumentAnchors.astro';
import FlowDocuments from '../components/living/FlowDocuments.astro';
import FlowIdeasAnchors from '../components/living/FlowIdeasAnchors.astro';
import FlowIdeas from '../components/living/FlowIdeas.astro';
import FlowRoutingAnchors from '../components/living/FlowRoutingAnchors.astro';
import FlowRouting from '../components/living/FlowRouting.astro';
import FlowReceiptsAnchors from '../components/living/FlowReceiptsAnchors.astro';
import FlowReceipts from '../components/living/FlowReceipts.astro';
import FlowMorningBriefing from '../components/living/FlowMorningBriefing.astro';
import FlowEverydayCraft from '../components/living/FlowEverydayCraft.astro';
import FlowLibrary from '../components/living/FlowLibrary.astro';
import FlowProof from '../components/living/FlowProof.astro';
import FlowPlans from '../components/living/FlowPlans.astro';
import FlowFaq from '../components/living/FlowFaq.astro';
import FlowClosing from '../components/living/FlowClosing.astro';
const title = "Flow for Mac \u00b7 Give your work a Night Shift.";
const description = "Flow Living Documents bring recurring jobs, living data, local notes and a Morning Briefing to files you own. Base is free forever.";
const og = ogMeta('/flow/');
const pageSchema = {'@context':'https://schema.org','@type':'SoftwareApplication',name:'Orionfold Flow',applicationCategory:'ProductivityApplication',operatingSystem:'macOS',description,url:`${SITE.url}/flow/`,image:`${SITE.url}${og.image}`,author:PERSON,brand:{'@type':'Brand',name:'Orionfold'}};
const faqSchema = {
  "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: faqs.map(faq => ({"@type":"Question",name:faq.question,acceptedAnswer:{"@type":"Answer",text:faq.parts.map(part => part.text).join("")}})),
};
---
<Layout title={title} description={description} ogImage={og.image} ogImageAlt={og.alt} bodyClass="ls ls-page-flow" jsonLd={[pageSchema, faqSchema]}>
  <Nav />
  <main id="main" class="ls-main">
    <FlowHero />
    <FlowNavigation />
    <FlowRhythm />
    <FlowRhythmNote />
    <FlowDataDefinition />
    <FlowDocumentAnchors />
    <FlowDocuments />
    <FlowIdeasAnchors />
    <FlowIdeas />
    <FlowRoutingAnchors />
    <FlowRouting />
    <FlowReceiptsAnchors />
    <FlowReceipts />
    <FlowMorningBriefing />
    <FlowEverydayCraft />
    <FlowLibrary />
    <FlowProof />
    <FlowPlans />
    <FlowFaq />
    <FlowClosing />
  </main>
  <Footer showDownload={false} />
</Layout>
<script>
  import "../scripts/living-documents.js";
</script>
