---
// Orionfold Flow flagship landing page. Rebuilt 2026-08-14 from the measured
// capability briefs in the Flow repo (docs/reference/flow-*-source.md). Every
// screenshot is a real capture of the running development build over the
// synthetic flow-demo library; every number is a recorded measurement with its
// date. Copy stays inside each brief's truth boundary: agency is gated not
// autonomous, no pricing or launch date exists yet, and every qualification
// ("on one M3 Max", "whole-Mac", "development build") stays welded to the claim
// it constrains. Those boundaries MOVE as proofs land: the zero-install claim
// was hedged until its notarized-install proof passed on 2026-08-14, so re-read
// the brief before changing a claim rather than trusting this comment.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FlowShot from '../components/flow/FlowShot.astro';
import FlowDetail from '../components/flow/FlowDetail.astro';
import FlowWorkbenchIllustration from '../components/flow/FlowWorkbenchIllustration.astro';
import FlowWaitlist from '../components/sections/FlowWaitlist.astro';
import { Image } from 'astro:assets';
import { SITE, PERSON } from '../data/seo';
import { ogMeta } from '../data/og';

import appIcon from '../assets/flow/flow-app-icon-512.png';
import shotApprove from '../assets/flow/shots/flow-writing-you-approve-shot.webp';
import shotLongDocs from '../assets/flow/shots/flow-long-documents-shot.webp';
import shotLongDocsMenu from '../assets/flow/shots/flow-long-documents-menu-shot.webp';
import shotDomains from '../assets/flow/shots/flow-domains-shot.webp';
import shotSearch from '../assets/flow/shots/flow-search-shot.webp';
import shotTables from '../assets/flow/shots/flow-table-editor-shot.webp';
import shotOrganizer from '../assets/flow/shots/flow-organizer-shot.webp';
import shotCharts from '../assets/flow/shots/flow-charts-shot.webp';
import shotRuntimeModels from '../assets/flow/shots/flow-runtime-models-shot.webp';
import shotToolbar from '../assets/flow/shots/flow-editor-toolbar-shot.webp';
import shotBenchmarks from '../assets/flow/shots/flow-benchmarks-shot.webp';
import shotBenchmarksScoring from '../assets/flow/shots/flow-benchmarks-scoring-shot.webp';
import shotSmartRouting from '../assets/flow/shots/flow-smart-routing-shot.webp';
// Purpose-cut feature details (scripts/prepare-flow-details.mjs). Each tour
// chapter makes a claim about one control; these crops show that control at a
// size where the claim can be checked, instead of asking the reader to believe
// an eight-pixel-tall fragment of a full window.
import detailProposal from '../assets/flow/details/detail-proposal.webp';
import detailChecks from '../assets/flow/details/detail-checks.webp';
import detailDiff from '../assets/flow/details/detail-diff.webp';
import detailDomains from '../assets/flow/details/detail-domains.webp';
import detailRuntimeStorage from '../assets/flow/details/detail-runtime-storage.webp';
import detailParts from '../assets/flow/details/detail-parts.webp';
import detailGrid from '../assets/flow/details/detail-grid.webp';
import detailSearch from '../assets/flow/details/detail-search.webp';
import detailResourcePopover from '../assets/flow/details/detail-resource-popover.webp';
import detailToolbarPreview from '../assets/flow/details/detail-toolbar-preview.webp';
import detailToolbarBlocked from '../assets/flow/details/detail-toolbar-blocked.webp';
import detailToolbarArmed from '../assets/flow/details/detail-toolbar-armed.webp';
import detailToolbarMenu from '../assets/flow/details/detail-toolbar-menu.webp';
import detailBenchRows from '../assets/flow/details/detail-benchmarks-rows.webp';
import detailBenchScoring from '../assets/flow/details/detail-benchmarks-scoring.webp';
import detailBenchPreset from '../assets/flow/details/detail-benchmarks-preset.webp';
import detailBenchMachine from '../assets/flow/details/detail-benchmarks-machine.webp';
import detailBenchMethod from '../assets/flow/details/detail-benchmarks-method.webp';
import detailRoutingDecided from '../assets/flow/details/detail-routing-decided.webp';
import detailRoutingRules from '../assets/flow/details/detail-routing-rules.webp';
import detailRoutingNorule from '../assets/flow/details/detail-routing-norule.webp';
import detailRoutingProviders from '../assets/flow/details/detail-routing-providers.webp';

const og = ogMeta('/flow/');
const flowUrl = `${SITE.url}/flow/`;
const flowStoryHref = '/story/limitless-without-the-pill/';

// "Measured, not promised" stat band. Each number is a recorded measurement;
// the fine print names its scope so the claim stays checkable.
const stats = [
  { value: '22.3 ms', label: 'Search, 95th percentile', fine: 'Measured on a 10,000-note library, Apple silicon, 2026-08-04' },
  { value: '620,000', label: 'Characters planned part by part', fine: 'Document analysis stays linear. About 0.5 seconds, no cliff' },
  { value: '$0.00425', label: 'A real billed run, to the digit', fine: '105 input and 149 output tokens. Exact decimal arithmetic' },
  { value: '+19.2 MiB', label: 'A complete local AI runtime', fine: 'Two engines inside the app. About the size of twenty photos' },
  { value: '5 actions', label: 'The Agency catalog', fine: 'Proofread, Summarize, Translate, and two table conversions' },
  { value: '4 domains', label: 'Where AI may run', fine: 'Local, LAN, Cloud prepaid, Cloud postpaid. Each has its own switch' },
];

// Enterprise adoption patterns. Each card answers a question enterprise AI
// owners actually ask. "Today" marks shipped behavior in the development
// build; "Direction" marks where the design is headed.
const enterprise = [
  {
    q: 'How do we know which users need more AI and which need to cut back?',
    k: 'Allocation',
    a: 'Every action carries its own cost record. Local runs record no charge because none was owed. Billed runs record the observed charge, never an estimate. Spend becomes a per-person, per-action fact you can read, not a monthly surprise.',
    tag: 'Today',
  },
  {
    q: 'How do we control which documents AI may touch, and which AI may touch them?',
    k: 'Data classification',
    a: 'The folder is the classification. Flow only sees folders you open, and a document cannot reach outside its folder by naming a path. Four execution domains then decide where work may run: on the Mac, on your network, or in the cloud you already pay for.',
    tag: 'Today',
  },
  {
    q: 'How do we know who changed which part of a document, human or AI, and when?',
    k: 'Attribution',
    a: 'Text changes two ways only: an edit you typed, or a change you approved. Every AI change arrives as an exact diff with its own approval, and the receipt records what ran. Version history keeps that boundary readable later.',
    tag: 'Today',
  },
  {
    q: 'How do we apply guardrails at the source of knowledge work?',
    k: 'Guardrails',
    a: 'Checks run inside the document, at creation, as named rules with six honest states. An override never turns Failed into Passed. The decision is recorded and the failure stays visible. Rules live where the work happens, not in a policy PDF.',
    tag: 'Today',
  },
  {
    q: 'How do we compare the quality of one AI generation against another?',
    k: 'Evidence',
    a: 'Evidence is scored only where a measurement exists. A proofread reads "2 dimensions assessed, 3 need sources". A summary is deliberately not scored, because Flow refuses to print a number with no measurement behind it. When the same model writes and judges a change, the receipt says so.',
    tag: 'Today',
  },
  {
    q: 'How do we route each part of the work to the best model, provider, and place?',
    k: 'Routing',
    a: 'The domain is the decision; the provider is a detail. Long documents are improved part by part, so each part gets a right-sized run. A fallback that would leave your Mac stops and asks. Routing reads measured capability, never a vendor claim.',
    tag: 'Today',
  },
  {
    q: 'How do we curate structured value out of unstructured documents?',
    k: 'Curation',
    a: 'Convert Text to Table builds real structure from prose, and the review reports what was actually built, read from the proposed table itself, never from the model’s claim. The file stays plain Markdown, so the structure belongs to you.',
    tag: 'Today',
  },
  {
    q: 'How do we keep one system of record feeding many documents?',
    k: 'System of record',
    a: 'Plain files are the only authority. Search results carry anchors that are re-checked byte for byte before Flow highlights a passage, so a citation cannot silently drift. The index is disposable; your documents are the record.',
    tag: 'Today',
  },
  {
    q: 'How do we capture how our best people decide, without "big brother watching"?',
    k: 'Knowledge mining',
    a: 'The receipt is made by the worker, artifact by artifact, as a side effect of work they already wanted to do. They consent by name and get the trust benefit of the same record. That is the only capture a professional volunteers for.',
    tag: 'Direction',
  },
];

const faqs = [
  {
    q: 'What is Orionfold Flow?',
    a: 'Flow is a native Mac app for professional documents with AI agency built in. It works on ordinary folders of plain Markdown files. Every AI change arrives as an exact diff you approve, and a receipt records what ran, where it ran, and what it cost.',
  },
  {
    q: 'When does Flow launch?',
    a: 'Flow is in active development and is used daily for real work by its builder. Join the waitlist on this page to get development updates and the launch note. A freemium subscription is planned.',
  },
  {
    q: 'Does my text leave my Mac?',
    a: 'Only if you allow it. Flow separates where AI may run into four switchable domains: Local, LAN, Cloud prepaid, and Cloud postpaid. Search is on-device, and a fallback that would leave your Mac stops and asks first.',
  },
  {
    q: 'What does "patent pending" mean for Flow?',
    a: 'Flow includes patent-pending technology for revision-scoped, verifiable AI agency in durable documents. A pending application does not mean granted rights, and it does not cover every Flow feature.',
  },
  {
    q: 'Do I need to install a separate AI runtime?',
    a: 'No. Flow carries its own local inference runtime inside the app, adding about 19 MiB to the download, and it has been measured end to end: on a machine with no other AI runtime present, a model was pulled and runs were approved entirely by the app itself. If you already run Ollama or LM Studio, Flow detects them and serves the models you already pulled in place, with nothing copied.',
  },
  {
    q: 'How is Flow different from a chat canvas or artifacts panel?',
    a: 'A chat canvas is a session workspace. The output lives inside the chat tool, export breaks formatting, and attribution is lost the moment you paste. Flow works the other way around: the document on your disk is the workplace. AI proposes changes there, you approve them there, and the record stays with the file.',
  },
  {
    q: 'Is Flow another notes database?',
    a: 'No. Flow opens ordinary folders of ordinary Markdown files. There is no import step and no library format. Every other tool on your Mac can read the same files at the same time, and delete goes to the system Trash.',
  },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Orionfold Flow',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'macOS',
  description:
    'Orionfold Flow is a native Mac app for professional documents with AI agency built in. Every AI change is a diff you approve, with a receipt recording what ran, where, and what it cost. Patent pending.',
  url: flowUrl,
  image: `${SITE.url}${og.image}`,
  author: PERSON,
  brand: { '@type': 'Brand', name: 'Orionfold' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Layout
  title="Conduct beautiful documents with AI agency built in · Orionfold Flow"
  description="A native Mac app for documents with AI agency built in. Every change is a diff you approve, with a receipt naming what ran and what it cost. Patent pending."
  ogImage={og.image}
  ogImageAlt={og.alt}
  jsonLd={[
    softwareSchema,
    faqSchema,
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Flow', item: flowUrl },
      ],
    },
  ]}
>
  <Nav />
  <main class="flow-page overflow-x-clip">
    <!-- ================= HERO ================= -->
    <section class="flow-hero relative px-6 pb-16 pt-32 sm:pt-40">
      <div class="flow-hero__grid" aria-hidden="true"></div>
      <div class="flow-hero__glow" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-5xl text-center">
        <div class="flex flex-wrap items-center justify-center gap-2">
          <span class="flow-eyebrow-chip">
            <Image src={appIcon} alt="" width={40} height={40} class="h-5 w-5 rounded-[5px]" loading="eager" />
            Orionfold Flow
          </span>
          <span class="flow-eyebrow-chip">Native Mac</span>
          <span class="flow-eyebrow-chip flow-eyebrow-chip--accent">Patent pending</span>
        </div>
        <h1 class="hero-gradient-text mx-auto mt-7 max-w-4xl font-display text-[clamp(2.4rem,8.4vw,4.6rem)] font-extrabold leading-[1.03] tracking-[-0.055em]">
          Conduct beautiful documents with AI agency built in
        </h1>
        <!-- One claim, stated once. The receipt, the domains, and the diff each
             get their own chapter below, where a picture can carry them. -->
        <p class="mx-auto mt-6 max-w-2xl text-balance text-xl leading-[1.5] text-text-muted sm:text-2xl">
          Your text changes two ways only: an edit you typed, or a change you approved.
        </p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <a href="#waitlist" class="of-primary-action">Join the waitlist</a>
          <a href="#tour" class="of-secondary-action">See the product tour <span aria-hidden="true">↓</span></a>
        </div>
        <p class="mt-6 font-mono text-[0.66rem] uppercase tracking-[0.16em] text-text-dim">
          In development · Freemium subscription planned · Every screen below is the real development build
        </p>
      </div>
      <div class="relative mx-auto mt-12 max-w-6xl">
        <FlowShot
          src={shotCharts}
          alt="Orionfold Flow with two documents open side by side: a Q4 content strategy with a publishing calendar table and a chart, and an investment memo carrying a photo and a metrics table, over a plain folder of Markdown files."
          caption="The real development build. Memos, calendars, charts, and tables, side by side, all plain files in a folder you chose."
          priority
        />
      </div>
    </section>

    <!-- ================= STAT BAND ================= -->
    <section class="border-y border-border/70 bg-surface-raised/40 px-6 py-16 sm:py-20" aria-labelledby="flow-stats-heading">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="of-eyebrow" data-animate="rise">Measured, not promised</p>
          <h2 id="flow-stats-heading" class="of-display mt-4 text-[clamp(2rem,4vw,3rem)]" data-animate="lead">Numbers with dates, not adjectives.</h2>
          <p class="of-lede mx-auto mt-5 text-center" data-animate="rise">Every figure comes from a recorded measurement of the development build. The fine print names exactly what was measured.</p>
        </div>
        <!-- The measurement leads; the card is a hairline, not a box. A grid of
             six bordered panels made every number look like a UI control rather
             than a fact you could quote. -->
        <dl class="mt-14 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" data-animate-stagger="slow">
          {stats.map((s) => (
            <div class="flow-stat" data-animate="rise">
              <dd class="of-spec-figure">{s.value}</dd>
              <dt class="of-spec-label mt-2 font-semibold text-text">{s.label}</dt>
              <dd class="of-spec-fine mt-2">{s.fine}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ================= THE PROBE STORY ================= -->
    <section class="px-6 py-16 sm:py-24">
      <div class="mx-auto max-w-4xl">
        <p class="flow-kicker text-center" data-animate="rise">Why approval is the whole product</p>
        <h2 class="of-display mt-4 text-center text-[clamp(2rem,4vw,3rem)]" data-animate="lead">A silent rewrite is not a feature. It is a risk.</h2>
        <div class="flow-probe mt-10 rounded-2xl border border-warn/30 bg-surface-raised/60 p-7 sm:p-9">
          <p class="text-lg leading-relaxed text-text">
            While building Flow, we tested the Mac's own built-in Writing Tools on a document that
            held a code comment with two typos. The system feature corrected and capitalized the text
            <em>inside the code block</em>. Silently. No diff shown, no approval asked, no record kept.
            On a real working note, that is corruption of code.
          </p>
          <p class="mt-4 leading-relaxed text-text-muted">
            We measured it, dated it (2026-07-30), and reproduced it. Then we retired the system
            Writing Tools inside Flow and replaced the whole shape: five AI actions, one trust path.
            The exact change, what the evidence does and does not support, the checks that ran, and
            your approval. Recorded.
          </p>
          <p class="mt-6 font-mono text-[0.66rem] uppercase tracking-[0.16em] text-text-dim">
            Flow's own recorded probes of macOS Writing Tools, 2026-07-30 to 2026-08-14. Other apps are untouched; the feature is off inside Flow only.
          </p>
        </div>
        <!-- The whole promise in one picture: the five-layer Living Workbench
             (Outcome → Context → Specialists → Your call → Receipt). Concept
             here, mechanism and real screenshots in the tour below. -->
        <div class="mt-14">
          <FlowWorkbenchIllustration />
          <p class="mx-auto mt-6 max-w-2xl text-center text-sm leading-relaxed text-text-muted">
            The whole promise in one picture. Your outcome sits on trusted context, specialist
            intelligence does the work, nothing passes without your call, and a durable receipt
            records how it happened.
          </p>
        </div>
      </div>
    </section>

    <!-- ================= PRODUCT TOUR ================= -->
    <section id="tour" class="scroll-mt-28 border-t border-border/70 px-6 pt-16 sm:pt-20">
      <div class="mx-auto max-w-6xl text-center">
        <p class="flow-kicker" data-animate="rise">The product tour</p>
        <h2 class="of-display mt-4 text-[clamp(2.1rem,5vw,3.5rem)]" data-animate="lead">Real screens. Real runs. Real receipts.</h2>
      </div>
    </section>

    <!-- Chapter 1: Writing you approve.
         The trust path is shown as one picture per step rather than one window
         containing all of them at 8px. This is the chapter where "shows its
         work" has to be literally legible. The count in the lede and the number
         of <li> below must agree — the prose used to promise four steps while
         three were drawn, which the toolbar step closed on 2026-08-18. -->
    <section class="px-6 py-16 sm:py-24" aria-labelledby="tour-agency">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <p class="of-eyebrow" data-animate="rise">Agency</p>
          <h3 id="tour-agency" class="of-display scroll-mt-28 mt-4 text-[clamp(1.85rem,3.4vw,2.75rem)]" data-animate="lead">AI editing with a paper trail.</h3>
          <p class="of-lede mt-5" data-animate="rise">
            Five actions: Proofread, Summarize, Translate into eleven languages, Convert Text to Table,
            and Convert Table to Text. They live in the document's own tool strip, beside the
            bold and italic buttons, and every one goes through the same steps: it prices the
            work before you click, then says what it will do, shows its evidence, and shows the
            exact bytes before anything is saved.
          </p>
        </div>

        <!-- The trust path, one step per picture.
             STEP ZERO added 2026-08-18 from the editor-toolbar brief. The other
             four steps all happen AFTER you commit to a run; the toolbar is the
             only one that answers "what will this do" while the answer can still
             change your mind, so it leads rather than joins the middle. -->
        <ol class="flow-path mt-12" data-animate-stagger="slow">
          <li class="flow-path__step" data-animate="rise">
            <div class="flow-path__copy">
              <p class="flow-path__num">Step zero</p>
              <h4 class="flow-path__head">It tells you the price before you click.</h4>
              <p class="flow-path__body">
                Hover any of the five AI tools and Flow answers three questions first: how much
                text it would act on, what the run would cost, and which model would do the work.
                A run on your own hardware is free, and Flow writes "No cost" rather than a
                number, because that is an absence of cost and not a measurement of one.
              </p>
            </div>
            <FlowDetail
              src={detailToolbarPreview}
              alt="Flow's document tool strip: bold, italic and text controls, then five colored AI monograms, with Proofread's panel open showing 3,911 words for the whole document, 'No cost, free, it runs on hardware you have', and the model that would run it staying on this Mac."
              caption="Scope, cost, and route · Answered before the click, not after"
              sizes="(min-width: 900px) 38rem, calc(100vw - 3rem)"
            />
          </li>
          <li class="flow-path__step" data-animate="rise">
            <div class="flow-path__copy">
              <p class="flow-path__num">Step one</p>
              <h4 class="flow-path__head">It says what it will do.</h4>
              <p class="flow-path__body">
                The effect sentence is read out of the proposed bytes by Flow's own parser,
                never taken on the model's word. The permission scope is stated before you decide.
              </p>
            </div>
            <FlowDetail
              src={detailProposal}
              alt="Flow's proposal panel: 'Correct spelling and grammar in the selected text', permission 'Edit this document only', external action 'No external action', and three content hashes."
              caption="Permission stated up front · No external action"
              sizes="(min-width: 900px) 38rem, calc(100vw - 3rem)"
            />
          </li>
          <li class="flow-path__step" data-animate="rise">
            <div class="flow-path__copy">
              <p class="flow-path__num">Step two</p>
              <h4 class="flow-path__head">It shows the evidence, or admits there is none.</h4>
              <p class="flow-path__body">
                Evidence is scored only where a measurement exists. A summary is deliberately
                not scored, and Flow prints that instead of inventing a number.
              </p>
            </div>
            <FlowDetail
              src={detailChecks}
              alt="Flow's Evidence and Checks panel: two dimensions assessed, 'No comparison, one side is not scored', two passing checks, and a Human review gate awaiting confirmation."
              caption="Named checks · An override never turns Failed into Passed"
              sizes="(min-width: 900px) 38rem, calc(100vw - 3rem)"
            />
          </li>
          <li class="flow-path__step" data-animate="rise">
            <div class="flow-path__copy">
              <p class="flow-path__num">Step three</p>
              <h4 class="flow-path__head">It shows the exact bytes.</h4>
              <p class="flow-path__body">
                Not a summary of the change. The diff itself, line by line. The save is guarded
                byte for byte, so a run started before your edit can never land after it.
              </p>
            </div>
            <FlowDetail
              src={detailDiff}
              alt="Flow's exact proposed diff: numbered lines with removed text marked in red, above the Reject, Later, and Approve and Save buttons."
              caption="The exact proposed diff · Decline changes nothing at all"
              sizes="(min-width: 900px) 38rem, calc(100vw - 3rem)"
              glow
            />
          </li>
        </ol>
      </div>
    </section>

    {/* Chapter 1b: the tool strip (2026-08-18, from the editor-toolbar brief).
        Sits directly after Agency because it is the same five actions seen from
        the other end — Agency is what happens after you commit, this is what you
        are told beforehand and where the tools actually live.

        STAGE CORNER: --tl. The next stage down the page (Long documents) takes
        --br, so adjacent bands do not repeat a corner; tests/e2e/product-stage
        asserts exactly that. */}
    <section class="border-t border-border/60 px-6 py-14 sm:py-20" aria-labelledby="tour-toolbar">
      <div>
        <div class="mx-auto max-w-3xl">
          <p class="of-eyebrow" data-animate="rise">The tool strip</p>
          <h3 id="tour-toolbar" class="of-display scroll-mt-28 mt-4 text-[clamp(1.85rem,3.4vw,2.75rem)]" data-animate="lead">The tools come to the document.</h3>
          <p class="of-lede mt-5" data-animate="rise">
            The strip lives in the document's top-right corner and stays out of the way until you
            reach for it. Your writing tools sit on one side of a divider and the five AI actions
            on the other, because both act on the same document. The AI ones are marked with
            letters rather than icons: five text operations do not have five icons you could tell
            apart, and the same marks appear in the Agency menu so the two never drift.
          </p>
          <p class="of-lede mt-4" data-animate="rise">
            When an action cannot run, it stays where it is, greyed, and the same panel says why in
            words that came from whatever refused it. In a document that already has a table,
            Convert Text to Table reads "Already contains a table". In one with nothing to convert,
            the same tool gives a different reason. The scope line stays, because it is still true;
            the cost and the model do not, because a run that cannot happen has neither.
          </p>
        </div>

        {/* The armed strip, at rest and full width. Both crops on the stage
            below carry a popover across half the strip; this is the only cut
            where the DIVIDER is visible end to end, which is the chapter's
            actual claim. Sized narrow and centred so it reads as one object
            rather than a band. */}
        <figure class="toolbar-armed mx-auto mt-12" data-animate="rise">
          <FlowDetail
            src={detailToolbarArmed}
            alt="Flow's document tool strip at rest: bold, italic, text size and alignment controls, a divider, then five AI marks. Pr, Sm, Tr and Tt are in colour and ready; Tx is greyed out."
            caption="Four ready, one unavailable · The divider is the whole idea"
            sizes="(min-width: 900px) 34rem, calc(100vw - 3rem)"
          />
        </figure>
        <p class="toolbar-armed__note mx-auto mt-5 text-center" data-animate="rise">
          A tool you can run is in full colour. A tool you cannot is still there, greyed, rather
          than hidden, so the set never changes shape under you.
        </p>
