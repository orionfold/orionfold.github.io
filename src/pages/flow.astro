---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FlowHeroCreative from '../components/flow/FlowHeroCreative.astro';
import FlowRoutingIcon from '../components/flow/FlowRoutingIcon.astro';
import FlowWaitlist from '../components/sections/FlowWaitlist.astro';
import StoryCard from '../components/ui/StoryCard.astro';
import { SITE, PERSON } from '../data/seo';
import { ogMeta } from '../data/og';

const og = ogMeta('/flow/');
const flowUrl = `${SITE.url}/flow/`;
const flowStorySlug = 'limitless-without-the-pill';
const flowStory = (await getCollection('story')).find((story) => story.id === flowStorySlug);
const flowStoryHref = `/story/${flowStorySlug}/`;

const continuity = [
  { number: '01', title: 'Outcome', body: 'Start with what the document needs to accomplish.' },
  { number: '02', title: 'Trusted context', body: 'Keep sources, files, decisions, and boundaries with the document.' },
  { number: '03', title: 'Intelligence', body: 'Use context, checks, and feedback to make the next version stronger.' },
  { number: '04', title: 'Agency', body: 'Let specialists research, analyze, and act inside clear boundaries.' },
  { number: '05', title: 'Durable receipt', body: 'See what changed, why it changed, and what still needs judgment.' },
];

const fold = [
  { letter: 'F', title: 'Frame', body: 'Define what the document must accomplish.', icon: '<path d="M5 5h14v14H5z"/><path d="M9 9h6v6H9z"/>' },
  { letter: 'O', title: 'Orchestrate', body: 'Bring intelligence and specialists into the document.', icon: '<circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4M5 5l3 3M16 16l3 3M19 5l-3 3M8 16l-3 3"/>' },
  { letter: 'L', title: 'Lock', body: 'Keep sources, decisions, approvals, and receipts attached.', icon: '<rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M9 15l2 2 4-4"/>' },
  { letter: 'D', title: 'Distill', body: 'Turn the result and its feedback into a stronger next version.', icon: '<path d="M4 4h16v5H4zM7 9v11h10V9M10 13h4"/>' },
];

const scenarios = [
  {
    audience: 'Retail investor',
    title: 'Portfolio dashboard document',
    body: 'A living view of holdings, thesis, market signals, risk, and the next decision, with every number tied back to its source.',
    path: ['Gather holdings', 'Improve the thesis', 'Flag decisions'],
    tone: 'violet',
    featured: true,
    icon: '<rect x="3" y="4" width="18" height="16" rx="3"/><path d="M7 15l3-4 3 2 4-6M7 8h3M17 11v4"/>',
  },
  {
    audience: 'Sales',
    title: 'Leads dataset',
    body: 'A source-linked dataset that researches accounts, cleans fields, scores fit, and prepares the next outreach step.',
    path: ['Find accounts', 'Qualify fit', 'Prepare outreach'],
    tone: 'cyan',
    icon: '<circle cx="8" cy="8" r="3"/><path d="M3 19c0-3 2-5 5-5s5 2 5 5M15 7h6M15 11h6M16 16h5"/>',
  },
  {
    audience: 'Communications',
    title: 'Earned media content post',
    body: 'A publishable story that turns research, coverage, quotes, and proof into a clear point of view with a defensible trail.',
    path: ['Collect signals', 'Shape the angle', 'Publish with proof'],
    tone: 'coral',
    icon: '<path d="M4 10v4h4l9 4V6L8 10zM8 14l1.5 6h3L11 15M20 9v6"/>',
  },
  {
    audience: 'Startup founder',
    title: 'Startup investor pitch presentation',
    body: 'A presentation that sharpens the company story, checks every claim, and keeps supporting evidence ready for diligence.',
    path: ['Frame the story', 'Check the claims', 'Prepare the room'],
    tone: 'amber',
    icon: '<rect x="3" y="3" width="18" height="14" rx="2"/><path d="M8 13l3-3 2 2 3-5M12 17v4M8 21h8"/>',
  },
  {
    audience: 'Personal admin',
    title: 'Tax filing handoff',
    body: 'A reviewable document that organizes local records, checks support, tracks corrections, and prepares a clean handoff.',
    path: ['Gather records', 'Check guidance', 'Approve handoff'],
    tone: 'green',
    icon: '<path d="M6 2h9l4 4v16H6zM15 2v5h4M9 12h6M9 16h3"/><path d="M13 17l2 2 4-5"/>',
  },
];

type RoutingRoute = { label: string; icon: string; tone: string; brand?: boolean; mono?: boolean };
type RoutingTier = { tier: string; icon: string; tone: string; label: string; detail: string; routes: RoutingRoute[] };

const routingTiers: RoutingTier[] = [
  {
    tier: '0', icon: 'device', tone: 'violet', label: 'On your device', detail: 'First',
    routes: [
      { label: 'Apple Intelligence', icon: 'apple', tone: 'apple', brand: true, mono: true },
      { label: 'Foundation Models', icon: 'foundation', tone: 'blue' },
      { label: 'Writing Tools', icon: 'writing', tone: 'purple' },
    ],
  },
  {
    tier: '1', icon: 'local', tone: 'cyan', label: 'Local runtimes', detail: 'Private',
    routes: [
      { label: 'Ollama', icon: 'ollama', tone: 'ollama', brand: true, mono: true },
      { label: 'LM Studio', icon: 'lmstudio', tone: 'lmstudio', brand: true, mono: true },
    ],
  },
  {
    tier: '2', icon: 'subscription', tone: 'coral', label: 'Subscriptions you have', detail: 'Already paid',
    routes: [
      { label: 'Claude Code', icon: 'claude', tone: 'claude', brand: true },
      { label: 'Codex', icon: 'openai', tone: 'codex', brand: true, mono: true },
    ],
  },
  {
    tier: '3', icon: 'settings', tone: 'amber', label: 'Standard configuration', detail: 'Detected',
    routes: [
      { label: 'Environment keys', icon: 'environment', tone: 'amber' },
      { label: 'MCP tools', icon: 'mcp', tone: 'mcp', brand: true, mono: true },
    ],
  },
  {
    tier: '4', icon: 'key', tone: 'green', label: 'Bring your own key', detail: 'Only if needed',
    routes: [
      { label: 'BYOK', icon: 'key', tone: 'green' },
    ],
  },
];

const principles = [
  { title: 'Beautiful results stay explainable', body: 'Sources, models, cost, checks, and approvals travel with the document instead of disappearing into a side log.' },
  { title: 'Improvement stays inspectable', body: 'Feedback and decisions can strengthen the next version without hiding what changed or why.' },
  { title: 'Agency respects your boundaries', body: 'Flow starts with the smallest useful action; consequential steps, including moving work off device, remain your choice.' },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Orionfold Flow',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'macOS',
  description: 'Orionfold Flow creates documents with self-improving intelligence built in and AI agency enabled to get work done.',
  url: flowUrl,
  image: `${SITE.url}${og.image}`,
  author: PERSON,
  brand: { '@type': 'Brand', name: 'Orionfold' },
};
---
<Layout
  title="Conduct beautiful documents with AI agency built in · Orionfold Flow"
  description="Orionfold Flow creates documents with self-improving intelligence built in and AI agency enabled to get work done. In development as a native Mac, closed-source freemium subscription."
  ogImage={og.image}
  ogImageAlt={og.alt}
  jsonLd={[
    softwareSchema,
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Flow', item: flowUrl },
      ],
    },
  ]}
>
  <Nav />
  <main class="flow-page overflow-x-clip">
    <section class="flow-hero relative px-6 pb-20 pt-32 sm:pb-28 sm:pt-40">
      <div class="flow-hero__grid" aria-hidden="true"></div>
      <div class="flow-hero__glow" aria-hidden="true"></div>
      <div class="flow-hero__fade" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[0.84fr_1.16fr] lg:gap-16">
        <div class="relative z-10 text-center lg:text-left">
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-primary">Orionfold Flow · In development</p>
          <h1 class="hero-gradient-text mt-6 font-display text-[clamp(1.4rem,2.65vw,3.25rem)] font-extrabold leading-[1.16] tracking-[-0.055em] text-text">
            <span class="block whitespace-nowrap">Conduct beautiful documents</span>
            <span class="mt-[0.02em] block whitespace-nowrap">with AI agency built in</span>
          </h1>
          <p class="mx-auto mt-7 max-w-2xl text-balance text-lg leading-relaxed text-text-muted sm:text-xl lg:mx-0">
            Orionfold Flow creates documents with self-improving intelligence built in and AI agency enabled to get work done.
          </p>
          <div class="mt-7 flex flex-wrap justify-center gap-2 lg:justify-start">
            <span class="flow-chip">Native Mac app</span>
            <span class="flow-chip">Self-improving intelligence</span>
            <span class="flow-chip">Agency with your approval</span>
          </div>
          <div class="mt-9 flex flex-wrap justify-center gap-3 lg:justify-start">
            <a href="#fold-loop" class="of-primary-action">See how Flow works <span aria-hidden="true">↓</span></a>
            <a href={flowStoryHref} class="of-secondary-action">Read the story</a>
          </div>
        </div>
        <FlowHeroCreative />
      </div>
    </section>

    <section class="px-6 py-20 sm:py-28">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="flow-kicker">The routing direction</p>
          <h2 class="mt-4 text-balance text-4xl font-bold sm:text-6xl">Use the best intelligence for each part of the document.</h2>
          <p class="mt-5 text-lg leading-relaxed text-text-muted">Flow is designed to start with useful on-device routes before asking you to configure a new one. It begins private, free, and already present, then expands only with your choice.</p>
        </div>
        <div class="flow-routing mt-14">
          {routingTiers.map((tier) => (
            <div class:list={['flow-routing__row', `flow-routing__row--${tier.tone}`]}>
              <div class="flow-routing__tier">
                <span class="flow-routing__tier-symbol">
                  <FlowRoutingIcon name={tier.icon} />
                  <span class="flow-routing__tier-number" aria-label={`Tier ${tier.tier}`}>{tier.tier}</span>
                </span>
                <div><strong>{tier.label}</strong><small>{tier.detail}</small></div>
              </div>
              <div class="flow-routing__marks">
                {tier.routes.map((route) => (
                  <span
                    class:list={[
                      'flow-routing__mark',
                      `flow-routing__mark--${route.tone}`,
                      route.brand && 'flow-routing__mark--brand',
                      route.mono && 'flow-routing__mark--mono',
                    ]}
                    data-brand-mark={route.brand ? route.icon : undefined}
                  >
                    <span class="flow-routing__mark-icon"><FlowRoutingIcon name={route.icon} /></span>
                    <span class="flow-routing__mark-label">{route.label}</span>
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
        <p class="mx-auto mt-6 max-w-3xl text-center font-mono text-[0.66rem] uppercase leading-relaxed tracking-[0.14em] text-text-dim">Support arrives in measured increments. A name here shows routing direction, not that every connection ships today.</p>
      </div>
    </section>

    <section class="flow-scenario-section border-y border-border/70 bg-surface-raised/40 px-6 py-20 sm:py-28">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-end">
          <div>
            <p class="flow-kicker">Concrete journeys</p>
            <h2 class="mt-4 text-balance text-4xl font-bold sm:text-5xl">One work system. Five very different documents.</h2>
          </div>
          <p class="max-w-2xl text-lg leading-relaxed text-text-muted">A Flow document can be a dashboard, dataset, post, presentation, or filing handoff. The artifact changes. The pattern stays consistent: gather trusted context, improve with feedback, and use agency to move the next step.</p>
        </div>
        <ol class="flow-scenarios mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-label="Example Flow documents">
          {scenarios.map((scenario) => (
            <li
              class:list={[
                'flow-scenario',
                `flow-scenario--${scenario.tone}`,
                scenario.featured && 'flow-scenario--featured',
              ]}
              data-flow-scenario={scenario.title}
            >
              <div class="flow-scenario__top">
                <span class="flow-scenario__icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={scenario.icon}></svg>
                </span>
                <span class="flow-scenario__audience">{scenario.audience}</span>
              </div>
              <h3>{scenario.title}</h3>
              <p>{scenario.body}</p>
              <ol class="flow-scenario__path" aria-label={`${scenario.title} workflow`}>
                {scenario.path.map((step) => <li>{step}</li>)}
              </ol>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="border-y border-border/70 bg-surface-raised/40 px-6 py-16 sm:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-3xl">
          <p class="flow-kicker">The document is the work system</p>
          <h2 class="mt-4 text-balance text-4xl font-bold sm:text-6xl">A beautiful document that gets better and gets work done.</h2>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-text-muted">Flow keeps intent, sources, decisions, feedback, and action in one living artifact. Its intelligence improves with the work while agents help research, analyze, and act without leaving the document.</p>
        </div>
        <ol class="flow-continuity mt-12 grid gap-3 lg:grid-cols-5" aria-label="The Flow continuity journey">
          {continuity.map((item) => (
            <li class="flow-continuity__item">
              <span class="flow-continuity__number">{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {flowStory && (
      <section class="border-y border-border/70 bg-surface-raised/40 px-6 py-20 sm:py-24" aria-labelledby="flow-story-heading">
        <div class="mx-auto max-w-6xl">
          <div class="mb-10 max-w-3xl">
            <p class="flow-kicker">From the build log</p>
            <h2 id="flow-story-heading" class="mt-4 text-balance text-4xl font-bold sm:text-5xl">Why I built documents that can think and act.</h2>
            <p class="mt-5 text-lg leading-relaxed text-text-muted">How going AI-native turned the document from a static output into the place where intelligence improves and agency gets work done.</p>
          </div>
          <StoryCard
            href={flowStoryHref}
            title={flowStory.data.title}
            date={flowStory.data.date}
            tag={flowStory.data.tags[0]}
            summary={flowStory.data.summary}
            seed={flowStory.data.accent}
            cover={flowStory.data.hero}
            coverAlt={flowStory.data.heroAlt}
            featured
          />
        </div>
      </section>
    )}

    <section id="fold-loop" class="scroll-mt-28 px-6 py-20 sm:py-28">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="flow-kicker">The FOLD loop</p>
          <h2 class="mt-4 text-balance text-4xl font-bold sm:text-6xl">Conduct the document. Let agency move the work.</h2>
          <p class="mt-5 text-lg leading-relaxed text-text-muted">Frame the outcome, orchestrate intelligence, lock the evidence, and distill a stronger artifact. You still own goals, truth, taste, risk, and final approval.</p>
        </div>
        <div class="flow-fold mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {fold.map((item) => (
            <article class="flow-fold__card">
              <div class="flex items-start justify-between gap-5">
                <span class="flow-fold__letter">{item.letter}</span>
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={item.icon}></svg>
              </div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
        <div class="flow-approval mt-6">
          <span class="flow-approval__line" aria-hidden="true"></span>
          <span class="flow-approval__pill"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4L19 6" /></svg> You approve consequential actions</span>
        </div>
      </div>
    </section>

    <section class="px-6 pb-20 sm:pb-28">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-4 lg:grid-cols-3">
          {principles.map((principle, index) => (
            <article class="flow-principle">
              <span>R0{index + 3}</span>
              <h2>{principle.title}</h2>
              <p>{principle.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <FlowWaitlist placement="flow" storyHref={flowStoryHref} />
  </main>
  <Footer />
</Layout>

<style>
  .flow-page { --flow-accent: #5b8def; }
  .flow-hero {
    isolation: isolate;
    display: grid;
    min-height: min(980px, 100svh);
    align-items: center;
    overflow: hidden;
    background: linear-gradient(145deg, color-mix(in oklch, var(--color-primary) 5%, var(--color-surface)) 0%, var(--color-surface) 58%, color-mix(in oklch, var(--color-primary) 3%, var(--color-surface)) 100%);
  }
  .flow-hero__grid {
    --bp-line: color-mix(in oklch, var(--color-primary) 12%, transparent);
    --bp-major: color-mix(in oklch, var(--color-primary) 20%, transparent);
    position: absolute; inset: 0; pointer-events: none;
    background-image:
      linear-gradient(to right, var(--bp-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--bp-line) 1px, transparent 1px),
      linear-gradient(to right, var(--bp-major) 1px, transparent 1px),
      linear-gradient(to bottom, var(--bp-major) 1px, transparent 1px);
    background-size: 24px 24px, 24px 24px, 120px 120px, 120px 120px;
    -webkit-mask-image: radial-gradient(ellipse 82% 74% at 68% 45%, black 38%, transparent 100%);
    mask-image: radial-gradient(ellipse 82% 74% at 68% 45%, black 38%, transparent 100%);
  }
  .flow-hero__glow { position: absolute; right: -14rem; top: 9rem; width: 58rem; height: 50rem; border-radius: 999px; background: rgb(91 141 239 / 0.11); filter: blur(120px); pointer-events: none; }
  .flow-hero__fade { position: absolute; inset: auto 0 0; height: 9rem; background: linear-gradient(transparent, var(--color-surface)); pointer-events: none; }
  .flow-chip { border: 1px solid color-mix(in oklch, var(--color-primary) 25%, var(--color-border)); border-radius: 999px; background: color-mix(in oklch, var(--color-primary) 7%, var(--color-surface)); padding: 0.5rem 0.8rem; font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.08em; color: var(--color-text-muted); }
  .flow-kicker { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.23em; text-transform: uppercase; color: var(--color-primary); }
  .flow-continuity__item { position: relative; min-height: 15rem; border: 1px solid var(--color-border); border-radius: 1.25rem; background: var(--color-surface); padding: 1.35rem; }
  .flow-continuity__item:not(:last-child)::after { content: '→'; position: absolute; z-index: 2; right: -0.85rem; top: 2rem; display: none; width: 1.65rem; height: 1.65rem; place-items: center; border: 1px solid var(--color-border); border-radius: 999px; background: var(--color-surface-raised); color: var(--color-primary); }
  .flow-continuity__number { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.16em; color: var(--color-primary); }
  .flow-continuity h3 { margin-top: 3.4rem; font-size: 1.18rem; font-weight: 700; }
  .flow-continuity p { margin-top: 0.65rem; font-size: 0.9rem; line-height: 1.65; color: var(--color-text-muted); }
  .flow-fold__card { border: 1px solid var(--color-border); border-radius: 1.5rem; background: linear-gradient(145deg, var(--color-surface-raised), var(--color-surface)); padding: 1.5rem; box-shadow: 0 22px 60px -50px rgb(91 141 239 / 0.55); }
  .flow-fold__letter { font-family: var(--font-display); font-size: 3.5rem; font-weight: 800; line-height: 1; color: color-mix(in oklch, var(--color-primary) 82%, var(--color-text)); }
  .flow-fold svg { width: 2rem; height: 2rem; fill: none; stroke: var(--color-primary); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; opacity: 0.75; }
  .flow-fold h3 { margin-top: 2.2rem; font-size: 1.35rem; font-weight: 700; }
  .flow-fold p { margin-top: 0.6rem; font-size: 0.92rem; line-height: 1.6; color: var(--color-text-muted); }
  .flow-approval { position: relative; display: grid; place-items: center; min-height: 4rem; }
  .flow-approval__line { position: absolute; left: 5%; right: 5%; height: 1px; background: linear-gradient(90deg, transparent, var(--color-primary), transparent); opacity: 0.35; }
  .flow-approval__pill { position: relative; display: inline-flex; align-items: center; gap: 0.5rem; border: 1px solid color-mix(in oklch, var(--color-success) 42%, var(--color-border)); border-radius: 999px; background: var(--color-surface); padding: 0.6rem 0.9rem; font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-success); }
  .flow-approval__pill svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .flow-scenario-section { position: relative; overflow: hidden; }
  .flow-scenario-section::before { position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(rgb(91 141 239 / 0.035) 1px, transparent 1px), linear-gradient(90deg, rgb(91 141 239 / 0.035) 1px, transparent 1px); background-size: 36px 36px; content: ''; mask-image: radial-gradient(circle at 62% 58%, #000, transparent 78%); }
  .flow-scenario-section > div { position: relative; }
  .flow-scenario { --scenario-accent: #7770f5; position: relative; display: flex; min-height: 20rem; flex-direction: column; overflow: hidden; border: 1px solid color-mix(in oklch, var(--scenario-accent) 25%, var(--color-border)); border-radius: 1.5rem; background: linear-gradient(145deg, color-mix(in oklch, var(--scenario-accent) 8%, var(--color-surface)), var(--color-surface)); padding: 1.5rem; box-shadow: 0 28px 70px -58px color-mix(in oklch, var(--scenario-accent) 58%, transparent); }
  .flow-scenario::before { position: absolute; inset: 0 0 auto; height: 2px; background: linear-gradient(90deg, transparent, var(--scenario-accent), transparent); content: ''; opacity: 0.8; }
  .flow-scenario::after { position: absolute; right: -4.5rem; top: -5rem; width: 12rem; height: 12rem; border: 1px solid color-mix(in oklch, var(--scenario-accent) 18%, transparent); border-radius: 999px; content: ''; pointer-events: none; }
  .flow-scenario--violet { --scenario-accent: #7770f5; }
  .flow-scenario--cyan { --scenario-accent: #168da3; }
  .flow-scenario--coral { --scenario-accent: #d06f56; }
  .flow-scenario--amber { --scenario-accent: #b77a13; }
  .flow-scenario--green { --scenario-accent: #208761; }
  .flow-scenario__top { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
