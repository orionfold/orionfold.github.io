---
// Orionfold Flow flagship landing page. Rebuilt 2026-08-14 from the measured
// capability briefs in the Flow repo (docs/reference/flow-*-source.md), split
// into an overview plus four category pages on 2026-08-20, and rewritten the
// same day against the content-masterclass review
// (audit-reports/content-masterclass-review-2026-08-20.md): the hero states
// the approval promise in plain words (title, H1, lede, and picture agree),
// names who the page is for, puts two dated facts and the first email ask
// before the second scroll, and sends the reader into ONE part of the tour.
// Every screenshot is a real capture of the running build over the synthetic
// flow-demo library; every number is a recorded measurement with its date.
// Copy stays inside each brief's truth boundary: agency is gated not
// autonomous, no pricing exists yet, and every qualification ("on one M3 Max",
// "whole-Mac") stays welded to the claim it constrains. Re-read the brief
// before changing a claim.
//
// 2026-08-21, PRE-LAUNCH reframing (operator direction). The page hedged with
// "in development" everywhere, which understated the build: verified against
// the Flow repo's own BACKLOG "Now", every capability chapter on this site has
// shipped, and the only goals left are 0145 first-run onboarding (took Now at
// 09:12 that day) and 0127 buy/license/update. The dev-build/released
// distinction was an internal guardrail the operator had not yet retired, not
// a claim boundary. "Pre-launch" replaced "in development"; no launch DATE is
// printed anywhere without the operator.
// 2026-08-22 (operator direction): the standing disclosure line "Pre-launch ·
// Freemium subscription planned · Every screen is the real build, running" is
// REMOVED from every Flow surface -- the /flow/ hero, the four tour subpages
// (FlowCategoryPage.astro), and /flow/enterprise/ -- along with the
// "Pre-launch." and "Freemium subscription planned." sentences in the press-kit
// Status row. The three guards in flow-flagship-surface.test.mjs are inverted
// to doesNotMatch so the line cannot creep back. Pricing copy stays absent
// until the operator declares Flow released.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FlowShot from '../components/flow/FlowShot.astro';
import FlowIdeasPitStop from '../components/flow/FlowIdeasPitStop.astro';
import FlowWorkbenchIllustration from '../components/flow/FlowWorkbenchIllustration.astro';
import FlowWaitlist from '../components/sections/FlowWaitlist.astro';
import FlowPricing from '../components/flow/FlowPricing.astro';
import FlowDownloadCta from '../components/flow/FlowDownloadCta.astro';
import LineIcon from '../components/ui/LineIcon.astro';
import WaitlistForm from '../components/ui/WaitlistForm.astro';
import { Image } from 'astro:assets';
import { SITE, PERSON } from '../data/seo';
import { ogMeta } from '../data/og';
import { FLOW_CATEGORIES, flowCategoryHref } from '../data/flow-categories';
import { FLOW_CATEGORY_SHOTS } from '../data/flow-category-shots';
import { FLOW_ENTERPRISE_TEASER } from '../data/flow-enterprise';
import { FLOW_CONSENT_TEXT } from '../data/flow-consent';
import { FLOW, formatUsd } from '../data/commerce.ts';
import { FLOW_SYSTEM_REQUIREMENT } from '../data/flow-pricing.ts';
import { FLOW_MEASUREMENTS } from '../data/flow-measurements.ts';
import { ORIONFOLD_FLOW_IDEAS_CAMPAIGN, ORIONFOLD_FLOW_LIVE } from '../data/launch.ts';
import '../styles/flow.css';

import appIcon from '../assets/flow/flow-app-icon-512.png';
// Flow Guide capture (3840x2100, light only). The hero artifact: the Welcome
// document renders "Conduct beautiful documents" as its own H1, so the page's
// headline and the product agree inside one frame.
import shotGuideCharts from '../assets/flow/shots/flow-guide-charts-market-shot.webp';

const og = ogMeta('/flow/');
const flowUrl = `${SITE.url}/flow/`;
const flowStoryHref = '/story/limitless-without-the-pill/';

// Title tag, OG card title (src/data/og.ts), and H1: one promise, three
// lengths. The official tagline stays in the press kit, where a journalist
// wants the exact phrase.
const FLOW_TITLE = 'Orionfold Flow · Charts and diagrams from plain text, offline on your Mac';

const totalChapters = FLOW_CATEGORIES.reduce((n, c) => n + c.chapters.length, 0);
const chapterOffsets = FLOW_CATEGORIES.reduce<number[]>((acc, c, i) => [...acc, (acc[i - 1] ?? 0) + (FLOW_CATEGORIES[i - 1]?.chapters.length ?? 0)], []);

// "Measured, not promised" stat band. Each number is a recorded measurement;
// the fine print names its scope so the claim stays checkable.
// DATES REMOVED 2026-08-22 (operator): the fine print states the DATA — what
// was measured and on what — and no longer carries capture dates. The dates
// remain recorded in the capability briefs and this file's history; nothing
// about a figure changed, only whether the strip prints its timestamp.
const stats = FLOW_MEASUREMENTS;

// Price strings come from the catalog via formatUsd, never from a literal, so
// the FAQ, the pricing section and the JSON-LD Offer cannot disagree.
const flowMonthlyDisplay = formatUsd(FLOW.monthly.amount);
const flowAnnualDisplay = formatUsd(FLOW.annual.amount);

const faqs = [
  {
    q: 'What is Orionfold Flow?',
    a: 'Flow is a native Mac app for professional documents with AI agency built in. It works on ordinary folders of plain Markdown files. Every AI change arrives as an exact diff you approve, and a receipt records what ran, where it ran, and what it cost.',
  },
  // Buyer questions. These feed faqSchema, so every answer here also reaches
  // Google and the AI answer engines; a wrong one is wrong in more places than
  // this page. All five are gated on ORIONFOLD_FLOW_LIVE: while it is off the
  // page keeps the pre-launch answer instead, because a price nothing can charge
  // must not appear in structured data.
  ...(ORIONFOLD_FLOW_LIVE
    ? [
        {
          q: 'How much does Flow cost?',
          a: `Reading, writing, searching, organizing and exporting your documents are free forever, with no account and no expiry. Flow's AI features are ${flowMonthlyDisplay} a month, or ${flowAnnualDisplay} a year if you pay for the year at once. One licence covers one person on as many of your own Macs as you like. Nobody counts your machines.`,
        },
        {
          q: 'Is there a free version of Flow?',
          a: 'Yes, and it is not a trial. The whole document side of Flow is free permanently: the editor, the reader, search across your folders including search by meaning, wiki links, tables, charts, the bundled guide, dictation, the shipped guardrail checks and app updates. You can also read every receipt, timeline and evidence score Flow has ever recorded, permanently, even if you never subscribe. What you pay for is running the AI that produces new ones. You also get a stretch of Pro access to try it properly, and a day is only spent on a day you actually use it.',
        },
        {
          q: 'What happens if I stop paying?',
          a: 'The AI stops. That is the whole list. There are no document locks, no read-only mode, no export wall and no watermark. Your files are ordinary Markdown in your own folders, so they stay open and editable in Flow and in any other editor. App updates keep arriving too, including security fixes.',
        },
        {
          q: 'Are local models free to use in Flow?',
          a: 'No, and this is the line most people expect to go the other way. Flow can run models on your own Mac with no network involved, and that is still part of the subscription. What you pay for is the layer around the model: the routing that picks which one runs, the tools it may use, the approval step, the receipt and the checks on its output. Flow never charges for the words a model produces and never touches your provider bill.',
        },
        {
          q: 'What Macs does Flow run on?',
          a: `${FLOW_SYSTEM_REQUIREMENT}. Flow is a direct download, signed and notarized, outside the App Store.`,
        },
      ]
    : [
        {
          q: 'When does Flow launch?',
          a: 'Very soon. Every capability on this page is built and running, and Flow is used daily for real work by its builder. What is left is the way you first meet the app and the way you buy it: first-run onboarding, then licensing and updates. Join the waitlist to get the launch note the day it ships.',
        },
      ]),
  {
    q: 'Does my text leave my Mac?',
    a: 'Only if you allow it. Flow separates where AI may run into four switchable domains: Local, LAN, Cloud prepaid, and Cloud postpaid. Search is on-device, and a fallback that would leave your Mac stops and asks first.',
  },
  {
    q: 'What does "patent pending" mean for Flow?',
    a: 'Flow includes patent-pending technology for revision-scoped, verifiable AI agency in durable documents. A pending application does not mean granted rights, and it does not cover every Flow feature.',
  },
  {
    q: 'Do I need to install a separate AI runtime?',
    a: 'No. Flow carries its own local inference runtime inside the app, adding about 19 MiB to the download, and it has been measured end to end: on a machine with no other AI runtime present, a model was pulled and runs were approved entirely by the app itself. If you already run Ollama or LM Studio, Flow detects them and serves the models you already pulled in place, with nothing copied.',
  },
  {
    q: 'How is Flow different from a chat canvas or artifacts panel?',
    a: 'A chat canvas is a session workspace. The output lives inside the chat tool, export breaks formatting, and attribution is lost the moment you paste. Flow works the other way around: the document on your disk is the workplace. AI proposes changes there, you approve them there, and the record stays with the file.',
  },
  {
    // Added 2026-08-21. The site could answer "how does Flow keep me safe" in
    // eight places and "what do I get out of it" in none. This is the answer
    // engines' version of the hero's capability line, and it stays inside the
    // briefs: charts and diagrams ship, Expand with Sources ships, and the
    // improvement claim is scoped to what routing actually does (reads
    // measured speed on this Mac) rather than a document that rewrites itself.
    q: 'What can Flow actually do for my document?',
    a: 'Flow draws charts and diagrams in place from the plain text in your file, fifty four types, offline and in one house style. It can research a partial document using your own folders, showing each lookup as it happens. It reviews a fifty page document part by part instead of cutting it. And because Flow measures the models on your Mac and routes by rules you keep, the same document uses a better model as your models get better, without you changing anything. Every one of those arrives as a diff you approve.',
  },
  {
    // Added 2026-08-21 after a competitive check (Obsidian, Typora, Bear, iA
    // Writer, Craft, Ulysses, Zettlr, Logseq, Joplin, Notion, MarkText,
    // VS Code + MPE). TWO RAILS, both load-bearing:
    //   * NEVER claim "the only app that renders charts and diagrams".
    //     MarkText bundles mermaid 11 and vega-embed and does both natively;
    //     verified in its package.json on 2026-08-21. That claim would be
    //     false and an evaluator would catch it.
    //   * NEVER lead with Mermaid. Bear (2.9.2, Jul 2026), Craft, Typora,
    //     Joplin, Obsidian, Zettlr and VS Code all render it natively.
    // The real, defensible difference is NAMED TYPES vs a hand-authored
    // chart grammar, plus one house style across both engines. Obsidian's
    // chart support is a COMMUNITY PLUGIN (Chart.js, a handful of types),
    // which is why "core" is the word doing the work below.
    // TWO MORE RAILS, added the same day from a second market check:
    //   * Do NOT write that Craft "draws Mermaid" unqualified. Craft's own
    //     help page (support.craft.do/en/write-and-edit/mermaid-diagrams,
    //     read 2026-08-21) lists flowchart, sequence, state, class, ER and XY
    //     chart, then says "other types like pie charts, Gantt charts, or
    //     mindmaps are not currently supported". Naming that limit is both
    //     more accurate and more useful than a flat list.
    //   * Do NOT use "offline" inside the competitor comparison. Offline
    //     rendering is documented only for Typora and MarkText; asserting or
    //     implying it about Bear or Craft is the likeliest expert challenge.
    //     Flow's own offline claim is fine and lives in the chapters, welded
    //     to Flow. Here the phrase is "drawn in place".
    q: 'Do other Markdown apps draw charts like this?',
    a: 'Diagrams, yes. Mermaid is common now, and Typora, Bear, Joplin, Obsidian and VS Code all draw it, though coverage varies: Craft, for one, says pie charts, Gantt charts and mindmaps are not currently supported. Data charts are the rare part. Obsidian needs a community plugin for a handful of chart types, most apps offer none at all, and the few editors that do draw charts hand you a chart grammar to write by hand. Flow ships 34 chart types you pick by name, next to 20 diagram types, drawn in place in one house style, from plain text that any other editor still shows as text.',
  },
  {
    q: 'Is Flow another notes database?',
    a: 'No. Flow opens ordinary folders of ordinary Markdown files. There is no import step and no library format. Every other tool on your Mac can read the same files at the same time, and delete goes to the system Trash.',
  },
];

// Merchant fields for a digital product, matching the shape the other paid
// Orionfold products use (defined locally per file, as they are).
const flowMerchantFields = {
  hasMerchantReturnPolicy: {
    '@type': 'MerchantReturnPolicy',
    applicableCountry: 'US',
    returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted',
  },
  shippingDetails: {
    '@type': 'OfferShippingDetails',
    shippingRate: { '@type': 'MonetaryAmount', value: '0', currency: 'USD' },
    shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'US' },
  },
};

const flowAvailability = ORIONFOLD_FLOW_LIVE
  ? 'https://schema.org/InStock'
  : 'https://schema.org/OutOfStock';

// The press-kit Status row. This shipped UNGATED and so kept telling journalists
// that licensing was unfinished and a waitlist was open while the launch flag was
// ON -- the third time a flag-less Flow surface drifted (llms.txt twice before).
// Anything a journalist quotes has to track the flag like the rest of the page.
const pressStatus = ORIONFOLD_FLOW_LIVE
  ? 'Released for Mac. Every capability shown on this page is built, running, and used daily for real work by its builder. Direct download for Mac, signed and notarized, outside the App Store.'
  : 'Every capability shown on this page is built and running, and Flow is used daily for real work by its builder. The remaining work is first-run onboarding, then licensing and updates. Direct download for Mac, signed and notarized, outside the App Store. Waitlist open on this page.';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Orionfold Flow',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'macOS',
  description:
    'Orionfold Flow is a native Mac app for professional documents with AI agency built in. Every AI change is a diff you approve, with a receipt recording what ran, where, and what it cost. Patent pending.',
  url: flowUrl,
  image: `${SITE.url}${og.image}`,
  author: PERSON,
  brand: { '@type': 'Brand', name: 'Orionfold' },
  // Flow is the first SUBSCRIPTION offer on this site, so it needs a shape the
  // three one-time-license products did not: each Offer carries a
  // priceSpecification with a billingDuration, or a crawler reads "$96" as a
  // one-off purchase and the annual plan looks ten times more expensive than
  // the monthly one.
  //
  // Base (Flow unlicensed) is deliberately NOT an Offer. It has no SKU and
  // nothing to buy; it is expressed by the free-to-use SoftwareApplication
  // itself. Only the subscription is offered.
  //
  // Availability is gated on ORIONFOLD_FLOW_LIVE exactly like Relay Host gates
  // on RELAY_HOST_LIVE, so a pre-launch crawl reports OutOfStock rather than
  // advertising a price nothing can yet charge.
  offers: [
    {
      '@type': 'Offer',
      name: 'Orionfold Flow, monthly',
      price: (FLOW.monthly.amount / 100).toFixed(2),
      priceCurrency: 'USD',
      availability: flowAvailability,
      url: `${flowUrl}#pricing`,
      category: 'Software subscription',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: (FLOW.monthly.amount / 100).toFixed(2),
        priceCurrency: 'USD',
        billingDuration: FLOW.periodMonths.monthly,
        billingIncrement: 1,
        unitCode: 'MON',
      },
      ...flowMerchantFields,
    },
    {
      '@type': 'Offer',
      name: 'Orionfold Flow, annual',
      price: (FLOW.annual.amount / 100).toFixed(2),
      priceCurrency: 'USD',
      availability: flowAvailability,
      url: `${flowUrl}#pricing`,
      category: 'Software subscription',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: (FLOW.annual.amount / 100).toFixed(2),
        priceCurrency: 'USD',
        billingDuration: FLOW.periodMonths.annual,
        billingIncrement: 1,
        unitCode: 'MON',
      },
      ...flowMerchantFields,
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// The hero carries the SAME named offer and consent scope as the FlowWaitlist
// panels, with its own formId/source so DOM ids stay unique and the placements
// stay distinguishable in conversion data.
const heroConsentText = FLOW_CONSENT_TEXT;
---
<Layout
  title={FLOW_TITLE}
  description="A native Mac app that draws 54 kinds of chart and diagram in place from the plain text in your file, offline. Every AI change is a diff you approve, with a receipt. Patent pending."
  ogImage={og.image}
  ogImageAlt={og.alt}
  jsonLd={[
    softwareSchema,
    faqSchema,
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Flow', item: flowUrl },
      ],
    },
  ]}
>
  <Nav />
  <main class="flow-page overflow-x-clip">
    <!-- ================= HERO ================= -->
    <section class="flow-hero relative px-6 pb-16 pt-32 sm:pt-40">
      <div class="flow-hero__grid" aria-hidden="true"></div>
      <div class="flow-hero__glow" aria-hidden="true"></div>
      {/* TWO-COLUMN HERO (2026-08-21, operator direction). Same layout as the
          homepage: copy left, artifact right, so the picture sits BESIDE the
          claim rather than a scroll below it. Collapses to one centred column
          below lg. */}
      <div class="relative mx-auto grid w-full max-w-[88rem] items-center gap-10 lg:grid-cols-[0.8fr_1.3fr] lg:gap-12">
        <!-- Left column: who it is for, the claim, the ask -->
        <div class="flow-hero__copy min-w-0 text-center lg:text-left">
          <div class="flex flex-wrap items-center justify-center gap-2 lg:justify-start">
            <span class="flow-eyebrow-chip">
              <Image src={appIcon} alt="" width={40} height={40} class="h-5 w-5 rounded-[5px]" loading="eager" />
              Orionfold Flow
            </span>
            <span class="flow-eyebrow-chip">Native Mac</span>
            <span class="flow-eyebrow-chip flow-eyebrow-chip--accent">Patent pending</span>
          </div>
          <!-- Context first: who this is for. Then one claim, stated once, and
               the picture that proves it. The receipt, the domains, and the diff
               each get their own chapter on the tour pages. -->
          <p class="of-eyebrow mt-7">
            For creators, builders, and authors.
            {/* Second line, dimmer: the audience is named first, then widened.
                Splitting it stops the eyebrow wrapping mid-thought at any
                width, and the tone drop marks it as the aside it is. */}
            <span class="hero-icp__wide">Anyone whose name is on the document.</span>
          </p>
          {/* Two lines on a large screen, one sentence each: the spans go
              display:block + nowrap from lg up (flow.css .flow-hero__title).
              2026-08-21: the homepage owns the tagline ("Conduct beautiful
              documents. Choose where AI operates."), so this page must NOT
              repeat it -- a reader arriving from / would see the same sentence
              twice and learn nothing. The homepage sells the promise; this page
              sells what the file itself can hold, which is the tour's subject
              and what the picture beside it shows. */}
          <h1 class="flow-hero__title hero-gradient-text mt-4 font-display text-[clamp(1.7rem,2.85vw,2.2rem)] font-extrabold leading-[1.1] tracking-[-0.04em]">
            <span>Charts and images.</span>{' '}
            <span>Flow organizes. AI refines.</span>{' '}
            <span>Human approves.</span>
          </h1>
          <p class="mt-6 max-w-xl text-balance text-lg leading-[1.5] text-text-muted sm:text-xl">
            Fifty four kinds of chart and diagram, drawn in place and offline. Flow lays them out, AI proposes the changes, and nothing lands until you approve it.
          </p>
          {/* Once Flow ships the hero leads with the app itself, and the
              download is its ONLY ask: the email capture was moved out of the
              hero so nothing competes with it above the fold. Pre-launch, the
              waitlist form leads exactly as before. */}
          <div class="mt-9 max-w-md lg:mx-0">
            {ORIONFOLD_FLOW_LIVE ? (
              /* ONE ASK IN THE HERO (operator 2026-08-22 20:58). Once Flow ships
                 the download is the only call to action above the fold; the email
                 capture moved out so the hero does not fork the reader. It still
                 appears further down the page. */
              <FlowDownloadCta source="flow-hero" size="large" />
            ) : (
              /* Pre-launch there is no download to offer, so the hero keeps the
                 waitlist rather than standing empty. */
              <>
                <WaitlistForm
                  id="flow-hero-waitlist"
                  source="flow-hero-waitlist"
                  offer="flow-waitlist"
                  buttonText="Join the waitlist"
                  successMessage="Check your inbox to confirm."
                  consentText={heroConsentText}
                />
                <p class="of-waitlist-caption mt-3 font-mono uppercase text-text-dim">
                  Free to join · Double opt-in · One email a week, no more
                </p>
              </>
            )}
          </div>
        </div>

        {/* RIGHT COLUMN: the artifact. Flow is roughly 90% rendered document
            and 10% chrome, so the hero shows what the file holds: a chart
            catalogue beside a document carrying a diagram and a photograph --
            the headline's three nouns, in one frame.
            MOTION: float + one slow sheen sweep, shared with the homepage. Both
            animate `transform` only (compositor-only, no layout or paint),
            which is why they are safe on the eager LCP image where a
            `data-animate` reveal would NOT be. The caption bar keeps the
            pre-launch framing, which must stay welded to the shot. */}
        <div class="home-hero__shot">
          <div class="home-hero__shot-frame">
            <FlowShot
              src={shotGuideCharts}
              alt="Two documents open side by side in Orionfold Flow: a Visualization Gallery showing a highlighted bar chart and a grouped bar chart with their source notes, beside a market landscape document showing a flow diagram and a photograph of a whiteboard."
              crop
              sizes="(min-width: 1536px) 64rem, (min-width: 1280px) 54rem, (min-width: 1024px) 44rem, 100vw"
              priority
            />
            <span class="home-hero__sheen" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </section>


    <!-- ================= STAT BAND ================= -->
    <section class="border-y border-border/70 bg-surface-raised/40 px-6 py-16 sm:py-20" aria-labelledby="flow-stats-heading">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="of-eyebrow" data-animate="rise">Measured, not promised</p>
          <h2 id="flow-stats-heading" class="of-display mt-4 text-[clamp(2rem,4vw,3rem)]" data-animate="lead">Numbers, not adjectives.</h2>
          <p class="of-lede mx-auto mt-5 text-center" data-animate="rise">Every figure comes from a recorded measurement of the running build. The fine print names exactly what was measured.</p>
        </div>
        {/* INFOGRAPHIC TILES, same treatment as the homepage stat strip: one
            glyph per figure, and a single gap value in both axes so the nine
            tiles sit on an even rhythm however long their fine print runs. */}
        <dl class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3" data-animate-stagger="slow">
          {stats.map((s) => (
            <div class="flow-stat" data-animate="rise">
              <dd class="flow-stat__row of-spec-figure">
                <LineIcon name={s.icon} class={`flow-stat__icon flow-stat__icon--${s.tone}`} strokeWidth={1.6} />
                <span>{s.value}</span>
              </dd>
              <dt class="of-spec-label mt-1.5 font-semibold text-text">{s.label}</dt>
              <dd class="of-spec-fine mt-2">{s.fine}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    {/* Campaign splice, launch-dark until Flow Ideas has its own acceptance.
        The measured band above and the real product proof below remain in
        their original order; this metaphor never replaces either one. */}
    {ORIONFOLD_FLOW_IDEAS_CAMPAIGN && (
      <FlowIdeasPitStop id="flow-ideas-pit-stop" variant="flow" />
    )}

    <!-- ================= THE WHOLE PROMISE IN ONE PICTURE ================= -->
    <section class="px-6 py-16 sm:py-20">
      <div class="mx-auto max-w-4xl">
        <p class="flow-kicker text-center" data-animate="rise">How the pieces fit</p>
        <h2 class="of-display mt-4 text-center text-[clamp(2rem,4vw,3rem)]" data-animate="lead">Five layers, one approval.</h2>
        <div class="mt-10">
          <FlowWorkbenchIllustration />
          <p class="mx-auto mt-6 max-w-2xl text-center text-sm leading-relaxed text-text-muted">
            The whole promise in one picture. Your outcome sits on trusted context, specialist
            intelligence does the work, nothing passes without your call, and a durable receipt
            records how it happened.
          </p>
        </div>
      </div>
    </section>

    <!-- ================= PRODUCT TOUR (four category pages) =================
         2026-08-20 split: the tour chapters live at /flow/<category>/
         (src/components/flow/chapters/*, data in src/data/flow-categories.ts).
         Each chapter link below carries the chapter's ORIGINAL #tour-<chapter>
         id, so every deep link published before the split still lands here
         and goes one click onward. Chapters are numbered 1 to 13 across the
         four parts so the series reads as one set to complete. -->
    <section id="tour" class="scroll-mt-28 border-t border-border/70 px-6 py-16 sm:py-24" aria-labelledby="tour-heading">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="flow-kicker" data-animate="rise">The product tour</p>
          <h2 id="tour-heading" class="of-display mt-4 text-[clamp(2.1rem,5vw,3.5rem)]" data-animate="lead">Real screens. Real runs. Real receipts.</h2>
          <p class="mt-5 text-lg leading-relaxed text-text-muted">
            {totalChapters} chapters in four parts. Every screen is a real capture of the development
            build. Start with the part that matches your question.
          </p>
        </div>
        <div class="mt-12 grid gap-4 md:grid-cols-2" data-animate-stagger>
          {FLOW_CATEGORIES.map((cat, i) => (
            <article class="flow-cat-card of-surface flex flex-col rounded-2xl border border-border/70 p-6 sm:p-7" data-animate>
              <a href={flowCategoryHref(cat.slug)} class="flow-cat-card__plate" aria-hidden="true" tabindex="-1">
                <Image src={FLOW_CATEGORY_SHOTS[cat.slug].src} alt={FLOW_CATEGORY_SHOTS[cat.slug].alt} widths={[560, 1120]} sizes="(min-width: 768px) 42vw, 88vw" class="flow-cat-card__thumb" loading="lazy" decoding="async" />
              </a>
              <p class="mt-5 font-mono text-[0.62rem] uppercase tracking-[0.16em] text-accent-ink">Part {i + 1} of {FLOW_CATEGORIES.length} · {cat.label} · Chapters {chapterOffsets[i] + 1} to {chapterOffsets[i] + cat.chapters.length}</p>
              <h3 class="mt-3 text-xl font-bold leading-snug"><a href={flowCategoryHref(cat.slug)} class="transition-colors hover:text-primary">{cat.title}</a></h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-text-muted">{cat.blurb}</p>
              <ul class="flow-cat-card__list mt-5">
                {cat.chapters.map((ch, j) => (
                  <li><a id={ch.id} class="scroll-mt-28" href={`${flowCategoryHref(cat.slug)}#${ch.id}`}><span><span class="font-mono text-[0.62rem] text-text-dim">{chapterOffsets[i] + j + 1}</span> {ch.label}</span><span>Read →</span></a></li>
                ))}
              </ul>
              <a href={flowCategoryHref(cat.slug)} class="of-text-action mt-6 inline-flex items-center gap-2">Open {cat.label} <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= WHO FEELS THIS FIRST ================= -->
    <section class="border-t border-border/70 px-6 py-16 sm:py-24" aria-labelledby="open-file-heading">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="flow-kicker" data-animate="rise">Who feels this first</p>
          <h2 id="open-file-heading" class="of-display mt-4 text-[clamp(2rem,4vw,3rem)]" data-animate="lead">Built for the moment someone opens the file.</h2>
          <p class="mt-5 text-lg leading-relaxed text-text-muted">
            Diligence has moved from the story to the artifact. Investors open the file.
            Journalists check the stat. Clients ask what the AI touched. Flow is for the
            people whose name is on the document.
          </p>
        </div>
        <div class="mt-10 grid gap-4 md:grid-cols-3">
          <article class="of-surface rounded-2xl border border-border/70 p-6">
            <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-accent-ink">Founders raising</p>
            <h3 class="mt-3 text-lg font-bold leading-snug">One fake citation can kill a round.</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">Your pitch is a living document with every claim tied to its source. When a partner asks where a number came from, the answer is attached to the number.</p>
          </article>
          <article class="of-surface rounded-2xl border border-border/70 p-6">
            <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-accent-ink">Comms and earned media</p>
            <h3 class="mt-3 text-lg font-bold leading-snug">Journalists now screen for AI slop.</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">A story with quotes, stats, and coverage attached earns trust that a polished paste job cannot. Proof travels with the piece, and a human approved every line.</p>
          </article>
          <article class="of-surface rounded-2xl border border-border/70 p-6">
            <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-accent-ink">Independent operators</p>
            <h3 class="mt-3 text-lg font-bold leading-snug">Client work that survives scrutiny.</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">Proposals, analyses, and briefs where sensitive documents stay on your Mac by default, and the record shows exactly what ran and what it cost.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ================= ENTERPRISE (three cards; all nine on /flow/enterprise/) ================= -->
    <section id="enterprise" class="scroll-mt-28 border-t border-border/70 bg-surface-raised/40 px-6 py-16 sm:py-24" aria-labelledby="enterprise-heading">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="flow-kicker" data-animate="rise">Enterprise adoption patterns</p>
          <h2 id="enterprise-heading" class="of-display mt-4 text-[clamp(2rem,4vw,3rem)]" data-animate="lead">The questions enterprise AI owners ask. Answered in the document.</h2>
          <p class="mt-5 text-lg leading-relaxed text-text-muted">
            Enterprises do not fail at AI for lack of models. They fail because they cannot tell
            which 30 percent of the output is wrong, who approved what, and what it all cost.
          </p>
        </div>
        <div class="mt-12 grid gap-4 md:grid-cols-3" data-animate-stagger>
          {FLOW_ENTERPRISE_TEASER.map((card) => (
            <article class="flow-ent-card of-surface flex flex-col rounded-2xl border border-border/70 p-6" data-animate>
              <div class="flex items-center justify-between gap-3">
                <span class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-accent-ink">{card.k}</span>
                <span class:list={['flow-ent-tag', card.tag === 'Direction' && 'flow-ent-tag--direction']}>{card.tag}</span>
              </div>
              <h3 class="mt-3 text-lg font-bold leading-snug">{card.q}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-text-muted">{card.a}</p>
            </article>
          ))}
        </div>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/flow/enterprise/" class="of-primary-action">All nine patterns, with what ships today</a>
        </div>
      </div>
    </section>

    <!-- ================= PRESS KIT ================= -->
    {/* Pricing sits after the reader has seen what Flow does and before the
        press kit. While ORIONFOLD_FLOW_LIVE is off it shows the Base/Pro
        capability split with no amount and no buy button. */}
    <FlowPricing />

    <section id="press" class="scroll-mt-28 border-t border-border/70 px-6 py-16 sm:py-24" aria-labelledby="press-heading">
      <div class="mx-auto max-w-4xl">
        <p class="flow-kicker text-center" data-animate="rise">Writing about Flow?</p>
        <h2 id="press-heading" class="of-display mt-4 text-center text-[clamp(2rem,4vw,3rem)]" data-animate="lead">The facts, ready to quote.</h2>
        <div class="mt-10 overflow-hidden rounded-2xl border border-border/70">
          <table class="w-full text-left text-sm">
            <tbody class="divide-y divide-border/70">
              <tr class="bg-surface"><th scope="row" class="w-40 px-5 py-3.5 font-mono text-[0.66rem] uppercase tracking-[0.14em] text-text-dim align-top">Product</th><td class="px-5 py-3.5 text-text">Orionfold Flow. A native Mac app for professional documents with AI agency built in.</td></tr>
              <tr class="bg-surface-raised/40"><th scope="row" class="px-5 py-3.5 font-mono text-[0.66rem] uppercase tracking-[0.14em] text-text-dim align-top">Tagline</th><td class="px-5 py-3.5 text-text">"{SITE.tagline}."</td></tr>
              <tr class="bg-surface"><th scope="row" class="px-5 py-3.5 font-mono text-[0.66rem] uppercase tracking-[0.14em] text-text-dim align-top">Status</th><td class="px-5 py-3.5 text-text">{pressStatus}</td></tr>
              <tr class="bg-surface-raised/40"><th scope="row" class="px-5 py-3.5 font-mono text-[0.66rem] uppercase tracking-[0.14em] text-text-dim align-top">Patent</th><td class="px-5 py-3.5 text-text">Flow includes patent-pending technology for revision-scoped, verifiable AI agency in durable documents.</td></tr>
              <tr class="bg-surface"><th scope="row" class="px-5 py-3.5 font-mono text-[0.66rem] uppercase tracking-[0.14em] text-text-dim align-top">The wedge</th><td class="px-5 py-3.5 text-text">Text changes two ways only: an edit you typed, or a change you approved. Every AI change is an exact diff with evidence, checks, and a receipt naming what ran, where, and what it cost. Chat is where work evaporates; Flow is where the record is kept.</td></tr>
              <tr class="bg-surface-raised/40"><th scope="row" class="px-5 py-3.5 font-mono text-[0.66rem] uppercase tracking-[0.14em] text-text-dim align-top">Numbers</th><td class="px-5 py-3.5 text-text">Search p95 of 22.3 ms on a 10,000-note library (2026-08-04). Long-document planning linear through 620,000 characters. A real billed run recorded at $0.00425, reproducible to the digit. A complete two-engine local AI runtime inside the app for about 19 MiB (2026-08-14).</td></tr>
              <tr class="bg-surface"><th scope="row" class="px-5 py-3.5 font-mono text-[0.66rem] uppercase tracking-[0.14em] text-text-dim align-top">Founder</th><td class="px-5 py-3.5 text-text">Manav Sehgal, Orionfold LLC, Sacramento, California. Press and analyst contact: <a href="mailto:manav@orionfold.com" class="text-primary underline underline-offset-2">manav@orionfold.com</a>.</td></tr>
              <tr class="bg-surface-raised/40"><th scope="row" class="px-5 py-3.5 font-mono text-[0.66rem] uppercase tracking-[0.14em] text-text-dim align-top">Imagery</th><td class="px-5 py-3.5 text-text">Every screenshot on this page is a real capture of the running build over a synthetic demo library. Email for original-resolution captures and the app icon.</td></tr>
            </tbody>
          </table>
        </div>
        <p class="mt-6 text-center text-sm leading-relaxed text-text-muted">
          Background story: <a href={flowStoryHref} class="text-primary underline underline-offset-2">why I built documents that can think and act</a>.
          The models, the books, and the Relay and Arena products are in the footer directory.
        </p>
      </div>
    </section>

    <!-- ================= FAQ ================= -->
    <section class="bg-surface-raised/40 px-6 py-16 sm:py-24" aria-labelledby="faq-heading">
      <div class="mx-auto max-w-3xl">
        <h2 id="faq-heading" class="of-display text-center text-[clamp(2rem,4vw,3rem)]" data-animate="lead">Questions, answered plainly.</h2>
        <div class="mt-10 flex flex-col gap-3">
          {faqs.map((f) => (
            <details class="of-surface group rounded-2xl border border-border/70 p-5 open:border-primary/30">
              <summary class="cursor-pointer list-none text-base font-semibold text-text marker:content-none [&::-webkit-details-marker]:hidden">
                <span class="flex items-center justify-between gap-4">
                  {f.q}
                  <span class="text-primary transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
                </span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-text-muted">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= WAITLIST ================= -->
    <div id="waitlist" class="scroll-mt-24">
      <FlowWaitlist placement="flow" storyHref={flowStoryHref} />
    </div>
  </main>
  <Footer />
</Layout>
