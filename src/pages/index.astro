---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ogMeta } from '../data/og';
import { SITE, PERSON } from '../data/seo';
import '../styles/living-base.css';
import '../styles/living-home.css';
import HomeHero from '../components/living/HomeHero.astro';
import CapabilityRibbon from '../components/living/CapabilityRibbon.astro';
import HomeContinuity from '../components/living/HomeContinuity.astro';
import HomeDocumentWorkshop from '../components/living/HomeDocumentWorkshop.astro';
import HomeIdeas from '../components/living/HomeIdeas.astro';
import HomeProof from '../components/living/HomeProof.astro';
import Founder from '../components/living/Founder.astro';
import EssayInvitation from '../components/living/EssayInvitation.astro';
import Ecosystem from '../components/living/Ecosystem.astro';
import HomeClosing from '../components/living/HomeClosing.astro';
import ConfirmBanner from '../components/ui/ConfirmBanner.astro';
const title = "Orionfold \u00b7 Make knowledge a living thing.";
const description = "Flow Living Documents on your Mac. Files you own, changes you can review, and useful work that continues between visits.";
const og = ogMeta('/');
const pageSchema = {'@context':'https://schema.org','@type':'SoftwareApplication',name:'Orionfold Flow',applicationCategory:'ProductivityApplication',operatingSystem:'macOS',description,url:`${SITE.url}/flow/`,image:`${SITE.url}${og.image}`,author:PERSON,brand:{'@type':'Brand',name:'Orionfold'}};
---
<Layout title={title} description={description} ogImage={og.image} ogImageAlt={og.alt} bodyClass="ls ls-page-home" jsonLd={pageSchema}>
  <Nav />
  <ConfirmBanner />
  <main id="main" class="ls-main">
    <HomeHero />
    <CapabilityRibbon />
    <HomeContinuity />
    <HomeDocumentWorkshop />
    <HomeIdeas />
    <HomeProof />
    <Founder />
    <EssayInvitation />
    <Ecosystem />
    <HomeClosing />
  </main>
  <Footer showDownload={false} />
</Layout>
<script>
  import "../scripts/living-documents.js";
</script>
