---
// Homepage. Rebuilt 2026-08-14 as a full Flow flagship takeover: real product
// shots from the development build, waitlist capture in the hero and in the
// closing band, and the rest of the catalog relocated to the footer directory.
// The /flow/ page carries the deep product tour, enterprise patterns, press
// kit, and FAQ; this page is the demand-generation front door.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ConfirmBanner from '../components/ui/ConfirmBanner.astro';
import FlowShot from '../components/flow/FlowShot.astro';
import WaitlistForm from '../components/ui/WaitlistForm.astro';
import FlowWaitlist from '../components/sections/FlowWaitlist.astro';
import { Image } from 'astro:assets';
import { ogMeta } from '../data/og';
import { SITE, PERSON } from '../data/seo';

import FlowDetail from '../components/flow/FlowDetail.astro';

import appIcon from '../assets/flow/flow-app-icon-512.png';
import originArt from '../assets/story/limitless-without-the-pill/hero.png';
import shotResourcePopover from '../assets/flow/shots/flow-resource-popover-shot.webp';
import shotApprove from '../assets/flow/shots/flow-writing-you-approve-shot.webp';
import shotLongDocs from '../assets/flow/shots/flow-long-documents-shot.webp';
import shotDomains from '../assets/flow/shots/flow-domains-shot.webp';
import shotCharts from '../assets/flow/shots/flow-charts-shot.webp';
import shotToolbar from '../assets/flow/shots/flow-editor-toolbar-shot.webp';
// Purpose-cut feature details (scripts/prepare-flow-details.mjs). A full window
// shrunk into a page column renders the control being described at ~8px; these
// crops show that one control at a size where the claim is checkable.
import detailDiff from '../assets/flow/details/detail-diff.webp';
import detailToolbarPreview from '../assets/flow/details/detail-toolbar-preview.webp';
import detailDomains from '../assets/flow/details/detail-domains.webp';
import detailParts from '../assets/flow/details/detail-parts.webp';
import detailGrid from '../assets/flow/details/detail-grid.webp';

const og = ogMeta('/');

// The homepage is the Flow front door, so it carries the same product entity
// as /flow/ (canonical product URL stays /flow/). Helps answer engines tie
// "Orionfold" and "Flow" to one SoftwareApplication.
const flowSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Orionfold Flow',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'macOS',
  description:
    'Orionfold Flow is a native Mac app for professional documents with AI agency built in. Every AI change is a diff you approve, with a receipt recording what ran, where it ran, and what it cost. Patent pending.',
  url: `${SITE.url}/flow/`,
  image: `${SITE.url}${og.image}`,
  author: PERSON,
  brand: { '@type': 'Brand', name: 'Orionfold' },
};

// Consent copy must stay identical to FlowWaitlist.astro so a subscriber's
// recorded consent reads the same no matter which surface captured them.
const consentText =
  'By joining the Flow waitlist, you agree to receive Flow development and launch updates plus the AI For Everyone digest, one email a week, no more. You can unsubscribe any time. See our privacy policy.';

const heroStats = [
  { value: '22.3 ms', label: 'search across 10,000 notes' },
  { value: '$0.00425', label: 'a billed run, recorded to the digit' },
  { value: '+19.2 MiB', label: 'a complete local AI runtime' },
  { value: '5 actions', label: 'every one needs your approval' },
];

// One capability per band, and one picture that PROVES it.
//
// Each row now carries two images doing different jobs: `shot` is the whole
// window (context: this is a real Mac app), and `detail` is a purpose-cut crop
// of the exact control the headline names (proof: here is the thing, legibly).
// Before this, the window alone had to do both jobs and did neither: the
// control being described rendered around eight pixels tall.
//
// Copy shape follows the section-headline rhythm: a short verbless claim, then
// one tight paragraph. The long qualifier lists moved to /flow/, which is the
// page built to carry them.
//
// `stage` and `align` drive the round-2 variety rule. The hero above spends
// bottom-right + centred copy, so the bands walk away from it and from each
// other. Full sequence down the page:
//   hero  br / centre
//   1     tl / left      approval
//   2     bl / centre    long documents
//   3     tr / right     trust boundaries
//   4     bl / left      professional artifacts
// No two ADJACENT sections share a corner (bl repeats at 2 and 4, which are
// two apart and read as a rhythm rather than a rut). Keep them distinct —
// collapsing these to one repeated position is the exact thing the operator
// asked us not to do, and tests/e2e/product-stage.spec.ts enforces it.
// `stage` values are the .of-stage__detail--* corner modifiers in global.css.
const capabilityRows = [
  {
    // Moved out of the hero on 2026-08-16 when the resource popover took over
    // that slot. The approval gate is still the product's core promise, so it
    // leads the bands rather than leaving the homepage.
    kicker: 'Approval, not autopilot',
    title: 'Nothing is saved until you approve it.',
    body: 'Every AI change arrives as a diff in the file itself, with the evidence behind it and the checks that ran. Approve it, decline it, or leave it for later. Decline changes nothing at all.',
    href: '/flow/#tour-agency',
    shot: shotApprove,
    alt: 'Orionfold Flow reviewing an AI proofread: the proposal, its permission scope, Evidence, Checks with a human-review gate, and the exact diff beside the document.',
    detail: detailDiff,
    detailAlt: 'The exact proposed diff in Flow: numbered lines with the removed text marked in red, above the Reject, Later, and Approve and Save buttons.',
    detailCaption: 'The exact proposed diff · Nothing is saved until you approve it',
    stage: 'tl',
    align: 'left',
  },
  {
    // Added 2026-08-18 from the editor-toolbar brief. Sits second because it is
    // the step BEFORE the approval gate above it: the strip prices the work
    // while you can still change your mind, the diff gates it once you have.
    // STAGE: 'br' — neighbours are 'tl' above and 'bl' below, so no two
    // adjacent bands share a corner (product-stage.spec.ts asserts this), and
    // it is the one corner the homepage was not yet using.
    kicker: 'Priced before you click',
    title: 'The AI tools tell you the cost first.',
    body: 'The five AI actions live in the document\'s own tool strip, beside bold and italic. Hover one and Flow answers before it runs: how much text it would act on, what it would cost, and which model would do the work. Work on your own Mac is free, and Flow says so in words rather than a number.',
    href: '/flow/#tour-toolbar',
    shot: shotToolbar,
    alt: 'Orionfold Flow with the document tool strip expanded: writing controls, a divider, and five colored AI marks, with Proofread\'s panel stating the scope, the cost, and the model for the run.',
    detail: detailToolbarPreview,
    detailAlt: 'Flow\'s tool strip with Proofread\'s panel open: 3,911 words for the whole document, "No cost, free, it runs on hardware you have", and the model that would run it staying on this Mac.',
    detailCaption: 'Scope, cost, and route · Answered before the click',
    stage: 'br',
    align: 'right',
  },
  {
    kicker: 'Long documents',
    title: 'A 50-page document is not too big. It is four reviews.',
    body: 'Flow plans a long document into ordered parts that follow its own structure, then reviews each part on its own. Never truncated, never guessed. Coverage comes back in counts you can check.',
    href: '/flow/#tour-longdocs',
    shot: shotLongDocs,
    alt: 'A live two-part review on a 3,905-word document in Flow, with part chips and an honest coverage line.',
    detail: detailParts,
    detailAlt: 'Flow’s review header on a long document: numbered part chips, and the line "0 approved, 0 declined, 2 remaining".',
    detailCaption: 'Coverage in plain counts · Approve, decline, or skip any part',
    stage: 'bl',
    align: 'center',
  },
  {
    kicker: 'Trust boundaries',
    title: 'You pick where AI runs. Flow keeps it there.',
    body: 'Four execution domains, each with its own switch: Local, LAN, Cloud prepaid, Cloud postpaid. Every one states plainly whether your text stays on this Mac and what the work costs. A fallback that would leave your Mac stops and asks first.',
    href: '/flow/#tour-domains',
    shot: shotDomains,
    alt: 'Flow’s Models settings showing four execution domains with locality and cost statements and a user-owned provider order.',
    detail: detailDomains,
    detailAlt: 'The Local execution domain in Flow: its switch turned on, the line "Stays on this Mac, free, it runs on hardware you have", and three discovered providers.',
    detailCaption: 'One switch per domain · Discovery never enables anything',
    stage: 'tr',
    align: 'right',
  },
  {
    kicker: 'Professional artifacts',
    title: 'Documents that look like your work, not a chat transcript.',
    body: 'Memos, calendars, proposals, and investment briefs over plain folders of plain Markdown. Pictures render in place. Tables get a real grid while the file stays exactly the text you wrote.',
    href: '/flow/#tour-files',
    shot: shotCharts,
    alt: 'Flow documents carrying images and tables: a publishing calendar beside an investment memo with charts and metrics.',
    detail: detailGrid,
    detailAlt: 'A Markdown table open in Flow’s spreadsheet grid, one cell selected and named R5:C2 in the cell editor bar above it.',
    detailCaption: 'Edit the cell, not the pipes · The file stays plain Markdown',
    stage: 'bl',
    align: 'left',
  },
];

const enterpriseTeaser = [
  {
    k: 'Data classification',
    q: 'Which documents may AI touch, and which AI may touch them?',
    a: 'The folder is the classification. Four switchable domains decide where work may run.',
  },
  {
    k: 'Attribution',
    q: 'Who changed this part, human or AI, and when?',
    a: 'Text changes two ways only: an edit you typed, or a change you approved. With a receipt.',
  },
  {
    k: 'Knowledge mining',
    q: 'How do we capture expert judgment without surveillance?',
    a: 'The receipt is made by the worker, artifact by artifact, with consent. Not by watching them.',
  },
];
---
<Layout
  title={`${SITE.tagline} · Orionfold`}
  description={SITE.description}
  ogImage={og.image}
  ogImageAlt={og.alt}
  jsonLd={[flowSchema]}
>
  <Nav />
  <!-- Surfaces the ?confirmed= state the confirm-email funnel redirects here with -->
  <ConfirmBanner />
  <main class="overflow-x-clip">
    <!-- ================= HERO ================= -->
    <section class="home-hero relative px-6 pb-16 pt-32 sm:pt-36">
      <div class="home-hero__grid" aria-hidden="true"></div>
      <div class="home-hero__glow" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-5xl text-center">
        <div class="flex flex-wrap items-center justify-center gap-2">
          <span class="home-chip">
            <Image src={appIcon} alt="" width={40} height={40} class="h-5 w-5 rounded-[5px]" loading="eager" />
            Orionfold Flow · Our flagship Mac app
          </span>
          <span class="home-chip home-chip--accent">Patent pending</span>
        </div>
        <!-- Operator copy, 2026-08-16. Written against the hero picture: the
             "What Flow is using" popover open over a real document, with the
             local runtime serving the model. The headline says OPEN models
             deliberately — that is the wedge, and the picture backs it (the
             Models pane shows Ollama, LM Studio, and Flow's own runtime, with
             a 19.1 GB open model actually answering). The subtext names the
             three things the picture lets you check (cost $0.00, privacy — it
             ran on this Mac, quality — you can see which model answered), then
             heads off the obvious objection: open-first is not open-only. -->
        <h1 class="hero-gradient-text mx-auto mt-7 max-w-4xl font-display text-[clamp(2.4rem,8.4vw,4.6rem)] font-extrabold leading-[1.03] tracking-[-0.055em]">
          Bring open AI models to your documents
        </h1>
        {/* Each sentence is its own line on a large screen, and none of them
            breaks mid-sentence. `.hero-lede` sets the three spans to
            display:block + text-wrap:nowrap only from lg up, so the container
            stops constraining them; below lg they fall back to inline spans in
            one balanced paragraph, because forcing nowrap on a phone would
            push the longest sentence off the side of the screen. */}
        <p class="hero-lede mx-auto mt-6 max-w-xl text-balance text-xl leading-[1.5] text-text-muted sm:text-2xl">
          <span>Stay in control of cost, privacy, and quality on your Mac.</span>{' '}
          <span>Switching to frontier models is a checkbox.</span>{' '}
          <span>Flow selects the best model for the job.</span>
        </p>
        <div class="mx-auto mt-9 max-w-md">
          <WaitlistForm
            id="home-hero-waitlist"
            source="home-hero-waitlist"
            offer="flow-waitlist"
            buttonText="Join the waitlist"
            successMessage="Check your inbox to confirm."
            consentText={consentText}
          />
          <p class="mt-3 font-mono text-[0.64rem] uppercase tracking-[0.14em] text-text-dim">
            Free to join · Double opt-in · One email a week, no more
          </p>
        </div>
      </div>
      <!-- The hero product visual: the whole window for context, with the ONE
           control the headline is about lifted out and shown at a legible size.
           The window alone made "shows its work" an unreadable thumbnail. -->
      {/* The hero picture: a live local run with the resource popover open.
          No overlay crop here, deliberately — unlike the other captures, this
          popover is already legible at full-window scale, so a zoom of it
          would repeat what the reader can see rather than reveal anything. The
          overlay pattern exists to rescue an 8px control; it is not decoration
          to apply by default. */}
      <div class="mx-auto mt-14 w-full max-w-[78rem]">
        <FlowShot
          src={shotResourcePopover}
          alt="Orionfold Flow during a live local run: the Models settings with the built-in runtime enabled, a field-notes document open, and the What Flow is using popover reporting processor at 35 percent, memory at 53 percent, whole-Mac graphics at 100 percent, the model's 19.1 GB footprint, the token ledger, and a spend of zero dollars."
          sizes="(min-width: 1280px) 78rem, (min-width: 1024px) 64rem, 100vw"
          priority
        />
      </div>
      {/* Matches the stage's width, not the old max-w-6xl: with the media now
          running to 78rem, a narrower stat row read as a second, misaligned
          column edge directly beneath it. */}
      <div class="mx-auto mt-10 w-full max-w-[78rem] sm:mt-14">
        <dl class="grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4" data-animate-stagger="slow">
          {heroStats.map((s) => (
            <div data-animate="rise">
              <dd class="of-spec-figure text-primary">{s.value}</dd>
              <dt class="of-spec-label mt-2">{s.label}</dt>
            </div>
          ))}
        </dl>
        <p class="of-spec-fine mt-8 uppercase tracking-[0.14em]">
          Measured on the development build · <a href="/flow/" class="of-text-action of-compact underline underline-offset-2">See all the numbers and dates</a>
        </p>
      </div>
    </section>

    <!-- ================= THE BROKEN LOOP ================= -->
    <section class="px-6 py-16 sm:py-24">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="of-eyebrow" data-animate="rise">The problem</p>
          <h2 class="of-display mt-4 text-[clamp(2rem,4vw,3rem)]" data-animate="lead">Chat is where work evaporates.</h2>
          <p class="of-lede mx-auto mt-5 text-center" data-animate="rise">
            You draft in a chat window, paste into your document, and fix the formatting.
            Again. Nobody can tell which parts you wrote and which parts the AI did. And the
            thread that produced the work is gone in a month.
          </p>
        </div>
        <div class="mt-12 grid gap-4 md:grid-cols-3" data-animate-stagger="slow">
          <article class="of-surface rounded-2xl border border-border/70 p-6" data-animate="rise">
            <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-accent-ink">No more pasting</p>
            <h3 class="mt-3 text-lg font-bold leading-snug">The work happens in the file.</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">Nothing to copy out of a chat, nothing to reformat, and you always see exactly what changed.</p>
          </article>
          <article class="of-surface rounded-2xl border border-border/70 p-6">
            <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-accent-ink">Attribution survives</p>
            <h3 class="mt-3 text-lg font-bold leading-snug">Which parts you wrote. Which parts AI proposed.</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">Who approved each change, recorded with the document. When someone opens the file and asks, you have the answer.</p>
          </article>
          <article class="of-surface rounded-2xl border border-border/70 p-6">
            <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-accent-ink">A file, not a session</p>
            <h3 class="mt-3 text-lg font-bold leading-snug">Chat workspaces expire. Files are forever.</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">Your work is plain Markdown on your own disk, readable by every other tool you own. No export step, no lock-in.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ================= THE WEDGE ================= -->
    <section class="border-y border-border/70 bg-surface-raised/40 px-6 py-16 sm:py-24">
      <div class="mx-auto max-w-4xl text-center">
        <p class="of-eyebrow" data-animate="rise">Why Flow exists</p>
        <h2 class="of-display mt-4 text-[clamp(2rem,4vw,3rem)]" data-animate="lead">A silent rewrite is not a feature. It is a risk.</h2>
        <p class="of-lede mx-auto mt-6 max-w-2xl text-center" data-animate="rise">
          We measured the Mac's own built-in Writing Tools rewriting text inside a code block.
          Silently. No diff, no approval, no record. So Flow retired that whole shape and replaced
          it with one trust path: the exact change, the evidence for it, the checks that ran, and
          your approval. Recorded. That is what "AI agency built in" means here.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3" data-animate="rise">
          <a href="/flow/" class="of-primary-action">Take the product tour</a>
          <a href="/flow/#press" class="of-secondary-action">Writing about Flow? Get the facts</a>
        </div>
      </div>
    </section>

    <!-- ================= CAPABILITY ROWS ================= -->
    {/* Round 2: these were stacked two-column bands where the crop sat inside a
        narrow 1.14fr media column. Promoted to the hero treatment — contained
        copy above, the shot running wide beneath it, and the zoom crop
        staggered over the shot. Each band takes a different corner and a
        different copy alignment (see `stage`/`align` in capabilityRows) because
        the operator asked for variety; do not normalise these back to one. */}
    {capabilityRows.map((row) => (
      <section class="border-b border-border/60 px-6 py-16 sm:py-24">
        <div class:list={['mx-auto max-w-3xl', row.align === 'center' ? 'text-center' : row.align === 'right' ? 'lg:ml-auto lg:mr-0' : '']}>
          <p class="of-eyebrow" data-animate="rise">{row.kicker}</p>
          <h2 class="of-display mt-4 text-[clamp(1.85rem,3.4vw,2.75rem)]" data-animate="lead">{row.title}</h2>
          <p class:list={['of-lede mt-5', row.align === 'center' && 'mx-auto text-center']} data-animate="rise">{row.body}</p>
          <a href={row.href} class="of-text-action mt-7 inline-flex items-center gap-2" data-animate="rise">
            See it in the tour <span aria-hidden="true">→</span>
          </a>
        </div>
        {/* The window sets the scene; the crop over it carries the proof. Both
            come from the same capture, so the reader can place the detail. */}
        <div
          class:list={['of-stage mt-12', row.stage.startsWith('t') ? 'of-stage--pad-top' : 'of-stage--pad-bottom']}
          data-animate="plate"
        >
          <FlowShot src={row.shot} alt={row.alt} crop sizes="(min-width: 1280px) 78rem, (min-width: 1024px) 64rem, 100vw" />
          <FlowDetail
            class={`of-stage__detail of-stage__detail--${row.stage}`}
            src={row.detail}
            alt={row.detailAlt}
            caption={row.detailCaption}
            sizes="(min-width: 1280px) 30rem, (min-width: 1024px) 27rem, calc(100vw - 4rem)"
            animate
          />
        </div>
      </section>
    ))}

    <!-- ================= ENTERPRISE TEASER ================= -->
    <section class="bg-surface-raised/40 px-6 py-16 sm:py-24">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="of-eyebrow" data-animate="rise">For enterprise AI owners</p>
          <h2 class="of-display mt-4 text-[clamp(2rem,4vw,3rem)]" data-animate="lead">Governance at the source of knowledge work.</h2>
          <p class="of-lede mx-auto mt-5 text-center" data-animate="rise">
            The hard part of enterprise AI is not reaching 70 percent accuracy. It is knowing which
            30 percent is wrong, who approved what, and what it cost.
          </p>
        </div>
        <div class="mt-12 grid gap-4 md:grid-cols-3" data-animate-stagger="slow">
          {enterpriseTeaser.map((card) => (
            <article class="of-surface rounded-2xl border border-border/70 p-6" data-animate="rise">
              <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-accent-ink">{card.k}</p>
              <h3 class="mt-3 text-lg font-bold leading-snug">{card.q}</h3>
              <p class="mt-3 text-sm leading-relaxed text-text-muted">{card.a}</p>
            </article>
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href="/flow/#enterprise" class="of-secondary-action">See all nine enterprise patterns <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- ================= ONE STACK ================= -->
    <section class="border-t border-border/70 px-6 py-16 sm:py-24">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="of-eyebrow" data-animate="rise">One company, one stack</p>
          <h2 class="of-display mt-4 text-[clamp(2rem,4vw,3rem)]" data-animate="lead">Flow is where the Orionfold work comes together.</h2>
        </div>
        <div class="mt-12 grid gap-4 lg:grid-cols-3" data-animate-stagger="slow">
          <article class="of-surface rounded-2xl border border-border/70 p-7" data-animate="rise">
            <h3 class="text-xl font-bold">Open models</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">
              We publish open domain models in the same format Flow's bundled engine runs. The
              models we ship and the app we ship are converging on one runtime you own.
            </p>
            <a href="/experts/" class="of-text-action mt-5 inline-flex items-center gap-2">See the models <span aria-hidden="true">→</span></a>
          </article>
          <article class="of-surface rounded-2xl border border-border/70 p-7" data-animate="rise">
            <h3 class="text-xl font-bold">The books</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">
              Flow productizes the operating method from our books: routed work, receipts, and
              human judgment, worked out in public by a one-person AI-native business.
            </p>
            <a href="/learn/" class="of-text-action mt-5 inline-flex items-center gap-2">Read the books <span aria-hidden="true">→</span></a>
          </article>
          <article class="of-surface rounded-2xl border border-border/70 p-7" data-animate="rise">
            <h3 class="text-xl font-bold">Relay and Arena</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">
              Relay runs AI client work with per-client cost receipts. Arena scores local models
              with reruns you can verify. Different products, one refusal: no invisible AI work.
            </p>
            <a href="/relay/" class="of-text-action mt-5 inline-flex items-center gap-2">Meet the family <span aria-hidden="true">→</span></a>
          </article>
        </div>
      </div>
    </section>

    <!-- ================= THE ORIGIN STORY ================= -->
    <section class="origin-story border-t border-border/70 bg-surface-raised/40 px-6 py-16 sm:py-24" aria-labelledby="origin-heading">
      <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
        <a
          href="/story/limitless-without-the-pill/"
          class="origin-story__card"
          aria-label="Read the origin story: Limitless, Without the Pill"
        >
          <span class="origin-story__plane of-surface">
            <Image
              src={originArt}
              alt="A knowledge worker at a laptop conducts a luminous constellation of research, code, strategy, art, and scientific ideas across a deep blue night sky."
              widths={[640, 960, 1280, 1672]}
              sizes="(min-width: 1024px) 38rem, calc(100vw - 3rem)"
              loading="lazy"
              decoding="async"
              quality={90}
              data-no-zoom
              class="origin-story__image"
            />
          </span>
        </a>
        <div>
          <p class="home-kicker">The origin story</p>
          <h2 id="origin-heading" class="mt-4 text-balance text-4xl font-bold sm:text-5xl">Limitless, without the pill.</h2>
          <p class="mt-5 leading-relaxed text-text-muted">
            The movie sold a fantasy: one pill, and every dormant capability wakes up.
            Building Orionfold as one AI-native person has felt like the closest real-world
            version of that. No pill needed.
          </p>
