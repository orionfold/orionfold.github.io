---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ogMeta } from '../data/og';
import { SITE, PERSON } from '../data/seo';
import '../styles/living-base.css';
import '../styles/living-home.css';
import HomeHero from '../components/living/HomeHero.astro';
import CompareSection from '../components/flow/paths/CompareSection.astro';
import FlagshipEssayInvitation from '../components/living/FlagshipEssayInvitation.astro';
import HomeClosing from '../components/living/HomeClosing.astro';
import FlowElementsShowcase from '../components/flow/FlowElementsShowcase.astro';
import WowStat from '../components/flow/WowStat.astro';
import FlowDomainsBand from '../components/flow/FlowDomainsBand.astro';
import ConfirmBanner from '../components/ui/ConfirmBanner.astro';
const title = "Orionfold Flow \u00b7 Turn what you know into a Domain.";
const description = "Flow for Mac helps consultants and experts turn their method into a Domain. Write it with your AI, publish it to GitHub, and each client gets your updates to review.";
const og = ogMeta('/');
const pageSchema = {'@context':'https://schema.org','@type':'SoftwareApplication',name:'Orionfold Flow',applicationCategory:'ProductivityApplication',operatingSystem:'macOS',description,url:`${SITE.url}/flow/`,image:`${SITE.url}${og.image}`,author:PERSON,brand:{'@type':'Brand',name:'Orionfold'}};
---
<Layout title={title} description={description} ogImage={og.image} ogImageAlt={og.alt} bodyClass="ls ls-page-home" jsonLd={pageSchema}>
  <Nav />
  <ConfirmBanner />
  <main id="main" class="ls-main">
    <HomeHero />
    <FlowElementsShowcase id="home-elements" />
    <FlowDomainsBand id="home-domains" />
    <WowStat ids={['brief43', 'agent']} />
    <CompareSection />
    <FlagshipEssayInvitation />
    <WowStat ids={['watch']} tone="ink" />
    <HomeClosing />
  </main>
  <Footer showDownload={false} />
</Layout>
<script>
  import "../scripts/living-documents.js";
</script>
