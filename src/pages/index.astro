---
// Flow launch homepage. The hero, title, social card, and product schema carry
// one promise; the four acts below prove it without duplicating the full tour.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ConfirmBanner from '../components/ui/ConfirmBanner.astro';
import FlowIdeasPitStop from '../components/flow/FlowIdeasPitStop.astro';
import FlowLaunchHomeHero from '../components/flow/FlowLaunchHomeHero.astro';
import HomeRaceCapabilityAct from '../components/flow/HomeRaceCapabilityAct.astro';
import FlowWaitlist from '../components/sections/FlowWaitlist.astro';
import { ogMeta } from '../data/og';
import { SITE, PERSON } from '../data/seo';

import shotApprove from '../assets/flow/shots/flow-writing-you-approve-shot.webp';
import shotCharts from '../assets/flow/shots/flow-charts-shot.webp';
import shotDomains from '../assets/flow/shots/flow-domains-shot.webp';
import shotRunCard from '../assets/flow/shots/flow-run-card-shot.webp';
import detailDiff from '../assets/flow/details/detail-diff.webp';
import detailChartLine from '../assets/flow/details/detail-chart-line.webp';
import detailDomains from '../assets/flow/details/detail-domains.webp';
import detailRunChecks from '../assets/flow/details/detail-run-checks.webp';

const og = ogMeta('/');
const HOME_TITLE = 'Orionfold Flow for Mac · You drive the work. Flow tunes AI to your needs.';
const HOME_DESCRIPTION = 'Orionfold Flow brings the right AI to documents you own, proposes exact changes, and waits for your approval. Every run leaves an inspectable receipt.';

const flowSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Orionfold Flow',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'macOS',
  description: HOME_DESCRIPTION,
  url: `${SITE.url}/flow/`,
  image: `${SITE.url}${og.image}`,
  author: PERSON,
  brand: { '@type': 'Brand', name: 'Orionfold' },
};

// Four claims, four current product captures. Exact qualifications remain in
// the linked tour; the homepage gives each claim only the proof needed to earn
// the next scroll.
const capabilityRows = [
  {
    kicker: 'Approval',
    title: 'See exactly what Flow wants to change.',
    body: 'Every AI action arrives as a proposal. Read the exact diff and the checks beside it. Approve it, reject it, or leave it for later. Nothing is saved until you approve it.',
    href: '/flow/writing-with-ai/#tour-agency',
    shot: shotApprove,
    alt: 'Orionfold Flow reviewing a proposed edit beside the document, with the exact change, named checks, and human approval controls visible.',
    detail: detailDiff,
    detailAlt: 'Flow\'s decision footer with the review checkbox, one check to resolve, and Approve and Save disabled until the reviewer confirms the change.',
    detailCaption: 'Review the diff · Approve and Save stays disabled until you confirm it',
    stage: 'tl',
  },
  {
    kicker: 'Documents',
    title: 'Turn plain text into a chart you can hand over.',
    body: 'Flow draws 34 chart types and 20 diagram types from plain text in your file. They render offline in one house style, and the document stays readable in every editor you own.',
    href: '/flow/documents-and-files/#tour-visualize',
    shot: shotCharts,
    alt: 'Orionfold Flow showing a quarterly review with a line chart and flowchart drawn inside the document, beside the chart editor for the same file.',
    detail: detailChartLine,
    detailAlt: 'A line chart drawn by Flow with a claim-led title, one highlighted series, dated axes, and a source line.',
    detailCaption: 'Drawn from the file · A clear claim, one highlight, and a source',
    stage: 'br',
  },
  {
    kicker: 'Routing',
    title: 'Choose where the work may run.',
    body: 'Local, LAN, prepaid cloud, or postpaid cloud. Each domain says whether your text leaves your Mac and what the work costs. A fallback outside your boundary stops and asks first.',
    href: '/flow/models-and-runtime/#tour-domains',
    shot: shotDomains,
    alt: 'Flow Models settings showing four execution domains with locality, cost, and provider controls.',
    detail: detailDomains,
    detailAlt: 'Flow\'s Local domain enabled with the statement that work stays on this Mac and runs free on hardware you own.',
    detailCaption: 'One switch per domain · Discovery never enables a route',
    stage: 'tl',
  },
  {
    kicker: 'Receipts',
    title: 'Every run leaves a record.',
    body: 'The receipt binds the model, route, cost, checks, evidence, proposal, and your decision to the exact document revision. You can see what happened without reconstructing a chat.',
    href: '/flow/receipts/#tour-receipts',
    shot: shotRunCard,
    alt: 'Orionfold Flow Receipts showing a demonstration run with named checks, evidence, recorded cost, and before and after document digests.',
    detail: detailRunChecks,
    detailAlt: 'Three named checks in a Flow receipt, each with its stored result and the rule it applied.',
    detailCaption: 'Named checks · Stored with the run and the document revision',
    stage: 'br',
  },
];

const capabilityActs = [
  {
    number: '01',
    label: 'Control',
    title: 'Nothing changes until you say so.',
    body: 'Flow can move quickly without taking the decision away from you. The proposal, checks, and approval stay together.',
    rows: capabilityRows.slice(0, 1),
  },
  {
    number: '02',
    label: 'Craft',
    title: 'The file becomes the finished work.',
    body: 'Write in portable Markdown. Add charts and diagrams where the argument needs them. Keep the result on your own disk.',
    rows: capabilityRows.slice(1, 2),
  },
  {
    number: '03',
    label: 'Routing',
    title: 'Use the right AI. Keep the boundary.',
    body: 'Flow can use models on your Mac, your network, or supported cloud providers. You decide which routes are available.',
    rows: capabilityRows.slice(2, 3),
  },
  {
    id: 'home-race-control',
    number: '04',
    label: 'Governance',
    title: 'Keep the record with the work.',
    body: 'A durable receipt preserves the facts of every run, so review starts with evidence instead of memory.',
    rows: capabilityRows.slice(3, 4),
  },
];
---
<Layout
  title={HOME_TITLE}
  description={HOME_DESCRIPTION}
  ogImage={og.image}
  ogImageAlt={og.alt}
  jsonLd={[flowSchema]}
>
  <Nav />
  <ConfirmBanner />
  <main class="home-race-theme overflow-x-clip">
    <FlowLaunchHomeHero />

    <section class="home-race-problem border-y px-6 py-16 sm:py-24" aria-labelledby="home-problem-title">
      <div class="mx-auto max-w-4xl text-center">
        <p class="of-eyebrow" data-animate="rise">Why Flow</p>
        <h2 id="home-problem-title" class="of-display mt-4 text-[clamp(2rem,4vw,3.4rem)]" data-animate="lead">
          Chat makes work disposable. Flow keeps it in the document.
        </h2>
        <p class="of-lede mx-auto mt-5 max-w-3xl text-center" data-animate="rise">
          Your words, AI proposals, approvals, and receipts stay with the file. No copy and paste. No lost thread. No mystery about what changed.
        </p>
      </div>
    </section>

    <FlowIdeasPitStop id="home-flow-ideas-pit-stop" variant="home" />

    {capabilityActs.map((act) => (
      <HomeRaceCapabilityAct
        id={act.id}
        number={act.number}
        label={act.label}
        title={act.title}
        body={act.body}
        rows={act.rows}
      />
    ))}

    <div id="waitlist" class="home-race-waitlist scroll-mt-24">
      <FlowWaitlist placement="home" />
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .home-race-problem {
    border-color: rgba(15, 118, 116, 0.16);
    color: #173138;
    background: #f4f7f5;
  }
  .home-race-problem h2 { color: #10272e; }
  .home-race-problem .of-lede { color: rgba(29, 57, 63, 0.7); }
  .home-race-waitlist :global(.flow-waitlist--home) {
    border-color: rgba(15, 118, 116, 0.16);
    color: #173138;
    background: #edf4f1;
  }
  .home-race-waitlist :global(.flow-waitlist__panel) {
    border-color: rgba(15, 118, 116, 0.2);
    color: #10272e;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 2rem 6rem rgba(35, 76, 79, 0.13);
  }
  .home-race-waitlist :global(.flow-waitlist__panel h2) { color: #10272e; }
  .home-race-waitlist :global(.flow-waitlist__panel p) { color: rgba(29, 57, 63, 0.7); }
</style>
