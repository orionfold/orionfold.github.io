---
// Homepage. Rebuilt 2026-08-14 as a full Flow flagship takeover, then rewritten
// on 2026-08-20 against the content-masterclass review
// (audit-reports/content-masterclass-review-2026-08-20.md). The rules that
// shaped this page:
//   * the hero says ONE thing three ways (headline, lede, picture) and that
//     thing is the approval promise, which is also the title tag's promise;
//   * the common belief is named before it is flipped (direct contrast);
//   * the reader knows who the page is for in the first screen;
//   * two usable, dated facts arrive before the second scroll, and the first
//     email ask is the answer to the worry those facts raise;
//   * six capability bands, each with the crop of the control it names; the
//     rest of the tour lives on /flow/ and its category pages.
// The /flow/ page carries the stat band, the tour, the press kit, and the FAQ;
// this page is the demand-generation front door.
//
// 2026-08-21, VISION alignment pass. An audit against ~/orionfold-flow/VISION.md
// found the page true to ONE of the abstract's three claims (agency with your
// approval) and near-silent on the other two. The vision's own words: "Conduct
// beautiful documents with AI agency built in", where "beautiful" is called a
// commitment and "the one easiest to let slide", and self-improving is
// "promised in the abstract rather than deferred to a roadmap". The page showed
// the app's CHROME (toolbars, diffs, settings) and never the ARTIFACT, and all
// four band titles were shaped "AI will not hurt you". Three changes:
//   * the hero keeps its two safety sentences and gains one line naming what
//     the reader GETS (the vision's first word is "conduct", not "approve");
//   * an output band, because ICP latent need 7 is "turn thinking into a
//     professional artifact" and nothing on the site answered it;
//   * a compounding band, stating the SHIPPED half of self-improving: rules
//     plus measured-on-this-Mac benchmarks mean the document uses a better
//     model as your models improve. Nothing claims a document that rewrites
//     itself; that capability (0062 freshness monitor) is unbuilt.
// The truth rails for both new bands are guarded by name in
// scripts/test/flow-flagship-surface.test.mjs.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ConfirmBanner from '../components/ui/ConfirmBanner.astro';
import FlowShot from '../components/flow/FlowShot.astro';
import FlowDetail from '../components/flow/FlowDetail.astro';
import FlowProofNuggets from '../components/flow/FlowProofNuggets.astro';
import WaitlistForm from '../components/ui/WaitlistForm.astro';
import FlowWaitlist from '../components/sections/FlowWaitlist.astro';
import { Image } from 'astro:assets';
import { ogMeta } from '../data/og';
import { SITE, PERSON } from '../data/seo';
import { FLOW_CONSENT_TEXT } from '../data/flow-consent';
import { FLOW_ENTERPRISE_TEASER } from '../data/flow-enterprise';

import appIcon from '../assets/flow/flow-app-icon-512.png';
import originArt from '../assets/story/limitless-without-the-pill/hero.png';
import shotApprove from '../assets/flow/shots/flow-writing-you-approve-shot.webp';
import shotLongDocs from '../assets/flow/shots/flow-long-documents-shot.webp';
import shotDomains from '../assets/flow/shots/flow-domains-shot.webp';
import shotToolbar from '../assets/flow/shots/flow-editor-toolbar-shot.webp';
import shotRunCard from '../assets/flow/shots/flow-run-card-shot.webp';
import shotCharts from '../assets/flow/shots/flow-charts-shot.webp';
import shotRouting from '../assets/flow/shots/flow-smart-routing-shot.webp';
// Purpose-cut feature details (scripts/prepare-flow-details.mjs). A full window
// shrunk into a page column renders the control being described at ~8px; these
// crops show that one control at a size where the claim is checkable.
import detailDiff from '../assets/flow/details/detail-diff.webp';
import detailToolbarPreview from '../assets/flow/details/detail-toolbar-preview.webp';
import detailDomains from '../assets/flow/details/detail-domains.webp';
import detailParts from '../assets/flow/details/detail-parts.webp';
import detailRunChecks from '../assets/flow/details/detail-run-checks.webp';
import detailChartLine from '../assets/flow/details/detail-chart-line.webp';
import detailRoutingRules from '../assets/flow/details/detail-routing-rules.webp';

const og = ogMeta('/');

// The title tag, the OG card title (src/data/og.ts), and the H1 below are one
// promise in three lengths. A reader who clicks the title must see it confirmed
// in the first five seconds, so none of the three may drift from the others.
const HOME_TITLE = 'Orionfold Flow · AI that asks before it changes your document';

// The homepage is the Flow front door, so it carries the same product entity
// as /flow/ (canonical product URL stays /flow/). Helps answer engines tie
// "Orionfold" and "Flow" to one SoftwareApplication.
const flowSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Orionfold Flow',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'macOS',
  description:
    'Orionfold Flow is a native Mac app for professional documents with AI agency built in. Every AI change is a diff you approve, with a receipt recording what ran, where it ran, and what it cost. Patent pending.',
  url: `${SITE.url}/flow/`,
  image: `${SITE.url}${og.image}`,
  author: PERSON,
  brand: { '@type': 'Brand', name: 'Orionfold' },
};

// Consent copy is shared (src/data/flow-consent.ts) so a subscriber's recorded
// consent reads the same no matter which surface captured them.
const consentText = FLOW_CONSENT_TEXT;

// The fourth figure was "5 actions, every one needs your approval" until
// 2026-08-21. It restated the hero headline a fourth time, while the pace of
// the build, which is the reason a waitlist is worth joining, was nowhere on
// the page. The count is the Flow CHANGELOG's own entries, and that file's
// first line reads "User-visible behavior only", so the claim is checkable
// rather than a commit tally dressed up as progress.
//
// THIS NUMBER DRIFTS. It is a hand-count of top-level CHANGELOG entries in the
// span 2026-07-28 (the file's first commit) to the stated end date, re-verified
// 2026-08-21 at 140 (was 138 on 2026-08-20). The Flow repo is not a build
// dependency here, so nothing recomputes it. Re-count and move BOTH this tile
// and the /flow/ stat band together, or widen the window and restate the days.
const heroStats = [
  { value: '22.3 ms', label: 'search across 10,000 notes' },
  { value: '$0.00425', label: 'a billed run, recorded to the digit' },
  { value: '+19.2 MiB', label: 'a complete local AI runtime' },
  { value: '140 changes', label: 'shipped in the last 24 days' },
];

// One capability per band, and one picture that PROVES it.
//
// Each row carries two images doing different jobs: `shot` is the whole window
// (context: this is a real Mac app), and `detail` is a purpose-cut crop of the
// exact control the headline names (proof: here is the thing, legibly).
//
// Copy shape: the common belief first, then the flip, then one tight paragraph.
// The long qualifier lists live on the tour pages, which are built to carry
// them.
//
// `stage` and `align` drive the variety rule. The hero above spends
// top-right + centred copy, so the bands walk away from it and from each
// other. Sequence down the page: hero tr, then tl, br, bl, tr, tl, br. No two
// ADJACENT stages share a corner; tests/e2e/product-stage.spec.ts enforces it.
// Adding a band in the middle re-pins every corner BELOW it, which is why
// domains and receipts moved on 2026-08-21.
//
// Band order is an argument, not a list: cost, then scale, then what you get
// out (output), then where it runs, then the record, then why it keeps paying
// off. The two capability bands sit among the safety ones deliberately rather
// than in a block, so the page never reads as four warnings then a brochure.
const capabilityRows = [
  {
    kicker: 'Priced before you click',
    title: 'Most tools bill you after. Flow tells you the cost first.',
    body: 'The six AI actions live in the document\'s own tool strip, beside bold and italic. Hover one and Flow answers before it runs: how much text it would act on, what it would cost, and which model would do the work. Work on your own Mac is free, and Flow says so in words rather than a number.',
    href: '/flow/writing-with-ai/#tour-toolbar',
    shot: shotToolbar,
    alt: 'Orionfold Flow with the document tool strip expanded: writing controls, a divider, and five colored AI marks, with Proofread\'s panel stating the scope, the cost, and the model for the run.',
    detail: detailToolbarPreview,
    detailAlt: 'Flow\'s tool strip with Proofread\'s panel open: 3,911 words for the whole document, "No cost, free, it runs on hardware you have", and the model that would run it staying on this Mac.',
    detailCaption: 'Scope, cost, and route · Answered before the click',
    stage: 'tl',
    align: 'left',
  },
  {
    kicker: 'Long documents',
    title: 'Most tools cut a long document and guess. Flow reviews it in parts.',
    body: 'A 50-page document is not too big. It is four reviews. Flow plans it into ordered parts that follow its own structure, then reviews each part on its own. Never truncated, never guessed. Coverage comes back in counts you can check.',
    href: '/flow/writing-with-ai/#tour-longdocs',
    shot: shotLongDocs,
    alt: 'A live two-part review on a 3,905-word document in Flow, with part chips and an honest coverage line.',
    detail: detailParts,
    detailAlt: 'Flow’s review header on a long document: numbered part chips, and the line "0 approved, 0 declined, 2 remaining".',
    detailCaption: 'Coverage in plain counts · Approve, decline, or skip any part',
    stage: 'br',
    align: 'right',
  },
  {
    // THE OUTPUT BAND. Added 2026-08-21 to close the gap the vision names as
    // the easiest to let slide: "beautiful" is a commitment, and the site
    // showed only the app's chrome, never the artifact it produces. The claim
    // here is about the DOCUMENT, not the control.
    // TRUTH RAIL (flow-charts brief + 0129 SPEC): Visualize ADDS one chart or
    // diagram fence AFTER the selection, never replaces it. Rendering is
    // offline from the fence text. Never "AI-generated infographics".
    // Designed layout blocks (callouts, columns, cards) are a later goal and
    // must not be claimed. Every number in the capture is invented demo data.
    kicker: 'Documents worth handing over',
    title: 'Most AI gives you text to reformat. Flow gives you a document to send.',
    body: 'Ask for a waterfall, a bump chart, or a calendar heatmap by name. Thirty four chart types, and twenty diagram types beside them, drawn in place from plain text in your file, offline, in one house style: a title that makes the claim, one highlighted series, a source line. The few other editors that draw charts at all hand you a chart grammar to write yourself. Select a table or a paragraph and Flow proposes the picture, reviewed like any other change, and the file stays readable in every editor you own.',
    href: '/flow/documents-and-files/#tour-visualize',
    shot: shotCharts,
    alt: 'Orionfold Flow with a quarterly business review open in Reader on the left, its line chart and deal-flow flowchart drawn in place from the file\'s own text, and the chart gallery editor open on the right on the same file\'s bar chart.',
    detail: detailChartLine,
    detailAlt: 'A line chart drawn by Flow inside a document: the title "Team plan drove MRR growth through the summer", a plan legend with Team highlighted in the accent colour, dated axes, and the source line "Billing system, month-end snapshots".',
    detailCaption: 'Drawn from the text in your file · A title that makes the claim, one highlighted series, a source line',
    stage: 'bl',
    align: 'left',
  },
  {
    kicker: 'Trust boundaries',
    title: 'Most tools decide where your text goes. You pick where AI runs. Flow keeps it there.',
    body: 'Four execution domains, each with its own switch: Local, LAN, Cloud prepaid, Cloud postpaid. Every one states plainly whether your text stays on this Mac and what the work costs. A fallback that would leave your Mac stops and asks first.',
    href: '/flow/models-and-runtime/#tour-domains',
    shot: shotDomains,
    alt: 'Flow’s Models settings showing four execution domains with locality and cost statements and a user-owned provider order.',
    detail: detailDomains,
    detailAlt: 'The Local execution domain in Flow: its switch turned on, the line "Stays on this Mac, free, it runs on hardware you have", and three discovered providers.',
    detailCaption: 'One switch per domain · Discovery never enables anything',
    // Was 'bl' until 2026-08-21, when the output band above took that corner.
    // Adjacent bands may never repeat one (tests/e2e/product-stage.spec.ts).
    stage: 'tr',
    align: 'center',
  },
  {
    // TRUTH RAIL: the receipts in this capture are STAGED DEMONSTRATION
    // material written over the demo library through the same code path a real
    // run uses (the alt says "demonstration" for exactly this reason). The
    // staged $0.00318 figure must never appear in homepage copy as a real
    // charge; the real recorded run is the $0.00425 one in the hero stats.
    // The crop is deliberately the CHECKS block, which carries no dollar
    // figure, so this band makes no cost claim its picture cannot support.
    kicker: 'Receipts',
    title: 'Most AI work leaves no trace. Every Flow run leaves a receipt you can read.',
    body: 'One run reads as one card: the named checks that ran, what the evidence concluded, the cost with its basis, and the exact before and after content the change is bound to. The recorded cost is an observed fact, never an estimate, and a local run records no charge because none was owed.',
    href: '/flow/receipts/#tour-receipts',
    shot: shotRunCard,
    alt: 'Orionfold Flow\'s Receipts timeline beside a demonstration client proposal: a run selected, its card showing three named checks with severity pills, Evidence at 89 of 100, the recorded cost with its basis, and before and after digests.',
    detail: detailRunChecks,
    detailAlt: 'Three named checks in a Flow run receipt: Human review with the pill Needs your acknowledgment, References are current with Warns you, and Citations resolve with Stops the change, each row also carrying a stored Checked mark.',
    detailCaption: 'Named checks, two facts each · What it saw then, what the rule does now',
    // Was 'tr' until 2026-08-21; the domains band above now holds that corner.
    stage: 'tl',
    align: 'left',
  },
  {
    // THE COMPOUNDING BAND. Added 2026-08-21. The vision promises
    // "self-improving intelligence" and the site never said it. This band
    // states the honest, shipped half of it: your rules outlive any one model,
    // and the routing reads measurements taken on YOUR Mac, so the same
    // document gets a better model as your models get better.
    // TRUTH RAILS (flow-smart-routing brief, non-negotiable):
    //   * Vocabulary is the screen's: "rules", "rules decide in order; the
    //     first one that matches applies", "Deciding". NEVER predicates,
    //     resolvers, gates, or fail-closed. The feature is Smart Routing;
    //     "Auto routing" was retired 2026-08-18.
    //   * "Fastest measured on this Mac" orders by SPEED measured on this
    //     machine only. It is NEVER a quality verdict, and a model with no
    //     measurement is not ranked at all.
    //   * Rules do not learn. "Your rules, re-applied" is the claim; never
    //     "learns your preferences". The refusal to adapt is the selling point.
    kicker: 'It gets better without you',
    title: 'Most tools age around a model. Flow gets better as the models do.',
    body: 'No AI improves itself yet, and Flow does not claim to. The system around it does. Flow benchmarks the models on your own Mac, and Smart Routing reads those measurements: rules decide in order, and the first one that matches applies. Write "Fastest measured on this Mac" once. Pull a better model next month and the same document starts using it, with no setting to revisit and no rule to rewrite. The screen always names the rule that decided.',
    href: '/flow/models-and-runtime/#tour-routing',
    shot: shotRouting,
    alt: 'Flow\'s Smart Routing settings: an ordered rulebook with the sentence "Rules decide in order; the first one that matches applies", four named rules with live model counts, a Deciding badge on the first, and the provider routing order beneath.',
    detail: detailRoutingRules,
    detailAlt: 'Flow\'s rulebook: the sentence "Rules decide in order; the first one that matches applies", four ordered rules with the count of models that qualify for each, a Deciding badge on rule one, and an orange no-model state on rule four.',
    detailCaption: 'Rules decide in order · The first one that matches applies',
    stage: 'br',
    align: 'right',
  },
];
---
<Layout
  title={HOME_TITLE}
  description={SITE.description}
  ogImage={og.image}
  ogImageAlt={og.alt}
  jsonLd={[flowSchema]}
>
  <Nav />
  <!-- Surfaces the ?confirmed= state the confirm-email funnel redirects here with -->
  <ConfirmBanner />
  <main class="overflow-x-clip">
    <!-- ================= HERO ================= -->
    <section class="home-hero relative px-6 pb-16 pt-32 sm:pt-36">
      <div class="home-hero__grid" aria-hidden="true"></div>
      <div class="home-hero__glow" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-5xl text-center">
        <div class="flex flex-wrap items-center justify-center gap-2">
          <span class="home-chip">
            <Image src={appIcon} alt="" width={40} height={40} class="h-5 w-5 rounded-[5px]" loading="eager" />
            Orionfold Flow · Native Mac app
          </span>
          <span class="home-chip home-chip--accent">Patent pending</span>
        </div>
        <!-- Context first: who this is for, in plain words, before the claim. -->
        <p class="of-eyebrow mt-7">For founders, comms leads, and independent operators. Anyone whose name is on the document.</p>
        <!-- The common belief, then the flip. Written against the hero picture:
             the review surface with Approve and Save DISABLED until the reader
             ticks the box. Headline, lede, and picture carry one claim. -->
        <h1 class="hero-gradient-text mx-auto mt-4 max-w-4xl font-display text-[clamp(2.3rem,7.6vw,4.4rem)] font-extrabold leading-[1.04] tracking-[-0.05em]">
          Most AI tools rewrite your document. Flow asks first.
        </h1>
        <p class="hero-lede mx-auto mt-6 max-w-2xl text-balance text-xl leading-[1.5] text-text-muted sm:text-2xl">
          <span>Every AI change arrives as a diff you approve, with a receipt of what ran, where it ran, and what it cost.</span>{' '}
          <span>Your text changes two ways only: an edit you typed, or a change you approved.</span>
        </p>
        <!-- The gain, not only the guard. The vision's first word is "conduct",
             and a page that only promises safety sells a smaller product than
             the one being built. This line names what the reader gets; the two
             sentences above name what they keep. -->
        <p class="hero-gain mx-auto mt-5 max-w-2xl text-lg leading-[1.55] text-text sm:text-xl">
          You stop writing every line and start directing the work. Research, tables, charts,
          and diagrams are drawn in the file you already own.
        </p>
        <div class="mx-auto mt-9 max-w-md">
          <WaitlistForm
            id="home-hero-waitlist"
            source="home-hero-waitlist"
            offer="flow-waitlist"
            buttonText="Join the waitlist"
            successMessage="Check your inbox to confirm."
            consentText={consentText}
          />
          <p class="of-waitlist-caption mt-3 font-mono uppercase text-text-dim">
            Free to join · Double opt-in · One email a week, no more
          </p>
        </div>
      </div>
      <!-- The hero picture proves the headline: the whole review window for
           context, and the decision footer lifted out at a legible size, with
           Approve and Save disabled until the box is ticked. TOP-right, not a
           bottom corner: the footer crop is a short wide strip, and at a bottom
           corner it renders shorter than the stage overhang and never overlaps
           the shot (product-stage.spec.ts catches exactly that). The first band
           below takes top-left. -->
      <div class="of-stage of-stage--pad-top mx-auto mt-14 w-full max-w-6xl" data-animate="plate">
        <FlowShot
          src={shotApprove}
          alt="Orionfold Flow reviewing an AI proofread: the proposed document with the change highlighted, one fact row, three check pills, and the human-review gate beside a disabled Approve and Save button."
          crop
          sizes="(min-width: 1280px) 72rem, (min-width: 1024px) 64rem, 100vw"
          priority
        />
        <FlowDetail
          class="of-stage__detail of-stage__detail--tr"
          src={detailDiff}
          alt="Flow's decision footer: an unticked 'I have reviewed this change' checkbox, '1 Check to resolve', and a disabled Approve and Save button beside Reject and Later."
          caption="Approve and Save stays disabled until you tick the box · Nothing is saved until you approve it"
          sizes="(min-width: 1280px) 30rem, (min-width: 1024px) 27rem, calc(100vw - 4rem)"
          animate
        />
      </div>
      <div class="mx-auto mt-10 w-full max-w-6xl sm:mt-14">
        <dl class="grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4" data-animate-stagger="slow">
          {heroStats.map((s) => (
            <div data-animate="rise">
              <dd class="of-spec-figure text-primary">{s.value}</dd>
              <dt class="of-spec-label mt-2">{s.label}</dt>
            </div>
          ))}
        </dl>
        <p class="of-spec-fine mt-8 uppercase tracking-[0.14em]">
          Measured on the running build · <a href="/flow/" class="of-text-action of-compact underline underline-offset-2">See all the numbers and dates</a>
        </p>
      </div>
    </section>

    <!-- ================= TWO THINGS WE MEASURED + the native ask ================= -->
    <FlowProofNuggets formId="home-proof-waitlist" />

    <!-- ================= THE BROKEN LOOP ================= -->
    <section class="border-y border-border/70 bg-surface-raised/40 px-6 py-16 sm:py-24">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="of-eyebrow" data-animate="rise">The problem</p>
          <h2 class="of-display mt-4 text-[clamp(2rem,4vw,3rem)]" data-animate="lead">Chat is where work evaporates.</h2>
          <p class="of-lede mx-auto mt-5 text-center" data-animate="rise">
            You draft in a chat window, paste into your document, and fix the formatting.
            Again. Nobody can tell which parts you wrote and which parts the AI did. And the
            thread that produced the work is gone in a month.
          </p>
        </div>
        <div class="mt-12 grid gap-4 md:grid-cols-3" data-animate-stagger="slow">
          <article class="of-surface rounded-2xl border border-border/70 p-6" data-animate="rise">
            <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-accent-ink">No more pasting</p>
            <h3 class="mt-3 text-lg font-bold leading-snug">The work happens in the file.</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">Nothing to copy out of a chat, nothing to reformat, and you always see exactly what changed.</p>
          </article>
          <article class="of-surface rounded-2xl border border-border/70 p-6">
            <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-accent-ink">Attribution survives</p>
            <h3 class="mt-3 text-lg font-bold leading-snug">Which parts you wrote. Which parts AI proposed.</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">Who approved each change, recorded with the document. When someone opens the file and asks, you have the answer.</p>
          </article>
          <article class="of-surface rounded-2xl border border-border/70 p-6">
            <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-accent-ink">A file, not a session</p>
            <h3 class="mt-3 text-lg font-bold leading-snug">Chat workspaces expire. Files are forever.</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">Your work is plain Markdown on your own disk, readable by every other tool you own. No export step, no lock-in.</p>
          </article>
        </div>
        <div class="mt-10 flex flex-wrap justify-center gap-3" data-animate="rise">
          <a href="/flow/" class="of-primary-action">Take the product tour</a>
          <a href="/flow/#press" class="of-secondary-action">Writing about Flow? Get the facts</a>
        </div>
      </div>
    </section>

    <!-- ================= CAPABILITY BANDS ================= -->
    {capabilityRows.map((row) => (
      <section class="border-b border-border/60 px-6 py-16 sm:py-24">
        <div class:list={['mx-auto max-w-3xl', row.align === 'center' ? 'text-center' : row.align === 'right' ? 'lg:ml-auto lg:mr-0' : '']}>
          <p class="of-eyebrow" data-animate="rise">{row.kicker}</p>
          <h2 class="of-display mt-4 text-[clamp(1.85rem,3.4vw,2.75rem)]" data-animate="lead">{row.title}</h2>
          <p class:list={['of-lede mt-5', row.align === 'center' && 'mx-auto text-center']} data-animate="rise">{row.body}</p>
          <a href={row.href} class="of-text-action mt-7 inline-flex items-center gap-2" data-animate="rise">
            See it in the tour <span aria-hidden="true">→</span>
          </a>
        </div>
        <div
          class:list={['of-stage mt-12', row.stage.startsWith('t') ? 'of-stage--pad-top' : 'of-stage--pad-bottom']}
          data-animate="plate"
        >
          <FlowShot src={row.shot} alt={row.alt} crop sizes="(min-width: 1280px) 78rem, (min-width: 1024px) 64rem, 100vw" />
          <FlowDetail
            class={`of-stage__detail of-stage__detail--${row.stage}`}
            src={row.detail}
            alt={row.detailAlt}
            caption={row.detailCaption}
            sizes="(min-width: 1280px) 30rem, (min-width: 1024px) 27rem, calc(100vw - 4rem)"
            animate
          />
        </div>
      </section>
    ))}

    <!-- ================= ENTERPRISE TEASER ================= -->
    <section class="bg-surface-raised/40 px-6 py-16 sm:py-24">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="of-eyebrow" data-animate="rise">For enterprise AI owners</p>
          <h2 class="of-display mt-4 text-[clamp(2rem,4vw,3rem)]" data-animate="lead">Governance at the source of knowledge work.</h2>
          <p class="of-lede mx-auto mt-5 text-center" data-animate="rise">
            The hard part of enterprise AI is not reaching 70 percent accuracy. It is knowing which
            30 percent is wrong, who approved what, and what it cost.
          </p>
        </div>
