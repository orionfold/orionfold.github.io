    <!-- ================= THE ORIGIN STORY ================= -->
    <section class="origin-story border-t border-border/70 px-6 py-16 sm:py-24" aria-labelledby="origin-heading">
      <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
        <a
          href="/story/limitless-without-the-pill/"
          class="origin-story__card"
          aria-label="Read the origin story: Limitless, Without the Pill"
        >
          <span class="origin-story__plane of-surface">
            <Image
              src={originArt}
              alt="A knowledge worker at a laptop conducts a luminous constellation of research, code, strategy, art, and scientific ideas across a deep blue night sky."
              widths={[640, 960, 1280, 1672]}
              sizes="(min-width: 1024px) 38rem, calc(100vw - 3rem)"
              loading="lazy"
              decoding="async"
              quality={90}
              data-no-zoom
              class="origin-story__image"
            />
          </span>
        </a>
        <div>
          <p class="home-kicker">The origin story</p>
          <h2 id="origin-heading" class="mt-4 text-balance text-4xl font-bold sm:text-5xl">Limitless, without the pill.</h2>
          <p class="mt-5 leading-relaxed text-text-muted">
            The movie sold a fantasy: one pill, and every dormant capability wakes up.
            Building Orionfold as one AI-native person has felt like the closest real-world
            version of that. No pill needed.
          </p>
          <p class="mt-4 leading-relaxed text-text-muted">
            That feeling is what Flow is built to give you. Not AI that replaces you. AI you
            conduct: different modes of thinking, context that stays with the work, and
            capabilities that used to live in separate departments, now in one document.
          </p>
          <p class="mt-5 border-l-2 border-primary/50 pl-4 text-lg font-medium leading-relaxed text-text">
            The future may not be artificial superintelligence. It may be ordinary people
            becoming far more capable versions of themselves.
          </p>
          <a href="/story/limitless-without-the-pill/" class="of-text-action mt-6 inline-flex items-center gap-2">
            Read the origin story <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <div id="waitlist" class="scroll-mt-24">
      <FlowWaitlist placement="home" />
    </div>
  </main>
  <Footer />
</Layout>

<style>
  /* HERO STAT TILES. An infographic row: each figure gets a glyph in a soft
     accent chip, and the three parts share one vertical rhythm so the tiles
     line up whether their label runs one line or two. */
  .hero-stat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }
  /* Icon sits ON the figure's own line and is sized in `em`, so it tracks the
     figure's fluid clamp automatically instead of needing its own breakpoints.
     No chip: the glyph carries the colour itself. */
  /* :global() on the icon rules is REQUIRED, not stylistic. Astro scopes a
     page's <style> by hashing elements in this file's markup; the <svg> is
     rendered by the LineIcon child component, so it never carries this page's
     scope hash and an unscoped rule silently does nothing (measured: width
     computed to 0px and every tone fell back to text colour). */
  .hero-stat__row {
    display: flex;
    align-items: center;
    gap: 0.45em;
    /* NEVER WRAP. The icon and its figure are one unit; a wrapped row would
       drop the glyph onto a line of its own and stop reading as one fact. */
    flex-wrap: nowrap;
    white-space: nowrap;
    /* The figure came down from clamp(1.9rem, 3.4vw, 2.6rem) once the glyph
       joined its line: the pair is wider than the figure alone, and the widest
       tile ("4 AI domains") has to clear a quarter of the row at every width. */
    font-size: clamp(1.35rem, 2.1vw, 1.75rem);
  }
  /* Captions come down from the shared .of-spec-label size so the longest one
     ("proofread, table conversions, expand with sources") sits on one line at
     desktop instead of wrapping alone and unbalancing the row. */
  .hero-stat__label {
    font-size: 0.78rem;
    line-height: 1.45;
  }
  :global(.hero-stat__icon) {
    width: 0.92em;
    height: 0.92em;
    flex: none;
  }
  /* Tones are semantic, not decorative: speed, routing, money, capability.
     Four live theme-aware tokens (each redefines under dark), deliberately not
     the retired orbit-* hues. Cyan stays the action colour, so the glyph tones
     read as data categories and never as something to click. */
  :global(.hero-stat__icon--speed) { color: var(--color-accent-ink); }
  :global(.hero-stat__icon--route) { color: var(--color-danger); }
  :global(.hero-stat__icon--money) { color: var(--color-success); }
  :global(.hero-stat__icon--craft) { color: var(--color-warn); }

  .home-hero {
    isolation: isolate;
    /* Clip only the axis that needs it (the decorative grid/glow bleed
       sideways); the overlaid detail crop hangs past the shot vertically. */
    overflow-x: clip;
    background: linear-gradient(155deg, color-mix(in oklch, var(--color-primary) 6%, var(--color-surface)) 0%, var(--color-surface) 55%, color-mix(in oklch, var(--color-primary) 3%, var(--color-surface)) 100%);
  }
