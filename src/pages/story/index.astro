---
// /story/ — the build-log index in Paper (R6, G-145): the newest story as the
// lead card, then every other story in an even grid of three, then the story
// subscribe sheet (the same double-opt-in capture as each post).
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import PaperLayout from '../../layouts/PaperLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PaperSubscribe from '../../components/paper/PaperSubscribe.astro';
import { ogMeta } from '../../data/og';
import '../../styles/living-in-paper.css';

const posts = (await getCollection('story')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const [lead, ...rest] = posts;
const og = ogMeta('/story/');
// timeZone UTC, so a date-only frontmatter value shows its authored day.
const shortDate = (d: Date) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(d);
---
<PaperLayout
  title="Story · Orionfold"
  description="Building in public: short, honest notes on what we shipped, what broke, and what we learned along the way."
  ogImage={og.image}
  ogImageAlt={og.alt}
>
  <Nav />
  <main id="main" class="pp-page">
    <section class="pp-hero pp-hero--inner pp-hero--solo" aria-labelledby="story-title">
      <div class="pp-hero-copy">
        <p class="pp-kicker">Story</p>
        <h1 id="story-title" class="pp-h1">From the build log</h1>
        <p class="pp-sub">We build in public. Each note is a short, honest look at what we shipped, what broke, and what we learned.</p>
      </div>
    </section>

    <section class="pp-index" aria-label="Stories, newest first">
      <a class="pp-lead" href={`/story/${lead.id}/`}>
        {lead.data.hero && <Image src={lead.data.hero} alt={lead.data.heroAlt ?? lead.data.title} widths={[640, 960, 1280]} sizes="(min-width: 860px) 54vw, 92vw" loading="eager" fetchpriority="high" data-no-zoom />}
        <div class="pp-lead-copy">
          <p class="pp-kicker">Newest · {shortDate(lead.data.date)}{lead.data.tags[0] && ` · ${lead.data.tags[0]}`}</p>
          <h2>{lead.data.title}</h2>
          <p>{lead.data.summary}</p>
          <span class="pp-rail-go">Read the story →</span>
        </div>
      </a>
      <ul class="pp-art-cards pp-art-cards--3">
        {rest.map((post) => (
          <li><a href={`/story/${post.id}/`}>
            {post.data.hero && <Image src={post.data.hero} alt={post.data.heroAlt ?? post.data.title} widths={[400, 640]} sizes="(min-width: 1100px) 30vw, (min-width: 420px) 46vw, 92vw" loading="lazy" data-no-zoom />}
            <span class="pp-card-date">{shortDate(post.data.date)}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.summary}</p>
          </a></li>
        ))}
      </ul>
    </section>

    <PaperSubscribe id="story-subscribe" heading="Get each new story in your inbox." dek="Formerly AI For Everyone. Short, honest notes from building Orionfold in public. One email a week, no more." source="story" />
  </main>
  <Footer showDownload={false} />
</PaperLayout>
