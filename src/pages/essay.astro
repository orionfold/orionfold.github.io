---
// Essay 01, Room for a Renaissance, in the Paper long-form template (R6,
// G-145). Same URL, title, dates and Article JSON-LD as the Living page.
import PaperLayout from '../layouts/PaperLayout.astro';
import PaperLongform from '../components/paper/PaperLongform.astro';
import Fold from '../components/paper/Fold.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import EssayBody from '../components/living/EssayBody.astro';
import { ogMeta } from '../data/og';
import { SITE, PERSON } from '../data/seo';
import { ESSAYS } from '../data/essays';
import { ORIONFOLD_FLOW_LIVE } from '../data/launch';
import { FLOW_DMG_URL } from '../data/flow-pricing';
import '../styles/living-in-paper.css';
import '../styles/paper-bridge-essays.css';
const title = "Room for a Renaissance · An essay by Manav Sehgal";
const description = "How knowledge that keeps working can make more room for the researcher, writer, and builder in each of us. An essay by Manav Sehgal.";
const og = ogMeta('/essay/');
const pageSchema = {'@context':'https://schema.org','@type':'Article',datePublished:'2026-09-06T00:00:00.000Z',dateModified:'2026-09-17T00:00:00.000Z',headline:title,description,author:PERSON,publisher:{'@type':'Organization',name:SITE.name,url:SITE.url},mainEntityOfPage:`${SITE.url}/essay/`,image:`${SITE.url}${og.image}`};
const essay = ESSAYS.find((e) => e.href === '/essay/')!;
const [latest] = ESSAYS;
const manifesto = ESSAYS.find((e) => e.href === '/manifesto/')!;
// The chapter sections carry their own ids; the rail lists them in order.
const chapters = [
  ['the-work-returns', 'More of us is possible'],
  ['give-the-method-a-home', 'Give curiosity a place to return'],
  ['the-morning-is-the-product', 'A better kind of morning'],
  ['intelligence-needs-a-place-to-show-its-work', 'Keep the right to question the result'],
  ['attention-is-the-scarce-resource', 'A larger life needs quieter tools'],
  ['ownership-becomes-more-important-when-work-runs', 'Own the work and its boundaries'],
  ['start-with-the-document-you-already-reopen', 'FOLD: turn one intention into a practice'],
  ['expertise-can-become-a-practice', 'Let hard-won knowledge travel'],
  ['a-familiar-page-has-to-earn-its-place', 'The document has to earn the return'],
  ['leave-something-useful-in-motion', 'Make room for the next chapter'],
].map(([slug, text]) => ({ depth: 2, slug, text }));
---
<PaperLayout title={title} description={description} ogImage={og.image} ogImageAlt={og.alt} jsonLd={pageSchema} ogType="article" article={{datePublished:"2026-09-06",dateModified:"2026-09-17",author:"Manav Sehgal",section:"Living Documents"}}>
  <Nav />
  <main id="main" class="pp-page">
    <PaperLongform crumb={{ href: '/essays/', label: 'Essays' }} kicker={`Essay ${essay.number}`} title="Room for a Renaissance." dek={essay.subtitle} published={new Date('2026-09-06')} updated={new Date('2026-09-17')} minutes={essay.minutes} headings={chapters} bodyClass="ls-essay-in-paper">
      <EssayBody />
      <a slot="rail" class="pp-rail-link" href={essay.download} download>Download the essay ↓</a>
      <nav slot="after" class="pp-long-next" aria-label="More essays">
        <a href={latest.href}><span class="pp-kicker">Essay {latest.number}</span><strong>{latest.title}</strong></a>
        <a class="pp-next-newer" href={manifesto.href}><span class="pp-kicker">Essay {manifesto.number}</span><strong>{manifesto.title}</strong></a>
      </nav>
    </PaperLongform>

    <section class="pp-closing" data-cta-placement="closing" aria-labelledby="essay-closing-heading">
      <Fold id="hop" live class="pp-closing-fold" />
      <h2 id="essay-closing-heading">Give one page its next life.</h2>
      <p>Start with a document you already reopen.</p>
      <a class="pp-btn" href={ORIONFOLD_FLOW_LIVE ? FLOW_DMG_URL : '/#waitlist'} data-flow-download={ORIONFOLD_FLOW_LIVE ? 'essay-living-documents' : undefined}>{ORIONFOLD_FLOW_LIVE ? 'Download Flow for Mac' : 'Join the waitlist'}</a>
      <small><a href="/essays/">All essays</a></small>
    </section>
  </main>
  <Footer showDownload={false} />
</PaperLayout>
