---
// Book purchase thank-you (C4). The Checkout success_url for books lands here
// with ?session_id=…. Delivery is NOT done here — the stripe-webhook emails the
// signed PDF+EPUB links server-side (never trusted to this redirect). This page
// just confirms and reassures. It shows a sensible message even if the optional
// order-status lookup fails (e.g. CORS on localhost), then enhances it with the
// book title + email when the lookup succeeds. noindex (post-checkout).
// R7a (G-146): the Paper done sheet; the ids the script fills are unchanged.
import PaperLayout from '../layouts/PaperLayout.astro';
import Fold from '../components/paper/Fold.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
---
<PaperLayout title="Thank you · Orionfold" description="Your Orionfold purchase is confirmed." noindex>
  <Nav />
  <main id="main" class="pp-page">
    <section class="pp-done" aria-labelledby="thanks-heading">
      <Fold id="tally" bob />
      <p class="pp-kicker">Thank you</p>
      <h1 id="thanks-heading">Your order is confirmed</h1>
      <p id="thanks-msg">We just sent your download links to your inbox. You get both the PDF and the EPUB, so you can read on any device. The links work for 7 days, so save the files once you open them.</p>
      <small>Do not see it? Check your spam folder, then email <a href="mailto:manav@orionfold.com">manav@orionfold.com</a> and we will help.</small>
      <div class="pp-done-actions">
        <a class="pp-btn" href="/books/">More books</a>
        <a class="pp-btn pp-btn--ghost" href="/adoption/">See the roadmap</a>
      </div>
    </section>
  </main>
  <Footer showDownload={false} />
</PaperLayout>

<script>
  import { fetchOrderStatus } from '../lib/checkout';
  import { reportPurchase } from '../lib/conversion';

  async function confirmOrder() {
    const sessionId = new URLSearchParams(location.search).get('session_id');
    if (!sessionId) return;
    const status = await fetchOrderStatus(sessionId);
    if (!status || !status.paid) return;

    // Report the purchase: GA4 `purchase` for every kind; books + Arena licenses
    // also fire the value-based Google Ads conversion (hashed-email Enhanced
    // Conversions) + Meta Pixel (MARKETING-HANDOFF.md Tasks 1–3).
    await reportPurchase({
      transactionId: sessionId,
      value: typeof status.amount === 'number' ? status.amount / 100 : null,
      currency: status.currency ? status.currency.toUpperCase() : 'USD',
      itemId: status.lookupKey,
      itemName: status.label,
      email: status.email,
      kind: status.kind,
    });

    // This page serves both book purchases and Arena Field Edition licenses
    // (both are payment-mode → success_url /thanks/). Specialize the copy by kind.
    const where = status.email ? ` to ${status.email}` : '';
    const heading = document.getElementById('thanks-heading');
    const msg = document.getElementById('thanks-msg');
    if (status.kind === 'license') {
      if (heading) heading.textContent = 'Your Field Edition license is confirmed';
      if (msg) {
        const lic = status.label ? status.label : 'your Arena Field Edition license';
        msg.textContent =
          `Thank you. Your license file for ${lic} and the one-command setup steps are on the way${where}. Keep the license file safe, it carries your private update access.`;
      }
    } else {
      if (heading) heading.textContent = 'Your book is on the way';
      if (msg) {
        const book = status.label ? `your copy of ${status.label}` : 'your book';
        msg.textContent =
          `We just sent the download links for ${book}${where}. You get both the PDF and the EPUB, so you can read on any device. The links work for 7 days, so save the files once you open them.`;
      }
    }
  }
  confirmOrder();
  document.addEventListener('astro:after-swap', confirmOrder);
</script>
