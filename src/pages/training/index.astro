---
// R7e (G-146): a Paper page. The one workshop is a lead card; the three
// promises are Paper cells. Links, pricing JSON and JSON-LD are unchanged.
import PaperLayout from '../../layouts/PaperLayout.astro';
import { ogMeta } from '../../data/og';
import Panel from '../../components/paper/Panel.astro';
import Media from '../../components/paper/Media.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ThemedShot from '../../components/relay/ThemedShot.astro';
import { RELAY_OPERATOR_WORKSHOP, formatUsd } from '../../data/commerce';
import { RELAY_OPERATOR_WORKSHOP_CHECKOUT_ENABLED } from '../../data/launch';
import { SITE } from '../../data/seo';

const workshop = RELAY_OPERATOR_WORKSHOP;
const price = formatUsd(workshop.primary.amount);
const catalogUrl = `${SITE.url}/training/`;

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Orionfold Training Workshops',
  description: 'Self-serve working sessions that end in working software and retained evidence.',
  url: catalogUrl,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: 1,
    itemListElement: [{
      '@type': 'ListItem',
      position: 1,
      url: `${SITE.url}/training/relay-operator-workshop/`,
      name: workshop.primary.label,
    }],
  },
};
---

<PaperLayout
  ogImage={ogMeta('/training/').image}
  ogImageAlt={ogMeta('/training/').alt}
  title="Training Workshops · Build working AI systems"
  description="Focused, self-serve Orionfold workshops that help you build one working system, verify it, and keep the result."
  jsonLd={collectionSchema}
>
  <Nav />
  <main id="main" class="pp-page">
    <section class="pp-hero pp-hero--inner pp-hero--solo" aria-labelledby="training-title">
      <div class="pp-hero-copy">
        <p class="pp-kicker">Orionfold Training</p>
        <h1 id="training-title" class="pp-h1">Working sessions, not watched courses.</h1>
        <p class="pp-sub">
          Bring a real operating problem. Follow a bounded, source-grounded path. Leave with working software and evidence you can inspect, rerun, and keep.
        </p>
      </div>
    </section>

    <section class="pp-index" aria-labelledby="available-workshops">
      <div class="pp-index-head pp-training-head">
        <p class="pp-kicker">Founding catalog · 01</p>
        <h2 id="available-workshops">Available workshops</h2>
        <a class="pp-link" href="/training/pricing.json">Machine-readable pricing →</a>
      </div>

      <article class="pp-lead pp-training-card">
        <div class="pp-lead-copy">
          <p class="pp-kicker">Relay · Founding edition · 90–150 minutes · No account</p>
          <h3>Build and run one AI-assisted workflow.</h3>
          <p>
            Turn one bounded operating process into a Relay workflow with owned inputs, a human checkpoint, a visible cost or trust boundary, and a retained completion receipt.
          </p>
          <ul class="pp-training-ticks">
            <li>Compatible Relay free core</li>
            <li>Provider-free rehearsal</li>
            <li>Source-hashed starter</li>
            <li>14-day full refund</li>
          </ul>
          <div class="pp-hero-cta">
            <a class="pp-btn" href="/training/relay-operator-workshop/">Explore the workshop · {price}</a>
            <small>{RELAY_OPERATOR_WORKSHOP_CHECKOUT_ENABLED ? 'Enrollment open' : 'Enrollment opens with the first workshop release'}</small>
          </div>
        </div>
        <Media caption={"Human checkpoint · waiting for judgment"} ratio="contain" class="pp-training-shot">
          <ThemedShot id="inbox-approvals" alt="Relay Inbox showing a human approval checkpoint waiting for an operator decision." />
</Media>
      </article>
    </section>

    <Panel id="training-promise" seam="What every workshop ends with" fold="hop" tinted>
      <ul class="pp-cells pp-cells--3">
        <li><small>01 · Build</small><b>A working system</b><span>The outcome is a working system in Relay, not a decorative certificate.</span></li>
        <li><small>02 · Verify</small><b>Evidence you can check</b><span>Visible checkpoints, truthful state, failure evidence, retry, and a known-good fallback.</span></li>
        <li><small>03 · Keep</small><b>Files that stay yours</b><span>Your workflow, files, outputs, portable bundle, and completion receipt remain yours.</span></li>
      </ul>
    </Panel>
  </main>
  <Footer showDownload={false} />
</PaperLayout>
