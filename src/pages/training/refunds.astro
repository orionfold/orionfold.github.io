---
// Workshop refunds. R7a (G-146): Paper. The form id, fields, honeypot and the
// status line the script writes to are unchanged.
import PaperLayout from '../../layouts/PaperLayout.astro';
import { ogMeta } from '../../data/og';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../data/seo';

const pageUrl = `${SITE.url}/training/refunds/`;
const faq = [
  {
    question: 'How long is the refund window?',
    answer: 'You may request a full, no-judgment refund within 14 calendar days of successful payment.',
  },
  {
    question: 'What happens to workshop access?',
    answer: 'Access remains active while Stripe processes the request. A successful full refund closes future private playback and re-download.',
  },
  {
    question: 'Do I lose work I already made?',
    answer: 'No. Files you already downloaded and work you created in Relay remain yours.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  url: pageUrl,
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<PaperLayout
  ogImage={ogMeta('/training/refunds/').image}
  ogImageAlt={ogMeta('/training/refunds/').alt}
  title="Training workshop refunds · Orionfold"
  description="Read the Orionfold training workshop refund policy and request a refund using your purchase email."
  jsonLd={faqSchema}
>
  <Nav />
  <main id="main" class="pp-page">
    <section class="pp-hero pp-hero--inner pp-hero--solo" aria-labelledby="refunds-title">
      <div class="pp-hero-copy">
        <p class="pp-kicker"><a href="/training/">Orionfold Training</a></p>
        <h1 id="refunds-title" class="pp-h1">Workshop refunds, without a maze.</h1>
        <p class="pp-sub">Every paid Orionfold training workshop includes a 14-day full, no-judgment refund window. Use the purchase email below and confirm the private link we send you.</p>
      </div>
    </section>

    <section class="pp-split" aria-label="The policy and the request form">
      <div>
        <p class="pp-kicker">The policy</p>
        <dl class="pp-policy">
          <div><dt>14 calendar days</dt><dd>The window begins when payment succeeds. Requests inside it receive a full refund to the original payment method.</dd></div>
          <div><dt>Access stays open while pending</dt><dd>Only a successful Stripe refund closes future private playback and re-download.</dd></div>
          <div><dt>Your work remains yours</dt><dd>Downloaded files and the workflows, outputs, and receipts you created in Relay are not removed.</dd></div>
          <div><dt>Private by default</dt><dd>The form always returns the same message, so it does not reveal whether an email owns a purchase.</dd></div>
        </dl>
      </div>

      <form id="refund-request-form" class="pp-form">
        <p class="pp-kicker">Request a refund</p>
        <h2>Relay Operator Workshop</h2>
        <p>Enter the email used at checkout. If it owns an eligible purchase, we will send a one-hour confirmation link. Refund timing after confirmation depends on Stripe and your bank.</p>
        <label for="refund-email">Purchase email</label>
        <input id="refund-email" name="email" type="email" autocomplete="email" required maxlength="254" />
        <input class="hidden" name="company" tabindex="-1" autocomplete="off" />
        <button class="pp-btn" type="submit">Email my confirmation link</button>
        <p id="refund-request-status" role="status" aria-live="polite"></p>
        <small>Outside the automatic window or unable to use the form? Email <a href="mailto:manav@orionfold.com">manav@orionfold.com</a>.</small>
      </form>
    </section>

    <section class="pp-index" aria-labelledby="refund-questions">
      <div class="pp-index-head">
        <p class="pp-kicker">Clear before you ask</p>
        <h2 id="refund-questions">Refund questions</h2>
      </div>
      <div class="pp-faq">
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
  <Footer showDownload={false} />
</PaperLayout>

<script>
  import { requestWorkshopLink } from '../../lib/workshop';

  const form = document.getElementById('refund-request-form') as HTMLFormElement | null;
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const status = document.getElementById('refund-request-status');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (data.get('company')) return;
    if (button) button.disabled = true;
    if (status) status.textContent = 'Sending a private confirmation link…';
    const result = await requestWorkshopLink('refund', String(data.get('email') || ''));
    if (status) status.textContent = String(result.data.message || 'If that inbox owns an eligible workshop, the confirmation link is on its way.');
    if (button) button.disabled = false;
  });
</script>
