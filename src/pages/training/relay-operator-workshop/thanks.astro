---
// R7e (G-146): the R7a done sheet. The status script keeps its ids (heading,
// status, preview-badge, next-link) and the dev-only preview is unchanged.
import PaperLayout from '../../../layouts/PaperLayout.astro';
import Fold from '../../../components/paper/Fold.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
const operatorPreviewEnabled = import.meta.env.DEV;
---
<PaperLayout title="Workshop purchase confirmed · Orionfold" description="Your Relay Operator Workshop purchase is confirmed." noindex>
  <Nav />
  <main id="main" class="pp-page pp-done-page">
    <section class="pp-done" aria-labelledby="heading">
      <Fold id="tally" live />
      {operatorPreviewEnabled && <p id="preview-badge" hidden class="pp-kicker">Operator preview · simulated payment</p>}
      <p class="pp-kicker">Relay Operator Workshop</p>
      <h1 id="heading">Your workshop is confirmed</h1>
      <p id="status" aria-live="polite">
        Payment confirmation is loading. Your private access link is delivered transactionally by email—not by this redirect.
      </p>
      <p>The link works for seven days. If it expires, request a fresh one automatically; no account or founder reply is required.</p>
      <div class="pp-done-actions">
        <a id="next-link" class="pp-btn" href="/training/relay-operator-workshop/access/">Request access or a refund</a>
      </div>
    </section>
  </main>
  <Footer showDownload={false} />
</PaperLayout>

<script>
  import { fetchOrderStatus } from '../../../lib/checkout';
  import { reportPurchase } from '../../../lib/conversion';
  async function confirm() {
    const preview = import.meta.env.DEV && new URLSearchParams(location.search).get('preview') === 'paid';
    const sessionId = new URLSearchParams(location.search).get('session_id');
    const statusEl = document.getElementById('status');
    const headingEl = document.getElementById('heading');
    const badgeEl = document.getElementById('preview-badge');
    const nextLink = document.getElementById('next-link') as HTMLAnchorElement | null;
    if (preview) {
      if (badgeEl) badgeEl.hidden = false;
      if (headingEl) headingEl.textContent = 'Your paid workshop is ready';
      if (statusEl) statusEl.textContent = 'Payment confirmed. In the real path, the private seven-day access link arrives transactionally in the purchase inbox.';
      if (nextLink) {
        nextLink.href = '/training/relay-operator-workshop/access/?preview=paid';
        nextLink.textContent = 'Open the private access link';
      }
      return;
    }
    if (!sessionId || !statusEl) return;
    const status = await fetchOrderStatus(sessionId);
    if (!status?.paid || status.kind !== 'workshop') {
      statusEl.textContent = 'We could not confirm this redirect. If you paid, the webhook still delivers access to your checkout inbox.';
      return;
    }
    statusEl.textContent = `Payment confirmed${status.email ? ` for ${status.email}` : ''}. Your private seven-day access link is on its way.`;
    await reportPurchase({
      transactionId: sessionId,
      value: typeof status.amount === 'number' ? status.amount / 100 : null,
      currency: status.currency?.toUpperCase() ?? 'USD',
      itemId: status.lookupKey,
      itemName: status.label,
      email: status.email,
      kind: status.kind,
    });
  }
  confirm();
</script>
