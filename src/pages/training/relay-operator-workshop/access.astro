---
// R7e (G-146): the access card on the Paper done sheet, with the recovery
// form on the Paper form styles. Every id the script reads is unchanged.
import PrivateLayout from '../../../layouts/PrivateLayout.astro';
import Fold from '../../../components/paper/Fold.astro';
const operatorPreviewEnabled = import.meta.env.DEV;
---
<PrivateLayout title="Workshop access · Orionfold" description="Open or recover your Relay Operator Workshop access.">
  <header class="pp-done-brand">
    <span class="pp-logo" aria-label="Orionfold"><img src="/logos/orionfold-mark-3d-48.png" alt="" width="24" height="24" />ORIONFOLD</span>
  </header>
  <main id="main" class="pp-done-page">
    <section class="pp-done pp-private-card" aria-labelledby="access-title">
      <Fold id="tally" live />
      {operatorPreviewEnabled && <p id="preview-badge" hidden class="pp-kicker">Operator preview · active entitlement</p>}
      <p class="pp-kicker">Private edition access</p>
      <h1 id="access-title">Relay Operator Workshop</h1>
      <div id="access-status" class="pp-private-status" role="status" aria-live="polite">
        Checking your private access link…
      </div>
      <a id="manifest-link" hidden class="pp-btn" rel="noreferrer">Enter the guided workshop</a>

      <form id="recovery-form" class="pp-form pp-private-form">
        <h2>Need a fresh access link?</h2>
        <label for="email">Purchase email</label>
        <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" />
        <input class="hidden" name="company" tabindex="-1" autocomplete="off" />
        <button class="pp-btn" type="submit" data-action="reaccess">Email a fresh access link</button>
        <p id="request-status" role="status" aria-live="polite"></p>
      </form>
      <small>Looking for the policy or request form? Visit <a href="/training/refunds/">Training workshop refunds</a>.</small>
    </section>
  </main>
</PrivateLayout>

<script>
  import {
    clearWorkshopAccessToken,
    exchangeWorkshopAccess,
    readWorkshopAccessToken,
    requestWorkshopLink,
    storeWorkshopAccessToken,
    takeFragmentToken,
  } from '../../../lib/workshop';
  const preview = import.meta.env.DEV && new URLSearchParams(location.search).get('preview') === 'paid';
  const token = takeFragmentToken() || readWorkshopAccessToken();
  const accessStatus = document.getElementById('access-status');
  const manifestLink = document.getElementById('manifest-link') as HTMLAnchorElement | null;
  const previewBadge = document.getElementById('preview-badge');
  if (preview) {
    if (previewBadge) previewBadge.hidden = false;
    if (accessStatus) accessStatus.textContent = 'Access verified. This purchased edition can be reopened without an account; the inbox link rotates if a fresh one is requested.';
    if (manifestLink) {
      manifestLink.href = '/training/relay-operator-workshop/workspace/?preview=operator';
      manifestLink.textContent = 'Enter the guided workshop';
      manifestLink.hidden = false;
    }
  } else if (!token) {
    if (accessStatus) accessStatus.textContent = 'Paste-free access starts from the private link in your inbox. Request a fresh link below if needed.';
  } else {
    exchangeWorkshopAccess(token).then(({ ok, data }) => {
      if (ok && typeof data.workspacePath === 'string') {
        storeWorkshopAccessToken(token);
        if (accessStatus) accessStatus.textContent = 'Access verified. Your private guided workspace is ready.';
        if (manifestLink) {
          manifestLink.href = data.workspacePath;
          manifestLink.textContent = 'Enter the guided workshop';
          manifestLink.hidden = false;
        }
      } else if (accessStatus) {
        clearWorkshopAccessToken();
        accessStatus.textContent = data.retryable
          ? 'The private workspace is temporarily unavailable. Retry this page shortly or request a fresh link.'
          : 'This access link is expired or has been replaced. Request a fresh link below.';
      }
    });
  }

  const form = document.getElementById('recovery-form') as HTMLFormElement | null;
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const email = String(new FormData(form).get('email') || '');
    const status = document.getElementById('request-status');
    form.querySelectorAll('button').forEach((button) => button.disabled = true);
    const result = await requestWorkshopLink('reaccess', email);
    if (status) status.textContent = result.data.message as string || 'If that inbox owns this edition, the requested link is on its way.';
    form.querySelectorAll('button').forEach((button) => button.disabled = false);
  });
</script>
