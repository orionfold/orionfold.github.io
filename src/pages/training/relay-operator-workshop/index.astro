---
// R7e (G-146): a Paper page on the Relay product hero. Both checkout buttons
// keep their data-checkout, data-item and data-error-target; the free
// showcase video, the JSON-LD and the dev-only operator preview are unchanged.
import PaperLayout from '../../../layouts/PaperLayout.astro';
import { ogMeta } from '../../../data/og';
import Panel from '../../../components/paper/Panel.astro';
import Media from '../../../components/paper/Media.astro';
import PageNav from '../../../components/paper/PageNav.astro';
import Fold from '../../../components/paper/Fold.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import ThemedShot from '../../../components/relay/ThemedShot.astro';
import WorkshopShot from '../../../components/training/WorkshopShot.astro';
import { RELAY_OPERATOR_WORKSHOP, formatUsd } from '../../../data/commerce';
import { RELAY_OPERATOR_WORKSHOP_CHECKOUT_ENABLED } from '../../../data/launch';
import { WORKSHOP_MEDIA_BASE } from '../../../lib/commerce-config';
import { SITE } from '../../../data/seo';

const workshop = RELAY_OPERATOR_WORKSHOP;
const price = formatUsd(workshop.primary.amount);
const pageUrl = `${SITE.url}/training/relay-operator-workshop/`;
const operatorPreview = import.meta.env.DEV;
const media = {
  showcase: `${WORKSHOP_MEDIA_BASE}/media/the-marketing-line-master.mp4`,
  showcaseCaptions: `${WORKSHOP_MEDIA_BASE}/captions/the-marketing-line-master.vtt`,
  showcaseTranscript: `${WORKSHOP_MEDIA_BASE}/transcripts/the-marketing-line-master.md`,
  showcasePoster: `${WORKSHOP_MEDIA_BASE}/posters/the-marketing-line-master-poster.png`,
  fieldLesson: `${WORKSHOP_MEDIA_BASE}/media/relay-operator-workshop-field-lesson.mp4`,
  fieldLessonCaptions: `${WORKSHOP_MEDIA_BASE}/captions/relay-operator-workshop-field-lesson.vtt`,
  fieldLessonTranscript: `${WORKSHOP_MEDIA_BASE}/transcripts/relay-operator-workshop-field-lesson.md`,
};

const syllabus = [
  ['Inspect', 'Open the source-hashed Marketing Line example. Name its owned inputs, workflow boundary, human checkpoint, and retained evidence.'],
  ['Adapt', 'Replace the example with one bounded process and inputs you are authorized to use.'],
  ['Govern', 'Put a person and a visible cost or trust boundary before consequential action.'],
  ['Run + recover', 'Use a configured runtime or the labeled deterministic rehearsal. Inspect failed evidence, retry, and use the known-good fallback.'],
  ['Retain', 'Export the learner-owned app Pack, Operations Receipt, selected outputs, hashes, and limitations.'],
];

const workshopExperience = [
  {
    id: 'start',
    eyebrow: '00 · Orient',
    title: 'See the result before you touch the starter.',
    body: 'The opening screen names the governed workflow, human decision, visible boundary, and reusable blueprint you are working toward. The Relay check is read-only, so orientation does not mutate your workspace.',
    alt: 'Relay Operator Workshop start screen showing the target result, progress rail, and read-only Relay preflight.',
  },
  {
    id: 'inspect',
    eyebrow: '01 · Inspect',
    title: 'Read the lesson and its source trail in one place.',
    body: 'Each private module keeps its formatted transcript directly below the video. Jump between chapters and open the exact Relay guide, API chapter, operating memo, or synthetic demo behind a claim without leaving the lesson context.',
    alt: 'Relay Operator Workshop Inspect screen with the in-place transcript expanded and chapter navigation visible.',
  },
  {
    id: 'adapt',
    eyebrow: '02 · Adapt',
    title: 'Replace the example with one bounded process you own.',
    body: 'The lesson explains the checkpoint, then hands the action to Relay. Your progress advances only after Relay confirms the checkpoint; the local bench keeps the execution truth.',
    alt: 'Relay Operator Workshop Adapt screen showing the second checkpoint and Relay action handoff.',
  },
  {
    id: 'govern',
    eyebrow: '03 · Govern',
    title: 'Put named judgment before consequence.',
    body: 'You identify who decides, what evidence they need, and which cost or trust boundary must remain visible before the workflow continues.',
    alt: 'Relay Operator Workshop Govern screen showing the human-judgment checkpoint and visible progress.',
  },
  {
    id: 'run',
    eyebrow: '04 · Run + recover',
    title: 'Treat failure evidence as part of the lesson.',
    body: 'Run with a configured provider or the labeled deterministic rehearsal. Inspect the named failure, retry from the right boundary, and use the known-good fallback without disguising what happened.',
    alt: 'Relay Operator Workshop Run screen showing the diagnosis and recovery checkpoint.',
  },
  {
    id: 'retain',
    eyebrow: '05 · Retain',
    title: 'Keep the workflow and the evidence that explains it.',
    body: 'Review Relay’s verdict, selected outputs, source identities, hashes, limitations, and portable completion files before you export the system you built.',
    alt: 'Relay Operator Workshop Retain screen showing the fifth checkpoint and completion progress.',
  },
  {
    id: 'finish',
    eyebrow: '06 · Finish',
    title: 'Close on an export, not a watch badge.',
    body: 'The final screen returns you to Relay for the completion bundle. The proof is a rerunnable workflow and receipt; the paid lesson does not turn video playback into certification.',
    alt: 'Relay Operator Workshop finish screen showing the completed progress rail and retained-system outcome.',
  },
] as const;

const facts = [
  ['90–150 min', 'Designed working time, not a completion guarantee'],
  ['Relay ≥0.42.2 <0.45.0', 'Compatible free core; paid Relay is not required'],
  ['No account', 'Guest purchase and inbox-possession access'],
  ['14 days', 'Full no-judgment refund window'],
];

const faq = [
  ['Is this a live class?', 'No. It is a self-serve working session with no cohort, calendar, sales call, grading, or required founder meeting.'],
  ['Do I need a paid Relay plan?', 'No. The accepted founding edition runs on compatible Relay free core.'],
  ['Do I need a model provider?', 'No. A configured provider is optional because Relay includes a clearly labeled deterministic rehearsal and known-good fallback.'],
  ['What do I keep?', 'Your downloaded workshop files and learner-created Relay workflows, apps, packs, outputs, and receipts remain your files.'],
  ['How does access work?', 'Checkout uses your email for a seven-day private link. If it expires, the same inbox can request a fresh rotating link without creating an account.'],
  ['What happens after a refund?', 'Access stays active while Stripe processes the request. A successful refund closes future private access and re-download; files already downloaded and your Relay work remain yours.'],
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: workshop.primary.label,
  description: 'A focused self-serve workshop for building and running one AI-assisted workflow with human approval, cost controls, and a reusable blueprint.',
  sku: workshop.editionId,
  url: pageUrl,
  brand: { '@type': 'Brand', name: 'Orionfold' },
  offers: {
    '@type': 'Offer',
    price: (workshop.primary.amount / 100).toFixed(2),
    priceCurrency: 'USD',
    availability: RELAY_OPERATOR_WORKSHOP_CHECKOUT_ENABLED ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder',
    url: `${pageUrl}#start`,
    category: 'Training workshop',
    hasMerchantReturnPolicy: {
      '@type': 'MerchantReturnPolicy',
      applicableCountry: 'US',
      returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
      merchantReturnDays: workshop.refundDays,
      returnMethod: 'https://schema.org/KeepProduct',
      returnFees: 'https://schema.org/FreeReturn',
      refundType: 'https://schema.org/FullRefund',
    },
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([question, answer]) => ({
    '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<PaperLayout
  ogImage={ogMeta('/training/relay-operator-workshop/').image}
  ogImageAlt={ogMeta('/training/relay-operator-workshop/').alt}
  title="Relay Operator Workshop · Build and run one AI-assisted workflow"
  description="Bring one real operating process. Leave with a governed Relay workflow you can run, inspect, and improve, with no call to schedule with Orionfold."
  jsonLd={[productSchema, faqSchema]}
>
  <Nav />
  <main id="main" class="pp-page">
    <section class="pp-hero pp-hero--relay" aria-labelledby="workshop-title">
      <div class="pp-hero-copy">
        <a href="/training/" class="pp-kicker">Orionfold Training · Founding edition</a>
        <h1 id="workshop-title" class="pp-h1">Build and run one AI-assisted workflow.</h1>
        <p class="pp-sub">
          Add human approval, visible cost controls, and a reusable blueprint. Bring one real operating process; leave with a governed Relay workflow you can run, inspect, and improve, with no call to schedule with Orionfold.
        </p>
        <div id="start" class="pp-hero-cta">
          {RELAY_OPERATOR_WORKSHOP_CHECKOUT_ENABLED ? (
            <button
              type="button"
              class="pp-btn"
              data-checkout={workshop.primary.lookupKey}
              data-item="workshop:relay-operator-workshop"
              data-error-target="workshop-checkout-error"
            >Start the Relay Operator Workshop · {price} founding</button>
          ) : (
            <span class="pp-btn pp-btn--ghost">Checkout opens at launch</span>
          )}
          <a href="#free-lesson" class="pp-btn pp-btn--ghost">Watch the free workshop showcase</a>
        </div>
        <p id="workshop-checkout-error" class="pp-done-error" role="alert" hidden></p>
        <p class="pp-workshop-fine">
          One-time USD payment · 14-day full no-judgment refund · no recurring charge · {RELAY_OPERATOR_WORKSHOP_CHECKOUT_ENABLED ? 'enrollment open' : 'enrollment opens with the first workshop release'}
        </p>
        {operatorPreview && (
          <a class="pp-workshop-fine" href="/training/relay-operator-workshop/thanks/?preview=paid">
            Operator review · walk the simulated paid experience →
          </a>
        )}
      </div>
      <div class="pp-hero-stage">
        <Media caption={"Governed support workflow · checkpoint 03 of 05 · the human decides"} ratio="contain" class="pp-workshop-hero-shot">
          <ThemedShot id="inbox-approvals" alt="Relay Inbox showing the human approval checkpoint in a governed workflow." />
</Media>
      </div>
    </section>

    <PageNav label="Workshop page" onPage={[
      { href: '#outcome', label: 'Outcome' },
      { href: '#free-lesson', label: 'Free showcase' },
      { href: '#inside-workshop', label: 'Inside' },
      { href: '#checkpoints', label: 'Checkpoints' },
      { href: '#fit', label: 'Fit' },
      { href: '#workshop-faq', label: 'Questions' },
    ]} pages={[{ href: '/training/', label: 'All training' }]} />

    <section class="pp-index pp-workshop-facts" aria-label="Workshop facts">
      <dl class="pp-facts">
        {facts.map(([value, label]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
      </dl>
    </section>

    <Panel id="outcome" seam="The outcome" fold="tally" title="A working system, with the judgment left visible." lede="You start from a labeled synthetic Marketing Line example, then replace it with one bounded process you own. Relay keeps the human checkpoint, state, cost or trust boundary, recovery path, and completion evidence inspectable.">
      <ul class="pp-cells pp-cells--4">
        <li><small>Build</small><b>Your governed workflow</b><span>Owned inputs, explicit steps, one consequential pause, and a visible completion boundary.</span></li>
        <li><small>Retain</small><b>Your completion bundle</b><span>Learner-owned app Pack, Operations Receipt, selected outputs, hashes, and honest limitations.</span></li>
        <li><small>Recover</small><b>A known-good fallback</b><span>Named preflight failures, retry actions, and a provider-free rehearsal that never pretends a model call happened.</span></li>
        <li><small>Own</small><b>Files that stay yours</b><span>Downloaded materials and the workflows, apps, packs, outputs, and receipts you create remain your files.</span></li>
      </ul>
    </Panel>

    <Panel id="free-lesson" seam="Free · 15-minute workshop showcase" tinted>
      <div class="pp-workshop-lesson">
        <Media ratio="auto" class="pp-workshop-video">
          <video controls playsinline preload="metadata" poster={media.showcasePoster} crossorigin="anonymous">
            <source src={media.showcase} type="video/mp4" />
            <track kind="captions" src={media.showcaseCaptions} srclang="en" label="English" default />
            Your browser cannot play this video. Use the transcript link beside it.
          </video>
        </Media>
        <div class="pp-tour-copy">
          <h2>Follow the Marketing Line from operating memo to retained proof.</h2>
          <p>This complete public showcase uses synthetic Marketing Line data to inspect the source, isolate the join, shape the workflow, place human judgment before consequence, and keep a deterministic receipt. It makes no model call and writes nothing to your Relay workspace.</p>
          <a class="pp-btn pp-btn--ghost" href={media.showcaseTranscript}>Read the chaptered transcript</a>
          <a class="pp-link" href="/relay/memos/marketing-line/">Read the operating memo →</a>
          <a class="pp-link" href="/relay/demo/">Explore the synthetic Relay demo →</a>
        </div>
      </div>
    </Panel>

    <section id="inside-workshop" class="pp-index pp-workshop-inside" aria-labelledby="inside-title">
      <div class="pp-index-head">
        <p class="pp-kicker">Inside the paid workspace</p>
        <h2 id="inside-title">One calm screen at a time, from orientation to retained proof.</h2>
        <p>These are the actual guided-workspace screens. They follow the site’s light or dark theme, while private video remains available only after purchase.</p>
      </div>
      <ol class="pp-tour" aria-label="Workshop screens">
        {workshopExperience.map((step, index) => (
          <li id={`workshop-screen-${step.id}`} class:list={['pp-workshop-beat', { 'pp-tour--flip': index % 2 === 1 }]}>
            <div class="pp-tour-copy">
              <p class="pp-kicker">{step.eyebrow}</p>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
            <figure class="pp-tour-shot">
              <WorkshopShot id={step.id} alt={step.alt} />
              <figcaption>Actual guided workspace · theme-matched · synthetic example</figcaption>
            </figure>
          </li>
        ))}
      </ol>
    </section>

    <Panel id="checkpoints" seam="Five checkpoints" fold="hop" title="One path from inspection to retained proof.">
      <ol class="pp-rows pp-workshop-steps">
        {syllabus.map(([title, body], index) => (
          <li class="pp-row"><b>0{index + 1}</b><div><strong>{title}</strong><span>{body}</span></div></li>
        ))}
      </ol>
    </Panel>

    <Panel id="fit" seam="Good fit, or not" tinted>
      <div class="pp-relay-split">
        <div class="pp-relay-paid">
          <p class="pp-kicker">Good fit</p>
          <h3>You own a repeated process and want it governed.</h3>
          <ul><li>You already use AI and can follow a local software workflow.</li><li>You can bring one bounded process and authorized inputs.</li><li>You want human judgment visible before a consequential step.</li><li>You value rerunnable evidence over a completion badge.</li></ul>
        </div>
        <div>
          <p class="pp-kicker">Do not buy if</p>
          <h3>You need consulting, a cohort, or a guaranteed business result.</h3>
          <ul><li>You want Orionfold to design or operate the process for you.</li><li>You need live teaching, grading, office hours, or a response-time promise.</li><li>You cannot run a compatible local Relay installation.</li><li>You need a guaranteed completion time, revenue result, or professional certification.</li></ul>
        </div>
      </div>
    </Panel>

    <section class="pp-index pp-workshop-sources" aria-labelledby="sources-title">
      <div class="pp-index-head">
        <p class="pp-kicker">Source-grounded</p>
        <h2 id="sources-title">Built around current Relay behavior.</h2>
        <p>The learning path stays aligned with current Relay behavior, documentation, runtime, validation, and export. Orionfold connects those product facts to the lesson, payment, access, and refund experience.</p>
      </div>
      <ul class="pp-rows">
        <li><a href="/relay/docs/run-workflows-with-human-checkpoints/"><b>Guide</b><div><strong>Run Workflows With Human Checkpoints</strong></div><span aria-hidden="true">→</span></a></li>
        <li><a href="/relay/api/04-workflows-automation/"><b>API</b><div><strong>Workflows, approvals, Workshop lifecycle, fallback and export</strong></div><span aria-hidden="true">→</span></a></li>
        <li><a href="/relay/memos/marketing-line/"><b>Operating memo</b><div><strong>Marketing Line: the canonical synthetic example</strong></div><span aria-hidden="true">→</span></a></li>
      </ul>
    </section>

    <Panel id="workshop-faq" seam="Questions answered plainly">
      <div class="pp-faq">
        {faq.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}
      </div>
    </Panel>

    <section class="pp-closing" aria-labelledby="workshop-closing-title">
      <Fold id="tally" live class="pp-closing-fold" />
      <p class="pp-kicker">Relay Operator Workshop · 2026.07 founding</p>
      <h2 id="workshop-closing-title">Bring the process. Keep the working system.</h2>
      <p>One-time {price}. No account, cohort, sales call, premium Relay requirement, or recurring charge.</p>
      <div class="pp-done-actions">
        {RELAY_OPERATOR_WORKSHOP_CHECKOUT_ENABLED ? (
          <button type="button" class="pp-btn" data-checkout={workshop.primary.lookupKey} data-item="workshop:relay-operator-workshop" data-error-target="workshop-bottom-error">Start the workshop · {price} founding</button>
        ) : (
          <span class="pp-btn pp-btn--ghost">Checkout opens at launch</span>
        )}
      </div>
      <p id="workshop-bottom-error" class="pp-done-error" role="alert" hidden></p>
      <small><a href="/training/relay-operator-workshop/access/">Already purchased? Open or recover access →</a></small>
    </section>
  </main>
  <Footer showDownload={false} />
</PaperLayout>

<script>
  import { wireCheckoutButtons } from '../../../lib/checkout';
  wireCheckoutButtons();
  document.addEventListener('astro:after-swap', () => wireCheckoutButtons());
</script>
