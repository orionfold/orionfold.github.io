---
import PaperLayout from '../layouts/PaperLayout.astro';
import PageNav from '../components/paper/PageNav.astro';
import Panel from '../components/paper/Panel.astro';
import Fold from '../components/paper/Fold.astro';
import { Image } from 'astro:assets';
import { resolveProofArt } from '../lib/flagship/proof-art';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { flagshipById } from '../data/flagship-offers';
import { ogMeta } from '../data/og';

const offer = flagshipById.workflows;
const og = ogMeta('/workflows/');
const proof = offer.proof.map((link) => ({ ...link, art: resolveProofArt(link.href), external: link.href.startsWith('http') }));

// The anatomy every starter kit ships with — the pitch's core trust loop,
// shown as the pipeline it actually is.
const pipeline = [
  { step: 'Trigger', gloss: 'A schedule, file drop, or request starts the run.' },
  { step: 'Runner', gloss: 'A local agent does the work with the tools it is given.' },
  { step: 'Eval', gloss: 'Checks score the output before anyone relies on it.' },
  { step: 'Approval', gloss: 'A person reviews and signs off. Nothing ships itself.' },
  { step: 'Artifact', gloss: 'The run produces a real file, draft, or report.' },
  { step: 'Audit trail', gloss: 'Every run is logged and can be replayed later.' },
];

const kits = [
  { n: '01', title: 'Founder operating memory', body: 'Capture decisions, summarize work, propose next actions, and keep a traceable memory of what changed.' },
  { n: '02', title: 'Content to launch', body: 'Turn a source note into article, social posts, product copy, screenshots, and a final approval checklist.' },
  { n: '03', title: 'Private document workflow', body: 'Read sensitive files locally, draft an artifact, run checks, and preserve the audit trail.' },
];
---
<PaperLayout
  title="Workflows · Orionfold"
  description="Private Agent Starter Kits package one useful local workflow with trigger, runner, eval, approval, artifact output, and audit trail."
  ogImage={og.image}
  ogImageAlt={og.alt}
>
  <Nav />
  <main id="main" class="pp-page">
    {/* Paper R5 (G-144): the same copy and links; the audience and CTA stay the operator's call (G-015). */}
    <section class="pp-hero pp-hero--inner pp-hero--article" aria-labelledby="workflows-title">
      <div class="pp-hero-copy">
        <span class="pp-kicker">Workflows</span>
        <h1 id="workflows-title" class="pp-h1">Run one private agent workflow end to end.</h1>
        <p class="pp-sub">A starter kit is not a consulting retainer. It is one reusable local workflow with a trigger, runner, evaluation, approval loop, artifact output, and audit trail.</p>
        <div class="pp-hero-cta">
          <a class="pp-btn" href="/adoption/#run">Request a starter kit</a>
          <a class="pp-btn pp-btn--ghost" href="/relay/">Open Relay</a>
        </div>
      </div>
    </section>

    <PageNav label="Workflows navigation" pages={[
      { href: '/relay/', label: 'Relay' },
      { href: '/experts/', label: 'Experts' },
      { href: '/software/', label: 'All software' },
    ]} />

    <Panel id="anatomy" seam="Anatomy of every kit" fold="tally" title="Six stages.<br />Nothing ships itself.">
      <ol class="pp-cells pp-cells--3 pp-cells--steps">
        {pipeline.map((stage, i) => <li><small>{String(i + 1).padStart(2, '0')}</small><b>{stage.step}</b><span>{stage.gloss}</span></li>)}
      </ol>
    </Panel>

    <Panel id="kits" seam="First starter kits" fold="ember" tinted title="Three kits<br />to start from.">
      <ul class="pp-cells pp-cells--3">{kits.map((kit) => <li><small>Kit {kit.n}</small><b>{kit.title}</b><span>{kit.body}</span></li>)}</ul>
    </Panel>

    <Panel id="proof" seam="Built from shipped parts" fold="atlas" title="Shipped parts,<br />not slides.">
      <ul class="pp-art-cards pp-art-cards--3">
        {proof.map((link) => (
          <li><a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
            {link.art
              ? <Image src={link.art} alt={`${link.label} artwork`} widths={[400, 640]} sizes="(min-width: 860px) 30vw, 92vw" loading="lazy" data-no-zoom />
              : <span class="pp-art-fallback" aria-hidden="true"><Fold id="shell" /></span>}
            <h3>{link.label}</h3>
            <p>{link.note}</p>
          </a></li>
        ))}
      </ul>
      <p class="pp-panel-link"><a href="/software/">All software <span aria-hidden="true">→</span></a></p>
    </Panel>

    <section class="pp-closing" aria-labelledby="workflows-closing">
      <Fold id="tally" bob class="pp-closing-fold" />
      <h2 id="workflows-closing">Start with one workflow.</h2>
      <p>Tell us the job. We package it as one kit with its checks and its audit trail.</p>
      <a class="pp-btn" href="/adoption/#run">Request a starter kit</a>
    </section>
  </main>
  <Footer showDownload={false} />
</PaperLayout>
