---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import FlowSubNav from '../../components/flow/FlowSubNav.astro';
import FlowWaitlist from '../../components/sections/FlowWaitlist.astro';
import { SITE } from '../../data/seo';
import { ogMeta } from '../../data/og';
import { FLOW_CATEGORIES, flowCategoryHref } from '../../data/flow-categories';
import { FLOW_CATEGORY_SHOTS } from '../../data/flow-category-shots';
import { FLOW_V16_TOURS } from '../../data/flow-v16';
import '../../styles/flow.css';

const href = '/flow/tour/';
const og = ogMeta(href);
const flowStoryHref = '/story/the-day-i-stopped-trusting-invisible-edits/';

const tourCards = FLOW_CATEGORIES;

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Flow', item: `${SITE.url}/flow/` },
    { '@type': 'ListItem', position: 3, name: 'Product tour', item: `${SITE.url}${href}` },
  ],
};
---
<Layout
  title="Orionfold Flow product tour · See Flow at work"
  description="Tour Flow 1.6 through real screens: Living Documents, the Night Shift, six clear Settings screens, writing, files, model routing and evidence."
  ogImage={og.image}
  ogImageAlt={og.alt}
  jsonLd={[breadcrumbs]}
>
  <Nav />
  <FlowSubNav active="tour" />
  <main class="flow-page flow-page--category -mt-20 overflow-x-clip sm:-mt-24">
    <section class="flow-hero relative px-6 pb-12 pt-32 sm:pb-16 sm:pt-40" aria-labelledby="flow-tour-title">
      <div class="flow-hero__grid" aria-hidden="true"></div>
      <div class="flow-hero__glow" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-4xl text-center">
        <p class="of-eyebrow">Product tour</p>
        <h1 id="flow-tour-title" class="hero-gradient-text mx-auto mt-4 max-w-3xl font-display text-[clamp(2.5rem,6vw,4.4rem)] font-extrabold leading-[1.03] tracking-[-0.05em]">
          See Flow at work.
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-balance text-lg leading-[1.55] text-text-muted sm:text-xl">
          Real Flow screens. Start with Living Documents and the Night Shift, then explore the writing, files, models and evidence underneath.
        </p>
      </div>
    </section>

    <section class="border-t border-border/70 px-6 py-14 sm:py-20" aria-labelledby="flow-v16-tours">
      <div class="mx-auto max-w-6xl">
        <p class="of-eyebrow">Flow 1.6</p><h2 id="flow-v16-tours" class="of-display mt-3 text-4xl">Make knowledge a living thing.</h2>
        <p class="mt-5 max-w-3xl text-lg leading-relaxed text-text-muted">A page connected to its sources. A night shift with clear jobs. A morning you can review. See how the three parts work together.</p>
        <div class="mt-9 grid gap-6 lg:grid-cols-3">
          {FLOW_V16_TOURS.map((tour) => <article class="flow-cat-card of-surface flex flex-col rounded-2xl border border-border/70 p-6">
            <a href={`/flow/${tour.slug}/`} class="flow-cat-card__plate" aria-hidden="true" tabindex="-1"><Image src={tour.image} alt={tour.alt} widths={[560, 1120]} sizes="(min-width: 1024px) 28vw, 88vw" class="flow-cat-card__thumb" loading="lazy" decoding="async" /></a>
            <p class="mt-5 font-mono text-xs uppercase tracking-widest text-accent-ink">{tour.label}</p><h3 class="mt-3 text-2xl font-bold"><a href={`/flow/${tour.slug}/`}>{tour.title}</a></h3><p class="mt-3 flex-1 leading-relaxed text-text-muted">{tour.description}</p><a class="of-text-action mt-6" href={`/flow/${tour.slug}/`}>Explore {tour.label} <span aria-hidden="true">→</span></a>
          </article>)}
        </div>
        <p class="mt-6 text-sm text-text-dim">Real product details from Flow 1.6 (1899), captured September 6, 2026. Example documents use sample data.</p>
      </div>
    </section>

    <section class="border-t border-border/70 px-6 py-14 sm:py-20" aria-label="Flow product tour parts">
      <div class="mx-auto mb-8 max-w-6xl"><p class="of-eyebrow">The foundations</p><h2 class="of-display mt-3 text-3xl">Go deeper into the work.</h2></div>
      <div class="mx-auto grid max-w-6xl gap-4 md:grid-cols-2" data-animate-stagger>
        {tourCards.map((category, index) => (
          <article class="flow-cat-card of-surface flex flex-col rounded-2xl border border-border/70 p-6 sm:p-7" data-animate>
            <a href={flowCategoryHref(category.slug)} class="flow-cat-card__plate" aria-hidden="true" tabindex="-1">
              <Image src={FLOW_CATEGORY_SHOTS[category.slug].src} alt={FLOW_CATEGORY_SHOTS[category.slug].alt} widths={[560, 1120]} sizes="(min-width: 768px) 42vw, 88vw" class="flow-cat-card__thumb" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
            </a>
            <div class="mt-5 flex items-center justify-between gap-4">
              <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-accent-ink">Part {index + 1} · {category.label}</p>
              <p class="font-mono text-[0.62rem] text-text-dim">{category.chapters.length} chapters</p>
            </div>
            <h2 class="mt-3 text-2xl font-bold leading-tight"><a href={flowCategoryHref(category.slug)} class="transition-colors hover:text-primary">{category.title}</a></h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-text-muted">{category.blurb}</p>
            <ul class="mt-5 border-t border-border/70 pt-4 text-sm leading-relaxed text-text-muted">
              {category.chapters.map((chapter) => <li class="mt-1 first:mt-0">{chapter.label}</li>)}
            </ul>
            <a href={flowCategoryHref(category.slug)} class="of-text-action mt-6 inline-flex items-center gap-2">Open part {index + 1} <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </section>

    <div id="waitlist" class="scroll-mt-24">
      <FlowWaitlist placement="flow-mid" storyHref={flowStoryHref} nextHref="/flow/specifications/" nextLabel="Tech Specs" />
    </div>
  </main>
  <Footer showDownload={false} />
</Layout>
