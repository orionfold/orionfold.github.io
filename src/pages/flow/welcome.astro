---
// /flow/welcome/ — where Stripe returns a buyer after a Flow Pro checkout.
//
// WHY A PAGE AND NOT A DEEP LINK AS success_url. A browser cannot be relied on
// to hand off to an app: the buyer may have paid on their phone, may be in a
// browser that blocks scheme handoffs, or may dismiss the "Open Flow?" dialog.
// So the page is what ALWAYS renders, and the page offers the deep link. A
// success_url pointing straight at a URL scheme would strand every buyer whose
// browser refuses it, holding a receipt and no licence.
//
// THE ORDERING THIS PAGE EXPRESSES:
//   FLOOR  Flow is already polling with the checkout session id and will pick
//          the licence up on its own. This page says so, so a buyer who does
//          nothing is still fine.
//   FAST   the button below opens Flow directly with a single-use claim.
//
// NOINDEX. A post-checkout page has nothing to offer search, and the URL
// carries a session id. The sitemap filter already excludes /thanks/ pages by
// convention; this one says so in its own head as well.
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { ORIONFOLD_FLOW_LIVE } from '../../data/launch.ts';
---

<Layout
  title="Welcome to Flow Pro"
  description="Your Flow Pro subscription is active."
  noindex={true}
>
  <Nav />
  <main id="main">
    <section class="px-6 py-20 sm:py-28">
      <div class="mx-auto max-w-2xl text-center">
        <p class="font-mono text-[0.66rem] uppercase tracking-[0.16em] text-accent-ink">
          Payment received
        </p>
        <h1 class="mt-4 text-balance text-3xl font-bold leading-[1.15] sm:text-4xl">
          Welcome to Flow Pro
        </h1>

        {ORIONFOLD_FLOW_LIVE ? (
          <>
            <p class="mt-6 text-lg leading-[1.55] text-text-muted">
              Your subscription is active. Flow is already looking for your licence, so
              you can simply switch back to the app and keep working.
            </p>

            {/* The fast path. Hidden until the script confirms the app scheme is
                worth offering, so a buyer is never shown a button that does
                nothing. See the inline script below. */}
            <div id="flow-open" class="mt-8 hidden">
              <a id="flow-open-link" href="#" class="of-primary-action">Open Flow now</a>
              <p class="mt-3 font-mono text-[0.62rem] uppercase tracking-[0.16em] text-text-dim">
                Opens the app and finishes setting up
              </p>
            </div>

            <div class="of-surface mt-10 rounded-2xl border border-border/70 p-6 text-left">
              <h2 class="text-base font-bold">If Flow does not pick it up</h2>
              <p class="mt-3 text-sm leading-relaxed text-text-muted">
                Give it a moment first. Flow checks for a new licence every few seconds
                after a purchase, and a payment can take a short while to clear.
              </p>
              <p class="mt-3 text-sm leading-relaxed text-text-muted">
                We also email your licence file. If you ever need it, open Flow, go to
                Settings, then Billing, and choose Add licence.
              </p>
            </div>

            <p class="mt-8 text-sm text-text-dim">
              A receipt is on its way to the address you paid with.
            </p>
          </>
        ) : (
          <p class="mt-6 text-lg leading-[1.55] text-text-muted">
            Flow Pro is not on sale yet. If you reached this page by accident, nothing
            was charged.
          </p>
        )}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

{ORIONFOLD_FLOW_LIVE && (
  <script is:inline>
    // The deep link is offered ONLY when this page was reached from a real
    // checkout, so the button can never appear on a bare visit to the URL.
    //
    // The claim itself is NOT in the URL this page receives; only the session id
    // is. That is deliberate: the session id is already visible in the address
    // bar and is not secret, whereas a claim on a channel another app could
    // register should not sit in browser history. The app exchanges the session
    // id for its licence over the polling path it already runs.
    (function () {
      var params = new URLSearchParams(window.location.search);
      var session = params.get('session_id');
      if (!session || session.indexOf('cs_') !== 0) return;

      var wrap = document.getElementById('flow-open');
      var link = document.getElementById('flow-open-link');
      if (!wrap || !link) return;

      link.setAttribute('href', 'orionfold-flow://licence?session=' + encodeURIComponent(session));
      wrap.classList.remove('hidden');
    })();
  </script>
)}
