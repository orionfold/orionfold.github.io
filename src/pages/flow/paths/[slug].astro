---
// /flow/paths/<slug>/ — one Flow 2.0 path, walked end to end by the product
// lane. The body is the lane's article, verbatim (scripts/sync-flow-paths.mjs);
// the hero, the receipt rail and the CTA are the website's.
import { render } from 'astro:content';
import { FLOW_VERSION, flowName } from '../../../lib/flow/flow-release';
import { fitTitle, fitDescription } from '../../../lib/flow/seo-meta';
import { Image } from 'astro:assets';
import PaperLayout from '../../../layouts/PaperLayout.astro';
import PaperLongform from '../../../components/paper/PaperLongform.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import PaperCta from '../../../components/ui/PaperCta.astro';
import PathShowcase from '../../../components/flow/mocks/PathShowcase.astro';
import { publishedPaths, pathHref, EVIDENCE_NOTE, type PathEntry } from '../../../lib/flow/paths';
import { flowPathOgSlug, ogPath } from '../../../data/og';
import { SITE, PERSON, PUBLISHER } from '../../../data/seo';
import '../../../styles/living-base.css';
import '../../../styles/essays.css';
import '../../../styles/flow-paths.css';
import '../../../styles/living-in-paper.css';
import '../../../styles/paper-bridge-catalog.css';

export async function getStaticPaths() {
  const paths = await publishedPaths();
  return paths.map((entry) => ({ params: { slug: entry.id }, props: { entry, others: paths.filter((p) => p.id !== entry.id) } }));
}

const { entry, others } = Astro.props as { entry: PathEntry; others: PathEntry[] };
const { Content, headings } = await render(entry);
const d = entry.data;
const sections = headings.filter((h) => h.depth === 2);
const evidenceSection = sections.find((h) => /^(Evidence|The numbers)$/.test(h.text));
// Name the current release: readers open the path in it. The dev build
// each walk ran on is spelled out in full on the "Walked on:" line below.
const release = d.release ?? FLOW_VERSION;
const dateIso = d.drafted.toISOString().slice(0, 10);
const minutes = Math.max(1, Math.ceil((entry.body ?? '').split(/\s+/).filter(Boolean).length / 230));
const canonical = `${SITE.url}${pathHref(entry.id)}`;
const ogImage = ogPath(flowPathOgSlug(entry.id));
const description = fitDescription(d.summary);
const seoTitle = fitTitle(`${d.title} · Flow Paths · Orionfold`, `${d.path} · Flow Paths · Orionfold`);
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Article',
    headline: d.title, description: d.dek,
    datePublished: `${dateIso}T00:00:00.000Z`, dateModified: `${dateIso}T00:00:00.000Z`,
    author: PERSON, publisher: PUBLISHER,
    mainEntityOfPage: canonical, url: canonical,
    image: `${SITE.url}${ogImage}`,
    about: { '@type': 'SoftwareApplication', name: 'Orionfold Flow', operatingSystem: 'macOS', softwareVersion: release },
    isPartOf: { '@type': 'CollectionPage', name: 'Flow Paths', url: `${SITE.url}/flow/paths/` },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Flow', item: `${SITE.url}/flow/` },
      { '@type': 'ListItem', position: 2, name: 'Paths', item: `${SITE.url}/flow/paths/` },
      { '@type': 'ListItem', position: 3, name: d.path, item: canonical },
    ],
  },
];
---
<PaperLayout title={seoTitle} description={description} ogImage={ogImage} ogImageAlt={`${d.path}, a Flow path walked end to end`} ogType="article" jsonLd={schema} article={{ datePublished: dateIso, dateModified: dateIso, author: 'Manav Sehgal', section: 'Flow Paths', tags: [flowName(release), d.chip, d.path] }}>
  <Nav />
  <main id="main" class="pp-page">
    <PaperLongform
      crumb={{ href: '/flow/paths/', label: 'All paths' }}
      kicker={`${flowName(release)} path / ${d.chip}${d.persona !== d.chip ? ` · ${d.persona}` : ''}`}
      title={d.title} dek={d.dek} published={d.drafted} minutes={minutes} headings={sections}
      magnet={false} bodyClass="ed-page ed-article-page fp-page fp-longform">
      <div slot="lead" class="pp-long-lead">
        {d.caveat && <p class="pp-article-note fp-caveat"><b>On the released build:</b> {d.caveat}</p>}
        <p><a class="pp-btn pp-btn--ghost" href="#try-this-path">Try this path ↓</a></p>
      </div>
      <figure slot="figure" class="ls-article-figure fp-heroshot"><Image src={d.hero} alt={d.heroAlt} widths={[800, 1200, 1600, 2400]} sizes="(max-width: 940px) 100vw, 900px" loading="eager" fetchpriority="high" /></figure>

      <Content />
      <div class="fp-colophon">
        <p><strong>Walked on:</strong> {d.build}.</p>
        <p><strong>Data:</strong> {d.data}</p>
        <p>Written by the Flow product team from the walk's own records. Numbers are labelled verified, derived, assumed or unknown.</p>
      </div>
      <div id="try-this-path">
        <PaperCta layout="article" class="ed-paper-cta"
          source={`flow-path-${entry.id}`} headingId="path-cta"
          eyebrow="TRY THIS PATH IN FLOW" heading={d.onHome ? `Open “${d.path}” on your Mac.` : `Start “${d.path}” on your Mac.`}
          description={d.startInstructions ?? (d.onHome
            ? `In ${flowName(release)}, Home ▸ ${d.chip} ▸ ${d.path} ▸ Open. Your copy lands in a folder of its own, with the example files to try it on.`
            : `In ${flowName(release)}, open an empty folder, choose it in the sidebar, and tell Flow Chat your idea. The steps above show each message we sent.`)} />
      </div>

      <div slot="rail" class="pp-rail-block fp-receipt">
        <p class="pp-kicker">The receipt</p>
        <dl>
          {d.receipt.map((r) => (
            <div><dt>{r.label}</dt><dd>{r.value}<span class:list={['fp-tag', `fp-tag--${r.evidence}`]} title={EVIDENCE_NOTE[r.evidence]}>{r.evidence}</span></dd></div>
          ))}
        </dl>
        <p class="fp-receipt-note">Every number carries a label. {evidenceSection && <><a href={`#${evidenceSection.slug}`}>See the full evidence table</a>.</>}</p>
        <a class="fp-try" href="#try-this-path">Try this path in Flow →</a>
      </div>

      {others.length > 0 && (
        <section slot="after" class="fp-section fp-after ls ls-in-paper" aria-labelledby="more-paths">
          <div class="fp-head"><div class="fp-heading"><p class="ls-eyebrow">MORE PATHS</p><h2 id="more-paths">Another job,<br /><span class="ls-stroke">walked the same way.</span></h2></div><a class="fp-all" href="/flow/paths/">All paths →</a></div>
          <div class="ps-grid">{others.slice(0, 3).map((p) => <PathShowcase entry={p} />)}</div>
        </section>
      )}
    </PaperLongform>
  </main>
  <Footer showDownload={false} />
</PaperLayout>
