---
// /flow/compare/ — every Compare page.
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import CompareBand from '../../../components/flow/paths/CompareBand.astro';
import CompareTable from '../../../components/flow/paths/CompareTable.astro';
import PathShowcase from '../../../components/flow/mocks/PathShowcase.astro';
import PaperCta from '../../../components/ui/PaperCta.astro';
import { publishedCompare, publishedPaths, compareHref } from '../../../lib/flow/paths';
import { publishedDomainArticles, domainArticleHref } from '../../../lib/flow/domains';
import { ogMeta } from '../../../data/og';
import { SITE, PERSON } from '../../../data/seo';
import '../../../styles/living-base.css';
import '../../../styles/essays.css';
import '../../../styles/flow-paths.css';

const pages = await publishedCompare();
const paths = await publishedPaths();
// Each page names the path to start with; show each such path once.
const starts = [...new Set(pages.map((p) => p.data.startWith))].map((id) => paths.find((p) => p.id === id)).filter((p) => p !== undefined);
// A page can start from a Domain instead (Custom GPTs and Projects).
const domains = await publishedDomainArticles();
const domainStarts = [...new Set(pages.map((p) => p.data.startWith))].map((id) => domains.find((a) => a.id === id)).filter((a) => a !== undefined);
const startFor = (id: string) => pages.filter((p) => p.data.startWith === id).map((p) => p.data.tool);
const groups = [
  { kind: 'switch', eyebrow: 'SWITCH', heading: 'Move one job.', stroke: 'Keep the rest.', text: 'Coming from a notes app or a custom AI. Move one job you do again and again, and keep the tool for everything else. What moves, what stays the same, and what you give up.' },
  { kind: 'pair', eyebrow: 'PAIR', heading: 'Use both.', stroke: 'Each does its part.', text: 'Flow works beside the agent, writing app or design tool you already pay for. It does not replace them.' },
].map((g) => ({ ...g, pages: pages.filter((p) => p.data.kind === g.kind) })).filter((g) => g.pages.length > 0);
const rowCount = pages.reduce((n, p) => n + p.data.rows.length, 0);
const sourceCount = new Set(pages.flatMap((p) => p.data.rows.map((r) => r.source?.href).filter(Boolean))).size;
const lastChecked = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(Math.max(...pages.map((p) => p.data.updated.getTime()))));
// What holds on every page, in the pages' own words.
const notFlow = [
  'Flow is a Mac app only. There is no Windows, Linux, phone or web version.',
  'Flow is not a coding agent. It works beside Claude Code and Codex, and does not replace them.',
  'Flow is built for one person reviewing AI work, not for many people editing one page at once.',
  'Flow does not check your docs against your code. It proofreads and drafts prose, and you approve each change.',
  'The AI features need Flow Pro once your 10 Pro Days are used. Reading, writing and saving Markdown stays free.',
];
const title = 'Flow vs Notion, Obsidian, Custom GPTs, Word and agents | Orionfold';
const description = 'Pick one job you redo often. See how it goes in the tool you use now, your real choices, and what Flow adds, with a dated source for every claim.';
const og = ogMeta('/flow/compare/');
const schema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Compare', description, url: `${SITE.url}/flow/compare/`, author: PERSON,
  mainEntity: { '@type': 'ItemList', itemListElement: pages.map((p, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Article', name: p.data.title, url: `${SITE.url}${compareHref(p.id)}` } })) },
};
---
<Layout title={title} description={description} ogImage={og.image} ogImageAlt={og.alt} bodyClass="ls ed-page ed-hub-page fp-page" jsonLd={schema}>
  <Nav />
  <main id="main" class="ls-main">
    <header class="ed-hub-intro ls-container">
      <p class="ls-eyebrow">FLOW / COMPARE</p>
      <div class="ed-hub-heading">
        <h1>Bring the work.<br /><em>Keep your tools.</em></h1>
        <p>Start from one job you do again and again. That might be a monthly brief, an investor update, a launch post or an agent's edit. Each page shows that job in the tool you use now, your real choices, including staying put, what Flow adds, and what Flow is not.</p>
      </div>
    </header>
    <section class="ls-container" aria-label="Compare">
      <CompareBand headingLevel="h2" />
      <ul class="fc-facts" aria-label="How these pages are checked">
        <li><b>{pages.length}</b>tools compared</li>
        <li><b>{rowCount}</b>topics, side by side</li>
        <li><b>{sourceCount}</b>sources, each one dated</li>
        <li><b>{lastChecked}</b>sources last checked</li>
      </ul>
    </section>
    {groups.map((g) => (
      <section class="fp-section ls-container" aria-labelledby={`fc-${g.kind}`}>
        <div class="fp-head"><div class="fp-heading"><p class="ls-eyebrow">{g.eyebrow}</p><h2 id={`fc-${g.kind}`}>{g.heading}<br /><span class="ls-stroke">{g.stroke}</span></h2><p>{g.text}</p></div></div>
        {g.pages.map((p) => (
          <article class="fc-tool" aria-labelledby={`fc-tool-${p.id}`}>
            <div class="fc-tool-head">
              <div>
                <p class="fp-kind">{p.data.kind === 'switch' ? 'Switch from' : 'Pair with'} {p.data.tool}</p>
                <h3 id={`fc-tool-${p.id}`}>{p.data.tool}</h3>
                <p>{p.data.dek}</p>
              </div>
              <a class="fp-all" href={compareHref(p.id)}>Full comparison, {p.data.rows.length} topics →</a>
            </div>
            <CompareTable entry={p} limit={3} />
          </article>
        ))}
      </section>
    ))}
    {starts.length > 0 && (
      <section class="fp-section ls-container" aria-labelledby="fc-start">
        <div class="fp-head"><div class="fp-heading"><p class="ls-eyebrow">START WITH A PATH</p><h2 id="fc-start">Don’t take our word.<br /><span class="ls-stroke">Watch it walked.</span></h2><p>Most Compare pages name the path that shows Flow’s side. We walked every step on a Mac and wrote down the time and the cost. Where we have not walked a tool, its page says so.</p></div><a class="fp-all" href="/flow/paths/">All paths →</a></div>
        <div class="ps-grid">
          {starts.map((p) => (
            <div class="fc-start">
              <p class="fp-kind">For {startFor(p.id).join(' and ')} users</p>
              <PathShowcase entry={p} headingLevel="h3" />
            </div>
          ))}
        </div>
        {domainStarts.map((a) => (
          <p class="fc-domain-start"><span class="fp-kind">For {startFor(a.id).join(' and ')} users</span> Start with the <a href={domainArticleHref(a.id)}>{a.data.domain}</a> Domain. Read how it was built in Flow, published to GitHub and brought in by a reader.</p>
        ))}
      </section>
    )}
    <section class="fp-section ls-container" aria-labelledby="fc-not">
      <div class="fp-head"><div class="fp-heading"><p class="ls-eyebrow">WHAT FLOW IS NOT</p><h2 id="fc-not">Know the limits<br /><span class="ls-stroke">before you move.</span></h2><p>These hold on every page. Each page adds the limits for its own tool.</p></div></div>
      <ol class="fc-not">{notFlow.map((n) => <li>{n}</li>)}</ol>
    </section>
    <div class="ls-container" style="padding-block:24px 88px">
      <PaperCta source="flow-compare-index" eyebrow="EVERY CLAIM HAS A SOURCE" heading="See the work, not the pitch." description="Each page links a real Flow path that shows its side of the comparison. Start there." href="/flow/paths/" label="Browse the paths" />
    </div>
  </main>
  <Footer showDownload={false} />
</Layout>
