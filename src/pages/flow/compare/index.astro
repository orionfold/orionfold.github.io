---
// /flow/compare/ — every Compare page.
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import CompareBand from '../../../components/flow/paths/CompareBand.astro';
import PaperCta from '../../../components/ui/PaperCta.astro';
import { publishedCompare, compareHref } from '../../../lib/flow/paths';
import { ogMeta } from '../../../data/og';
import { SITE, PERSON } from '../../../data/seo';
import '../../../styles/living-base.css';
import '../../../styles/essays.css';
import '../../../styles/flow-paths.css';

const pages = await publishedCompare();
const title = 'Compare Flow with Notion, Obsidian, Claude Code and Codex | Orionfold';
const description = 'Coming to Flow from another tool? What moves, what stays, and the path to start with, with a dated source for every claim.';
const og = ogMeta('/flow/compare/');
const schema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Compare', description, url: `${SITE.url}/flow/compare/`, author: PERSON,
  mainEntity: { '@type': 'ItemList', itemListElement: pages.map((p, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Article', name: p.data.title, url: `${SITE.url}${compareHref(p.id)}` } })) },
};
---
<Layout title={title} description={description} ogImage={og.image} ogImageAlt={og.alt} bodyClass="ls ed-page ed-hub-page fp-page" jsonLd={schema}>
  <Nav />
  <main id="main" class="ls-main">
    <header class="ed-hub-intro ls-container">
      <p class="ls-eyebrow">FLOW 2.0 / COMPARE</p>
      <div class="ed-hub-heading">
        <h1>Bring the work.<br /><em>Keep your tools.</em></h1>
        <p>Moving from a notes app, or pairing Flow with the coding agent you already pay for. Each page says what moves, what stays, and what Flow is not.</p>
      </div>
    </header>
    <section class="ls-container" aria-label="Compare"><CompareBand headingLevel="h2" /></section>
    <div class="ls-container" style="padding-block:72px 88px">
      <PaperCta source="flow-compare-index" eyebrow="EVERY CLAIM HAS A SOURCE" heading="See the work, not the pitch." description="Each page links a real Flow path that shows its side of the comparison. Start there." href="/flow/paths/" label="Browse the paths" />
    </div>
  </main>
  <Footer showDownload={false} />
</Layout>
