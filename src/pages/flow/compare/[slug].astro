---
// /flow/compare/<slug>/ — how Flow sits next to a tool the reader already uses.
// Every claim about the other tool carries a dated source; every row links the
// path that proves Flow's side.
import { render } from 'astro:content';
import { FLOW_VERSION } from '../../../lib/flow/flow-release';
import { fitTitle, fitDescription } from '../../../lib/flow/seo-meta';
import PaperLayout from '../../../layouts/PaperLayout.astro';
import PaperLongform from '../../../components/paper/PaperLongform.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import PaperCta from '../../../components/ui/PaperCta.astro';
import PathShowcase from '../../../components/flow/mocks/PathShowcase.astro';
import CompareTable from '../../../components/flow/paths/CompareTable.astro';
import { publishedCompare, publishedPaths, compareHref, type CompareEntry } from '../../../lib/flow/paths';
import { publishedDomainArticles, domainArticleHref } from '../../../lib/flow/domains';
import { compareOgSlug, ogPath } from '../../../data/og';
import { SITE, PERSON, PUBLISHER } from '../../../data/seo';
import '../../../styles/living-base.css';
import '../../../styles/essays.css';
import '../../../styles/flow-paths.css';
import '../../../styles/living-in-paper.css';
import '../../../styles/paper-bridge-catalog.css';
import { flowTermsHtml } from '../../../lib/flow/flow-terms.mjs';
import { FLOW_DMG_URL, FLOW_SYSTEM_REQUIREMENT } from '../../../data/flow-pricing';
import { ORIONFOLD_FLOW_LIVE } from '../../../data/launch';

export async function getStaticPaths() {
  const pages = await publishedCompare();
  return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CompareEntry };
const { Content, headings } = await render(entry);
const d = entry.data;
const paths = await publishedPaths();
const start = paths.find((p) => p.id === d.startWith);
// A page can start from a Playbook instead of a path (Custom GPTs and Projects).
const startDomain = start ? undefined : (await publishedDomainArticles()).find((a) => a.id === d.startWith);
const dateIso = d.updated.toISOString().slice(0, 10);
const minutes = Math.max(1, Math.ceil((entry.body ?? '').split(/\s+/).filter(Boolean).length / 230));
const canonical = `${SITE.url}${compareHref(entry.id)}`;
const ogImage = ogPath(compareOgSlug(entry.id));
const seoTitle = fitTitle(`${d.title} · Orionfold`, `Flow ${d.kind === 'switch' ? 'vs' : 'with'} ${d.tool} · Compare · Orionfold`);
const seoDescription = fitDescription(d.dek);
const sections = [
  ...(d.quickStart ? [{ slug: 'quick-start', text: d.quickStart.title, depth: 2 }] : []),
  { slug: 'side-by-side', text: 'Side by side', depth: 2 },
  ...headings.filter((h) => h.depth === 2),
  { slug: 'what-flow-is-not', text: 'What Flow is not', depth: 2 },
  { slug: 'sources', text: 'Sources', depth: 2 },
];
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Article',
    headline: d.title, description: d.dek,
    datePublished: `${dateIso}T00:00:00.000Z`, dateModified: `${dateIso}T00:00:00.000Z`,
    author: PERSON, publisher: PUBLISHER, mainEntityOfPage: canonical, url: canonical,
    image: `${SITE.url}${ogImage}`,
    about: [{ '@type': 'SoftwareApplication', name: 'Orionfold Flow', operatingSystem: 'macOS' }, { '@type': 'SoftwareApplication', name: d.tool }],
    citation: d.sources.map((s) => s.href),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Flow', item: `${SITE.url}/flow/` },
      { '@type': 'ListItem', position: 2, name: 'Compare', item: `${SITE.url}/flow/compare/` },
      { '@type': 'ListItem', position: 3, name: `Flow and ${d.tool}`, item: canonical },
    ],
  },
];
---
<PaperLayout title={seoTitle} description={seoDescription} ogImage={ogImage} ogImageAlt={`Flow compared with ${d.tool}: what moves, what stays, and the path to start with`} ogType="article" jsonLd={schema} article={{ datePublished: dateIso, dateModified: dateIso, author: 'Manav Sehgal', section: 'Compare', tags: [`Flow ${FLOW_VERSION}`, d.tool] }}>
  <Nav />
  <main id="main" class="pp-page">
    <PaperLongform
      crumb={{ href: '/flow/compare/', label: 'Compare' }}
      kicker={`${d.tool} · ${d.kind === 'switch' ? 'Switch' : 'Pair'} · Sources checked`}
      title={d.title} dek={d.dek} updated={d.updated} minutes={minutes} headings={sections}
      magnet={false} bodyClass="ed-page ed-article-page fp-page fp-longform">
      <p slot="lead" class="pp-long-lead"><a class="pp-btn pp-btn--ghost" href={d.quickStart ? '#quick-start' : '#try-flow'}>Try Flow ↓</a></p>

      {d.quickStart && (
        <section id="quick-start" class="compare-quick-start" aria-labelledby="compare-quick-start-title">
          <h2 id="compare-quick-start-title">{d.quickStart.title}</h2>
          <p>{d.quickStart.description}</p>
          <p>{FLOW_SYSTEM_REQUIREMENT}. Markdown editing stays free. Try the AI features with 10 Pro Days. Flow Pro costs $10 a month or $96 a year.</p>
          {ORIONFOLD_FLOW_LIVE && <a class="pp-btn" href={FLOW_DMG_URL} data-flow-download={`flow-compare-${entry.id}-example`}>Download Flow for Mac</a>}
        </section>
      )}

      <h2 id="side-by-side">Side by side</h2>
      <CompareTable entry={entry} />
      <Content />
      {start && <div class="fp-start"><PathShowcase entry={start} /></div>}
      <h2 id="what-flow-is-not">What Flow is not</h2>
      <ul class="fp-not">{d.notFlow.map((n) => <li set:html={flowTermsHtml(n)} />)}</ul>
      <h2 id="sources">Sources</h2>
      <ul class="fp-not">{d.sources.map((s) => <li><a href={s.href} rel="noopener">{s.label}</a>, checked {s.checked}</li>)}</ul>
      <div id="try-flow">
        <PaperCta layout="article" class="ed-paper-cta" source={`flow-compare-${entry.id}`} headingId="flow-compare-cta"
          eyebrow={`FOR ${d.tool.toUpperCase()} USERS`} heading={start ? `Start with “${start.data.path}.”` : startDomain ? `Start with “${startDomain.data.domain}.”` : 'Try Flow on your Mac.'}
          description={startDomain ? `Read how ${startDomain.data.domain} was built in Flow, then bring it in with File ▸ New from GitHub… and try its method on your own work.` : 'Download Flow, open a path on Home, and try it on the example files first. Your documents stay plain files on your Mac.'}
          {...(startDomain ? { href: domainArticleHref(startDomain.id), label: 'Read how it was built' } : {})} />
      </div>
    </PaperLongform>
  </main>
  <Footer showDownload={false} />
</PaperLayout>

<style>
  .compare-quick-start {
    padding: clamp(16px, 4vw, 28px);
    border: 1px solid var(--pp-line);
    border-radius: var(--pp-r-2);
    background: var(--pp-paper-2);
    scroll-margin-top: calc(var(--of-nav-height, 102px) + 16px);
  }
  .compare-quick-start h2 { margin-top: 0; }
  .compare-quick-start a.pp-btn { margin-top: 12px; }
  .compare-quick-start a.pp-btn,
  .compare-quick-start a.pp-btn:hover { color: var(--pp-white); }
</style>
