---
import FlowFeaturePage from '../../components/flow/FlowFeaturePage.astro';
import FlowDetail from '../../components/flow/FlowDetail.astro';
import { FLOW_V16_SHOTS as shots } from '../../data/flow-v16';
const sections = [
  { id: 'general', name: 'General', title: 'The essentials, together.', body: 'Your plan, licence, app updates, the Flow Guide and privacy controls live in General. App updates are not tied to a paid subscription; security fixes remain available if it lapses.', detail: 'Find compatible models already on this Mac, and control Web Lookups. Web Lookups starts off. When enabled, a lookup requests a page; words from the document may appear in its address and be visible to that site.', image: shots.settingsPrivacy, alt: 'General shows local model discovery and Web Lookups switched off.' },
  { id: 'documents', name: 'Documents', title: 'Find it. Write it. Save it.', body: 'Choose text or related search results and where they open. Set automatic saving, then use the same dictation controls across editors.', detail: 'Automatic saving waits five seconds after you stop typing. Command-S still works. Dictation stays on this Mac, with controls for punctuation, emoji names and strong language.', image: shots.settingsDocuments, alt: 'Documents settings shows search results, saving and dictation controls.' },
  { id: 'models', name: 'Models', title: 'Start with the Mac you have.', body: 'See this Mac, the model Flow would use and the rule behind that choice. Models brings providers, cost, storage and local measurements into one place.', detail: 'Compatible models found through Ollama or LM Studio are shared with Flow Runtime when discovery checks them. Manage models distinguishes those shared files from downloads that count toward Flow’s storage allowance. Cloud providers are enabled by a key and bill their own token use.', image: shots.settingsLibrary, alt: 'Manage models lists one downloaded model and models shared from Ollama and LM Studio, with a storage allowance.' },
  { id: 'smart-routing', name: 'Smart Routing', title: 'Know why that model was picked.', body: 'One sentence names the model and the deciding rule. Start with Flow’s tuning or open Customize to change the ordered rules and providers.', detail: 'The first rule that fits the request decides. Flow Runtime comes first in the default provider order. You can reset to Flow’s tuning or choose the model yourself.', image: shots.settingsRouting, alt: 'Smart Routing lists six ordered rules and marks the deciding rule.' },
  { id: 'evidence', name: 'Evidence', title: 'Make the checks visible.', body: 'Five weighted questions cover factual support, the outcome, reasoning, reader clarity and presentation. Open Customize to change those weights.', detail: 'Three checks are shown separately: citations resolve, references are current and human review. Their effects are explicit: a stop, a warning or a required acknowledgment.', image: shots.settingsEvidence, alt: 'Evidence settings shows five weighted questions and three separate checks.' },
  { id: 'night-shift', name: 'Night Shift', title: 'Set the hours. Keep the controls.', body: 'Choose tonight’s window, catch up on wake and decide whether bound charts and tables redraw as data changes. The readiness line tells you whether this Mac is ready.', detail: 'Runs tonight works when the Mac is plugged in and idle, even with Flow closed. Use Run now to watch progress and open the Morning Briefing to review the result.', image: shots.nightSettings, alt: 'Night Shift settings shows the schedule and readiness for background work.' },
];
---
<FlowFeaturePage slug="settings" title="Flow Settings · Six clear screens for your Mac and AI · Orionfold" description="Explore Flow 1.6 Settings: General, Documents, Models, Smart Routing, Evidence and Night Shift. See the choices behind your document work.">
  <section class="flow-feature-section"><div class="flow-feature-inner"><p class="of-eyebrow">A smaller map</p><h2 class="of-display">Six screens. Every choice still here.</h2><p class="mt-6 max-w-3xl text-lg leading-relaxed text-text-muted">Flow 1.6 brings eleven Settings screens into six. Billing moves into General, editors into Documents, cost and benchmarks into Models, and guardrails into Evidence.</p><nav class="mt-8 flex flex-wrap gap-5" aria-label="Settings screens">{sections.map((section) => <a class="of-text-action" href={`#${section.id}`}>{section.name} <span aria-hidden="true">→</span></a>)}</nav></div></section>
  {sections.map((section, index) => <section class="flow-feature-section scroll-mt-28" id={section.id}><div class:list={['flow-feature-inner flow-feature-grid', index % 2 === 1 && 'flow-feature-grid--reverse']}><div class="flow-feature-copy"><p class="of-eyebrow">0{index + 1} · {section.name}</p><h2 class="of-display">{section.title}</h2><p>{section.body}</p><p>{section.detail}</p></div><FlowDetail src={section.image} alt={section.alt} caption={`Real Flow 1.6 (1899) · ${section.name} detail · September 6, 2026`} /></div></section>)}
</FlowFeaturePage>
