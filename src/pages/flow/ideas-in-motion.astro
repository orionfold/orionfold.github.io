---
// Private campaign-review route. Unlike a normal /story/ entry, this page is
// not part of the content collection, RSS, story index, or sitemap discovery.
// It exists only in builds that deliberately opt into the Flow Ideas campaign.
// R8 (G-147): a Paper page. The Living pit-stop hero and PaperCta gave way to
// a Paper hero, a Panel of the four beats and a pp-closing with the download.
import PaperLayout from '../../layouts/PaperLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Panel from '../../components/paper/Panel.astro';
import Fold from '../../components/paper/Fold.astro';
import FlowDownloadCta from '../../components/flow/FlowDownloadCta.astro';
import '../../styles/living-in-paper.css';
import { ORIONFOLD_FLOW_IDEAS_CAMPAIGN, ORIONFOLD_FLOW_LIVE } from '../../data/launch.ts';

if (!ORIONFOLD_FLOW_IDEAS_CAMPAIGN) {
  return Astro.redirect('/flow/', 302);
}

const beats = [
  {
    number: '01',
    kicker: 'Frame the work',
    title: 'One outcome. Your judgment.',
    body: 'Name the outcome and the boundaries. Flow keeps the document, its context, and its rules together so the next step has somewhere to begin.',
  },
  {
    number: '02',
    kicker: 'Organize the context',
    title: 'Make the thinking visible before the work begins.',
    body: 'Ideas makes a plan legible before any specialist runs. Inspect the suggested work, the evidence it will use, and what needs your approval.',
  },
  {
    number: '03',
    kicker: 'Specialist craft',
    title: 'The right specialist for each move.',
    body: 'Each specialist has a narrow job. One checks structure. Another checks evidence. Another checks presentation. They propose changes for you to review.',
  },
  {
    number: '04',
    kicker: 'Release',
    title: 'Your decision develops the work.',
    body: 'Approve the result and keep its record with the document. The next visit starts with the context of what changed and who decided.',
  },
];
---
<PaperLayout
  title="Flow Ideas in motion · Orionfold"
  description="Turn ideas into living documents: frame the outcome, organize the context, inspect a proposal, and develop the work with Flow."
  noindex={true}
>
  <Nav />
  <main id="main" class="pp-page">
    <section class="pp-hero pp-hero--inner pp-hero--solo" aria-labelledby="flow-ideas-story-hero-title">
      <div class="pp-hero-copy">
        <p class="pp-kicker">Flow capabilities · A living practice</p>
        <h1 id="flow-ideas-story-hero-title" class="pp-h1">Give the next idea somewhere to land.</h1>
        <p class="pp-sub">Ideas turns the work in front of you into clear, inspectable moves. You choose what runs, what changes, and when the document is ready.</p>
      </div>
    </section>

    <Panel id="flow-ideas-story-arc" seam="The launch story" fold="orri" title="Good work deserves<br />a second chapter." lede="A living practice connects intention, context, action, and reflection. Flow Ideas makes the next move visible while the document keeps the thread.">
      <ol class="pp-rows" aria-label="Four beats in the Flow Ideas launch story">
        {beats.map((beat) => (
          <li class="pp-row">
            <small>{beat.number} · {beat.kicker}</small>
            <div><strong>{beat.title}</strong><span>{beat.body}</span></div>
          </li>
        ))}
      </ol>
    </Panel>

    <section class="pp-closing" aria-labelledby="flow-ideas-story-control-title">
      <Fold id="tally" live class="pp-closing-fold" />
      <p class="pp-kicker">The point of the practice</p>
      <h2 id="flow-ideas-story-control-title">More possibility. Your judgment stays central.</h2>
      <p>Flow makes the work inspectable: the source, the proposal, the approval, and the record. You keep the authority to decide what belongs in the document.</p>
      <p>The work can grow through research, writing, and revision without losing its context. Each return becomes a chance to refine it and carry the useful parts forward.</p>
      {ORIONFOLD_FLOW_LIVE ? (
        <div class="ls-in-paper ls-done-cta pp-done-actions">
          <FlowDownloadCta source="ideas-in-motion" secondaryHref="/flow/" secondaryLabel="See the real Flow product" align="center" />
        </div>
      ) : (
        <div class="pp-done-actions"><a class="pp-btn" href="/flow/">See the real Flow product <span aria-hidden="true">→</span></a></div>
      )}
    </section>
  </main>
  <Footer showDownload={false} />
</PaperLayout>
