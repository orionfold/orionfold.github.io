---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import FlowSubNav from '../../components/flow/FlowSubNav.astro';
import Footer from '../../components/Footer.astro';
import FlowWaitlist from '../../components/sections/FlowWaitlist.astro';
import { SITE } from '../../data/seo';
import { ogMeta } from '../../data/og';
import { FLOW_ENTERPRISE } from '../../data/flow-enterprise';
import '../../styles/flow.css';

const href = '/flow/enterprise/';
const og = ogMeta(href);
const flowStoryHref = '/story/the-day-i-stopped-trusting-invisible-edits/';
const shippedCount = FLOW_ENTERPRISE.filter((pattern) => pattern.tag === 'Today').length;
const groups = [
  {
    eyebrow: 'Control',
    title: 'Set the boundary before AI runs.',
    body: 'Folders define the files in scope. Execution domains define where work may run. Ordered rules choose from the models allowed inside that boundary.',
    keys: ['Data classification', 'Guardrails', 'Routing'],
  },
  {
    eyebrow: 'Verify',
    title: 'Make every decision inspectable.',
    body: 'Exact diffs preserve human approval. Evidence states what was measured. Receipts bind the model, route, cost, checks, and saved bytes to one run.',
    keys: ['Attribution', 'Evidence', 'Allocation'],
  },
  {
    eyebrow: 'Learn',
    title: 'Keep the work as the record.',
    body: 'Plain files remain authoritative. Approved work can become structured knowledge without a hidden observation system or a second database to reconcile.',
    keys: ['Curation', 'System of record', 'Knowledge mining'],
  },
];
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Flow', item: `${SITE.url}/flow/` },
    { '@type': 'ListItem', position: 3, name: 'Enterprise', item: `${SITE.url}${href}` },
  ],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FLOW_ENTERPRISE.map((pattern) => ({
    '@type': 'Question',
    name: pattern.q,
    acceptedAnswer: { '@type': 'Answer', text: pattern.a },
  })),
};
---
<Layout
  title="Flow for enterprise · Govern AI in the document · Orionfold"
  description="Orionfold Flow puts AI scope, routing, approval, evidence, and cost inside the document, then keeps an inspectable receipt for every approved run."
  ogImage={og.image}
  ogImageAlt={og.alt}
  jsonLd={[breadcrumbs, faqSchema]}
>
  <Nav />
  <FlowSubNav active="enterprise" />
  <main class="flow-page flow-page--category -mt-20 overflow-x-clip sm:-mt-24">
    <section class="flow-hero relative px-6 pb-14 pt-32 sm:pt-40">
      <div class="flow-hero__grid" aria-hidden="true"></div>
      <div class="flow-hero__glow" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-4xl text-center">
        <p class="of-eyebrow">Flow for enterprise</p>
        <h1 class="hero-gradient-text mx-auto mt-4 max-w-3xl font-display text-[clamp(2.3rem,5.6vw,3.8rem)] font-extrabold leading-[1.06] tracking-[-0.05em]">Govern AI where the work happens.</h1>
        <p class="mx-auto mt-6 max-w-2xl text-balance text-lg leading-[1.55] text-text-muted sm:text-xl">Flow puts scope, routing, approval, evidence, and cost inside the document. Every approved run leaves a receipt your team can inspect.</p>
        <p class="mx-auto mt-5 max-w-xl text-sm leading-relaxed text-text-dim">{shippedCount} adoption patterns are built and running today. Knowledge mining remains a clearly marked direction.</p>
      </div>
    </section>

    <section class="border-t border-border/70 px-6 py-14 sm:py-20" aria-labelledby="enterprise-system-heading">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <p class="flow-kicker">One governance system</p>
          <h2 id="enterprise-system-heading" class="of-display mt-4 text-[clamp(2rem,4.6vw,3.25rem)]">Control. Verify. Learn.</h2>
          <p class="mt-5 text-lg leading-relaxed text-text-muted">The record is created as work moves from a bounded request to an approved artifact. Governance is part of the path, not a report assembled later.</p>
        </div>
        <div class="mt-10 grid gap-4 lg:grid-cols-3" data-animate-stagger>
          {groups.map((group) => (
            <article class="of-surface rounded-2xl border border-border/70 p-6 sm:p-7" data-animate>
              <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-accent-ink">{group.eyebrow}</p>
              <h3 class="mt-3 text-xl font-bold leading-snug">{group.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-text-muted">{group.body}</p>
              <p class="mt-5 text-xs font-semibold leading-relaxed text-text-dim">{group.keys.join(' · ')}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-border/70 bg-surface-raised/35 px-6 py-14 sm:py-20" aria-labelledby="enterprise-proof-heading">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <p class="flow-kicker">The proof pattern</p>
          <h2 id="enterprise-proof-heading" class="of-display mt-4 text-[clamp(2rem,4.6vw,3.25rem)]">One run. Four inspectable decisions.</h2>
        </div>
        <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {[
            ['01', 'Scope', 'Which files may be read.'],
            ['02', 'Route', 'Where the model may run.'],
            ['03', 'Approve', 'What a person accepted.'],
            ['04', 'Receipt', 'What ran, changed, and cost.'],
          ].map(([number, title, body]) => (
            <li class="rounded-2xl border border-border/70 bg-surface p-5">
              <p class="font-mono text-xs text-primary">{number}</p>
              <h3 class="mt-3 text-lg font-bold">{title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-text-muted">{body}</p>
            </li>
          ))}
        </ol>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/flow/receipts/" class="of-primary-action">See Flow receipts <span aria-hidden="true">→</span></a>
          <a href="/flow/specifications/" class="of-secondary-action">Read Tech Specs</a>
        </div>
      </div>
    </section>

    <section class="border-t border-border/70 px-6 py-12 sm:py-16" aria-labelledby="enterprise-patterns-heading">
      <div class="mx-auto max-w-5xl">
        <details class="rounded-2xl border border-border/70 bg-surface px-6 py-2 sm:px-8">
          <summary id="enterprise-patterns-heading" class="cursor-pointer py-5 text-lg font-bold">Read the nine adoption patterns</summary>
          <div class="grid gap-4 pb-6 md:grid-cols-2">
            {FLOW_ENTERPRISE.map((pattern, index) => (
              <article class="rounded-xl border border-border/60 bg-surface-raised/35 p-5">
                <div class="flex items-center justify-between gap-3">
                  <p class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-accent-ink">{index + 1} · {pattern.k}</p>
                  <span class:list={['flow-ent-tag', pattern.tag === 'Direction' && 'flow-ent-tag--direction']}>{pattern.tag}</span>
                </div>
                <h3 class="mt-3 text-base font-bold leading-snug">{pattern.q}</h3>
                <p class="mt-3 text-sm leading-relaxed text-text-muted">{pattern.a}</p>
              </article>
            ))}
          </div>
        </details>
      </div>
    </section>

    <div id="waitlist" class="scroll-mt-24">
      <FlowWaitlist placement="flow-enterprise" storyHref={flowStoryHref} />
    </div>
  </main>
  <Footer />
</Layout>
