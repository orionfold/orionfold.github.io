---
// /flow/elements/<slug>/ — one article of the Elements set, walked by the
// product lane (scripts/sync-flow-elements.mjs). A category page opens on its
// element viewer, one element at a time; the article's framing (what Flow
// does, the steps, the numbers) follows it.
import { render } from 'astro:content';
import { fitTitle, fitDescription } from '../../../lib/flow/seo-meta';
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import PaperCta from '../../../components/ui/PaperCta.astro';
import ElementViewer from '../../../components/flow/elements/ElementViewer.astro';
import CategoryCards from '../../../components/flow/elements/CategoryCards.astro';
import { publishedElementArticles, elementArticleHref, elementItems, type ElementArticle } from '../../../lib/flow/elements';
import { flowElementsOgSlug, ogPath } from '../../../data/og';
import { SITE, PERSON, PUBLISHER } from '../../../data/seo';
import '../../../styles/living-base.css';
import '../../../styles/essays.css';
import '../../../styles/flow-paths.css';
import '../../../styles/flow-elements.css';

export async function getStaticPaths() {
  const articles = await publishedElementArticles();
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry, articles } }));
}

const { entry, articles } = Astro.props as { entry: ElementArticle; articles: ElementArticle[] };
const { Content, headings } = await render(entry);
const d = entry.data;
const items = await elementItems(entry.id);
const others = articles.filter((a) => a.id !== entry.id);
const sections = headings.filter((h) => h.depth === 2);
const dateIso = d.drafted.toISOString().slice(0, 10);
const dateLabel = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(d.drafted);
const canonical = `${SITE.url}${elementArticleHref(entry.id)}`;
const ogImage = ogPath(flowElementsOgSlug(entry.id));
const description = fitDescription(d.summary);
const seoTitle = fitTitle(`${d.title} · Flow Elements · Orionfold`, `${d.category} · Flow Elements · Orionfold`);
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Article',
    headline: d.title, description: d.dek,
    datePublished: `${dateIso}T00:00:00.000Z`, dateModified: `${dateIso}T00:00:00.000Z`,
    author: PERSON, publisher: PUBLISHER,
    mainEntityOfPage: canonical, url: canonical,
    image: `${SITE.url}${ogImage}`,
    about: { '@type': 'SoftwareApplication', name: 'Orionfold Flow', operatingSystem: 'macOS', softwareVersion: d.release },
    isPartOf: { '@type': 'CollectionPage', name: 'Flow Elements', url: `${SITE.url}/flow/elements/` },
    ...(items.length ? { hasPart: items.map((i) => ({ '@type': 'WebPageElement', name: i.data.name, description: i.data.line, url: `${canonical}#${i.data.anchor}` })) } : {}),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Flow', item: `${SITE.url}/flow/` },
      { '@type': 'ListItem', position: 2, name: 'Elements', item: `${SITE.url}/flow/elements/` },
      { '@type': 'ListItem', position: 3, name: d.category, item: canonical },
    ],
  },
];
---
<Layout title={seoTitle} description={description} ogImage={ogImage} ogImageAlt={`${d.title}, from Flow Elements`} ogType="article" bodyClass="ls ed-page ed-article-page fp-page fe-page" jsonLd={schema} article={{ datePublished: dateIso, dateModified: dateIso, author: 'Manav Sehgal', section: 'Flow Elements', tags: ['Flow', 'Elements', d.category] }}>
  <Nav />
  <main id="main" class="ls-main">
    <header class="ed-article-hero fp-hero fe-hero ls-container">
      <div class="ed-article-kicker"><a href="/flow/elements/">← All elements</a><span>FLOW ELEMENTS / {d.category.toUpperCase()}</span></div>
      <h1>{d.title}</h1>
      <p class="ed-article-dek">{items.length ? d.summary : d.dek}</p>
      <div class="ed-hero-bottom"><div class="ed-meta"><span>{items.length ? `${items.length} elements` : 'The tour'}</span><span>Walked on Flow</span><time datetime={dateIso}>{dateLabel}</time></div><div class="ed-reading-links"><a href="#how-it-works" class="ed-download-link">How it works ↓</a></div></div>
    </header>

    {items.length > 0
      ? <ElementViewer items={items} label={d.category} />
      : <section class="ls-container fe-tour-cats" aria-label="The four groups"><CategoryCards articles={others} /></section>}

    <div class="ed-reading-layout fp-layout fe-how ls-container" id="how-it-works">
      <aside class="ed-contents fp-rail" aria-label="Article contents">
        <details open>
          <summary>{items.length ? 'HOW IT WORKS' : 'IN THIS ARTICLE'}</summary>
          <nav aria-label="Sections">
            {sections.map((h, i) => <a href={`#${h.slug}`}><span>{String(i + 1).padStart(2, '0')}</span>{h.text}</a>)}
          </nav>
        </details>
        <a class="fp-try" href="#try-elements">Try it in Flow →</a>
      </aside>
      <article class="ed-prose fp-prose fe-prose" aria-label={d.title}>
        {items.length > 0 && <p class="fe-how-dek">{d.dek}</p>}
        <Content />
        <div class="fp-colophon">
          <p><strong>Walked on:</strong> {d.build}.</p>
          <p><strong>Data:</strong> {d.data}</p>
          <p>Written by the Flow product team from the walk's own records. Numbers are labelled verified, derived, assumed or unknown.</p>
        </div>
        <div id="try-elements">
          <PaperCta layout="article" class="ed-paper-cta"
            source={`flow-elements-${entry.id}`} headingId="elements-cta"
            eyebrow="TRY IT IN FLOW" heading="Press ⌘5 and pick a card."
            description={`In Flow, open a document and press ⌘5 to open Elements. Select a passage, press a card, and decide what to keep in Review Changes.`} />
        </div>
      </article>
    </div>

    {items.length > 0 && (
      <section class="fp-section ls-container" aria-labelledby="more-elements">
        <div class="fp-head"><div class="fp-heading"><p class="ls-eyebrow">MORE ELEMENTS</p><h2 id="more-elements">Another group,<br /><span class="ls-stroke">walked the same way.</span></h2></div><a class="fp-all" href="/flow/elements/">All elements →</a></div>
        <CategoryCards articles={others} />
      </section>
    )}
  </main>
  <Footer showDownload={false} />
</Layout>
