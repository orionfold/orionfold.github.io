---
// Previously issued Jobs email links used this URL. It is only a silent bridge
// to the email-link confirmation endpoint, never another confirmation screen.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>Returning to Orionfold</title>
    <noscript><meta http-equiv="refresh" content="0;url=/?living-documents-confirmed=error" /></noscript>
  </head>
  <body>
    <script>
      import { SERVICE_ACTIONS_ENABLED, serviceEndpoint } from '../../lib/living-services';
      import { redirectLegacyLivingConfirmation } from '../../scripts/living-documents-confirmation-redirect';
      redirectLegacyLivingConfirmation(serviceEndpoint('flow-living-documents-confirm'), SERVICE_ACTIONS_ENABLED);
    </script>
  </body>
</html>
