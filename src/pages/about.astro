---
// About — the founder behind Orionfold (N-series, refreshed 2026-05-27 into a narrative,
// mission-first landing page: avatar + two story-style comics + public-product wordmark cards.
// Voice: first person, grade 3-5, no em-dashes (website-copy-style). No revenue figures;
// focus on the real public products. Person/ProfilePage JSON-LD ties it to the founder entity.
import { Image } from 'astro:assets';
import PaperLayout from '../layouts/PaperLayout.astro';
import Panel from '../components/paper/Panel.astro';
import Media from '../components/paper/Media.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE, PERSON } from '../data/seo';
import { ogMeta } from '../data/og';
import avatar from '../assets/about/manav.jpg';
import arc from '../assets/about/arc.jpeg';
import mission from '../assets/about/mission.jpeg';
// The Limitless story hero doubles as the Flow band creative: the same
// conductor image the founder story now builds toward.
import limitless from '../assets/story/limitless-without-the-pill/hero.png';

const og = ogMeta('/about/');

// Real, public products and the rooms they were built in, on a timeline. No revenue figures.
const milestones = [
  {
    year: 'Late 1990s',
    mark: 'Xerox PARC',
    line: 'Helped build one of India’s first systems for storing and sharing documents across distance.',
  },
  {
    year: '2017',
    mark: 'AWS, India',
    line: 'Brought cloud computing to businesses across India, and helped stand up the tech behind the country’s pandemic response that reached 100 million people in 40 days.',
  },
  {
    year: '2021',
    mark: 'Alexa Conversations',
    line: 'Led product for Alexa’s conversational AI and grew it from 1 language to 9.',
  },
  {
    year: '2024',
    mark: 'Amazon Nova',
    line: 'Worked inside Amazon AGI on the foundation models that ship today as Amazon Nova.',
  },
  {
    year: '2024',
    mark: 'Generative AI for the store',
    line: 'Helped bring generative AI to the Amazon shopping experience that millions use every day.',
  },
  {
    year: '2025',
    mark: 'AWS Frontier AI',
    line: 'Led the solutions work helping frontier AI labs build on AWS, with partners like Anthropic and NVIDIA.',
  },
  {
    year: '2026',
    mark: 'Orionfold',
    line: 'Open AI software, custom models, and books you can run, all from one small desk.',
  },
  {
    year: '2026',
    mark: 'Orionfold Flow',
    line: 'Building the Mac app that lets one person conduct their documents with AI, the way I learned to work.',
    now: true,
  },
];

const beliefs = [
  {
    title: 'Local and private by default',
    body: 'The best place for your AI to run is your own computer, not someone else’s cloud. Your work stays in the room.',
  },
  {
    title: 'Skill beats staff',
    body: 'One person with AI helpers can now do what used to take a whole team. I build the tools that make that real.',
  },
  {
    title: 'Open, not locked in',
    body: 'Open AI has caught up to the paid kind. I ship open software, open models, and books you can read and run.',
  },
];
---
<PaperLayout
  title="About Manav Sehgal · Orionfold"
  description="I am Manav Sehgal, the builder behind Orionfold. Twenty-five years building AI, from Xerox PARC to Alexa Conversations and Amazon Nova, now folded into one startup for the solo builder."
  ogImage={og.image}
  ogImageAlt={og.alt}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      url: `${SITE.url}/about/`,
      mainEntity: {
        ...PERSON,
        jobTitle: 'Founder, Orionfold',
        description:
          'Founder of Orionfold, an AI startup that builds open AI software, custom models, and the playbooks to run them locally and privately. Twenty-five years building AI, from Xerox PARC to Alexa Conversations and Amazon Nova. Author of the AI Native Business book.',
        worksFor: { '@type': 'Organization', name: 'Orionfold LLC', url: SITE.url },
        alumniOf: [
          { '@type': 'CollegeOrUniversity', name: 'Harvard Business School' },
          { '@type': 'CollegeOrUniversity', name: 'MIT Sloan School of Management' },
          { '@type': 'CollegeOrUniversity', name: 'University of California, Berkeley, Haas School of Business' },
        ],
        knowsAbout: ['Artificial Intelligence', 'Open-weight models', 'Local-first AI', 'AI agents', 'Cloud computing'],
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'About', item: `${SITE.url}/about/` },
      ],
    },
  ]}
>
  <Nav />
  <main id="main" class="pp-page">
    <!-- About as a letter (R6): mymind's large-type letter, the comics as figures,
         then the timeline and beliefs as quiet rows, then one Flow ask. -->
    <article class="pp-letter" aria-labelledby="about-title">
      <header class="pp-letter-head">
        <Image src={avatar} alt="Manav Sehgal, a stylized space-explorer portrait of the founder of Orionfold." width={132} height={132} loading="eager" class="pp-letter-avatar" />
        <p class="pp-kicker">About · Manav Sehgal, founder of Orionfold</p>
        <h1 id="about-title" class="pp-letter-title">I fold the frontier down to one desk.</h1>
      </header>
      <div class="pp-letter-body">
        <p class="pp-letter-lede">Hi, I’m Manav. For twenty-five years I helped the biggest companies in the world put powerful technology in front of millions of people. Now I do the opposite of big. I put that same frontier in the hands of one person at a time, starting with you.</p>
        <Media ai ratio="auto" class="pp-letter-figure">
          <Image src={mission} alt="A glowing tower of clouds and servers sends a bright star of light across a sunset sky into the open hands of a builder at a small desk, where a gold computer glows. A banner reads: Put the frontier in your hands." widths={[640, 960, 1280, 1600]} sizes="(min-width: 1000px) 900px, 100vw" />

          <Fragment slot="caption">That is the whole mission. The frontier of AI should not live only in giant clouds rented by giant companies. It should fit on your desk, run on your terms, and answer to you.</Fragment>
        </Media>
        <h2>Why I do this</h2>
        <p>For most of my life, the rule was simple. The best technology was big, expensive, and lived far away in someone else’s data center. You could use it, but you could not own it. I spent years on the inside of that world, and I kept noticing the same gap. The tech got more amazing every year, and yet it reached real people slowly, if at all.</p>
        <p>Then something changed. Open AI models caught up to the locked, paid ones. A computer small enough to sit on a desk got powerful enough to run them. For the first time, one person with the right tools could do what used to take a whole team and a cloud bill. I could not unsee it. So I left to build for that person.</p>
        <Media ai ratio="auto" class="pp-letter-figure">
          <Image src={arc} alt="Four-panel comic of a 25-year journey: a 1990s computer lab, a 2010s cloud city, a 2020s glowing voice assistant with a constellation of AI models, and today a builder at a home desk with a small glowing gold computer. A banner reads: Twenty-five years, folded into one desk." widths={[640, 960, 1280, 1600]} sizes="(min-width: 1000px) 900px, 100vw" />
        </Media>
        <h2>The path here</h2>
        <p>My path was not a straight line. It was the same idea told in very different rooms. It started at Xerox PARC in the late 1990s, where I helped build one of India’s first systems for storing and sharing documents across distance.</p>
        <p>At AWS I helped bring the cloud to businesses across India, and helped stand up the tech behind the country’s pandemic response. At Amazon I led product for Alexa’s conversational AI, then worked on the foundation models that ship today as Amazon Nova, then helped bring generative AI to the store millions of people shop in every day. After that I led the team helping frontier AI labs like Anthropic and chipmakers like NVIDIA build on AWS.</p>
        <p>Today that NVIDIA thread runs the other way. My reference machine is the NVIDIA DGX Spark, a small AI supercomputer on one desk, and the book, models, and tools are all proven on it. You can see that work gathered on the <a href="/dgx-spark/">DGX Spark page</a>.</p>
        <p>Every step taught me the same lesson, a little louder each time. The most powerful technology in the world is worth almost nothing until it reaches the person who needs it. In June 2026, after nearly nine years at Amazon, I left to do the one thing all of it pointed at.</p>
        <p>Then I spent sixty days building this startup the AI-native way. One person, one desk, research and software and books and operations, all with AI helpers alongside me. What I learned surprised me. AI did not make me smarter. It let me use different parts of my thinking together, and hold the thread between them. I wrote that down in <a href="/story/limitless-without-the-pill/">Limitless, Without the Pill</a>. The short version is a sentence I keep coming back to: I do not write every note anymore, I conduct.</p>
        <p>That sentence is now a product. <a href="/flow/">Orionfold Flow</a> is the Mac app I am building so anyone can work that way, in the place the work actually happens, the document. Everything before it taught me what to build. Flow is me building it.</p>
        <p>The frontier is finally small enough to hold. Let’s put it in your hands.</p>
        <p class="pp-letter-sign">Manav</p>
      </div>
    </article>

    <Panel id="shipped" seam="Things I’ve helped bring into the world" fold="atlas" title="Not a resume.<br />A timeline." lede="The real, public things I had a hand in shipping, and the one I am building now.">
      <ol class="pp-rows pp-rows--timeline">
        {milestones.map((m) => <li><div class="pp-row"><b>{m.year}</b><div><strong>{m.mark}</strong><span>{m.line}</span></div></div></li>)}
      </ol>
    </Panel>

    <Panel id="beliefs" seam="What I believe" fold="orri" tinted title="Three things<br />I hold to.">
      <ol class="pp-cells pp-cells--3 pp-cells--steps">
        {beliefs.map((b, i) => <li><small>{String(i + 1).padStart(2, '0')}</small><b>{b.title}</b><span>{b.body}</span></li>)}
      </ol>
      <p class="pp-panel-note">The <a href="/letter/">letter every month</a> covers where AI is going. The proof that a desk can do real AI is in the <a href="/proof/">receipts</a>. Why I left, and what the name means, is in <a href="/story/why-i-folded-orionfold/">Why I folded Orionfold</a>.</p>
    </Panel>

    <!-- Flow CTA (operator 2026-08-15): the founder story lands on Flow, the
         flagship. Not a ProductBand (priced-product machinery). -->
    <section class="pp-closing pp-closing--art" aria-labelledby="about-flow-heading">
      <Image src={limitless} alt="A knowledge worker at a laptop conducts a luminous constellation of research, code, strategy, art, and scientific ideas across a deep blue night sky." widths={[420, 840]} sizes="(min-width: 760px) 420px, 90vw" class="pp-closing-art" />
      <p class="pp-kicker">The tool I am building now</p>
      <h2 id="about-flow-heading">I do not write every note anymore. I conduct.</h2>
      <p>Orionfold Flow is that idea made into a Mac app. You work with AI inside your documents, and you stay the one who approves what changes.</p>
      <a class="pp-btn" href="/flow/?utm_source=orionfold&utm_medium=cross-sell&utm_campaign=about-flow&utm_content=about-band">Explore Orionfold Flow</a>
      <small><a href="/story/limitless-without-the-pill/">or read Limitless, Without the Pill</a></small>
    </section>
  </main>
  <Footer showDownload={false} />
</PaperLayout>
