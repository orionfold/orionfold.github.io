---
// /letter/ — the founder's letters hub. Shows the NEWEST edition in full (so the
// stable /letter/ URL the homepage, footer, about page, and the marketing campaign
// all point at always lands on fresh content), then archives the earlier editions.
// Each edition also has its own permalink at /letter/<slug>/ for posterity. The
// page declares itself a Blog hub in JSON-LD; the per-edition permalink carries the
// canonical BlogPosting, so the always-fresh index does not duplicate it.
import { getCollection, render } from 'astro:content';
import PaperLayout from '../../layouts/PaperLayout.astro';
import PaperSubscribe from '../../components/paper/PaperSubscribe.astro';
import '../../styles/living-in-paper.css';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import LetterArticle from '../../components/letters/LetterArticle.astro';
import { ogPath, letterOgSlug } from '../../data/og';
import { SITE, PERSON, PUBLISHER } from '../../data/seo';

const letters = (await getCollection('letters')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const latest = letters[0];
const earlier = letters.slice(1);
const { Content, headings } = await render(latest);
const minutes = Math.max(1, Math.ceil((latest.body ?? '').split(/\s+/).filter(Boolean).length / 230));

const dfmt = (d: Date) =>
  new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(d);
const latestIso = latest.data.date.toISOString().slice(0, 10);

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Letters from the founder',
  description:
    'A monthly letter from the founder of Orionfold, making the case for private AI you own against what is happening in AI right now.',
  url: `${SITE.url}/letter/`,
  author: { ...PERSON, url: `${SITE.url}/about/` },
  publisher: PUBLISHER,
  blogPost: letters.map((l) => ({
    '@type': 'BlogPosting',
    headline: l.data.title,
    description: l.data.dek,
    datePublished: l.data.date.toISOString().slice(0, 10),
    url: `${SITE.url}/letter/${l.id}/`,
    author: { ...PERSON, url: `${SITE.url}/about/` },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Letters', item: `${SITE.url}/letter/` },
  ],
};
---
<PaperLayout
  title={`${latest.data.title} · A letter from the founder · Orionfold`}
  description={latest.data.dek}
  ogImage={ogPath(letterOgSlug(latest.id))}
  ogImageAlt={`${latest.data.title} · a letter from the founder of Orionfold`}
  ogType="article"
  article={{ datePublished: latestIso, dateModified: latestIso, author: 'Manav Sehgal', section: 'Letters' }}
  jsonLd={[blogSchema, breadcrumbSchema]}
>
  <Nav />
  <main id="main" class="pp-page">
    <LetterArticle edition={latest.data.edition} title={latest.data.title} dek={latest.data.dek} date={latest.data.date} minutes={minutes} headings={headings}>
      <Content />
      <!-- Archive: earlier editions, or the cadence note when this is the first one -->
      <section slot="after" class="pp-long-archive" aria-labelledby="letter-archive">
        <p class="pp-kicker" id="letter-archive">Earlier letters · a new one about once a month</p>
        {earlier.length ? (
          <ul>
            {earlier.map((l) => (
              <li><a href={`/letter/${l.id}/`}><small>{l.data.edition} · <time datetime={l.data.date.toISOString().slice(0, 10)}>{dfmt(l.data.date)}</time></small><strong>{l.data.title}</strong><span>{l.data.dek}</span></a></li>
            ))}
          </ul>
        ) : (
          <p>This is the first one. New letters will land here, each making the case fresh against what is happening in AI that month.</p>
        )}
      </section>
    </LetterArticle>

    {/* A10: same soft opt-in as the per-edition permalink. */}
    <PaperSubscribe id="offer-founder-letter" heading="Get the next letter." dek="One honest letter a month from building Orionfold in public. What we shipped, what the numbers really say, and the receipts behind every claim." source="letter-index" offer="founder-letter" buttonText="Send it" fold="orri"
      consentText="By subscribing you agree to receive the AI For Everyone digest, one email a week, no more. You can unsubscribe any time. See our privacy policy." />
  </main>
  <Footer showDownload={false} />
</PaperLayout>
