---
// /letter/<slug>/ — the permalink for one founder-letter edition (posterity +
// shareable per-edition URL). Carries the canonical BlogPosting for the edition;
// the /letter/ index is the always-fresh hub that points here.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PaperLayout from '../../../layouts/PaperLayout.astro';
import PaperSubscribe from '../../../components/paper/PaperSubscribe.astro';
import '../../../styles/living-in-paper.css';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import LetterArticle from '../../../components/letters/LetterArticle.astro';
import { ogPath, letterOgSlug } from '../../../data/og';
import { SITE, PERSON, PUBLISHER } from '../../../data/seo';

export async function getStaticPaths() {
  const letters = await getCollection('letters');
  return letters.map((letter) => ({ params: { slug: letter.id }, props: { letter } }));
}

const { letter } = Astro.props as { letter: CollectionEntry<'letters'> };
const { Content, headings } = await render(letter);
const minutes = Math.max(1, Math.ceil((letter.body ?? '').split(/\s+/).filter(Boolean).length / 230));
const { title, dek, edition, date } = letter.data;

const dateIso = date.toISOString().slice(0, 10);
const dateTime = date.toISOString(); // JSON-LD wants a timezone; OG meta keeps the date
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogPath(letterOgSlug(letter.id)), Astro.site).href;

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: dek,
  image: ogImageUrl,
  datePublished: dateTime,
  dateModified: dateTime,
  author: { ...PERSON, url: `${SITE.url}/about/` },
  publisher: PUBLISHER,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  url: canonical,
  inLanguage: 'en',
  articleSection: 'Letters',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Letters', item: `${SITE.url}/letter/` },
    { '@type': 'ListItem', position: 3, name: title, item: canonical },
  ],
};
---
<PaperLayout
  title={`${title} · A letter from the founder · Orionfold`}
  description={dek}
  ogImage={ogPath(letterOgSlug(letter.id))}
  ogImageAlt={`${title} · a letter from the founder of Orionfold`}
  ogType="article"
  article={{ datePublished: dateIso, dateModified: dateIso, author: 'Manav Sehgal', section: 'Letters' }}
  jsonLd={[blogPostingSchema, breadcrumbSchema]}
>
  <Nav />
  <main id="main" class="pp-page">
    <LetterArticle edition={edition} title={title} dek={dek} date={date} minutes={minutes} headings={headings}>
      <Content />
    </LetterArticle>

    {/* A10: a soft opt-in to the monthly letter fits a reader who just finished one. */}
    <PaperSubscribe id="offer-founder-letter" heading="Get the next letter." dek="One honest letter a month from building Orionfold in public. What we shipped, what the numbers really say, and the receipts behind every claim." source="letter-page" offer="founder-letter" buttonText="Send it" fold="orri"
      consentText="By subscribing you agree to receive the AI For Everyone digest, one email a week, no more. You can unsubscribe any time. See our privacy policy." />
  </main>
  <Footer showDownload={false} />
</PaperLayout>
