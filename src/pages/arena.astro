---
// /arena/ — Orionfold Arena, the eval cockpit. The single canonical flagship
// landing + conversion surface, parallel to /proof/ + /relay/. Nav "Arena" points
// here (2026-07-01, repointed from /cockpit/). /cockpit/ stays live + footer-
// linked (SEO equity); the /software/arena/ detail page was retired the same day
// and 301s here (its Field Edition buy block now lives at #get-arena below).
//
// Content sourced from the ainative Arena corpus (products/orionfold-arena/
// product.md) + the FieldEditionBox positioning (capability/velocity-led). The
// paid Field Edition runs on an NVIDIA DGX Spark. Screenshots are the fresh dark
// Orionfold-Arena-branded cockpit shots (vendored to src/assets/arena/), cropped
// with object-top. Numbers use the newer counts (56 articles) and stay honest
// (receipt is verifiable, never "all gates green"). Prices come from the catalog
// SSOT (FIELD_EDITION) so they can't drift. Voice: grade 3-5, jargon explained,
// no em-dashes (website-copy-style).
//
// R7d (G-146): a Paper page, culled like /relay/. The cockpit shot is the
// hero stage, then one panel per idea (proof, the four moves, screens, what
// you get, security). The builder-velocity band left (its counts were stale
// and the field-note numbers already carry that proof), and so did the
// "board you can publish" band (the security answers carry it). The buy
// block, license band and sticky bar keep their markup inside the
// tw-in-paper bridge, with every data-checkout, data-item and
// data-error-target.
import { Image } from 'astro:assets';
import PaperLayout from '../layouts/PaperLayout.astro';
import PageNav from '../components/paper/PageNav.astro';
import Panel from '../components/paper/Panel.astro';
import Media from '../components/paper/Media.astro';
import Fold from '../components/paper/Fold.astro';
import PaperSubscribe from '../components/paper/PaperSubscribe.astro';
import '../styles/living-in-paper.css';
import '../styles/paper-bridge-product.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ArenaBox from '../components/product/ArenaBox.astro';
import LandingStickyCta from '../components/product/LandingStickyCta.astro';
import LicenseBand from '../components/product/LicenseBand.astro';
import ProductLineRail from '../components/product/ProductLineRail.astro';
import { ARENA_PAGES } from '../lib/arena/pages';
import { ARENA_FIELD_EDITION_LIVE } from '../data/launch';
import arenaPoster from '../assets/projects/arena-poster.png';
import arenaCockpit from '../assets/arena/01-cockpit.png';
import arenaLeaderboard from '../assets/arena/02-leaderboard.png';
import arenaFrontier from '../assets/arena/03-efficiency-frontier.png';
import arenaCompare from '../assets/arena/07-compare.png';
import arenaEvalDrawer from '../assets/arena/08-eval-drawer.png';
import { SITE, PERSON } from '../data/seo';
import { FIELD_EDITION, formatUsd } from '../data/commerce';
import { ogMeta } from '../data/og';

const og = ogMeta('/arena/');
const arenaUrl = `${SITE.url}/arena/`;
const ogImageAbs = `${SITE.url}${og.image}`;

// Merchant-listings completeness for the priced Offer below (same honest values
// as ProofBox/RelayBox: an instant digital license from a US LLC, so free
// "shipping" and no returns).
const digitalMerchantFields = {
  hasMerchantReturnPolicy: {
    '@type': 'MerchantReturnPolicy',
    applicableCountry: 'US',
    returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted',
  },
  shippingDetails: {
    '@type': 'OfferShippingDetails',
    shippingRate: { '@type': 'MonetaryAmount', value: '0', currency: 'USD' },
    shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'US' },
  },
};

// SoftwareApplication + Offer so /arena/ reads as the buyable product for answer
// engines. Price = the standard $499 (the durable price after the founding seats
// sell out); the catalog SSOT is the source, never a hardcoded number.
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Orionfold Arena',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'NVIDIA DGX Spark',
  description:
    'One screen to run, compare, score, and train local AI models on one NVIDIA DGX Spark. Live GPU readouts, a cost-against-quality view, reference-based scoring, and a leak-proof leaderboard built from your own results.',
  url: arenaUrl,
  image: ogImageAbs,
  author: PERSON,
  brand: { '@type': 'Brand', name: 'Orionfold' },
  offers: {
    '@type': 'Offer',
    price: (FIELD_EDITION.primary.amount / 100).toFixed(2),
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: arenaUrl,
    category: 'Software license',
    ...digitalMerchantFields,
  },
};

// What it does: the four core moves, sourced from product.md. Each is a real
// cockpit surface, not a claim.
const capabilities = [
  {
    verb: 'Run',
    line: 'Chat with a loaded model on your own box. Live GPU load, speed, and memory on one screen. Nothing you type leaves the machine.',
  },
  {
    verb: 'Compare',
    line: 'Put any two models side by side. Quality, speed, how fast the first word lands, and cost, each drawn over the run so you can see the difference, not guess it.',
  },
  {
    verb: 'Score',
    line: 'Pick a test, send a real prompt from the chat, and the right answer sits beside the model’s answer while a grader scores it. Testing becomes one button.',
  },
  {
    verb: 'Train',
    line: 'Queue tests and training runs overnight and wake up to a morning report. Start from where you left off, reward the good runs, and watch progress fill on one board.',
  },
];

// "What the loop earns" trio — replaces the ported own-it trust cards (which
// sold a TRUST story Arena already covers in its objection block) with three
// wins the Spark-owner ICP actually buys the box for: the eval->train->re-eval
// loop makes a model they own win, improves itself overnight, and costs almost
// nothing because it is their hardware. Each card is a SHOWN, cited field-note
// outcome (D2: proof is an artifact, never an adjective), deep-linking the note
// that backs it on ainative.business. Numbers verified 2026-07-03 against the
// article source. Deliberately distinct from the 18/21 buyer-outcome band below
// (no repeat): this trio leads with the overnight loop, the speed win, and the
// economics.
const loopWins = [
  {
    metric: '0 → 154/158',
    title: 'It improves itself overnight',
    body: '34 self-play steps on one Spark took an agent from finishing nothing to finishing almost every task. No cloud, no learned reward model, just the loop running while you sleep.',
    icon: '<path d="M21 12a9 9 0 1 1-6.219-8.56"/><path d="M12 7v5l3 3"/>',
    source: 'ClawGym on Spark, with self-play',
    href: 'https://ainative.business/field-notes/clawgym-on-spark-grpo/',
  },
  {
    metric: '76% faster',
    title: 'Faster on your own metal',
    body: 'Dropping to the Blackwell-native 4-bit kernel the Spark runs in hardware decoded 76% faster than the stock server, on a smaller model file. You get speed the rented endpoint never exposes.',
    icon: '<path d="m13 2-3 7h6l-3 7"/><path d="M12 2v2"/><path d="M12 20v2"/>',
    source: 'TensorRT-LLM on Spark',
    href: 'https://ainative.business/field-notes/trtllm-and-triton-on-spark/',
  },
  {
    metric: '$0.02',
    title: 'Because it is your box',
    body: 'A 50-run overnight research loop cost two cents of electricity. On a rented cloud the same loop bills per token and per GPU-second, so you plan carefully. On your Spark, running it is free enough to be rigorous.',
    icon: '<path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
    source: 'Auto-research agent loop',
    href: 'https://ainative.business/field-notes/autoresearch-agent-loop/',
  },
];

// Objection-as-header security block (reference-build gap D4-③c): the questions
// an Arena buyer (a hardware owner) asks before the price, each answered plainly
// and each linking the on-site /trust/ page that proves it. Same four-question
// pattern the shipped /relay/ page uses, adapted for the box owner. The
// publish-safety question is half-answered by the allowlist copy above; here it
// is promoted to a header.
const trust = [
  {
    q: 'Does Arena send our evals to you?',
    a: 'No. Arena runs on your own Spark. Your test prompts, your model answers, and your scores stay on the box. We run no service in the middle, so there is nothing for us to see and nothing for us to hold.',
    label: 'See every network call',
    href: '/trust/data-flow/',
  },
  {
    q: 'Can I publish the leaderboard safely?',
    a: 'Yes. The board exports only the scores and the totals, through a locked-down list. A prompt, an answer, or the model’s working never leaves with it. You can share the board and keep the data behind it.',
    label: 'Read the security packet',
    href: '/trust/security-packet/',
  },
  {
    q: 'What if you disappear?',
    a: 'You keep everything. The box is yours, your data is on it, and your license works offline. If Orionfold went away tomorrow, your lab keeps running. The honest edge cases are written down too.',
    label: 'Read the continuity note',
    href: '/trust/continuity/',
  },
  {
    q: 'Can I trust what gets installed?',
    a: 'Yes, and you can check it. Every release ships with a signed record of where it came from and a full parts list, and the install is checked against a fingerprint before it runs. The receipt on first boot reports the real state of the box.',
    label: 'See the supply chain',
    href: '/trust/supply-chain/',
  },
];

// The dark cockpit gallery (fresh Orionfold-Arena-branded shots), 16:9 top crops.
const gallery = [
  { img: arenaLeaderboard, alt: 'The Arena leaderboard: your own models ranked by score, built from your own results.', label: 'Leaderboard' },
  { img: arenaFrontier, alt: 'Cost against quality, plotted, so you can see which smaller model earns its place.', label: 'Cost vs. quality' },
  { img: arenaCompare, alt: 'Compare: any model against any other, side by side, with metric cards over a session sparkline.', label: 'Compare, any vs any' },
  { img: arenaEvalDrawer, alt: 'The eval drawer: send a real eval prompt from the chat, gold answer beside the live one, graded instantly.', label: 'Eval drawer' },
];

// Credibility evidence band, same shape as the /relay/ proof band. Every number
// is a live count from the public ainative.business field-notes "At a glance"
// (verified 2026-07-03 against the live page + the source project-stats.json,
// which agree): a real, growing research log produced on this exact stack. The
// stat is a SHOWN artifact (D2: proof is never an adjective), cited openly to
// the source site, and rerunnable by the reader.
const evidence = [
  { value: '56', sub: '+13 in the works', label: 'Field notes published' },
  { value: '176,597', sub: 'across the whole log', label: 'Words written' },
  { value: '63,840', sub: 'Python, CLI, tests', label: 'Lines of fieldkit code' },
  { value: '8', sub: 'run and scored locally', label: 'Open models' },
  { value: '11', sub: 'used across the notes', label: 'NVIDIA products' },
  { value: '100', unit: 'tok/s', sub: 'a local brain, on one Spark', label: 'Throughput' },
];
---
<PaperLayout
  title="See which AI wins, on your own desk · Orionfold Arena"
  description="Run, compare, score, and train local AI models on one NVIDIA DGX Spark, all on one screen. A cost-against-quality view and a leaderboard from your own results. Nothing leaves the box."
  ogImage={og.image}
  ogImageAlt={og.alt}
  jsonLd={[
    softwareSchema,
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Arena', item: arenaUrl },
      ],
    },
  ]}
>
  <Nav />
  <main id="main" class="pp-page">
    <section class="pp-hero pp-hero--relay" aria-labelledby="arena-title">
      <div class="pp-hero-copy">
        <p class="pp-kicker">Run · Compare · Score · Train</p>
        <h1 id="arena-title" class="pp-h1">See which AI wins, on your own desk.</h1>
        <p class="pp-sub">Orionfold Arena puts every move on one screen. Run, compare, score, and train local AI models on one NVIDIA DGX Spark. The model, the tests, the hardware, and the results all live in one place you control. Nothing leaves the box.</p>
        {/* Above-fold primary action: Arena's OWN buy CTA, one step straight to
            Stripe when ARENA_FIELD_EDITION_LIVE (wired by the page script); a
            scroll anchor when the flag is off, so no one can pay pre-fulfilment.
            Secondary = the runnable install verb. */}
        <div class="pp-hero-cta">
          {ARENA_FIELD_EDITION_LIVE ? (
            <button type="button" class="pp-btn" data-checkout={FIELD_EDITION.founding.lookupKey} data-item="software:arena" data-error-target="hero-cta-err">
              Get Arena Field Edition · {formatUsd(FIELD_EDITION.founding.amount)} founding
            </button>
          ) : (
            <a class="pp-btn" href="#get-arena">Get Arena Field Edition · {formatUsd(FIELD_EDITION.founding.amount)} founding</a>
          )}
          <span class="pp-install"><small>Install</small><code>pip install fieldkit[arena]</code></span>
        </div>
        <p id="hero-cta-err" class="pp-done-error" role="alert" hidden></p>
      </div>
      <div class="pp-hero-stage">
        <Media caption={"One screen over the whole loop"}>
          <Image
            src={arenaCockpit}
            alt="The Orionfold Arena screen: live GPU readouts, your models, the tests, and a leaderboard built from your own results, all in one place."
            widths={[720, 1080, 1440]}
            sizes="(min-width: 860px) 50vw, 100vw"
            loading="eager"
            decoding="async"
            data-no-zoom
          />
</Media>
      </div>
    </section>
    {/* Sticky-CTA sentinel: the bar fades in once this scrolls out of view. */}
    <div id="hero-cta-sentinel" aria-hidden="true"></div>
    <PageNav label="Arena product navigation" onPage={[
      { href: '#arena-proof', label: 'Proof' },
      { href: '#arena-moves', label: 'What it does' },
      { href: '#arena-screens', label: 'Screens' },
      { href: '#arena-outcome', label: 'Results' },
      { href: '#arena-security', label: 'Security' },
      { href: '#get-arena', label: 'Pricing' },
    ]} pages={ARENA_PAGES('overview')} />

    {/* THE PROOF: live counts from the public field notes, then three cited
        wins the loop already produced on this exact stack. */}
    <Panel id="arena-proof" seam="Proven on the same stack" fold="atlas" title="The field notes<br />are the receipts." lede="One builder, one Spark, a public research log anyone can read and rerun.">
      <ul class="pp-cells pp-cells--3 pp-relay-stats pp-arena-evidence">
        {evidence.map((t) => (
          <li><span class="pp-kicker">{t.label}</span><b>{t.value}{t.unit && <small> {t.unit}</small>}</b><span>{t.sub}</span></li>
        ))}
      </ul>
      <p class="pp-kicker pp-arena-wins-head">What the loop earns</p>
      <ul class="pp-cells pp-cells--3 pp-arena-wins">
        {loopWins.map((w) => (
          <li>
            <b>{w.metric}</b>
            <strong>{w.title}</strong>
            <span>{w.body}</span>
            <a href={w.href} target="_blank" rel="noopener">{w.source} <span aria-hidden="true">↗</span></a>
          </li>
        ))}
      </ul>
      <p class="pp-panel-note">Every number is a live count from the public research log, <a href="https://ainative.business/field-notes/" target="_blank" rel="noopener">the ainative field notes</a>. Read the notes, then rerun them yourself.</p>
    </Panel>

    {/* What it does: the four core moves. */}
    <Panel id="arena-moves" seam="What it does" fold="tally" tinted title="Four moves,<br />one screen." lede="You have a shelf of local models and nowhere to drive them from. Arena is the instrument panel that turns that shelf into something you can fly.">
      <ul class="pp-cells pp-cells--4 pp-arena-moves">
        {capabilities.map((c) => (<li><b>{c.verb}</b><span>{c.line}</span></li>))}
      </ul>
      <p class="pp-panel-note">Every install runs a test gate and writes a receipt you can read. The receipt reports the real state of the box, and the 12-month window re-tests and re-receipts every update. What you buy is the assembled, proven, kept-proven AI team, not a pile of parts you wire together and babysit.</p>
    </Panel>

    {/* Mid-page CTA for the reader who is already sold. Same SSOT-priced,
        launch-flag-gated band. */}
    <div class="tw-in-paper pd-paper pd-relay-bridge">
      <LicenseBand
        family={FIELD_EDITION}
        live={ARENA_FIELD_EDITION_LIVE}
        itemId="software:arena"
        errId="arena-band-err"
        fullBlockId="get-arena"
        eyebrow="Get an AI team without hiring one"
        heading="Own the proven box, not the parts."
        body="Arena Field Edition turns the Spark you own into a private AI lab, delivered turnkey. It installs in one pass, proves itself on first boot with a verifiable receipt, and stays proven for a year."
        enquiryHref="/adoption/?item=software:arena"
        image={arenaPoster}
        imageAlt="Orionfold Arena poster: the private AI lab you run on your own DGX Spark."
      />
    </div>

    {/* Inside the screen: the board, the frontier, compare and the eval drawer. */}
    <Panel id="arena-screens" seam="Inside the screen" fold="orri" title="Every surface,<br />on your desk." lede="Arena plots cost against quality, so you can read at a glance which smaller model earns its place. You hold the model, its tests, the hardware, and the results.">
      <ul class="pp-arena-gallery">
        {gallery.map((g) => (
          <li>
            <Media caption={g.label}>
              <Image src={g.img} alt={g.alt} widths={[480, 720, 1080]} sizes="(min-width: 860px) 36rem, 100vw" loading="lazy" decoding="async" data-no-zoom />
</Media>
          </li>
        ))}
      </ul>
    </Panel>

    {/* BUYER OUTCOME: the payoff of the run-compare-score loop, on the
        Advisor governance bench (config 552d0060f782), the same receipt
        /proof/ publishes. The honest losses stay in. */}
    <Panel id="arena-outcome" seam="What you get out of it" fold="sprout" tinted title="Your model beat<br />one 8 times bigger." lede="This is the payoff of the run-compare-score loop, on a locked governance test. The winner is a small model you run on your own box, for nothing per run.">
      <ul class="pp-cells pp-cells--3 pp-relay-stats">
        <li><span class="pp-kicker">A 4B model you own</span><b>18 <small>of 21</small></b><span>Scored on the locked test. It refused all 9 trick questions and made up nothing.</span></li>
        <li><span class="pp-kicker">Eight times bigger</span><b>8 <small>of 21</small></b><span>Same test. It made up 3 answers the small one did not.</span></li>
        <li><span class="pp-kicker">Cost to run the winner</span><b>$0.00</b><span>On the Spark under your desk. No account, no per-word bill.</span></li>
      </ul>
      <p class="pp-panel-note">The full receipt, config hash <code>552d0060f782</code>, is on the <a href="/proof/">receipts page</a>, with the three honest misses and the exact test, so you can rerun it yourself.</p>
    </Panel>

    {/* Security and trust: the questions a box owner asks before the price,
        each linking the on-site trust page that backs it. */}
    <Panel id="arena-security" seam="Before you buy" fold="shell" title="The questions<br />a box owner asks." lede="Arena runs on your own Spark, holds none of your data, and keeps working even if we do not. Each answer links the page that shows the code behind it.">
      <div class="pp-faq">
        {trust.map((t) => (
          <details><summary>{t.q}</summary><p>{t.a} <a href={t.href}>{t.label} <span aria-hidden="true">→</span></a></p></details>
        ))}
      </div>
    </Panel>

    {/* Own the box: the buy block, then the sibling line. */}
    <div class="tw-in-paper pd-paper pd-relay-bridge">
      <ArenaBox />
      <ProductLineRail current="arena" />
    </div>

    {/* Soft opt-in below the buy: readers who are not checkout-ready yet. */}
    <PaperSubscribe
      id="offer-become-ai-native-business"
      offer="become-ai-native-business"
      source="arena-page"
      heading="Not ready to buy? Start with the free book."
      dek="Get the AI Native Business book free, and a note when we ship new Arena proof."
      buttonText="Send it"
      fold="hop"
      consentText="By subscribing you agree to receive the AI For Everyone digest, one email a week, no more. You can unsubscribe any time. See our privacy policy."
    />

    {/* Close: hand the reader to the live demo and the buy block. */}
    <section class="pp-closing" aria-labelledby="arena-closing-heading">
      <Fold id="ember" live class="pp-closing-fold" />
      <p class="pp-kicker">Orionfold Arena</p>
      <h2 id="arena-closing-heading">Drive every screen yourself.</h2>
      <p>Click through every screen in the live demo, or get the Field Edition and run the whole stack on your own Spark.</p>
      <div class="pp-done-actions">
        <a href="/arena/demo/" class="pp-btn">Try the live demo <span aria-hidden="true">→</span></a>
        <a href="#get-arena" class="pp-btn pp-btn--ghost">Get Arena Field Edition</a>
      </div>
    </section>

    {/* Persistent Buy bar once the hero scrolls past. Same founding price and
        data-checkout wiring as ArenaBox (SSOT-driven). */}
    <div class="tw-in-paper pd-paper">
      <LandingStickyCta
        title="Orionfold Arena Field Edition"
        lookupKey={FIELD_EDITION.founding.lookupKey}
        priceLabel={formatUsd(FIELD_EDITION.founding.amount)}
        itemId="software:arena"
        live={ARENA_FIELD_EDITION_LIVE}
        anchor="#get-arena"
      />
    </div>
  </main>
  <Footer showDownload={false} />
</PaperLayout>

<script>
  // Wire the Arena purchase buttons (data-checkout → create-checkout-session →
  // Stripe). No-op when the buttons aren't rendered (ARENA_FIELD_EDITION_LIVE off).
  import { wireCheckoutButtons } from '../lib/checkout';
  wireCheckoutButtons();
  document.addEventListener('astro:after-swap', () => wireCheckoutButtons());
</script>
