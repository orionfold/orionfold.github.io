---
// Magnet thank-you. confirm-email redirects here after a become-ai-native-business
// opt-in is confirmed and the book email is sent. noindex (post-confirm utility).
//
// 2026-08-15 (operator): rebuilt as a single forward step to the Flow landing
// page. What changed and why:
//   - The $55 founding-reader bundle card was REMOVED. It was the only surface
//     selling book_bundle_founding (see catalog.ts), so that SKU is now dark by
//     decision, not by accident. The catalog entry stays intact so re-placing it
//     later is a copy change, not a rebuild.
//   - The Proof block was replaced by Flow, the current flagship.
//   - This page deliberately carries NO second capture form. Everyone landing
//     here just confirmed, and waitlist-signup short-circuits an already-confirmed
//     email with "You're already on the list." A form here would read as a dead
//     end and record nothing, so the forward step is a plain link to /flow/.
//   - That also removes the need for the never-built "later welcome email" the
//     old bundle comment promised. No scheduled-send rail is required.
// 2026-08-22: Flow shipped, so this block is now the "Download Flow" step the
// comment above anticipated. It branches on ORIONFOLD_FLOW_LIVE like every other
// Flow surface, so one line reverts it. The download control routes through
// FlowDownloadCta, which owns the truthful unavailable state while FLOW_DMG_URL
// is a placeholder -- this page must never hand out a link that 404s.
// R7a (G-146): the Paper done sheet. Still no site nav (the magnet funnel keeps
// its own bare header), and the download still goes through FlowDownloadCta.
import PaperLayout from '../../layouts/PaperLayout.astro';
import Fold from '../../components/paper/Fold.astro';
import '../../styles/living-in-paper.css';
import FlowDownloadCta from '../../components/flow/FlowDownloadCta.astro';
import { ORIONFOLD_FLOW_LIVE } from '../../data/launch';
---
<PaperLayout title="Your book is on the way · Orionfold" description="Your free AI Native Business book is on its way to your inbox." noindex>
  <header class="pp-done-brand">
    <!-- Logo + wordmark, top-left, subtle and non-linked (marketing 2026-06-28),
         consistent with the magnet page; the forward action is the Flow CTA. -->
    <span class="pp-logo" aria-label="Orionfold"><img src="/logos/orionfold-mark-3d-48.png" alt="" width="24" height="24" />ORIONFOLD</span>
  </header>

  <main id="main" class="pp-done-page">
    <section class="pp-done" aria-labelledby="magnet-thanks-heading">
      <Fold id="atlas" bob />
      <p class="pp-kicker">You're in</p>
      <h1 id="magnet-thanks-heading">Your book is on the way.</h1>
      <p>Check your inbox for the PDF and EPUB. The links work for seven days, so save the files once you grab them.</p>
      <p>
        {ORIONFOLD_FLOW_LIVE
          ? 'You are also signed up for Orionfold Flow updates. Nothing more to do.'
          : 'You are also on the list for Orionfold Flow. Nothing more to do.'}
      </p>

      <!-- Single forward step: the flagship. Link only, no capture (see header). -->
      <div class="pp-done-next">
        <p class="pp-kicker">{ORIONFOLD_FLOW_LIVE ? 'Your next step' : 'While you wait'}</p>
        <h2>Meet the tool the book is about.</h2>
        <p>
          Orionfold Flow is our Mac app for the person doing the work. It brings AI
          to your documents, and you stay the one who approves what changes.
          {ORIONFOLD_FLOW_LIVE
            ? ' Reading and writing your documents is free forever.'
            : ' See the real development build, screen by screen.'}
        </p>
        {ORIONFOLD_FLOW_LIVE ? (
          <div class="ls-in-paper ls-done-cta pp-done-actions">
            <FlowDownloadCta
              source="magnet-thanks"
              secondaryHref="/flow/"
              secondaryLabel="Take the product tour"
              align="center"
            />
          </div>
        ) : (
          <div class="pp-done-actions"><a class="pp-btn" href="/flow/" data-astro-prefetch>Explore Orionfold Flow <span aria-hidden="true">&rarr;</span></a></div>
        )}
      </div>

      <small>Didn't get the email? Check spam, or <a href="/become-ai-native-business/">request it again</a>.</small>
    </section>
  </main>
</PaperLayout>
