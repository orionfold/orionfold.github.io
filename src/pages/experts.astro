---
import PaperLayout from '../layouts/PaperLayout.astro';
import PageNav from '../components/paper/PageNav.astro';
import Panel from '../components/paper/Panel.astro';
import Fold from '../components/paper/Fold.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import { ogMeta } from '../data/og';
import patentCover from '../assets/models/patent-strategist/cover.png';
import benchCover from '../assets/models/patent-strategist-bench/cover.png';
import securityCover from '../assets/models/securityllm/cover.png';
import saulCover from '../assets/models/saul-7b-instruct/cover.png';
import financeCover from '../assets/models/finance-chat/cover.png';
import medicalCover from '../assets/models/ii-medical-8b/cover.png';
import keplerCover from '../assets/models/kepler/cover.png';

const og = ogMeta('/experts/');

// The model library behind the future packs. The models are shipped and free;
// the full pack (benchmark + use-case guide + run path) is the packaging step, so the
// status chips stay honest about which is which.
// Paper R5 (G-144): the same copy and links as before, one idea per panel.
const PACK = [
  { k: 'Model', v: 'An offline model or adapter selected for one domain, not a generic chatbot wrapper.' },
  { k: 'Benchmark', v: 'A test set or scorecard that makes improvement visible before the model is trusted.' },
  { k: 'Run path', v: 'A local setup path for customer-controlled hardware and private documents.' },
  { k: 'Use-case guide', v: 'Use cases, prompts, limits, and review rules for the domain.' },
];
const BENCH = 'https://huggingface.co/datasets/Orionfold/patent-strategist-bench-v0.1';
const library = [
  { img: securityCover, href: '/models/securityllm/', domain: 'Security', title: 'SecurityLLM', status: 'Model shipped · pack planned' },
  { img: saulCover, href: '/models/saul-7b-instruct/', domain: 'Legal', title: 'Saul 7B Instruct', status: 'Model shipped · pack planned' },
  { img: financeCover, href: '/models/finance-chat/', domain: 'Finance', title: 'Finance Chat', status: 'Model shipped · pack planned' },
  { img: medicalCover, href: '/models/ii-medical-8b/', domain: 'Medicine', title: 'II-Medical 8B', status: 'Model shipped · pack planned' },
  { img: keplerCover, href: '/models/kepler/', domain: 'Space math', title: 'Kepler', status: 'Model shipped · pack planned' },
];
---
<PaperLayout
  title="Experts · Orionfold"
  description="Orionfold Domain Experts combine offline models, benchmarks, local run paths, and use-case guides for sensitive work."
  ogImage={og.image}
  ogImageAlt={og.alt}
>
  <Nav />
  <main id="main" class="pp-page">
    <section class="pp-hero pp-hero--inner" aria-labelledby="experts-title">
      <div class="pp-hero-copy">
        <span class="pp-kicker">Experts</span>
        <h1 id="experts-title" class="pp-h1">Offline domain experts with a benchmark and a use-case guide.</h1>
        <p class="pp-sub">Patent Strategist leads the pattern. It has a domain model, a test set, a local run path, and a use-case guide. Security, legal, finance, and medical packs follow the same shape as they mature.</p>
        <div class="pp-hero-cta">
          <a class="pp-btn" href="/models/patent-strategist/">Open Patent Strategist</a>
          <a class="pp-btn pp-btn--ghost" href="/adoption/#know">Request an expert pack</a>
        </div>
      </div>
      <div class="pp-hero-stage">
        <a class="pp-cover" href="/models/patent-strategist/" aria-label="Patent Strategist model"><Image src={patentCover} alt="Patent Strategist model cover" widths={[400, 640]} sizes="(min-width: 860px) 30vw, 80vw" loading="eager" data-no-zoom /></a>
      </div>
    </section>

    <PageNav label="Experts navigation" pages={[
      { href: '/models/', label: 'All models' },
      { href: '/adoption/', label: 'Adoption' },
      { href: '/workflows/', label: 'Workflows' },
    ]} />

    <Panel id="flagship" seam="The flagship pack" fold="atlas" title="Patent Strategist.<br />Patents · live." lede="An AI built to reason about patents, fully offline. The pack pairs the model with its public benchmark, so you can see how it scores before your ideas and filings ever leave the room. Built with NVIDIA NeMo, shipped as GGUF and adapter artifacts.">
      <div class="pp-cover-pair">
        <a class="pp-cover" href="/models/patent-strategist/" aria-label="Patent Strategist model"><Image src={patentCover} alt="Patent Strategist model cover" widths={[400, 640]} sizes="(min-width: 860px) 40vw, 90vw" loading="lazy" data-no-zoom /></a>
        <a class="pp-cover" href={BENCH} target="_blank" rel="noopener noreferrer" aria-label="Patent Strategist Bench dataset"><Image src={benchCover} alt="Patent Strategist Bench cover" widths={[400, 640]} sizes="(min-width: 860px) 40vw, 90vw" loading="lazy" data-no-zoom /></a>
      </div>
      <p class="pp-panel-link"><a href="/models/patent-strategist/">Model card →</a> <a href={BENCH} target="_blank" rel="noopener noreferrer">Public benchmark ↗</a></p>
    </Panel>

    <Panel id="pack" seam="What a pack includes" fold="clause" tinted title="Four parts.<br />One domain.">
      <ul class="pp-cells pp-cells--4">{PACK.map((c) => <li><b>{c.k}</b><span>{c.v}</span></li>)}</ul>
    </Panel>

    <Panel id="library" seam="The library behind the next packs" fold="shell" title="Five models.<br />Packs to come." lede="The models are shipped and free. The full pack is the packaging step, so each card says which is which.">
      <ul class="pp-art-cards">
        {library.map((model) => (
          <li><a href={model.href}>
            <Image src={model.img} alt={`${model.title} model cover`} widths={[300, 480]} sizes="(min-width: 1100px) 18vw, (min-width: 640px) 30vw, 46vw" loading="lazy" data-no-zoom />
            <span class="pp-kicker">{model.domain}</span>
            <h3>{model.title}</h3>
            <p>{model.status}</p>
          </a></li>
        ))}
      </ul>
      <p class="pp-article-note">These expert models are implementation aids, not professional advice. Legal, medical, finance, and security outputs need qualified human review before use in real decisions.</p>
      <p class="pp-panel-link"><a href="/models/">All models <span aria-hidden="true">→</span></a></p>
    </Panel>

    <section class="pp-closing" aria-labelledby="experts-closing">
      <Fold id="atlas" live class="pp-closing-fold" />
      <h2 id="experts-closing">Need an expert for your field?</h2>
      <p>Tell us the domain and the work. Packs follow the Patent Strategist shape.</p>
      <a class="pp-btn" href="/adoption/#know">Request an expert pack</a>
    </section>
  </main>
  <Footer showDownload={false} />
</PaperLayout>
