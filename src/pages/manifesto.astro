---
// Essay 03, first published as The Living Documents Manifesto. It keeps its
// /manifesto/ address, publication date, eighteen principles and signup.
// Paper R6 (G-145): the long-form header and a chapter row in Paper; the wide
// chapters and their scenes stay Living markup in Paper's voice (bridge sheet).
import PaperLayout from '../layouts/PaperLayout.astro';
import PageNav from '../components/paper/PageNav.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ogMeta } from '../data/og';
import { SITE, PERSON } from '../data/seo';
import { ESSAYS } from '../data/essays';
import '../styles/living-base.css';
import '../styles/living-manifesto.css';
import '../styles/essays.css';
import '../styles/living-in-paper.css';
import '../styles/paper-bridge-essays.css';
import ManifestoBody from '../components/living/ManifestoBody.astro';
const essay = ESSAYS.find((e) => e.href === '/manifesto/')!;
const [latest] = ESSAYS;
const title = `${essay.title} · An essay by Manav Sehgal`;
const description = essay.description;
const og = ogMeta('/manifesto/');
const pageSchema = {'@context':'https://schema.org','@type':'Article',datePublished:'2026-09-06T00:00:00.000Z',dateModified:'2026-10-26T00:00:00.000Z',headline:essay.title,alternativeHeadline:'The Living Documents Manifesto',description,author:PERSON,publisher:{'@type':'Organization',name:SITE.name,url:SITE.url},mainEntityOfPage:`${SITE.url}/manifesto/`,image:`${SITE.url}${og.image}`,isPartOf:{'@type':'CollectionPage',name:'Orionfold Essays',url:`${SITE.url}/essays/`}};
const chapters = [
  { href: '#continuity', label: '01 The conviction' },
  { href: '#principles', label: '02 The principles' },
  { href: '#practice', label: '03 The practice' },
  { href: '#standards', label: '04 The standard' },
  { href: '#begin', label: '05 The invitation' },
];
---
<PaperLayout title={title} description={description} ogImage={og.image} ogImageAlt={og.alt} jsonLd={pageSchema} ogType="article" article={{datePublished:"2026-09-06",dateModified:"2026-10-26",author:"Manav Sehgal",section:"Living Documents"}}>
  <Nav />
  <main id="main" class="pp-page">
    <article class="pp-long" aria-labelledby="manifesto-title">
      <header class="pp-long-head">
        <p class="pp-long-crumb"><a href="/essays/">Essays</a><span aria-hidden="true">/</span><span>Essay {essay.number} · First published as the Living Documents Manifesto</span></p>
        <h1 id="manifesto-title" class="pp-long-title">The Researcher, Writer and Builder in You.</h1>
        <p class="pp-long-dek">Eighteen ideas for letting your documents carry the routine. So you can carry more of the ambition.</p>
        <dl class="pp-byline">
          <div><dt>Written by</dt><dd><a href="/about/">Manav Sehgal</a></dd></div>
          <div><dt>Published</dt><dd><time datetime="2026-09-06">September 6, 2026</time></dd></div>
          <div><dt>Last updated</dt><dd><time datetime="2026-10-26">October 26, 2026</time></dd></div>
          <div><dt>Reading time</dt><dd>{essay.minutes} min</dd></div>
        </dl>
      </header>
    </article>
    <PageNav label="Manifesto chapters" onPage={chapters} />
    <div class="ls ls-in-paper ls-manifesto-in-paper" data-ls-root>
      <ManifestoBody />
    </div>
    <nav class="pp-long-next" aria-label="More essays">
      <a href={latest.href}><span class="pp-kicker">More essays / {latest.number}</span><strong>{latest.title}</strong></a>
      <a class="pp-next-newer" href="/essays/"><span class="pp-kicker">Essays</span><strong>All essays</strong></a>
    </nav>
  </main>
  <Footer showDownload={false} />
</PaperLayout>
<script>
  import "../scripts/living-documents.js";
</script>
