---
// Essay 03, first published as The Living Documents Manifesto. It keeps its
// /manifesto/ address, publication date, eighteen principles and signup.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ogMeta } from '../data/og';
import { SITE, PERSON } from '../data/seo';
import { ESSAYS } from '../data/essays';
import '../styles/living-base.css';
import '../styles/living-manifesto.css';
import '../styles/essays.css';
import ManifestoHero from '../components/living/ManifestoHero.astro';
import ManifestoNavigation from '../components/living/ManifestoNavigation.astro';
import ManifestoBody from '../components/living/ManifestoBody.astro';
const essay = ESSAYS.find((e) => e.href === '/manifesto/')!;
const [latest] = ESSAYS;
const title = `${essay.title} \u00b7 An essay by Manav Sehgal`;
const description = essay.description;
const og = ogMeta('/manifesto/');
const pageSchema = {'@context':'https://schema.org','@type':'Article',datePublished:'2026-09-06T00:00:00.000Z',dateModified:'2026-10-26T00:00:00.000Z',headline:essay.title,alternativeHeadline:'The Living Documents Manifesto',description,author:PERSON,publisher:{'@type':'Organization',name:SITE.name,url:SITE.url},mainEntityOfPage:`${SITE.url}/manifesto/`,image:`${SITE.url}${og.image}`,isPartOf:{'@type':'CollectionPage',name:'Orionfold Essays',url:`${SITE.url}/essays/`}};
---
<Layout title={title} description={description} ogImage={og.image} ogImageAlt={og.alt} bodyClass="ls ls-page-manifesto" jsonLd={pageSchema} ogType="article" article={{datePublished:"2026-09-06",dateModified:"2026-10-26",author:"Manav Sehgal",section:"Living Documents"}}>
  <Nav />
  <main id="main" class="ls-main">
    <ManifestoHero />
    <ManifestoNavigation />
    <ManifestoBody />
    <section class="ed-next-essay ls-container" aria-labelledby="more-essays-title">
      <div><p class="ls-eyebrow">MORE ESSAYS / {latest.number}</p><h2 id="more-essays-title"><a href={latest.href}>The Work<br />We Want <em>to Keep.</em></a></h2></div>
      <div><p>{latest.subtitle}</p><a href={latest.href} class="ed-link">Read essay {latest.number} <span aria-hidden="true">↗</span></a><a href="/essays/" class="ed-all-link">All essays →</a></div>
    </section>
  </main>
  <Footer />
</Layout>
<script>
  import "../scripts/living-documents.js";
</script>
