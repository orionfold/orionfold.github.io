---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ogMeta } from '../data/og';
import { SITE, PERSON } from '../data/seo';
import '../styles/living-base.css';
import '../styles/living-manifesto.css';
import ManifestoHero from '../components/living/ManifestoHero.astro';
import ManifestoNavigation from '../components/living/ManifestoNavigation.astro';
import ManifestoBody from '../components/living/ManifestoBody.astro';
const title = "The Living Documents Manifesto \u00b7 Orionfold";
const description = "Eighteen ideas for Living Documents: work that continues, judgment that stays yours, and more room for the researcher, writer and builder in you.";
const og = ogMeta('/manifesto/');
const pageSchema = {'@context':'https://schema.org','@type':'Article',datePublished:'2026-09-06T00:00:00.000Z',dateModified:'2026-09-06T00:00:00.000Z',headline:title,description,author:PERSON,publisher:{'@type':'Organization',name:SITE.name,url:SITE.url},mainEntityOfPage:`${SITE.url}/manifesto/`,image:`${SITE.url}${og.image}`};
---
<Layout title={title} description={description} ogImage={og.image} ogImageAlt={og.alt} bodyClass="ls ls-page-manifesto" jsonLd={pageSchema} ogType="article" article={{datePublished:"2026-09-06",dateModified:"2026-09-06",author:"Manav Sehgal",section:"Living Documents"}}>
  <Nav />
  <main id="main" class="ls-main">
    <ManifestoHero />
    <ManifestoNavigation />
    <ManifestoBody />
  </main>
  <Footer />
</Layout>
<script>
  import "../scripts/living-documents.js";
</script>
