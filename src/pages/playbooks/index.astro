---
// /playbooks/ in Paper (R5, G-144), culled like the home: one idea per panel,
// long lists behind "What … includes" toggles, one primary action per band.
// The H1 is the plain promise (review 2026-10-28); the operator's selected line
// (PR/FAQ, 2026-10-26) rides under it as the tagline. The audience, business
// model and comparisons follow the Flow PR/FAQ inside its own limits: the buyer
// is a subject matter expert serving their own clients; publishing has no
// per-Playbook fee (it needs Pro plus the Publish add-on); bringing a Playbook in
// is free on Base and Chat on it needs Pro (product 0284, DR-023); the door
// for your own agents (Flow MCP, Settings ▸ General ▸ Your agents) is a Pro
// feature (operator 2026-10-28); publishing does not bring customers. Every walk
// number comes from the AI Consulting journals via the launch article.
// Left this page in R5 (named in the release notes): the loop figure, the
// "keep your tools" pairs (the Compare pages own them) and the How-it-moves
// band head (its payload figure stays).
import { Image } from 'astro:assets';
import PaperLayout from '../../layouts/PaperLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Panel from '../../components/paper/Panel.astro';
import Fold from '../../components/paper/Fold.astro';
import PageNav from '../../components/paper/PageNav.astro';
import WhyNow from '../../components/paper/WhyNow.astro';
import PlaybookSheet from '../../components/paper/PlaybookSheet.astro';
import DomainAnatomy from '../../components/flow/domains/DomainAnatomy.astro';
import DomainPayload from '../../components/flow/domains/DomainPayload.astro';
import { publishedDomainArticles, domainArticleHref, isBlueprint } from '../../lib/flow/domains';
import { elementDrawing } from '../../lib/flow/elements';
import { FOLDS } from '../../lib/paper/folds';
import { ogMeta } from '../../data/og';
import { SITE, PERSON } from '../../data/seo';
import { ORIONFOLD_FLOW_LIVE } from '../../data/launch';
import { FLOW_DMG_URL, FLOW_SYSTEM_REQUIREMENT } from '../../data/flow-pricing';
import '../../styles/living-base.css';
import '../../styles/living-in-paper.css';
import '../../styles/domains.css';

// The founder's built Playbooks (operator 2026-10-29), the launch story first,
// then the blueprints (G-135) in the PR/FAQ's order, each an invitation to build.
const articles = await publishedDomainArticles();
const [launch] = articles;
const blueprints = articles.filter(isBlueprint);
const founders = articles.filter((a) => !isBlueprint(a));
const FOLD_BY_SLUG = Object.fromEntries(FOLDS.map((f) => [f.domainSlug, f])) as Record<string, (typeof FOLDS)[number]>;
const title = 'Flow Playbooks: your expertise as a living system | Orionfold';
const description = 'Turn the method you use with clients into a Flow Playbook. Co-author living documents with any AI, review them, publish to GitHub and keep them current.';
const og = ogMeta('/playbooks/');
const downloadHref = ORIONFOLD_FLOW_LIVE ? FLOW_DMG_URL : '/#waitlist';
const downloadLabel = ORIONFOLD_FLOW_LIVE ? 'Download Flow for Mac' : 'Join the waitlist';

const PAINS = [
  { k: 'Every client starts from a blank chat.', v: 'Your method lives in your head, old decks and a dozen past conversations. On each new job you explain it to the AI again.' },
  { k: 'Last month’s fix is gone.', v: 'You corrected the AI on a client job. The next session does not know. The lesson stays in that one file.' },
  { k: 'The draft is fast. Checking it is not.', v: 'AI writes in seconds. Then you spend the evening making sure it says what you mean before a client sees it.' },
];
// Two days, as the walk journals record them (October 25 and 26, 2026); the
// Primer landed at 00:32 on the night of day one.
const TIMELINE = [
  { day: 'Day 1 · October 25', t: '10:55', k: 'An empty folder', v: 'Chat is ready before any document exists.' },
  { t: '11:09', k: 'The front page', v: 'Chat writes the README in the author’s voice: 788 words, 2 claims marked to check.' },
  { t: '11:32', k: 'An old AI chat, cleaned up', v: '24 Amazon mechanisms come in with their links, then get 14 sources.' },
  { t: '18:45', k: 'The first figure', v: 'Ideas picks a Skill. About a minute later, a stepped figure waits in Review.' },
  { t: '00:32', k: 'The next document, past midnight', v: 'The Mechanisms Primer, built from the author’s own pages in under 2.5 minutes.' },
  { day: 'Day 2 · October 26', t: '', k: 'Review cuts the path', v: 'Six documents become four, and every page that pointed at the old path follows.' },
  { t: '21:31', k: 'Published', v: 'Publish ▸ GitHub Repository: 6 files sent, nothing else touched.' },
  { t: '21:54', k: 'An update reaches a reader', v: 'A licence is added. The reader’s copy shows the change to review.' },
];
const COUNT_WORD: Record<number, string> = { 2: 'Two', 3: 'Three', 4: 'Four', 5: 'Five' };
const WALK_DAYS = TIMELINE.reduce<{ day: string; items: typeof TIMELINE }[]>((days, s) => {
  if (s.day) days.push({ day: s.day, items: [] });
  days[days.length - 1].items.push(s);
  return days;
}, []);
// Earn a conversation (review 2026-10-28, A5): one email, the four PULL
// fields, no form and no backend. manav@orionfold.com is the public contact.
const TALK = `mailto:manav@orionfold.com?subject=${encodeURIComponent('My first Playbook')}&body=${encodeURIComponent('The client job I would build a Playbook for:\n\nWhen it is due:\n\nWhat I use for it today:\n\nWhat gets in the way:\n')}`;
// Why now (review 2026-10-28, A1): the forcing event the Compare page already
// documents, with its dated source.
const NOW = {
  source: { label: 'OpenAI Help: Custom GPT retirement and migration FAQ', href: 'https://help.openai.com/en/articles/20001519-custom-gpt-retirement-and-migration-faq', checked: '2026-10-27' },
};
// One relevant reader (review 2026-10-28, G5): the first buyer, then the two
// nearest roles from the lane's ICP list (ranks 2 and 4).
// Keep acronyms (AI, HR, CFO) as they are when a role starts a phrase mid-sentence.
const lowerFirst = (s: string) => (/^[A-Z]{2}/.test(s) ? s : s.charAt(0).toLowerCase() + s.slice(1));
const ROLES = ['AI and management consultants', 'Learning designers and trainers', 'Fractional CFOs and finance advisors'];
const TERMS = [
  { k: 'You subscribe to Flow. Your clients pay you.', v: 'You set the offer, the price and the terms. Flow is not in between you and your clients.' },
  { k: 'No fee per Playbook.', v: 'Publishing needs Flow Pro and the Publish add-on, $10 a month each. Then publish as many Playbooks as you like. AI runs follow the terms of the service you connect.' },
  { k: 'The method stays yours.', v: 'Plain files in your own repository, under the licence you choose, with your name on them.' },
];
const FORMATS = [
  { k: 'A GitHub repository', v: 'Readers bring the folder into Flow with one address, and get your updates as changes they review.', walked: true },
  { k: 'A GitHub Pages site', v: 'A website for your method. Figures play step by step.' },
  { k: 'PDF and EPUB', v: 'A guide or a book in a form every client can open.' },
  { k: 'Word, Excel and PowerPoint', v: 'Deliverables your client’s team already works in.' },
];
const FAQ = [
  { q: 'What is a Flow Playbook?', a: 'A folder of living documents that carries your method. It holds what you know, the sources behind it, worked examples, and tools a reader can use on their own work. It carries your name, a version and a licence, and every file is plain Markdown you own.' },
  { q: 'Do I need to code?', a: 'No. You write with Chat, add figures and tables with Skills and Elements, review every change, and publish from a menu. The one-time setup is a GitHub account and a token for publishing.' },
  { q: 'What does it cost to publish a Playbook?', a: 'Publishing needs Flow Pro ($10 a month) and the Publish add-on ($10 a month). There is no fee per Playbook, so publish as many as you like. Bringing a Playbook in is free on Base. Chat on it, and the door for your own agents, need Flow Pro. Any AI you use follows the terms of the service you connect.' },
  { q: 'Can my clients use it without Flow?', a: 'Yes. They can read the website, the PDF or the EPUB, or open the Office files. In Flow they also get Chat on the Playbook, figures they can press and step through, and your updates.' },
  { q: 'What happens to client material?', a: 'Your documents stay in your files. Before a run leaves your Mac, Flow shows where it is going and asks. Publishing is a separate step you take yourself, so check the files and the repository’s visibility first.' },
  { q: 'Can I take a blueprint and launch it as my own Playbook?', a: 'Yes. That is what the blueprints are for. Each one is a plan, not a product. Build it in Flow from your own know-how, put your name, your version and your licence on the README, and publish it to your own GitHub. If you do, write to Manav. The next walkthrough on this page could be yours.' },
  { q: 'Will publishing a Playbook bring me clients?', a: 'Not on its own. Publishing gives people a way to find and use your work. You still need a clear offer, the right clients and a reason for them to choose you. Flow does not promise leads or revenue.' },
];
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage',
    name: 'Flow Playbooks', description, url: `${SITE.url}/playbooks/`, author: PERSON,
    mainEntity: { '@type': 'ItemList', itemListElement: articles.map((a, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Article', name: a.data.title, url: `${SITE.url}${domainArticleHref(a.id)}` } })) },
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Playbooks', item: `${SITE.url}/playbooks/` }] },
];
---
<PaperLayout title={title} description={description} ogImage={og.image} ogImageAlt={og.alt} jsonLd={schema}>
  <Nav />
  <main id="main" class="pp-page" data-ls-root>
    <section class="pp-hero pp-hero--inner pp-hero--play" aria-labelledby="pb-title">
      <div class="pp-hero-copy">
        <span class="pp-kicker">Flow Playbooks</span>
        <h1 id="pb-title" class="pp-h1">Write your method once.<br /><em>Every client gets the living version.</em></h1>
        <p class="pp-sub">Easily co-author with any AI once, one-click publish as AI system everywhere.</p>
        <div class="pp-hero-cta">
          <a class="pp-btn" href={domainArticleHref(launch.id)}>Read the launch story</a>
          <a class="pp-btn pp-btn--ghost" href="#dm-blueprints">Pick a blueprint</a>
          <small>Bringing a Playbook in is free on Base.</small>
        </div>
      </div>
      <div class="pp-hero-stage">
        <PlaybookSheet fold="tally" note="A Playbook, at its smallest. Step 3 stays yours." />
      </div>
    </section>

    <PageNav label="Playbooks navigation" onPage={[
      { href: '#dm-what', label: 'What it is' },
      { href: '#dm-founder', label: 'Built so far' },
      { href: '#dm-blueprints', label: 'Blueprints' },
      { href: '#dm-yours', label: 'Your service' },
      { href: '#dm-faq', label: 'Questions' },
    ]} pages={[
      { href: '/flow/', label: 'Flow' },
      { href: '/flow/paths/', label: 'Paths' },
      { href: '/flow/elements/', label: 'Elements' },
      { href: '/flow/compare/', label: 'Compare' },
    ]} />

    <Panel id="dm-pain" seam="The problem" fold="sprout" title="You have the method.<br />It keeps starting over." lede="A Playbook keeps your method, its sources and your corrections in one place, so the next client starts from what you already learned.">
      <ul class="pp-play-pains">{PAINS.map((p) => <li><b>{p.k}</b><span>{p.v}</span></li>)}</ul>
      <WhyNow href="/flow/compare/custom-gpts/" cta="Move a GPT's method into a Playbook"><span class="pp-kicker">Why now</span><br /><b>OpenAI retires custom GPTs on December 11, 2026.</b> A Playbook is plain Markdown in your own GitHub, and the files still open anywhere.</WhyNow>
      <p class="pp-play-src"><a href={NOW.source.href}>Source: {NOW.source.label}, checked {NOW.source.checked} ↗</a></p>
    </Panel>

    <Panel id="dm-what" seam="What a Playbook is" fold="orri" tinted title="One folder.<br />Everything you know about the job." lede="Your know-how, your sources, and tools your clients use on their own work. Here is the first one, file by file, as it sits on GitHub.">
      <div class="ls ls-in-paper"><DomainAnatomy repo={launch.data.repo} /></div>
      <details class="pp-more">
        <summary>How it travels to a client</summary>
        <p>From your Mac to your client's Flow, or to their agent through Flow. {launch.data.domain} travels as 6 files and 75 KB. Publish again, and every client gets a change to review.</p>
        <div class="ls ls-in-paper"><DomainPayload /></div>
      </details>
    </Panel>

    <Panel id="dm-founder" seam="Built so far" fold="atlas" title={`${COUNT_WORD[founders.length] ?? founders.length} Playbooks,<br />built and published.`} lede="Manav Sehgal built each one in Flow and published it to GitHub. Each took about three hours of hands-on work, and no run cost anything on top of a Claude subscription.">
      <ul class="pp-play-founders">
        {founders.map((f, i) => (
          <li>
            <a class="pp-play-shot" href={domainArticleHref(f.id)} tabindex="-1" aria-hidden="true"><Image src={f.data.hero!} alt="" widths={[640, 960, 1280]} sizes="(max-width: 900px) 92vw, 600px" loading="lazy" /></a>
            <span class="pp-kicker">{i === 0 ? 'The launch story' : 'Founder Playbook'} · {f.data.role}</span>
            <h3><a href={domainArticleHref(f.id)}>{f.data.domain}</a></h3>
            <p>{f.data.hook}</p>
            <dl class="pp-facts">
              <div><dt>Files</dt><dd>{f.data.files} Markdown, {f.data.size}</dd></div>
              <div><dt>Hands-on</dt><dd>{f.data.time}</dd></div>
              <div><dt>Licence</dt><dd>{f.data.licence}</dd></div>
            </dl>
            <p class="pp-play-links"><a href={domainArticleHref(f.id)}>Read how it was built →</a><a href={f.data.repo}>Get it on GitHub ↗</a></p>
          </li>
        ))}
      </ul>
      <details class="pp-more">
        <summary>The first one, hour by hour</summary>
        <p>{launch.data.domain} turns nine years of Amazon mechanisms into a path for adopting AI. Here is its walk across two days.</p>
        <div class="pp-play-walk">
          {WALK_DAYS.map((g) => (
            <ol>
              <li class="pp-play-day" aria-label={g.day}><span>{g.day}</span></li>
              {g.items.map((s) => <li>{s.t ? <time>{s.t}</time> : <span aria-hidden="true"></span>}<span><b>{s.k}</b> {s.v}</span></li>)}
            </ol>
          ))}
        </div>
      </details>
    </Panel>

    {blueprints.length > 0 && (
      <Panel id="dm-blueprints" seam="Blueprints" fold="ember" tinted title="Use a Blueprint<br />to create your own Playbook." lede="Blueprints we give away, one per field. Each shows what the Playbook would hold, the signals behind it, and the Flow steps to build it. Take yours, put your name on it, and launch it. None of them is built yet.">
        <ul class="pp-play-cards">
          {blueprints.map((b) => {
            const fold = FOLD_BY_SLUG[b.id];
            return (
              <li>
                <a href={domainArticleHref(b.id)}>
                  {fold
                    ? <span class="pp-ico pp-play-ico" style={`background:${fold.c}66`}><Fold id={fold.id} /></span>
                    : <span class="pp-ico pp-ico--drawing" style={`background:${b.data.tint}`} set:html={elementDrawing(b.data.icon)} />}
                  <h3>{b.data.domain}</h3>
                  <p>{b.data.hook}</p>
                  <span class="pp-card-tag">For {lowerFirst(b.data.role)}</span>
                </a>
              </li>
            );
          })}
          <li class="pp-play-yours">
            <a href={TALK}>
              <span class="pp-ico" aria-hidden="true">+</span>
              <h3>Your field is not here?</h3>
              <p>Tell Manav the client job you would build a Playbook for. The next blueprint could be yours.</p>
              <span class="pp-card-tag">Write to Manav</span>
            </a>
          </li>
        </ul>
      </Panel>
    )}

    <Panel id="dm-yours" seam="Your service" fold="clause" title="Your expertise.<br />Your clients. Your brand." lede={`Built first for ${ROLES[0]}. It fits any expert with a method they apply again and again, like ${lowerFirst(ROLES[1])} or ${lowerFirst(ROLES[2])}.`}>
      <ul class="pp-play-terms">{TERMS.map((t) => <li><b>{t.k}</b><span>{t.v}</span></li>)}</ul>
      <details class="pp-more">
        <summary>What publishing includes <em>{FORMATS.length}</em></summary>
        <p>Chat on the Playbook and its interactive tools stay in Flow. Exported files are for reading and delivery.</p>
        <ul class="pp-play-formats">{FORMATS.map((f) => <li><b>{f.k}</b><span>{f.v}</span>{f.walked && <small>Walked end to end for the first Playbook</small>}</li>)}</ul>
      </details>
      <div class="pp-play-talk">
        <p><b>Talk about your first Playbook.</b> Email Manav the client job you would build it for, when it is due, what you use today, and what gets in the way. You get one reply, not a list.</p>
        <a class="pp-btn" href={TALK}>Write to Manav</a>
      </div>
    </Panel>

    <Panel id="dm-mcp" seam="Flow MCP · Your agents" fold="shell" tinted title="Your agents,<br />on your Playbooks.">
      <p class="pp-play-prose">In Settings ▸ General ▸ Your agents, open Flow to the Claude Code or Codex you run in Terminal, as Read or Read and propose. Your agent can read a Playbook's summary and reading order, read and search its documents, and read a skill's method, then apply your method to the work it does for you. A document it proposes comes back to Review Changes under its name, and Flow keeps a log of each call. The door is open only while Flow is, and it needs Flow Pro.</p>
      <p class="pp-panel-link"><a href="/flow/compare/">Keep the tools you already trust. See the side-by-side comparisons <span aria-hidden="true">→</span></a></p>
    </Panel>

    <Panel id="dm-faq" seam="Questions" fold="hop" title="Before you<br />build your first.">
      <div class="pp-faq">{FAQ.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </Panel>

    <section class="pp-closing" data-cta-placement="closing" aria-labelledby="pb-closing-heading">
      <Fold id="orri" bob class="pp-closing-fold" />
      <h2 id="pb-closing-heading">Bring the first Playbook into Flow.</h2>
      <p>Download Flow, choose File ▸ New from GitHub…, and paste the address of AI Consulting. Then pick one real client task and work along the path.</p>
      <a class="pp-btn" href={downloadHref} data-flow-download={ORIONFOLD_FLOW_LIVE ? 'flow-domains-index' : undefined}>{downloadLabel}</a>
      <small>{FLOW_SYSTEM_REQUIREMENT}</small>
    </section>
  </main>
  <Footer showDownload={false} />
</PaperLayout>
