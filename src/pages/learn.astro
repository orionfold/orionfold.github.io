---
import PaperLayout from '../layouts/PaperLayout.astro';
import Panel from '../components/paper/Panel.astro';
import Fold from '../components/paper/Fold.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import { books } from '../data/books';
import { ogMeta } from '../data/og';
import aiNativeBusinessCover from '../assets/book/ai-native-business-book.jpg';
import aiNativePlatformCover from '../assets/book/ai-native-platform-book.jpg';
import aiResearchSparkCover from '../assets/book/ai-research-dgx-spark-book.jpg';
import sparkHero from '../assets/dgx-spark/hero.jpg';
import storyHero from '../assets/story/building-in-public/hero.jpeg';

const og = ogMeta('/learn/');

// The three teaching paths, each led by the real art its destination leads with.
const learning = [
  { label: 'Books', href: '/books/', img: aiNativeBusinessCover, alt: 'AI Native Business book cover', body: 'Implementation playbooks for the business, the platform, and the DGX Spark research path.' },
  { label: 'Field lab', href: '/dgx-spark/', img: sparkHero, alt: 'A small desktop computer sending beams of light into a starry sky', body: 'The customer-controlled hardware story, grounded in the DGX Spark reference platform.' },
  { label: 'Stories', href: '/story/', img: storyHero, alt: 'Building in public story artwork', body: 'Build-log essays that show the decisions, failures, and working systems behind the stack.' },
];

const bookCovers: Record<string, ImageMetadata> = {
  'ai-native-business': aiNativeBusinessCover,
  'ai-native-platform': aiNativePlatformCover,
  'ai-research-on-nvidia-dgx-spark': aiResearchSparkCover,
};
---
<PaperLayout
  title="Learn · Orionfold"
  description="Books, field notes, DGX Spark research, and story posts from Orionfold."
  ogImage={og.image}
  ogImageAlt={og.alt}
>
  <Nav />
  <main id="main" class="pp-page">
    <section class="pp-hero pp-hero--inner pp-hero--solo" aria-labelledby="learn-title">
      <div class="pp-hero-copy">
        <p class="pp-kicker">Learn</p>
        <h1 id="learn-title" class="pp-h1">The playbooks behind the stack.</h1>
        <p class="pp-sub">Books, field notes, DGX Spark research, and build stories explain how the private AI capability is made. The teaching layer stays linked to the software, models, and roadmap.</p>
      </div>
    </section>

    <section class="pp-index" aria-label="Ways to learn">
      <ul class="pp-art-cards pp-art-cards--3">
        {learning.map((item) => (
          <li><a href={item.href}>
            <Image src={item.img} alt={item.alt} widths={[400, 640]} sizes="(min-width: 1100px) 30vw, (min-width: 420px) 46vw, 92vw" loading="lazy" data-no-zoom />
            <p class="pp-kicker">{item.label}</p>
            <p>{item.body}</p>
          </a></li>
        ))}
      </ul>
    </section>

    <Panel id="books" seam="Current books" fold="hop" title="Read it,<br />then run it.">
      <ul class="pp-art-cards pp-art-cards--3 pp-art-cards--covers">
        {books.map((book) => (
          <li><a href={`/books/${book.slug}/`}>
            {bookCovers[book.slug] && <Image src={bookCovers[book.slug]} alt={`${book.title} book cover`} widths={[300, 480]} sizes="(min-width: 1100px) 30vw, (min-width: 420px) 46vw, 92vw" loading="lazy" data-no-zoom />}
            <h3>{book.title}</h3>
            <p>{book.body}</p>
          </a></li>
        ))}
      </ul>
      <p class="pp-panel-link"><a href="/books/">All books <span aria-hidden="true">→</span></a></p>
    </Panel>

    <section class="pp-closing" aria-labelledby="learn-closing">
      <Fold id="hop" live class="pp-closing-fold" />
      <h2 id="learn-closing">Start with the free book.</h2>
      <p>Become an AI-native business. The PDF and EPUB, by email.</p>
      <a class="pp-btn" href="/become-ai-native-business/">Get the free book</a>
    </section>
  </main>
  <Footer showDownload={false} />
</PaperLayout>
