---
// /cockpit/ — the Arena cockpit offer page (footer-linked; /arena/ is the
// canonical landing). R7d (G-146): a Paper page, the Field Edition band in the
// tw-in-paper bridge, the cockpit shot in a window frame, cells and art cards.
import { Image } from 'astro:assets';
import PaperLayout from '../layouts/PaperLayout.astro';
import Panel from '../components/paper/Panel.astro';
import Media from '../components/paper/Media.astro';
import ProofArtCards from '../components/paper/ProofArtCards.astro';
import '../styles/living-in-paper.css';
import '../styles/paper-bridge-product.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FieldEditionBand from '../components/sections/FieldEditionBand.astro';
import { flagshipById } from '../data/flagship-offers';
import { ogMeta } from '../data/og';
import arenaCockpit from '../assets/projects/arena/cockpit.png';

const offer = flagshipById.cockpit;
const og = ogMeta('/cockpit/');

const moves = [
  { label: 'Compare', body: 'Run models side by side, track speed and memory, and keep a local leaderboard.' },
  { label: 'Remember', body: 'Index notes and documents with source trails so recall can be tested, not guessed.' },
  { label: 'Evaluate', body: 'Score behavior, benchmarks, and regressions before a workflow is trusted.' },
  { label: 'Ship', body: 'Turn working local patterns into repeatable artifacts and guides.' },
];
---
<PaperLayout
  title="Arena for DGX Spark · Orionfold"
  description="Orionfold Arena is the cockpit for private AI. Compare, remember, evaluate, and ship local AI work. Arena Field Edition delivers the whole stack on your NVIDIA DGX Spark as a turnkey, proven lab."
  ogImage={og.image}
  ogImageAlt={og.alt}
>
  <Nav />
  <main id="main" class="pp-page">
    <section class="pp-hero pp-hero--relay" aria-labelledby="cockpit-title">
      <div class="pp-hero-copy">
        <p class="pp-kicker">Arena</p>
        <h1 id="cockpit-title" class="pp-h1">The cockpit that makes your Spark a private AI lab.</h1>
        <p class="pp-sub">Arena is the visible cockpit for local AI. Compare models, remember with provenance, evaluate, and ship. The Field Edition installs the whole stack on your NVIDIA DGX Spark as a turnkey, proven lab, with Cortex for memory and fieldkit for the reusable patterns.</p>
        <div class="pp-hero-cta">
          <a href="/arena/#get-arena" class="pp-btn">Get Arena Field Edition <span aria-hidden="true">→</span></a>
          <a href="/arena/demo/" class="pp-btn pp-btn--ghost">Watch the demo</a>
        </div>
      </div>
      {/* The cockpit itself: a real Arena screenshot, not a description of one. */}
      <div class="pp-hero-stage">
        <Media caption={"Local models side by side, with live speed and memory. Nothing you type leaves your machine."}>
          <Image
            src={arenaCockpit}
            alt="The Orionfold Arena cockpit running local models side by side with live speed and memory telemetry."
            widths={[720, 1080, 1440]}
            sizes="(min-width: 860px) 50vw, 100vw"
            loading="eager"
            decoding="async"
            data-no-zoom
          />
</Media>
      </div>
    </section>

    <div class="tw-in-paper pd-paper pd-relay-bridge"><FieldEditionBand /></div>

    <Panel id="cockpit-moves" seam="What the cockpit does" fold="tally" tinted>
      <ul class="pp-cells pp-cells--4 pp-arena-moves">
        {moves.map((m) => (<li><b>{m.label}</b><span>{m.body}</span></li>))}
      </ul>
    </Panel>

    <Panel id="cockpit-proof" seam="The stack around the cockpit" fold="atlas">
      <ProofArtCards links={offer.proof} />
      <p class="pp-panel-note"><a href="/software/">All software →</a></p>
    </Panel>
  </main>
  <Footer showDownload={false} />
</PaperLayout>
