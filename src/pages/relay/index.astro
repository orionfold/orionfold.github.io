---
// /relay/ — Orionfold Relay, the free and open engine for AI agents and
// workflows (the npm package `orionfold-relay`, the former open ainative-business
// engine, renamed). The page states the free-vs-paid boundary plainly, shows the
// premium packs a license unlocks, then the buy block. Built dark (buy buttons
// gated by ORIONFOLD_RELAY_LIVE) while the live prices + fulfilment go live.
//
// Content source (relay later-10, 2026-06-30): mirrored from the peer's canonical
// README (~/orionfold/relay/README.md, commit 1b0b1720) — the constellation
// framing, the agency operating-model table, the five gaps, and the AWS
// personal-project disclaimer (verbatim, it's compliance). Substance + structure
// mirror the README; the voice is retuned to the site rule (grade 3-5, jargon
// explained, em-dashes stripped — the README's polished-pro voice has both). The
// free-vs-paid boundary is the one thing NOT in the README yet (it predates the
// licensing work), sourced to the actual owns_product() gate per the peer's
// later-10 §(a)(2) so page and package agree. Product screenshots for the in-page
// proof sections are pending a fresh DARK-theme Relay-branded set (relay later-14;
// the ones the README hotlinks are stale legacy "ainative" UI). Voice: grade 3-5,
// jargon explained, no em-dashes (website-copy-style).
//
// R7c (G-146): a Paper page, culled like the home. The board shot is the hero
// stage; one panel per idea (proof, how it works, built for an agency, free vs
// paid, security). Problem, Solution and Under the hood left the page (their
// gaps, personas and counts repeat the agency map and the five gaps), and so
// did the trust trio (the security answers link the same three pages). The buy
// blocks, license band and sticky bar keep their markup inside the tw-in-paper
// bridge, with every data-checkout, data-item and data-error-target.
import { Image } from 'astro:assets';
import PaperLayout from '../../layouts/PaperLayout.astro';
import PageNav from '../../components/paper/PageNav.astro';
import Panel from '../../components/paper/Panel.astro';
import Media from '../../components/paper/Media.astro';
import PaperSubscribe from '../../components/paper/PaperSubscribe.astro';
import '../../styles/living-in-paper.css';
import '../../styles/paper-bridge-product.css';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import RelayBox from '../../components/product/RelayBox.astro';
import RelayHostBox from '../../components/product/RelayHostBox.astro';
import RelayShowcase from '../../components/product/RelayShowcase.astro';
import LandingStickyCta from '../../components/product/LandingStickyCta.astro';
import LicenseBand from '../../components/product/LicenseBand.astro';
import ProductLineRail from '../../components/product/ProductLineRail.astro';
import { RELAY_PAGES } from '../../lib/relay/pages';
import { ORIONFOLD_RELAY_LIVE } from '../../data/launch';
import relayPoster from '../../assets/projects/orionfold-relay-poster.jpeg';
import relayBoardShot from '../../assets/relay/home-list.png';
import relayCostReceipt from '../../assets/relay/customers-detail.png';
import { SITE, PERSON } from '../../data/seo';
import { RELAY, RELAY_HOST, formatUsd } from '../../data/commerce';
import { RELAY_HOST_LIVE } from '../../data/launch';
import { ogMeta } from '../../data/og';

const og = ogMeta('/relay/');
const relayUrl = `${SITE.url}/relay/`;
const ogImageAbs = `${SITE.url}${og.image}`;

// Merchant-listings completeness for the priced Offer below. Same honest values
// as ProductDetail.astro / ProofBox: Orionfold Relay is an instant digital
// license from a US LLC, so free "shipping" (nothing physical) + no returns (a
// delivered, signed license file can't be returned).
const digitalMerchantFields = {
  hasMerchantReturnPolicy: {
    '@type': 'MerchantReturnPolicy',
    applicableCountry: 'US',
    returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted',
  },
  shippingDetails: {
    '@type': 'OfferShippingDetails',
    shippingRate: { '@type': 'MonetaryAmount', value: '0', currency: 'USD' },
    shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'US' },
  },
};

// SoftwareApplication + Offer so /relay/ reads as the buyable product for answer
// engines. Price = the standard $499 (the durable price after the founding seats
// sell out); the catalog SSOT is the source, never a hardcoded number.
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Orionfold Relay',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux',
  description:
    'The free and open engine for AI agents and workflows. Install it with npm, run your agents from one place, and unlock premium packs you own with a license.',
  url: relayUrl,
  image: ogImageAbs,
  author: PERSON,
  brand: { '@type': 'Brand', name: 'Orionfold' },
  offers: {
    '@type': 'Offer',
    price: (RELAY.primary.amount / 100).toFixed(2),
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: relayUrl,
    category: 'Software license',
    ...digitalMerchantFields,
  },
};

const relayHostSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Orionfold Relay Host',
  description:
    'An annual offline-verifiable right to run one Relay Host with up to ten managed customer Cells. Premium Packs are separate.',
  url: `${relayUrl}#get-relay-host`,
  brand: { '@type': 'Brand', name: 'Orionfold' },
  offers: {
    '@type': 'Offer',
    price: (RELAY_HOST.amount / 100).toFixed(2),
    priceCurrency: 'USD',
    availability: RELAY_HOST_LIVE
      ? 'https://schema.org/InStock'
      : 'https://schema.org/OutOfStock',
    url: `${relayUrl}#get-relay-host`,
    category: 'Annual software license',
    hasMerchantReturnPolicy: {
      '@type': 'MerchantReturnPolicy',
      applicableCountry: 'US',
      returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
      merchantReturnDays: RELAY_HOST.refundDays,
      returnMethod: 'https://schema.org/KeepProduct',
      returnFees: 'https://schema.org/FreeReturn',
      refundType: 'https://schema.org/FullRefund',
    },
    shippingDetails: digitalMerchantFields.shippingDetails,
  },
};

// What you get free vs what a license unlocks. Stated plainly as a table so the
// boundary can't be overclaimed (same free-vs-paid discipline as Proof).
// Free-vs-paid, sourced to the real CLI gate (owns_product() → product:orionfold-relay,
// relay later-10 §(a)(2)) so the page and the package agree. The engine is a complete,
// free operations layer; a license adds premium packs + updates, not core function.
const freeVsPaid = [
  { free: 'The full engine and command-line tool, forever', paid: 'Premium packs you own' },
  { free: 'Run your own copy, your data stays on your machine', paid: 'One license unlocks every premium pack, not one at a time' },
  { free: 'All 21 agents and 15 service templates', paid: 'The agency pack, with real-estate and nonprofit agents, blueprints, and a customer setup' },
  { free: 'Build apps, track per-client cost, add free and open packs', paid: 'New packs and pack updates for 12 months' },
];

// Proof-band stats: one even row of three, the receipt shot under them.
const statTiles = [
  { label: 'AI spend, 30 days', value: '$0.05', sub: '6 runs · 32,150 tokens' },
  { label: 'Retainer (illustrative)', value: '~$500<small>/mo</small>', sub: 'Property-management client' },
  { label: 'What you see', value: 'Real margin', sub: 'Tallied per client, per run' },
];

// The concrete premium pack that exists today plus the named roadmap packs, shown
// as breadth (Gap #6). Only the agency pack has SHIPPED (relay entry); the rest are
// honestly tagged "Planned" so the vertical-pack rail is visible without overclaiming.
const shippedPack = {
  name: 'Agency pack',
  job: 'Run a client agency',
  dek: 'A ready-made setup for agency work in real estate and nonprofits: 7 agents, 8 blueprints, and a customer setup you drop in instead of wiring from scratch.',
};
const plannedPacks = [
  { name: 'Marketer pack', job: 'Run marketing work' },
  { name: 'Investor pack', job: 'Run investor updates' },
  { name: 'Operations pack', job: 'Run back-office ops' },
];

// The agency operating-model mapping (README "Built for an agency"): how the work
// you already do maps to a Relay building block. Rendered as transformation cards
// (your term -> arrow -> Relay block) with a per-row icon so the "maps straight
// onto Relay" claim is visible, not just stated. Icon = inner paths of a Lucide
// glyph; jargon spelled out in plain words.
const operatingModel = [
  { you: 'Clients', them: 'Projects', note: 'One workspace per client, with their own notes the agents read on their own.', icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>' },
  { you: 'Kinds of work', them: 'Agents', note: '21 ready-made agents, each tuned for a job like lease review or grant research.', icon: '<path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/>' },
  { you: 'Services', them: 'Blueprints', note: '15 templates. A packaged service you set up once and run for each client.', icon: '<rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/>' },
  { you: 'Deliverables', them: 'Schedules', note: 'Weekly digests, monthly statements, and deadline watches that run on their own.', icon: '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>' },
  { you: 'Billing', them: 'Cost and usage', note: 'Per-client spend you can see, so the retainer maps to real cost.', icon: '<line x1="12" x2="12" y1="2" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>' },
  { you: 'Sign-off', them: 'Inbox', note: 'Every client-facing result goes through your approval, with a full record.', icon: '<path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>' },
];

// The five gaps every AI agency hits (README), retuned to plain voice.
const gaps = [
  { title: 'Many steps, one run', body: 'Real client work is a chain. Take it in, do it, check it, send it. Relay runs the whole sequence with checkpoints, so you are not gluing steps together by hand.' },
  { title: 'Your words, the agent’s work', body: 'You think in clients, services, and deliverables. Agents think in prompts. Projects, agents, and blueprints give both a shared language.' },
  { title: 'The whole life of a job', body: 'A deliverable needs scheduling, retries, a way to pick up where it left off, cost tracking, and a record. Relay carries all of it.' },
  { title: 'Trust and sign-off', body: 'Agents that read client files and draft client-facing work need guardrails. Relay routes every result through your approval and keeps the trail funders and stakeholders ask for.' },
  { title: 'One command to start', body: 'Standing up a workspace should not mean cloning a repo and wiring a database. Relay is one command, no setup, and your data stays on your machine.' },
];

// Security and trust (relay later-4 FYI + issue #17 / security-packet.md). Turns
// the four questions a security review asks into plain answers, each linking the
// on-site /trust/ page (which mirrors the canonical Relay repo doc; re-sync in
// src/data/trust-pages.ts when the repo docs change). Marketing-facing rewrite of
// the evaluator-facing source: grade 3-5, jargon spelled out, hard proof one
// click away. `href` is the on-site trust page that backs the claim.
const trust = [
  {
    q: 'Does Relay send our data to you?',
    a: 'No. Relay never sends your data to Orionfold. It runs on your own machine, with no tracking, no usage reporting, and no license check-ins. When it reaches out at all, it only reads public sources, like the one-time, checked download of the app itself from GitHub. Anything that can leave your machine, like the AI models you pick, is listed in full with an off switch.',
    label: 'See every network call',
    href: '/trust/data-flow/',
  },
  {
    q: 'What data do you hold about us?',
    a: 'Only your purchase record. Everything the product touches, your projects, tasks, documents, and history, lives in a file on your own machine. AI work runs through your own model accounts, not ours. We run no service in the middle, so there is nothing for us to hold and no data agreement to chase.',
    label: 'Read the security packet',
    href: '/trust/security-packet/',
  },
  {
    q: 'Can we trust what we install?',
    a: 'Yes, and you can check it before you run it. Every release is published straight from our build with a signed record of where it came from, and ships a full parts list of what is inside. The download is checked against a fingerprint before it opens. Nothing updates itself, so the version you reviewed stays the version you run.',
    label: 'See the supply chain',
    href: '/trust/supply-chain/',
  },
  {
    q: 'What if you disappear?',
    a: 'You keep everything. The engine is open source, your data is on your machine, and your license works offline forever. If Orionfold went away tomorrow, your setup keeps running. The honest edge cases are written down too.',
    label: 'Read the continuity note',
    href: '/trust/continuity/',
  },
];
---
<PaperLayout
  title="Orionfold Relay · Run AI client work, see each client's cost"
  description="Run your AI agents for real client work on your own machine. Nothing leaves it. See what each client costs, approve every result before it ships, and own it forever."
  ogImage={og.image}
  ogImageAlt={og.alt}
  jsonLd={[
    softwareSchema,
    relayHostSchema,
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Relay', item: relayUrl },
      ],
    },
  ]}
>
  <Nav />
  <main id="main" class="pp-page">
    <section class="pp-hero pp-hero--relay" aria-labelledby="relay-title">
      <div class="pp-hero-copy">
        <p class="pp-kicker">Own it · Run it yourself</p>
        <h1 id="relay-title" class="pp-h1">Run AI agents for real client work. See what each client costs.</h1>
        <p class="pp-sub">Orionfold Relay runs on your own machine. Nothing leaves it. Point it at your client work, run it across local and cloud models, approve every result before it ships, and watch each client's cost add up on its own. Built for solo founders and small teams doing real work for real clients.</p>
        {/* Above-fold primary action: Relay's OWN buy CTA, one step straight to
            Stripe when ORIONFOLD_RELAY_LIVE (wired by the page script); a scroll
            anchor when the flag is off, so no one can pay pre-fulfilment.
            Secondary = the runnable install verb. */}
        <div class="pp-hero-cta">
          {ORIONFOLD_RELAY_LIVE ? (
            <button type="button" class="pp-btn" data-checkout={RELAY.founding.lookupKey} data-item="software:orionfold-relay" data-error-target="hero-cta-err">
              Get Orionfold Relay · {formatUsd(RELAY.founding.amount)} founding
            </button>
          ) : (
            <a class="pp-btn" href="#get-relay">Get Orionfold Relay · {formatUsd(RELAY.founding.amount)} founding</a>
          )}
          <span class="pp-install"><small>Install</small><code>npx orionfold-relay</code></span>
        </div>
        <p id="hero-cta-err" class="pp-done-error" role="alert" hidden></p>
      </div>
      <div class="pp-hero-stage">
        <Media caption={"One board for every client"}>
          <Image
            src={relayBoardShot}
            alt="The Orionfold Relay board: active work, tasks that need attention, a live agent activity stream, recent client projects, and today's cost, all on one screen."
            widths={[720, 1080, 1440]}
            sizes="(min-width: 860px) 50vw, 100vw"
            loading="eager"
            decoding="async"
            data-no-zoom
          />
</Media>
      </div>
    </section>
    {/* Sticky-CTA sentinel: the bar fades in once this scrolls out of view. */}
    <div id="hero-cta-sentinel" aria-hidden="true"></div>
    <PageNav label="Relay product navigation" onPage={[
      { href: '#relay-proof', label: 'Proof' },
      { href: '#relay-screens', label: 'Screens' },
      { href: '#relay-agency', label: 'For agencies' },
      { href: '#relay-free', label: 'Free vs paid' },
      { href: '#relay-security', label: 'Security' },
      { href: '#get-relay-host', label: 'Pricing' },
    ]} pages={RELAY_PAGES('overview')} />

    {/* THE PROOF: Relay's most differentiated shipped asset, a per-client
        margin a buyer can check, near the top. */}
    <Panel id="relay-proof" seam="The proof, on one client" fold="tally" title="$0.05 of AI cost.<br />A ~$500/mo retainer." lede="Per-client margin you can actually see, tallied from real runs.">
      <ul class="pp-cells pp-cells--3 pp-relay-stats">
        {statTiles.map((t) => (
          <li><span class="pp-kicker">{t.label}</span><b set:html={t.value} /><span>{t.sub}</span></li>
        ))}
      </ul>
      <Media caption={"Live per-client cost attribution, tallied from real runs. Not a hardcoded billing line."} class="pp-relay-receipt">
        <Image
          src={relayCostReceipt}
          alt="An Orionfold Relay customer page for Parkview Property Management: AI spend over 30 days reads $0.05 across 6 runs and 32,150 tokens, beside 1 linked project and an active status, with a note showing a roughly $500 a month retainer."
          widths={[720, 1080, 1440]}
          sizes="(min-width: 1024px) 64rem, 100vw"
          loading="lazy"
          decoding="async"
          data-no-zoom
        />
</Media>
    </Panel>

    {/* See it running: three capability beats on real screens. */}
    <Panel id="relay-screens" seam="On real screens" fold="orri" tinted>
      <div class="tw-in-paper pd-paper pd-relay-showcase"><RelayShowcase /></div>
    </Panel>

    {/* Built for an agency: the work you already do, mapped onto Relay's
        building blocks. The five gaps sit behind one toggle. */}
    <Panel id="relay-agency" seam="Built for an agency" fold="clause" title="Your way of working,<br />mapped." lede="The way you already run client work maps straight onto Relay. Each part of your day becomes a building block, so you are not bending your work to fit a tool.">
      <ul class="pp-relay-map">
        {operatingModel.map((row) => (
          <li>
            <span class="pp-ico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={row.icon} /></span>
            <p><b>{row.you}</b> <span aria-hidden="true">→</span><span class="sr-only"> becomes </span> <strong>{row.them}</strong></p>
            <p>{row.note}</p>
          </li>
        ))}
      </ul>
      <details class="pp-more pp-relay-gaps">
        <summary>The five gaps every AI agency hits <em>{gaps.length}</em></summary>
        <p>AI agents can already sum up a lease, research a grant, or sort a receipt. The hard part is everything around that. The more clients you serve, the bigger each gap gets. Orionfold Relay is built to close all five.</p>
        <ol>
          {gaps.map((g) => (<li><strong>{g.title}</strong><span>{g.body}</span></li>))}
        </ol>
      </details>
    </Panel>

    {/* Mid-page CTA for the reader who is already sold. Same SSOT-priced,
        launch-flag-gated band. */}
    <div class="tw-in-paper pd-paper pd-relay-bridge">
      <LicenseBand
        family={RELAY}
        live={ORIONFOLD_RELAY_LIVE}
        itemId="software:orionfold-relay"
        errId="relay-band-err"
        fullBlockId="get-relay"
        eyebrow="Own the premium packs"
        heading="Skip the setup. Own the packs."
        body="One license unlocks every premium pack you own, starting with the agency pack. The engine stays free; the license is the key that adds a pack with one command."
        enquiryHref="/adoption/?item=software:orionfold-relay"
        image={relayPoster}
        imageAlt="Orionfold Relay poster: one operator at a wide command wall of glowing client panels, running a whole AI agency from one board."
      />
    </div>

    {/* Free vs paid, sourced to the real CLI gate so page and package agree,
        then the packs by job (only the agency pack has shipped). */}
    <Panel id="relay-free" seam="What is free, what a license adds" fold="sprout" title="Free forever.<br />Paid rights stay distinct." lede="Relay Core and direct Cells are free forever. A Pack license adds maintained content. Relay Host separately covers managed customer Cells.">
      <div class="pp-relay-split">
        <div>
          <p class="pp-kicker">Free with the engine · open source, forever</p>
          <ul>{freeVsPaid.map((row) => <li>{row.free}</li>)}</ul>
          <p class="pp-relay-install">Install with <code>npm i -g orionfold-relay</code>, or run it without installing, with <code>npx orionfold-relay</code>. Then <code>relay</code> is your command.</p>
        </div>
        <div class="pp-relay-paid">
          <p class="pp-kicker">A Pack license adds · on top of everything free</p>
          <ul>{freeVsPaid.map((row) => <li>{row.paid}</li>)}</ul>
        </div>
      </div>
      <p class="pp-panel-note">The free engine is not a trial or a cut-down version. It is a complete operations layer you can run for real. A Pack license adds premium packs and their updates. Relay Host is shown separately below because it covers managed customer operations, not image access or a hidden core feature. This is a promise we hold every product to. Read <a href="/promise/">how our gating works</a>.</p>

      <div class="pp-relay-packs">
        <p class="pp-kicker">Packs by job</p>
        <p>A pack is a ready-made setup you drop in with one command instead of building it yourself. Your license adds it. Run <code>relay pack add</code> with your own private link and it installs. Packs are grouped by the job you are doing, not the title you hold.</p>
        <ul>
          <li class="pp-relay-pack--shipped"><small>{shippedPack.job} · Shipped</small><strong>{shippedPack.name}</strong><span>{shippedPack.dek}</span></li>
          {plannedPacks.map((p) => (<li><small>{p.job} · Planned</small><strong>{p.name}</strong></li>))}
        </ul>
      </div>
    </Panel>

    {/* Security and trust: the last objection before the price. Four plain
        answers, each linking the on-site trust page that backs it. */}
    <Panel id="relay-security" seam="Security and trust" fold="shell" tinted title="Built to pass<br />a security review." lede="Relay runs on your own machine, holds none of your data, and keeps working even if we do not. Each answer links the page that shows the code behind it.">
      <div class="pp-faq">
        {trust.map((t) => (
          <details><summary>{t.q}</summary><p>{t.a} <a href={t.href}>{t.label} <span aria-hidden="true">→</span></a></p></details>
        ))}
      </div>
      <p class="pp-panel-note">Found a security problem? Report it privately and we reply within three days: <a href="https://github.com/orionfold/relay/security/advisories/new" target="_blank" rel="noopener">open a private advisory</a>.</p>
    </Panel>

    {/* Own the premium packs: the buy blocks, then the sibling line. */}
    <div class="tw-in-paper pd-paper pd-relay-bridge">
      <RelayHostBox />
      <RelayBox />
      <ProductLineRail current="relay" />
    </div>

    {/* Soft opt-in below the buy: readers who are not checkout-ready yet. */}
    <PaperSubscribe
      id="relay-free-book"
      offer="become-ai-native-business"
      source="relay-page"
      heading="Not ready to buy? Start with the free book."
      dek="Get the AI Native Business book free, and a note when we ship a new Relay pack you can own."
      buttonText="Send it"
      fold="shell"
      consentText="By subscribing you agree to receive the AI For Everyone digest, one email a week, no more. You can unsubscribe any time. See our privacy policy."
    />

    {/* Persistent Buy bar once the hero scrolls past. Same founding price and
        data-checkout wiring as RelayBox (SSOT-driven). */}
    <div class="tw-in-paper pd-paper">
      <LandingStickyCta
        title="Relay premium Packs"
        lookupKey={RELAY.founding.lookupKey}
        priceLabel={formatUsd(RELAY.founding.amount)}
        itemId="software:orionfold-relay"
        live={ORIONFOLD_RELAY_LIVE}
        anchor="#get-relay"
        hideWhile="#get-relay-host"
      />
    </div>
  </main>
  <Footer showDownload={false} />
</PaperLayout>

<script>
  // Wire the Relay purchase buttons (data-checkout → create-checkout-session →
  // Stripe). No-op when the buttons aren't rendered (ORIONFOLD_RELAY_LIVE off).
  import { wireCheckoutButtons } from '../../lib/checkout';

  wireCheckoutButtons();
  document.addEventListener('astro:after-swap', () => {
    wireCheckoutButtons();
  });
</script>
