---
// /relay/docs/<slug>/ — one Relay user-guide chapter (Rail B publish, _RELAY
// #15). Renders the verbatim markdown body; inline ![alt](relay-shot:<id>)
// markers are rewritten to themed shots by the global rehype bridge. Prev/next
// walk the `order`. Footer CTA is the website's edge-to-edge RelayCtaBand
// (contract: footer-only, don't interrupt), matching the Memos + API surfaces.
// Mirrors the /receipts/<slug>/ idiom. R7c (G-146): a Paper docs page, the
// chapter list in the left nav and the chapter's h2s on the right.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PaperLayout from '../../../../layouts/PaperLayout.astro';
import PaperDocs from '../../../../components/paper/PaperDocs.astro';
import PageNav from '../../../../components/paper/PageNav.astro';
import '../../../../styles/living-in-paper.css';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import RelayClosing from '../../../../components/relay/RelayClosing.astro';
import { RELAY_PAGES } from '../../../../lib/relay/pages';
import { ogMeta } from '../../../../data/og';
import { SITE, PERSON, PUBLISHER } from '../../../../data/seo';

export async function getStaticPaths() {
  const chapters = (await getCollection('relayDocs')).sort((a, b) => a.data.order - b.data.order);
  return chapters.map((chapter, i) => ({
    params: { slug: chapter.id },
    props: {
      chapter,
      chapters: chapters.map((c) => ({ id: c.id, title: c.data.title, order: c.data.order })),
      prev: i > 0 ? chapters[i - 1] : null,
      next: i < chapters.length - 1 ? chapters[i + 1] : null,
    },
  }));
}

type Entry = CollectionEntry<'relayDocs'>;
const { chapter, chapters, prev, next } = Astro.props as {
  chapter: Entry;
  chapters: { id: string; title: string; order: number }[];
  prev: Entry | null;
  next: Entry | null;
};
const { Content, headings } = await render(chapter);
const num = (n: number) => `Chapter ${String(n).padStart(2, '0')}`;
const nav = {
  label: 'Guide chapters',
  items: chapters.map((c) => ({ href: `/relay/docs/${c.id}/`, label: c.title, num: num(c.order), current: c.id === chapter.id })),
};
const { title, order, summary } = chapter.data;

const og = ogMeta('/relay/');
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const techArticleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description: summary,
  author: { ...PERSON, url: `${SITE.url}/about/` },
  publisher: PUBLISHER,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  url: canonical,
  inLanguage: 'en',
  articleSection: 'Relay User Guide',
  isPartOf: { '@type': 'CollectionPage', name: 'Relay User Guide', url: `${SITE.url}/relay/docs/` },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Relay', item: `${SITE.url}/relay/` },
    { '@type': 'ListItem', position: 3, name: 'Docs', item: `${SITE.url}/relay/docs/` },
    { '@type': 'ListItem', position: 4, name: title, item: canonical },
  ],
};
---
<PaperLayout
  title={`${title} · Relay User Guide · Orionfold`}
  description={summary}
  ogImage={og.image}
  ogImageAlt={`${title} · Orionfold Relay user guide`}
  jsonLd={[techArticleSchema, breadcrumbSchema]}
>
  <Nav />
  <main id="main" class="pp-page">
    <PageNav label="Relay sections" pages={RELAY_PAGES('docs')} />
    <PaperDocs
      crumb={{ href: '/relay/docs/', label: 'User guide' }}
      kicker={num(order)}
      title={title}
      nav={nav}
      headings={headings}
      prev={prev && { href: `/relay/docs/${prev.id}/`, label: prev.data.title }}
      next={next && { href: `/relay/docs/${next.id}/`, label: next.data.title }}
    >
      <Content />
    </PaperDocs>

    <RelayClosing />
  </main>
  <Footer showDownload={false} />
</PaperLayout>
