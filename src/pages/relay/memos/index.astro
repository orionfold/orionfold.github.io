---
// /relay/memos/ — source-ordered Relay editorial series. Articles and signature
// SVGs come from _ASSETS; grouping, status labels and conversion chrome belong
// to Website. Each series keeps its own pillar and reading arc.
import { getCollection } from 'astro:content';
import PaperLayout from '../../../layouts/PaperLayout.astro';
import PageNav from '../../../components/paper/PageNav.astro';
import Fold from '../../../components/paper/Fold.astro';
import '../../../styles/living-in-paper.css';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { ogMeta } from '../../../data/og';
import { SITE } from '../../../data/seo';
import { groupedMemos, memoSignatureHtml } from '../../../lib/relay/memos.mjs';

const groups = groupedMemos(await getCollection('memos'));
const memos = groups.flatMap((group) => group.memos);
const og = ogMeta('/relay/');

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Relay field memos · Orionfold',
  description:
    'Source-verified essays about Relay Packs and the Host and Cell operating model.',
  url: `${SITE.url}/relay/memos/`,
  blogPost: memos.map((memo) => ({
    '@type': 'BlogPosting',
    headline: memo.data.title,
    description: memo.data.summary,
    url: `${SITE.url}/relay/memos/${memo.id}/`,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Relay', item: `${SITE.url}/relay/` },
    { '@type': 'ListItem', position: 3, name: 'Memos', item: `${SITE.url}/relay/memos/` },
  ],
};

const RELAY_PAGES = [
  { href: '/relay/', label: 'Overview' },
  { href: '/relay/host/', label: 'Host' },
  { href: '/relay/demo/', label: 'Demo' },
  { href: '/relay/docs/', label: 'Docs' },
  { href: '/relay/api/', label: 'API' },
  { href: '/relay/memos/', label: 'Memos', current: true },
];

const statusLabel = (memo) => memo.data.status === 'published' ? null : memo.data.status;
---
<PaperLayout
  title="Relay field memos · Orionfold"
  description="Two source-verified Relay memo series: how Packs become owned operating systems, and how Hosts and Cells create honest operating boundaries."
  ogImage={og.image}
  ogImageAlt={og.alt}
  jsonLd={[collectionSchema, breadcrumbSchema]}
>
  <Nav />
  <main id="main" class="pp-page">
    <section class="pp-hero pp-hero--inner pp-hero--solo" aria-labelledby="memos-title">
      <div class="pp-hero-copy">
        <p class="pp-kicker">Relay · Field memos</p>
        <h1 id="memos-title" class="pp-h1">The architecture behind Relay.</h1>
        <p class="pp-sub">Two reading arcs explain the product from the inside. Relay Packs covers the operating system you install for a domain. Relay Host &amp; Cells covers the boundaries that keep managed customer instances honest, recoverable, and legible.</p>
      </div>
    </section>
    <PageNav label="Relay sections" pages={RELAY_PAGES} />

    {groups.map((group) => {
      const [pillar, ...rest] = group.memos;
      return (
        <section class="pp-index" aria-labelledby={`series-${group.slugs[0]}`}>
          <div class="pp-index-head">
            <p class="pp-kicker">{group.label}</p>
            <h2 id={`series-${group.slugs[0]}`}>{group.name}</h2>
            <p>{group.description}</p>
          </div>
          {pillar && (
            <a class="pp-lead" href={`/relay/memos/${pillar.id}/`} aria-label={`Start the ${group.name} series: ${pillar.data.title}`}>
              {memoSignatureHtml(pillar) && <div class="pp-lead-art" set:html={memoSignatureHtml(pillar)} />}
              <div class="pp-lead-copy">
                <p class="pp-kicker">Start here · Pillar{statusLabel(pillar) && ` · ${statusLabel(pillar)}`}</p>
                <h2>{pillar.data.title}</h2>
                <p>{pillar.data.summary}</p>
                <span class="pp-rail-go">Start the series →</span>
              </div>
            </a>
          )}
          {rest.length > 0 && (
            <ul class="pp-rows">
              {rest.map((memo, index) => (
                <li><a href={`/relay/memos/${memo.id}/`} aria-label={`Read memo: ${memo.data.title}`}>
                  <b>Memo {String(index + 2).padStart(2, '0')}</b>
                  <div><strong>{memo.data.title}</strong><span>{memo.data.summary}</span></div>
                  <small>{statusLabel(memo) ?? 'Read →'}</small>
                </a></li>
              ))}
            </ul>
          )}
        </section>
      );
    })}

    <section class="pp-closing" aria-labelledby="memos-closing-heading">
      <Fold id="shell" bob class="pp-closing-fold" />
      <h2 id="memos-closing-heading">Choose the Relay boundary your work needs.</h2>
      <p>Explore Relay Core, premium Packs, and Relay Host from one product overview.</p>
      <a href="/relay/" data-relay-cta-btn class="pp-btn">Explore Orionfold Relay <span aria-hidden="true">→</span></a>
    </section>
  </main>
  <Footer showDownload={false} />
</PaperLayout>
