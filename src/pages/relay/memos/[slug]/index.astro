---
// /relay/memos/<slug>/ — one source-owned Relay memo.
// Renders the verbatim markdown body; the inline <figure class="fn-diagram">
// SVG flows through untouched (theme-reactive via the global --svg-* tokens),
// and the mid-essay CTA is mounted into the [data-memo-interstitial-slot] div
// that rehype-memo-interstitial auto-inserts at the section boundary. The hero
// signature.svg is inlined (not <img>) so its tokens theme-swap too. Prev/next
// walk the series order (pillar first). Footer CTA is the website's, hardcoded
// (contract: chrome is ours, Relay ships content only). Mirrors the
// /relay/docs/<slug>/ idiom, plus the story-page interstitial mount mechanism.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PaperLayout from '../../../../layouts/PaperLayout.astro';
import PaperLongform from '../../../../components/paper/PaperLongform.astro';
import PageNav from '../../../../components/paper/PageNav.astro';
import Fold from '../../../../components/paper/Fold.astro';
import '../../../../styles/living-in-paper.css';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import RelayCtaBand from '../../../../components/relay/RelayCtaBand.astro';
import { ogMeta } from '../../../../data/og';
import { SITE, PERSON, PUBLISHER } from '../../../../data/seo';
import { memoNeighbors, memoSignatureHtml, orderedMemos } from '../../../../lib/relay/memos.mjs';

export async function getStaticPaths() {
  const memos = orderedMemos(await getCollection('memos'));
  return memos.map((memo) => {
    const { prev, next } = memoNeighbors(memos, memo.id);
    return { params: { slug: memo.id }, props: { memo, prev, next } };
  });
}

type Entry = CollectionEntry<'memos'>;
const { memo, prev, next } = Astro.props as {
  memo: Entry;
  prev: Entry | null;
  next: Entry | null;
};
const { Content, headings } = await render(memo);
const minutes = Math.max(1, Math.ceil((memo.body ?? '').split(/\s+/).filter(Boolean).length / 230));
const { title, summary, series, date, difficulty } = memo.data;

// The hero SVG lives next to the article (signature.svg); read it raw and inline
// it so its --svg-* tokens resolve against the site theme (an <img> would
// sandbox the CSS vars). Absent -> no hero, page still renders.
const heroSvg = memoSignatureHtml(memo);

const og = ogMeta('/relay/');
const RELAY_PAGES = [
  { href: '/relay/', label: 'Overview' },
  { href: '/relay/host/', label: 'Host' },
  { href: '/relay/demo/', label: 'Demo' },
  { href: '/relay/docs/', label: 'Docs' },
  { href: '/relay/api/', label: 'API' },
  { href: '/relay/memos/', label: 'Memos', current: true },
];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const isHostSeries = series === 'Relay Host & Cells';
const cta = isHostSeries
  ? {
      kicker: 'One Host. Independent Cells. Honest boundaries.',
      line: 'Relay Core and the public Cell image stay free. Relay Host adds managed lifecycle authority within signed capacity.',
      href: '/relay/host/',
      label: 'Explore Relay Host',
    }
  : {
      kicker: 'Own the packs in this series.',
      line: undefined,
      href: '/relay/',
      label: 'Explore Orionfold Relay',
    };

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: summary,
  datePublished: date.toISOString(), // full datetime with timezone, per Rich Results Test
  author: { ...PERSON, url: `${SITE.url}/about/` },
  publisher: PUBLISHER,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  url: canonical,
  inLanguage: 'en',
  articleSection: series,
  isPartOf: { '@type': 'Blog', name: series, url: `${SITE.url}/relay/memos/` },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Relay', item: `${SITE.url}/relay/` },
    { '@type': 'ListItem', position: 3, name: 'Memos', item: `${SITE.url}/relay/memos/` },
    { '@type': 'ListItem', position: 4, name: title, item: canonical },
  ],
};
---
<PaperLayout
  title={memo.data.seoTitle ?? `${title} · ${series} · Orionfold`}
  description={memo.data.seoDescription ?? summary}
  ogImage={og.image}
  ogImageAlt={`${title} · Orionfold ${series}`}
  jsonLd={[articleSchema, breadcrumbSchema]}
>
  <Nav />
  <main id="main" class="pp-page">
    <PageNav label="Relay sections" pages={RELAY_PAGES} />
    <PaperLongform crumb={{ href: '/relay/memos/', label: 'Relay memos' }} kicker={series} title={title} dek={summary} published={date} minutes={minutes} headings={headings}>
      {heroSvg && <figure slot="figure" class="pp-long-svg" set:html={heroSvg} />}

      <Content />

      {/* The mid-essay interstitial: server-rendered hidden, then the inline
          script moves it into the [data-memo-interstitial-slot] the rehype
          plugin inserted at a section boundary. JS-off falls back to right
          after the body. Contract: ONE mid CTA + the closing CTA, no sticky. */}
      <div id="memo-interstitial-source" hidden>
        <RelayCtaBand variant="interstitial" kicker={cta.kicker} line={cta.line} href={cta.href} label={cta.label} />
      </div>
      <script is:inline>
        (() => {
          const src = document.getElementById('memo-interstitial-source');
          if (!src) return;
          const card = src.firstElementChild;
          const slot = document.querySelector('[data-memo-interstitial-slot]');
          if (!card) { src.remove(); return; }
          if (slot) slot.replaceWith(card);
          else src.parentElement.insertBefore(card, src);
          src.remove();
        })();
      </script>

      {difficulty && <p class="pp-long-note">Reading level: {difficulty}</p>}

      {(prev || next) && (
        <nav slot="after" class="pp-long-next" aria-label="Memo navigation">
          {prev && <a href={`/relay/memos/${prev.id}/`}><span class="pp-kicker">← Previous</span><strong>{prev.data.title}</strong></a>}
          {next && <a class="pp-next-newer" href={`/relay/memos/${next.id}/`}><span class="pp-kicker">Next →</span><strong>{next.data.title}</strong></a>}
        </nav>
      )}
    </PaperLongform>

    <section class="pp-closing" aria-labelledby="memo-closing-heading">
      <Fold id="shell" live class="pp-closing-fold" />
      <h2 id="memo-closing-heading">{cta.kicker}</h2>
      {cta.line && <p>{cta.line}</p>}
      <a href={cta.href} data-relay-cta-btn class="pp-btn">{cta.label} <span aria-hidden="true">→</span></a>
    </section>
  </main>
  <Footer showDownload={false} />
</PaperLayout>
