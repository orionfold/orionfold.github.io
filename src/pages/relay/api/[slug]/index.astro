---
// /relay/api/<slug>/ — one Relay API reference chapter (Rail B publish, _RELAY
// #23). Renders the verbatim markdown body; inline ![alt](relay-shot:<id>)
// markers are rewritten to themed shots by the global rehype bridge, and the
// endpoint tables render through the same story-prose + .of-table path as docs.
// The chapter body carries NO H1 (frontmatter `title` is the SSOT, #23 note #2),
// so the route renders the title. Prev/next walk the numeric id prefix. Footer
// CTA is the website's edge-to-edge RelayCtaBand (footer-only), matching the
// Memos + Docs surfaces. Mirrors the /relay/docs/<slug>/ idiom. R7c (G-146):
// the Paper docs page; stability and families become tags under the title.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PaperLayout from '../../../../layouts/PaperLayout.astro';
import PaperDocs from '../../../../components/paper/PaperDocs.astro';
import PageNav from '../../../../components/paper/PageNav.astro';
import '../../../../styles/living-in-paper.css';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import RelayClosing from '../../../../components/relay/RelayClosing.astro';
import { RELAY_PAGES } from '../../../../lib/relay/pages';
import { ogMeta } from '../../../../data/og';
import { SITE, PERSON, PUBLISHER } from '../../../../data/seo';

export async function getStaticPaths() {
  // Order chapters by their numeric filename prefix (01- -> 1). Defined inline
  // because Astro hoists getStaticPaths above the frontmatter body, so it cannot
  // reach a module-scope arrow-const (temporal dead zone -> "not defined").
  const order = (id: string) => {
    const m = id.match(/^(\d+)/);
    return m ? parseInt(m[1], 10) : 999;
  };
  const chapters = (await getCollection('relayApi')).sort(
    (a, b) => order(a.id) - order(b.id),
  );
  return chapters.map((chapter, i) => ({
    params: { slug: chapter.id },
    props: {
      chapter,
      order: i + 1,
      chapters: chapters.map((c) => ({ id: c.id, title: c.data.title })),
      prev: i > 0 ? chapters[i - 1] : null,
      next: i < chapters.length - 1 ? chapters[i + 1] : null,
    },
  }));
}

type Entry = CollectionEntry<'relayApi'>;
const { chapter, order, chapters, prev, next } = Astro.props as {
  chapter: Entry;
  order: number;
  chapters: { id: string; title: string }[];
  prev: Entry | null;
  next: Entry | null;
};
const { Content, headings } = await render(chapter);
const num = (n: number) => `Reference ${String(n).padStart(2, '0')}`;
const nav = {
  label: 'Reference chapters',
  items: chapters.map((c, i) => ({ href: `/relay/api/${c.id}/`, label: c.title, num: num(i + 1), current: c.id === chapter.id })),
};
const { title, stability, families } = chapter.data;

// Derived meta description (the chapter body has no summary field): stability +
// families read as a faithful one-liner for search + OG without editing the
// verbatim chapter.
const description = `Relay local API reference: ${title.toLowerCase()}. Endpoint families ${families.join(', ')}. Stability: ${stability}. Real request, response, and error shapes with worked curl examples.`;

const og = ogMeta('/relay/');
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const techArticleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description,
  author: { ...PERSON, url: `${SITE.url}/about/` },
  publisher: PUBLISHER,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  url: canonical,
  inLanguage: 'en',
  articleSection: 'Relay API Reference',
  isPartOf: { '@type': 'CollectionPage', name: 'Relay API Reference', url: `${SITE.url}/relay/api/` },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Relay', item: `${SITE.url}/relay/` },
    { '@type': 'ListItem', position: 3, name: 'API', item: `${SITE.url}/relay/api/` },
    { '@type': 'ListItem', position: 4, name: title, item: canonical },
  ],
};
---
<PaperLayout
  title={`${title} · Relay API Reference · Orionfold`}
  description={description}
  ogImage={og.image}
  ogImageAlt={`${title} · Orionfold Relay API reference`}
  jsonLd={[techArticleSchema, breadcrumbSchema]}
>
  <Nav />
  <main id="main" class="pp-page">
    <PageNav label="Relay sections" pages={RELAY_PAGES('api')} />
    <PaperDocs
      crumb={{ href: '/relay/api/', label: 'API reference' }}
      kicker={num(order)}
      title={title}
      tags={[stability, ...families]}
      nav={nav}
      headings={headings}
      prev={prev && { href: `/relay/api/${prev.id}/`, label: prev.data.title }}
      next={next && { href: `/relay/api/${next.id}/`, label: next.data.title }}
    >
      <Content />
    </PaperDocs>
    <RelayClosing />
  </main>
  <Footer showDownload={false} />
</PaperLayout>
