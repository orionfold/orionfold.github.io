---
// /advisor/ — the Advisor offer page. R7d (G-146): a Paper page, the corpus
// shelf as cover cards, the four facts as cells, the proof rail as art cards.
import PaperLayout from '../layouts/PaperLayout.astro';
import Panel from '../components/paper/Panel.astro';
import ProofArtCards from '../components/paper/ProofArtCards.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import { flagshipById } from '../data/flagship-offers';
import { ogMeta } from '../data/og';
import aiNativeBusinessCover from '../assets/book/ai-native-business-book.jpg';
import aiNativePlatformCover from '../assets/book/ai-native-platform-book.jpg';
import aiResearchSparkCover from '../assets/book/ai-research-dgx-spark-book.jpg';
import patentStrategistCover from '../assets/models/patent-strategist/cover.png';
import buildingInPublicHero from '../assets/story/building-in-public/hero.jpeg';

const offer = flagshipById.advisor;
const og = ogMeta('/advisor/');

// The corpus shelf: the real material the first Advisor reads, shown with the
// covers the rest of the site already uses. Seeing the shelf makes "trained on
// the Orionfold corpus" concrete instead of abstract.
const corpus = [
  { img: aiNativeBusinessCover, href: '/books/ai-native-business/', label: 'AI Native Business', alt: 'AI Native Business book cover' },
  { img: aiNativePlatformCover, href: '/books/ai-native-platform/', label: 'AI Native Platform', alt: 'AI Native Platform book cover' },
  { img: aiResearchSparkCover, href: '/books/ai-research-on-nvidia-dgx-spark/', label: 'AI Research on NVIDIA DGX Spark', alt: 'AI Research on NVIDIA DGX Spark book cover' },
  { img: patentStrategistCover, href: '/models/patent-strategist/', label: 'Model cards + benchmarks', alt: 'Patent Strategist model cover' },
  { img: buildingInPublicHero, href: '/story/', label: 'Build stories + field notes', alt: 'Building in public story artwork' },
];

const facts = [
  { label: 'Corpus', body: 'A sealed pack of 182 sources, from books, story posts, model cards and product notes to field lab material, with a fingerprint and its own recall checks.' },
  { label: 'Private first', body: 'Runs on one small desktop. Questions about private state never leave the machine, and hosted help is allow-listed under a dollar cap.' },
  { label: 'Inspectable', body: 'Every answer names the exact source it came from, and every gate the Advisor passed is a saved receipt a script can re-verify.' },
  { label: 'Live', body: 'The first Advisor shipped in June 2026. The trained model and its test set are free on Hugging Face, and the receipts are public.' },
];
---
<PaperLayout
  title="Advisor · Orionfold"
  description="Orionfold Advisor is live. It is a governed local AI advisor over the Orionfold corpus. Every answer names its exact source, unsupported questions get a refusal, and the trained model is free to download."
  ogImage={og.image}
  ogImageAlt={og.alt}
>
  <Nav />
  <main id="main" class="pp-page">
    <section class="pp-hero pp-hero--inner pp-hero--solo" aria-labelledby="advisor-title">
      <div class="pp-hero-copy">
        <p class="pp-kicker">Advisor</p>
        <h1 id="advisor-title" class="pp-h1">Ask Orionfold privately.</h1>
        <p class="pp-sub">A governed local AI advisor over the Orionfold corpus, running on one small desktop. Every answer names the exact source it came from. Questions the corpus cannot support get a refusal, not a guess. The first Advisor model is trained, promoted, and free to download.</p>
        <div class="pp-hero-cta">
          <a href="/software/advisor/" class="pp-btn">See the shipped Advisor <span aria-hidden="true">→</span></a>
          <a href="/adoption/#ask" class="pp-btn pp-btn--ghost">Bring your own corpus</a>
        </div>
      </div>
    </section>

    {/* The corpus shelf: what the Advisor actually reads. */}
    <Panel id="advisor-corpus" seam="What the Advisor reads" fold="atlas">
      <ul class="pp-art-cards pp-art-cards--covers">
        {corpus.map((item) => (
          <li><a href={item.href}>
            <Image src={item.img} alt={item.alt} widths={[300, 480]} sizes="(min-width: 1100px) 18vw, (min-width: 640px) 30vw, 46vw" loading="lazy" decoding="async" data-no-zoom />
            <h3>{item.label}</h3>
          </a></li>
        ))}
      </ul>
    </Panel>

    <Panel id="advisor-facts" seam="How it works" fold="shell" tinted>
      <ul class="pp-cells pp-cells--4">
        {facts.map((f) => (<li><small>{f.label}</small><span>{f.body}</span></li>))}
      </ul>
    </Panel>

    <Panel id="advisor-proof" seam="Proof in the current portfolio" fold="tally">
      <ProofArtCards links={offer.proof} />
    </Panel>
  </main>
  <Footer showDownload={false} />
</PaperLayout>
