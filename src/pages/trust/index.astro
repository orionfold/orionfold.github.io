---
// /trust/ — the trust hub (2026-07-03). Lists the on-site trust pages that back
// the homepage "Why teams trust it" trio and the /relay/ trust section. These
// used to link to raw GitHub markdown; now they live on-site with real design,
// with the Relay repo as the canonical source each page mirrors.
// R7a (G-146): Paper index. The Relay pages as hairline rows, then the
// promise and the two legal pages, which live under Trust in the crumbs.
import PaperLayout from '../../layouts/PaperLayout.astro';
import { ogMeta } from '../../data/og';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { SITE, PUBLISHER } from '../../data/seo';
import { trustPagesInOrder } from '../../data/trust-pages';

const pages = trustPagesInOrder();
const rules = [
  { href: '/promise/', title: 'Our promise', dek: 'Free stays free. What you own keeps working on your own machine.' },
  { href: '/privacy/', title: 'Privacy Policy', dek: 'What the website and the apps collect, why, and who handles it.' },
  { href: '/terms/', title: 'Terms of Use', dek: 'The rules for using the website, software, models and services.' },
];
---
<PaperLayout
  ogImage={ogMeta('/trust/').image}
  ogImageAlt={ogMeta('/trust/').alt}
  title="Trust: own it, run it local, verify every call · Orionfold"
  description="How Orionfold Relay earns trust: it runs on your machine, you own it forever, and you can verify every network call yourself. Data flow, continuity, supply chain, and license terms."
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'Trust · Orionfold',
      url: `${SITE.url}/trust/`,
      inLanguage: 'en',
      publisher: PUBLISHER,
      description:
        'How Orionfold Relay earns trust: it runs on your own machine, you own it forever, and you can verify every network call yourself.',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Trust', item: `${SITE.url}/trust/` },
      ],
    },
  ]}
>
  <Nav />
  <main id="main" class="pp-page">
    <section class="pp-hero pp-hero--inner pp-hero--solo" aria-labelledby="trust-title">
      <div class="pp-hero-copy">
        <p class="pp-kicker">Trust</p>
        <h1 id="trust-title" class="pp-h1">Yours to own, run, and check.</h1>
        <p class="pp-sub">Orionfold Relay runs on your own machine, you own it forever, and you can verify every network call yourself. These pages spell out how, each one backed by open-source code you can read. Nothing here asks you to trust a claim we make.</p>
      </div>
    </section>

    <section class="pp-index" aria-labelledby="trust-relay">
      <div class="pp-index-head">
        <p class="pp-kicker">Relay</p>
        <h2 id="trust-relay">Check every claim yourself.</h2>
      </div>
      <ul class="pp-rows">
        {pages.map((p) => (
          <li><a href={`/trust/${p.slug}/`}>
            <b>{p.title}</b>
            <div><span>{p.summary}</span></div>
            <small>Read it</small>
          </a></li>
        ))}
      </ul>
      <p class="pp-center-note">Ready to run it? <a href="/relay/">Get Orionfold Relay</a>. The engine is free and open. A license only adds the premium packs you own.</p>
    </section>

    <section class="pp-index" aria-labelledby="trust-rules">
      <div class="pp-index-head">
        <p class="pp-kicker">Every product</p>
        <h2 id="trust-rules">The rules we hold ourselves to.</h2>
      </div>
      <ul class="pp-rows">
        {rules.map((r) => (
          <li><a href={r.href}>
            <b>{r.title}</b>
            <div><span>{r.dek}</span></div>
            <small>Read it</small>
          </a></li>
        ))}
      </ul>
    </section>
  </main>
  <Footer showDownload={false} />
</PaperLayout>
