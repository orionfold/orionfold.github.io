---
// /receipts/<slug>/ — the permalink for one receipt (individually crawlable +
// OG-shareable). Carries the canonical BlogPosting; the /receipts/ index hub
// points here. A11.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PaperLayout from '../../../layouts/PaperLayout.astro';
import PaperLongform from '../../../components/paper/PaperLongform.astro';
import PaperSubscribe from '../../../components/paper/PaperSubscribe.astro';
import RailCard from '../../../components/paper/RailCard.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import '../../../styles/living-in-paper.css';
import { ogPath, receiptOgSlug } from '../../../data/og';
import { SITE, PERSON, PUBLISHER } from '../../../data/seo';

export async function getStaticPaths() {
  const receipts = await getCollection('receipts');
  return receipts.map((receipt) => ({ params: { slug: receipt.id }, props: { receipt } }));
}

const { receipt } = Astro.props as { receipt: CollectionEntry<'receipts'> };
const { Content, headings } = await render(receipt);
const minutes = Math.max(1, Math.ceil((receipt.body ?? '').split(/\s+/).filter(Boolean).length / 230));
const { title, metric, claim, dek, date, source } = receipt.data;

const dateIso = date.toISOString().slice(0, 10);
const dateTime = date.toISOString(); // JSON-LD wants a timezone; OG meta keeps the date

// Which product this receipt's band sells, by its source origin: a receipt
// "Built with Orionfold Arena" (or sourcing /software/arena/) is an Arena
// outcome; everything else is a Proof/Advisor outcome. Strong match either way.
const sourceBlob = (source ?? []).map((s) => `${s.label} ${s.href}`).join(' ');
const receiptProduct: 'arena' | 'proof' = /arena/i.test(sourceBlob) ? 'arena' : 'proof';
// The rail names the tool behind the receipt; the link keeps the product-band
// cross-sell UTM so GA4 still splits it per receipt.
const PRODUCT = {
  proof: { name: 'Orionfold Proof', landing: '/proof/', line: 'Runs on your own machine and hands back a signed receipt you can rerun.' },
  arena: { name: 'Orionfold Arena', landing: '/arena/', line: 'Runs, compares and scores local AI models on one DGX Spark.' },
}[receiptProduct];
const productHref = `${PRODUCT.landing}?utm_source=orionfold&utm_medium=cross-sell&utm_campaign=product-band&utm_content=receipt-${receipt.id}-${receiptProduct}`;
const others = (await getCollection('receipts'))
  .filter((r) => r.id !== receipt.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const shortDate = (d: Date) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(d);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogPath(receiptOgSlug(receipt.id)), Astro.site).href;

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: dek,
  image: ogImageUrl,
  datePublished: dateTime,
  dateModified: dateTime,
  author: { ...PERSON, url: `${SITE.url}/about/` },
  publisher: PUBLISHER,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  url: canonical,
  inLanguage: 'en',
  articleSection: 'Receipts',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Receipts', item: `${SITE.url}/receipts/` },
    { '@type': 'ListItem', position: 3, name: title, item: canonical },
  ],
};
---
<PaperLayout
  title={`${title} · Receipts · Orionfold`}
  description={dek}
  ogImage={ogPath(receiptOgSlug(receipt.id))}
  ogImageAlt={`${title} · a receipt you can rerun, from Orionfold`}
  ogType="article"
  article={{ datePublished: dateIso, dateModified: dateIso, author: 'Manav Sehgal', section: 'Receipts' }}
  jsonLd={[blogPostingSchema, breadcrumbSchema]}
>
  <Nav />
  <main id="main" class="pp-page">
    <PaperLongform crumb={{ href: '/receipts/', label: 'Receipts' }} kicker={metric} title={title} dek={claim} published={date} minutes={minutes} headings={headings} bodyClass="receipt-prose" magnet={false}>
      <Content />

      {source.length > 0 && (
        <section class="pp-sources" aria-labelledby="receipt-sources">
          <h2 id="receipt-sources">Sources</h2>
          <ol>{source.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ol>
        </section>
      )}

      <Fragment slot="rail">
        <RailCard href={productHref} kicker="The tool behind this receipt" title={PRODUCT.name} body={PRODUCT.line} go={`See ${PRODUCT.name.replace('Orionfold ', '')}`} />
        <nav class="pp-rail-block" aria-label="More receipts">
          <p class="pp-kicker">More receipts</p>
          <ul>{others.map((r) => <li><a href={`/receipts/${r.id}/`}><small>{shortDate(r.data.date)}</small>{r.data.title}</a></li>)}</ul>
        </nav>
      </Fragment>
    </PaperLongform>

    <PaperSubscribe id="offer-proof-playbook" heading="Get the proof guide." dek="The one-page guide to locking a test, running it on your own desk, and reading the receipts." source="receipt-page" offer="proof-playbook" buttonText="Send it" fold="tally"
      consentText="By subscribing you agree to receive the AI For Everyone digest, one email a week, no more. You can unsubscribe any time. See our privacy policy." />
  </main>
  <Footer showDownload={false} />
</PaperLayout>
