---
// /receipts/ — the receipts gallery hub. The complete, crawlable set of
// individually-URL'd receipts (A11). /proof/ stays the curated pillar; this is
// the full index one level out, a first-class content type alongside /story/
// and /letter/. Each card links to its own permalink.
import { getCollection } from 'astro:content';
import PaperLayout from '../../layouts/PaperLayout.astro';
import PaperSubscribe from '../../components/paper/PaperSubscribe.astro';
import '../../styles/living-in-paper.css';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { ogMeta } from '../../data/og';
import { SITE } from '../../data/seo';

const receipts = (await getCollection('receipts')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const og = ogMeta('/receipts/');

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Receipts',
  description:
    'Every Orionfold receipt on its own page: a frozen test you can rerun, the run, and what we found. The proof, not the pitch.',
  url: `${SITE.url}/receipts/`,
  hasPart: receipts.map((r) => ({
    '@type': 'BlogPosting',
    headline: r.data.title,
    description: r.data.dek,
    datePublished: r.data.date.toISOString().slice(0, 10),
    url: `${SITE.url}/receipts/${r.id}/`,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Receipts', item: `${SITE.url}/receipts/` },
  ],
};
---
<PaperLayout
  title="Receipts · AI tests you can rerun yourself · Orionfold"
  description="Every receipt on its own page: a frozen test you can rerun, the run, and what we found. The proof, not the pitch."
  ogImage={og.image}
  ogImageAlt={og.alt}
  jsonLd={[collectionSchema, breadcrumbSchema]}
>
  <Nav />
  <main id="main" class="pp-page">
    <section class="pp-hero pp-hero--inner pp-hero--solo" aria-labelledby="receipts-title">
      <div class="pp-hero-copy">
        <p class="pp-kicker">Receipts</p>
        <h1 id="receipts-title" class="pp-h1">The proof, one receipt at a time.</h1>
        <p class="pp-sub">Each claim on its own page. The test we locked, the run, and how you rerun it. The wall is at <a href="/proof/">/proof/</a>. These are the receipts behind it, one link each.</p>
      </div>
    </section>

    <section class="pp-index" aria-label="Receipts, newest first">
      <ul class="pp-rows">
        {receipts.map((r) => (
          <li><a href={`/receipts/${r.id}/`}>
            <b>{r.data.metric}</b>
            <div><strong>{r.data.title}</strong><span>{r.data.dek}</span></div>
            <small>{r.data.tags[0] ?? 'Receipt'}</small>
          </a></li>
        ))}
      </ul>
    </section>

    <PaperSubscribe id="offer-proof-playbook" heading="Get the proof guide." dek="The one-page guide to locking a test, running it on your own desk, and reading the receipts. Plus a note when we publish new proof." source="receipts-index" offer="proof-playbook" buttonText="Send it" fold="tally"
      consentText="By subscribing you agree to receive the AI For Everyone digest, one email a week, no more. You can unsubscribe any time. See our privacy policy." />
  </main>
  <Footer showDownload={false} />
</PaperLayout>
