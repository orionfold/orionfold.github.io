---
// Lead magnet — gates the free AI Native Business book behind a double-opt-in
// email capture. NO Stripe, NO checkout: a pure waitlist-signup opt-in with
// offer=become-ai-native-business; the book is delivered by confirm-email on
// confirm (see supabase/functions/confirm-email). Logo-only header + no footer
// = a 1:1 attention ratio (one action: enter email). The web book stays open
// and indexed; only the download is gated.
//
// 2026-08-15 (operator): the page now ties the free book to Flow, the flagship.
// The book GUIDES (how an AI-native business is structured); Flow TOOLS the
// knowledge worker who has to do that work in a document. Still ONE capture and
// ONE offer key — offer=become-ai-native-business is what confirm-email matches
// to deliver the book, so it must not change. The capture uses the same panel
// treatment as the Flow waitlist so both funnels read as one system. Flow copy
// here stays broad positioning plus the current in-development / Mac /
// freemium-planned facts, no mechanism claims.
import Layout from '../layouts/Layout.astro';
import BrandMark from '../components/ui/BrandMark.astro';
import WaitlistForm from '../components/ui/WaitlistForm.astro';
import { Image } from 'astro:assets';
import { ogMeta } from '../data/og';
import bookCover from '../assets/book/ai-native-business-book.jpg';

const og = ogMeta('/become-ai-native-business/');

// Consent scope now names Flow updates as well as the digest, because that is
// what this capture actually subscribes you to. Recorded verbatim on every
// submit (consent_text), so the stored record matches what the reader agreed to.
const consentText =
  'By subscribing you agree to receive the free book, Orionfold Flow development and launch updates, plus the AI For Everyone digest, one email a week, no more. You can unsubscribe any time. See our privacy policy.';
const privacyNote = consentText.replace(' See our privacy policy.', '');

// What's in the book — marketing-finalized outcome bullets (relay 2026-06-28 §5.2).
const insideBullets = [
  'How an AI-native company is actually structured: the shift from a hierarchy of people to an organization that runs on intelligence.',
  'Where AI does the work, not just the talking: how to refine your data, build your own tools, reuse what works, and put models to the test.',
  'How the pieces hold together at scale: institutional memory so nothing is relearned, agents that coordinate, and a governance layer you can trust.',
  'Where this is all heading: world models, systems that build their own systems, and what an AI-native business looks like a few years out.',
];

// Objection-as-header blocks (relay 2026-06-28 §5.3). These double as the
// FAQPage schema below, so they are real AEO/citation surface as well as
// conversion copy. Grade 3-5, no em-dashes.
const objections = [
  {
    q: 'Is it really free?',
    a: 'Yes. The full book sells for $20, and you get the same PDF and EPUB at no cost. We ask for your email so we can send the files and one short note a week. That is the whole deal.',
  },
  {
    q: 'What do you do with my email?',
    a: 'We send your book, then the AI For Everyone digest, one email a week, no more. You also get Orionfold Flow updates and the launch note when our Mac app is ready. We never sell or rent your address. You can leave any time with one click.',
  },
  {
    q: 'What is Orionfold Flow?',
    a: 'Flow is the Mac app we are building for the person doing the work: a place to conduct documents with AI agency built in, where you stay the one who approves what changes. The book shows you how an AI-native business is shaped. Flow is the tool for the writing, research, and reporting that shape asks of you. It is in development as a freemium subscription, so there is nothing to buy today.',
  },
  {
    q: 'Is this a sales pitch in disguise?',
    a: 'No. The book stands on its own and you can read the whole thing free online too. If you later want our tools, they are there. But the book owes you nothing in return.',
  },
  {
    q: 'Who is it for?',
    a: 'Founders and operators who want their business to run on AI, not just chat with it. It is not a guide to building models. It is a guide to running a company that already thinks in AI.',
  },
];

const title = 'Get the free AI Native Business book · Orionfold';
const description =
  'Get the $20 AI Native Business book free. Enter your email for the PDF and EPUB, plus updates on Orionfold Flow, the Mac app for the knowledge worker doing the work.';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: objections.map((o) => ({
    '@type': 'Question',
    name: o.q,
    acceptedAnswer: { '@type': 'Answer', text: o.a },
  })),
};
---
<Layout title={title} description={description} ogImage={og.image} ogImageAlt={og.alt} jsonLd={faqSchema}>
  <header class="px-6 py-5">
    <!-- Logo + wordmark, top-left, subtle and NON-LINKED (marketing 2026-06-28):
         brand presence for trust, but no escape hatch off the page so the only
         action is the email form (max 1:1 attention ratio). -->
    <div class="inline-flex items-center gap-1.5 opacity-80" aria-label="Orionfold">
      <BrandMark size={28} class="h-7 w-7" />
      <span class="text-xl font-semibold tracking-tight leading-none">
        <span class="text-text">Orion</span><span class="text-primary">fold</span>
      </span>
    </div>
  </header>

  <main class="mx-auto max-w-5xl px-6 pb-24 pt-6">
    <div class="grid items-center gap-12 md:grid-cols-2">
      <!-- Left: the offer + capture -->
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-primary">Free book · normally $20</p>
        <h1 class="mt-4 leading-tight" style="font-size: clamp(2rem, 5vw, 3rem);">
          Become an AI-native business.
        </h1>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-text-muted">
          Not how to build AI models. How to run a business that already thinks
          in AI.
        </p>
        <p class="mt-3 max-w-md leading-relaxed text-text-muted">
          Get the $20 <span class="italic">AI Native Business</span> book free.
          Just your email, and we send the PDF and EPUB to read on any device.
        </p>
        <p class="mt-3 max-w-md leading-relaxed text-text-muted">
          You will also be first to hear about <span class="font-semibold text-text">Orionfold Flow</span>,
          the Mac app we are building for the person doing the work.
        </p>

        <!-- Capture panel: same treatment as the Flow waitlist (FlowWaitlist.astro)
             so both funnels read as one system. Offer key is unchanged. -->
        <div class="mt-8 rounded-2xl border border-border/80 bg-surface/85 p-5 backdrop-blur sm:p-6">
          <p class="mb-5 flex items-center justify-between gap-4 font-mono text-[0.64rem] uppercase tracking-[0.16em] text-text-dim">
            <span>Email only</span>
            <span>Double opt-in</span>
          </p>
          <WaitlistForm
            id="magnet-ainb"
            source="magnet-ai-native-business"
            offer="become-ai-native-business"
            buttonText="Send me the book"
            successMessage="Check your inbox to confirm, then your book is on the way."
            consentText={consentText}
          />
          <p class="mt-5 max-w-sm text-xs leading-relaxed text-text-dim">
            {privacyNote}{' '}
            <a class="underline underline-offset-2 hover:text-text-muted" href="/privacy/">See our privacy policy.</a>
          </p>
        </div>

        <p class="mt-8 border-l-2 border-primary/40 pl-4 text-sm leading-relaxed text-text-muted">
          Built by one team running private AI on hardware they own: 15 tools, 7
          models, 3 books, and the open-source Orionfold Proof engine.
        </p>
      </div>

      <!-- Right: the cover + what's inside -->
      <div>
        <Image
          src={bookCover}
          alt="AI Native Business book cover"
          width={420}
          height={560}
          class="mx-auto w-full max-w-xs rounded-xl border border-border shadow-2xl"
          loading="eager"
          fetchpriority="high"
        />
        <div class="mt-10">
          <h2 class="text-lg font-semibold">What's in the book</h2>
          <ul class="mt-4 space-y-3">
            {insideBullets.map((b) => (
              <li class="flex gap-3 text-sm leading-relaxed text-text-muted">
                <svg class="mt-1 shrink-0 text-primary" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-sm text-text-dim">Written to be read in about two hours, then kept as a working reference.</p>
        </div>
      </div>
    </div>

    <!-- Objection blocks (relay §5.3). Header-as-question doubles as FAQPage
         schema (jsonLd above) — AEO/citation surface as well as conversion. -->
    <!-- Book to Flow tie (operator 2026-08-15). The book is the map; Flow is the
         tool. Copy stays broad positioning plus the current in-development /
         Mac / freemium-planned facts. No mechanism, verification, privacy, or
         pricing claims. -->
    <section class="mx-auto mt-24 max-w-4xl" aria-labelledby="flow-tie-heading">
      <div class="rounded-[2rem] border border-primary/25 bg-primary/[0.04] px-6 py-10 sm:px-10 sm:py-12">
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.23em] text-primary">The book and the tool</p>
        <h2 id="flow-tie-heading" class="mt-4 text-balance text-3xl font-bold leading-[1.08] sm:text-4xl">
          The book shows you the shape. Flow does the work with you.
        </h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-text-muted">
          Reading how an AI-native business is put together is the first half. The
          second half is Monday morning, when the writing, the research, and the
          reporting still land on your desk.
        </p>
        <div class="mt-10 grid gap-8 sm:grid-cols-2">
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.18em] text-text-dim">The book guides</p>
            <p class="mt-3 leading-relaxed text-text-muted">
              <span class="italic">AI Native Business</span> is the map. How the work is
              structured, where AI does the doing instead of the talking, and how the
              pieces hold together as you grow. Read it in about two hours, then keep
              it as a working reference.
            </p>
          </div>
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.18em] text-primary">Flow tools the work</p>
            <p class="mt-3 leading-relaxed text-text-muted">
              Orionfold Flow is our Mac app for the knowledge worker: a place to
              conduct documents with AI agency built in, where you stay the one who
              approves what changes. It is in development as a freemium subscription,
              and your email puts you first in line.
            </p>
          </div>
        </div>
        <a href="/flow/" class="of-text-action mt-9 inline-flex items-center gap-2">
          Explore Orionfold Flow <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section class="mx-auto mt-24 max-w-2xl" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-center text-2xl font-semibold">Questions, answered straight</h2>
      <dl class="mt-10 space-y-8">
        {objections.map((o) => (
          <div>
            <dt class="text-lg font-semibold text-text">{o.q}</dt>
            <dd class="mt-2 leading-relaxed text-text-muted">{o.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Repeated CTA: convertible from any scroll depth (relay §5.5). -->
    <section class="mx-auto mt-24 max-w-xl text-center" aria-labelledby="cta2-heading">
      <h2 id="cta2-heading" class="leading-tight" style="font-size: clamp(1.6rem, 4vw, 2.2rem);">
        Ready when you are.
      </h2>
      <p class="mx-auto mt-4 max-w-md leading-relaxed text-text-muted">
        Get the $20 <span class="italic">AI Native Business</span> book free, and
        be first to hear when Orionfold Flow is ready.
      </p>
      <div class="mx-auto mt-8 max-w-md rounded-2xl border border-border/80 bg-surface/85 p-5 text-left backdrop-blur sm:p-6">
        <p class="mb-5 flex items-center justify-between gap-4 font-mono text-[0.64rem] uppercase tracking-[0.16em] text-text-dim">
          <span>Email only</span>
          <span>Double opt-in</span>
        </p>
        <WaitlistForm
          id="magnet-ainb-2"
          source="magnet-ai-native-business-footer"
          offer="become-ai-native-business"
          buttonText="Send me the book"
          successMessage="Check your inbox to confirm, then your book is on the way."
          consentText={consentText}
        />
        <p class="mt-5 max-w-sm text-xs leading-relaxed text-text-dim">
          {privacyNote}{' '}
          <a class="underline underline-offset-2 hover:text-text-muted" href="/privacy/">See our privacy policy.</a>
        </p>
      </div>
    </section>
  </main>

  <!-- Minimal footer (relay §5.6): CAN-SPAM needs an unsubscribe path + a
       postal address in the EMAILS; on the page we surface the publisher,
       unsubscribe note, and privacy link. -->
  <footer class="mt-24 border-t border-border px-6 py-10 text-center text-xs leading-relaxed text-text-dim">
    <p>Orionfold LLC · 2108 N St Ste N, Sacramento, CA 95816</p>
    <p class="mt-1">One email a week, no more. Unsubscribe any time from any email we send.</p>
    <p class="mt-2">
      <a class="underline underline-offset-2 hover:text-text-muted" href="/privacy/">Privacy policy</a>
    </p>
  </footer>
</Layout>
