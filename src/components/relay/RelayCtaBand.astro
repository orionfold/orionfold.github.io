---
import Origami from '../ui/Origami.astro';
import { RELAY, formatUsd } from '../../data/commerce';
interface Props {
  variant?: 'interstitial' | 'footer';
  eyebrow?: string;
  kicker?: string;
  line?: string;
  href?: string;
  label?: string;
  class?: string;
}
const {
  variant = 'footer',
  eyebrow = 'Orionfold Relay',
  kicker = 'Run your AI team from one place.',
  line,
  href = '/relay/',
  label = 'Explore Orionfold Relay',
  class: className,
} = Astro.props;

const price = formatUsd(RELAY.founding.amount);
const defaultLine = `The engine is free and open. A license unlocks the premium packs you own and keeps them yours, offline. Founding seats from ${price}.`;
const body = line ?? defaultLine;

---
<section class:list={['living-relay-band', variant === 'interstitial' && 'living-relay-band--interstitial', className]} aria-label="Get Orionfold Relay">
  <div class="living-paper-cta not-prose">
    <Origami variant="planes" />
    <div class="living-paper-cta__copy">
      <p class="living-eyebrow">{eyebrow}</p><h2>{kicker}</h2><p>{body}</p>
      <a href={href} data-relay-cta-btn class="of-primary-action">{label}<span aria-hidden="true"> →</span></a>
    </div>
  </div>
</section>
