---
// src/components/relay/ThemedShot.astro
// Light-only Relay screenshot. Native loading="lazy" keeps below-fold shots off
// the initial network path. Exact viewport dimensions from the corpus reserve
// layout for zero CLS. Never use this for an above-fold LCP hero. See
// docs/superpowers/specs/2026-07-09-relay-themed-screenshot-component-design.md
import index from '../../data/relay-shots.json';
import { themedShotProps } from './themed-shot.logic.mjs';

interface Props {
  id: string;
  alt?: string;
  class?: string;
}
const { id, alt, class: className } = Astro.props;
const shot = themedShotProps(index, { id, alt });
---

<div class:list={['relay-shot', className]} style={shot.style}>
  <img
    class="relay-shot__image"
    width={shot.width}
    height={shot.height}
    alt={shot.alt}
    loading="lazy"
    decoding="async"
    sizes={shot.sizes}
    src={shot.light.src}
    srcset={shot.light.srcset}
    data-no-zoom
  />
</div>
