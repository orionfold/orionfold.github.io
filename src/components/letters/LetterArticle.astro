---
// Renders one founder-letter edition in the Paper long-form template (R6,
// G-145): the edition as kicker, the markdown body, and the standard capability
// close in the rail. The close is the same on every edition by design: the
// letters are proof that always ladders up to the capability outcome (an AI team
// you own), so the reader never leaves on "our numbers are honest" alone.
import type { MarkdownHeading } from 'astro';
import PaperLongform from '../paper/PaperLongform.astro';
import RailCard from '../paper/RailCard.astro';
interface Props {
  edition: string;
  title: string;
  dek: string;
  date: Date;
  minutes: number;
  headings: MarkdownHeading[];
}
const { edition, title, dek, date, minutes, headings } = Astro.props;
---
<PaperLongform crumb={{ href: '/letter/', label: 'Letters from the founder' }} kicker={edition} title={title} dek={dek} published={date} minutes={minutes} headings={headings} magnet={false}>
  <slot />
  <Fragment slot="rail">
    <RailCard href="/proof/" kicker="Proof you can rerun" title="An AI team you can own." body="Every claim here has a receipt you can check, on the Spark you already own, with no per-token bill." go="Read the receipts" />
    <a class="pp-rail-link" href="/cockpit/">Get an AI team you own →</a>
  </Fragment>
  <slot name="after" slot="after" />
</PaperLongform>
