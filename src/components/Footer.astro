---
// Three curated navigation groups. Product catalogs and stories own their
// detail-page discovery; the shared footer stays concise on every route.
import Wordmark from './ui/Wordmark.astro';
import PaperCta from './ui/PaperCta.astro';
import { ORIONFOLD_FLOW_LIVE } from '../data/launch';
interface Props { showDownload?: boolean; downloadSource?: string; }
const { showDownload = true, downloadSource = 'footer-download' } = Astro.props;

const FLOW_COLUMNS = [
  [
    { href: '/flow/', label: 'Overview' },
    { href: '/essay/', label: 'Essay' },
    { href: '/manifesto/', label: 'Manifesto' },
  ],
  [
    { href: '/flow/tour/', label: 'Tour' },
    { href: '/flow/night-shift/', label: 'Night Shift' },
    { href: '/flow/living-documents/', label: 'Living Documents' },
    { href: '/flow/settings/', label: 'Settings' },
    { href: '/flow/specifications/', label: 'Tech Specs' },
    { href: '/flow/enterprise/', label: 'Enterprise' },
  ],
];
const ORIONFOLD_COLUMNS = [
  [
    { href: '/flow/', label: 'Flow' },
    { href: '/arena/', label: 'Arena' },
    { href: '/relay/', label: 'Relay' },
  ],
  [
    { href: '/about/', label: 'About' },
    { href: '/story/', label: 'Story' },
    { href: '/proposal/', label: 'Proposal' },
    { href: '/sponsor/', label: 'Sponsor' },
  ],
  [
    { href: '/models/', label: 'Models' },
    { href: '/dgx-spark/', label: 'DGX Spark' },
  ],
];
const legal = [
  { href: '/promise/', label: 'Promise' },
  { href: '/terms/', label: 'Terms' },
  { href: '/privacy/', label: 'Privacy' },
];
const year = new Date().getFullYear();
---
<footer class="living-footer border-t border-border">
  <div class="living-footer-acquisition">{showDownload && ORIONFOLD_FLOW_LIVE && <PaperCta source={downloadSource} tone="yellow" />}</div>
  <div class="living-footer-menu">
    <nav class="living-footer-group" aria-labelledby="footer-flow-heading">
      <h2 id="footer-flow-heading">Flow</h2>
      <div class="living-footer-link-columns living-footer-link-columns--flow">
        {FLOW_COLUMNS.map(column => <ul>{column.map(link => <li><a href={link.href}>{link.label}</a></li>)}</ul>)}
      </div>
    </nav>
    <nav class="living-footer-group" aria-labelledby="footer-orionfold-heading">
      <h2 id="footer-orionfold-heading">Orionfold</h2>
      <div class="living-footer-link-columns living-footer-link-columns--orionfold">
        {ORIONFOLD_COLUMNS.map(column => <ul>{column.map(link => <li><a href={link.href}>{link.label}</a></li>)}</ul>)}
      </div>
    </nav>
    <section class="living-footer-group living-footer-group--connect" aria-labelledby="footer-connect-heading">
      <h2 id="footer-connect-heading">Connect</h2>
      <div class="living-footer-socials">
        <a href="https://www.linkedin.com/in/manavsehgal/" target="_blank" rel="noopener noreferrer" aria-label="Manav Sehgal on LinkedIn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.26 2.37 4.26 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z" />
          </svg>
        </a>
        <a href="https://x.com/manavsehgal" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg></a>
        <a href="https://github.com/manavsehgal" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg></a>
      </div>
    </section>
  </div>
  <div class="living-footer-utility">
    <Wordmark size={28} />
    <p>&copy; {year} Orionfold LLC.</p>
    <nav class="living-footer-legal" aria-label="Legal">
      {legal.map(link => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</footer>

<style>
  .living-footer-menu, .living-footer-utility {
    width: min(1260px, calc(100% - 96px)); margin-inline: auto;
    color: var(--living-ink); font: 400 14px/1.55 var(--font-body);
  }
  .living-footer-menu {
    display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr) minmax(132px, 1fr);
    gap: 48px; padding-block: 56px 48px;
  }
  .living-footer-group { min-width: 0; }
  .living-footer-group h2 {
    margin: 0 0 22px; color: var(--living-ink);
    font: 700 30px/1.05 var(--font-display); letter-spacing: -.015em;
    text-transform: uppercase;
  }
  .living-footer-link-columns { display: grid; gap: 24px; }
  .living-footer-link-columns--flow { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .living-footer-link-columns--orionfold { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .living-footer-link-columns ul { margin: 0; padding: 0; min-width: 0; list-style: none; }
  .living-footer-link-columns li { margin: 0; }
  .living-footer-link-columns a {
    display: inline-block; padding-block: 6px;
    color: var(--living-ink); font: 400 14px/1.55 var(--font-body); text-decoration: none;
  }
  .living-footer-link-columns a:hover, .living-footer-legal a:hover {
    color: var(--living-action); text-decoration: underline; text-underline-offset: 4px;
  }
  .living-footer-socials { display: flex; align-items: center; gap: 6px; margin-left: -8px; }
  .living-footer-socials a {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; color: var(--living-ink); border-radius: 5px;
  }
  .living-footer-socials a:hover { color: var(--living-action); background: var(--living-yellow-soft); }
  .living-footer-utility {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 24px; padding-block: 26px 32px; border-top: 1px solid var(--living-line);
  }
  .living-footer-utility p { margin: 0; color: #43595b; font: 400 13px/1.55 var(--font-body); }
  .living-footer-legal { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; }
  .living-footer-legal a { color: #43595b; font: 400 13px/1.55 var(--font-body); text-decoration: none; padding-block: 6px; }
  @media (max-width: 900px) {
    .living-footer-menu { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 36px; }
    .living-footer-group--connect { grid-column: 1 / -1; }
  }
  @media (max-width: 600px) {
    .living-footer-menu, .living-footer-utility { width: calc(100% - 40px); }
    .living-footer-menu { grid-template-columns: minmax(0, 1fr); gap: 34px; padding-block: 42px 34px; }
    .living-footer-group--connect { grid-column: auto; }
    .living-footer-group h2 { font-size: 28px; margin-bottom: 16px; }
    .living-footer-link-columns { gap: 14px; }
    .living-footer-utility { flex-direction: column; align-items: flex-start; gap: 18px; }
  }
</style>
