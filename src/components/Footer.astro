---
// The site shell's foot (G-140, Paper R1): the page's closing Download call
// (still per-page, gated and attributed), then the Paper footer. Every curated
// link comes from src/data/footer-links.ts through PaperFooter, so no
// internal link is lost in the switch.
import '../styles/paper/tokens.css';
import '../styles/paper/shell.css';
import PaperCta from './ui/PaperCta.astro';
import PaperFooter from './paper/PaperFooter.astro';
import { ORIONFOLD_FLOW_LIVE } from '../data/launch';
interface Props { showDownload?: boolean; downloadSource?: string; }
const { showDownload = true, downloadSource = 'footer-download' } = Astro.props;
---
<div class="living-footer-acquisition">{showDownload && ORIONFOLD_FLOW_LIVE && <PaperCta source={downloadSource} tone="yellow" />}</div>
<div class="paper pp-shell-foot"><PaperFooter /></div>
