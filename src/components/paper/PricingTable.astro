---
// Three plans side by side. Prices come in as props from the pricing source of
// truth; this component never states a price of its own. Each plan can carry
// what it includes, shown on request (operator 2026-10-30: progressive
// disclosure on the home instead of a link away).
export interface PriceFeature { label: string; note?: string }
export interface PricePlan { name: string; price: string; unit?: string; line: string; features?: PriceFeature[]; terms?: string }
interface Props { plans: PricePlan[] }
const { plans } = Astro.props;
---
<div class="pp-price">
  {plans.map((p) => (
    <div>
      <span>{p.name}</span>
      <b>{p.price}{p.unit && <small> {p.unit}</small>}</b>
      <p>{p.line}</p>
      {p.features && p.features.length > 0 && (
        <details class="pp-price-more">
          <summary>What {p.name} includes <em>{p.features.length}</em></summary>
          <ul>{p.features.map((f) => <li><b>{f.label}</b>{f.note && <small>{f.note}</small>}</li>)}</ul>
          {p.terms && <p class="pp-price-terms">{p.terms}</p>}
        </details>
      )}
    </div>
  ))}
</div>
