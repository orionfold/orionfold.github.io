---
// Filter chips on the left, a sliding row of cards on the right. Cards are
// real links; the chips only filter what is already on the page.
export interface RailItem { cat: string; title: string; line: string; href?: string; tag?: string; quote?: boolean; icon?: string; tint?: string }
interface Props { items: RailItem[]; allHref?: string; allLabel?: string; label: string }
const { items, allHref, allLabel, label } = Astro.props;
const cats = ['All', ...new Set(items.map((i) => i.cat))];
---
<div class="pp-rail-row" data-pp-rail>
  <div class="pp-rail-side">
    <div class="pp-chips" role="group" aria-label={`Filter ${label}`}>
      {cats.map((c, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-pp-cat={c}>{c}</button>)}
    </div>
    {allHref && <a class="pp-btn" href={allHref}>{allLabel}</a>}
  </div>
  <div class="pp-rail" role="list" aria-label={label}>
    <slot name="lead" />
    {items.map((it) => {
      const Tag = it.href ? 'a' : 'div';
      return (
        <Tag class="pp-card" role="listitem" href={it.href} data-pp-cat={it.cat}>
          {it.icon && <span class="pp-ico" style={it.tint ? `background:${it.tint}` : undefined} set:html={it.icon} />}
          <h4>{it.title}</h4>
          <p class:list={{ 'pp-quote': it.quote }}>{it.line}</p>
          <span class="pp-card-tag">{it.tag ?? it.cat}</span>
        </Tag>
      );
    })}
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-pp-rail]').forEach((r) => {
    const chips = r.querySelectorAll<HTMLButtonElement>('.pp-chips button');
    chips.forEach((b) => b.addEventListener('click', () => {
      const c = b.dataset.ppCat;
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      r.querySelectorAll<HTMLElement>('.pp-card[data-pp-cat]').forEach((card) => { card.hidden = c !== 'All' && card.dataset.ppCat !== c; });
    }));
  });
</script>
