---
// A Paper media frame (0.4.0 §4.14): an image, a screenshot or a video keeps
// its aspect ratio inside one bordered frame, the caption sits under it in
// ink-3, and generated media carries the "Made with AI" chip. Replaces the
// 0.3.x window shot (G-150).
interface Props {
  caption?: string;
  /** the picture was generated by a model: shows the chip */
  ai?: boolean;
  /** 'auto' lets the media set the height (contain); default crops to 16:9 */
  ratio?: 'auto' | 'wide' | 'square' | 'contain';
  class?: string;
}
const { caption, ai = false, ratio, class: cls = '' } = Astro.props;
---
<figure class:list={['pp-media', cls]}>
  <div class:list={['pp-media-frame', { 'pp-media-frame--auto': ratio === 'auto', 'pp-media-frame--wide': ratio === 'wide', 'pp-media-frame--square': ratio === 'square', 'pp-media-frame--contain': ratio === 'contain' }]}>
    <slot />
    {ai && <span class="pp-prov pp-ai-chip">Made with AI</span>}
  </div>
  {(caption || Astro.slots.has('caption')) && <figcaption>{caption}<slot name="caption" /></figcaption>}
</figure>
