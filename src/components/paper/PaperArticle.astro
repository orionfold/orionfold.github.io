---
// The Paper shell for the catalog articles (R5, G-144): Playbooks, Paths,
// Elements and Compare detail pages. Paper owns the hero (crumb, kicker, title,
// dek, byline, one link) and the figure under it; the reading layout (contents
// rail, prose, receipt) keeps its Living styles inside the bridge until the
// long-form article template replaces it in R6 (G-145).
interface Props {
  crumb: { href: string; label: string };
  kicker: string;
  title: string;
  dek: string;
  meta: string[];
  dateIso: string;
  dateLabel: string;
  link?: { href: string; label: string };
  /** Body classes the Living reading styles key on (ed-page, fp-page, …). */
  scope?: string;
}
const { crumb, kicker, title, dek, meta, dateIso, dateLabel, link, scope = '' } = Astro.props;
---
<section class="pp-hero pp-hero--inner pp-hero--article" aria-labelledby="pp-article-title">
  <div class="pp-hero-copy">
    <p class="pp-article-crumb"><a href={crumb.href}>← {crumb.label}</a><span class="pp-kicker">{kicker}</span></p>
    <h1 id="pp-article-title" class="pp-h1">{title}</h1>
    <p class="pp-sub">{dek}</p>
    <slot name="note" />
    <div class="pp-article-meta">
      <p>{meta.map((m) => <span>{m}</span>)}<time datetime={dateIso}>{dateLabel}</time></p>
      {link && <a class="pp-btn pp-btn--ghost" href={link.href}>{link.label}</a>}
    </div>
  </div>
</section>
{Astro.slots.has('figure') && <div class:list={['pp-article-figure ls ls-in-paper ls-article-figure', scope]}><slot name="figure" /></div>}
<div class:list={['ls ls-in-paper pp-article-body ls-article-body', scope]}>
  <slot />
</div>
