---
// The locked home hero (operator 2026-10-30): a person says how they work,
// their Fold answers "That's your playbook now", and the chat turns into a
// taped paper playbook. It rotates through the cast. With reduced motion, or
// before the script runs, the first Fold's finished page shows as plain HTML.
// The hero mock is never the LCP element: the H1 is.
import Fold from './Fold.astro';
import { FOLDS, foldSvg } from '../../lib/paper/folds';
import { PLAY } from '../../lib/paper/cast';
import type { FoldId } from '../../lib/paper/folds';
interface Props { faces?: Partial<Record<FoldId, string>>; ctaHref: string; ctaLabel: string; ctaNote?: string; interval?: number }
const { faces = {}, ctaHref, ctaLabel, ctaNote, interval = 10400 } = Astro.props;
const first = FOLDS[0];
const p0 = PLAY[first.id];
const cast = FOLDS.map((f) => ({ id: f.id, name: f.name, kind: f.kind, a: f.a, c: f.c, ink: f.ink, svg: foldSvg(f, { className: 'pp-bob' }), face: faces[f.id] ?? '', play: PLAY[f.id] }));
---
<section class="pp-hero" aria-label="Intro" style={`--pp-fold-a:${first.a};--pp-fold-c:${first.c};--pp-fold-ink:${first.ink}`} data-pp-hero data-interval={interval}>
  <div class="pp-hero-copy">
    <slot name="title" />
    <slot name="sub" />
    <div class="pp-hero-cta"><a class="pp-btn" href={ctaHref}>{ctaLabel}</a>{ctaNote && <small>{ctaNote}</small>}</div>
  </div>
  <div class="pp-duo" data-act="page" aria-hidden="true">
    <div class="pp-duo-talk pp-tk">
      <div class="pp-tk-row">
        <div class="pp-tk-av">{faces[first.id] && <img data-pp-face src={faces[first.id]} alt="" width="128" height="128" />}</div>
        <div><p class="pp-tk-who" data-pp-you>You, {p0.who.toLowerCase()}</p><div class="pp-tk-b" data-pp-said>{p0.said}</div></div>
      </div>
      <div class="pp-tk-row pp-tk-row--ai">
        <Fold id={first.id} bob class="pp-tk-av" />
        <div><p class="pp-tk-who" data-pp-who>{first.name} the {first.kind}</p><div class="pp-tk-b" data-pp-reply>Got it. That’s your playbook now. I’ll {p0.run}, and bring step 3 back to you.</div></div>
      </div>
    </div>
    <div class="pp-duo-page">
      <div class="pp-pb">
        <figure class="pp-pb-photo">{faces[first.id] ? <img data-pp-face src={faces[first.id]} alt="" width="400" height="500" /> : <Fold id={first.id} />}<span data-pp-role>{p0.who}</span></figure>
        <div class="pp-pb-sheet" data-pp-sheet>
          <span class="pp-pb-crumb">{p0.area} / playbook.md</span>
          <h3>{p0.title}</h3>
          <p class="pp-pb-for">{p0.client ? `For ${p0.client}` : 'For every client'}</p>
          <ol class="pp-pb-steps">{p0.steps.map((s, i) => <li class:list={{ 'pp-yours': i === 2 }}><span>{s}<small>{i === 2 ? 'YOUR CALL' : `${first.name.toUpperCase()} DOES THIS`}</small></span></li>)}</ol>
        </div>
        <Fold id={first.id} bob class="pp-pb-fold" />
        <p class="pp-pb-note">I’ll do steps 1 and 2. Step 3 is your call.</p>
      </div>
    </div>
  </div>
  <script type="application/json" data-pp-cast set:html={JSON.stringify(cast)} />
</section>

<script>
  type Beat = { id: string; name: string; kind: string; a: string; c: string; ink: string; svg: string; face: string; play: { area: string; who: string; client: string; title: string; said: string; steps: string[]; run: string } };
  const hero = document.querySelector<HTMLElement>('[data-pp-hero]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (hero && !reduce) {
    const cast: Beat[] = JSON.parse(hero.querySelector('[data-pp-cast]')!.textContent!);
    const duo = hero.querySelector<HTMLElement>('.pp-duo')!;
    const said = duo.querySelector<HTMLElement>('[data-pp-said]')!;
    const reply = duo.querySelector<HTMLElement>('[data-pp-reply]')!;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    let cur = 0, typing = 0, timers: number[] = [];
    const fill = (b: Beat) => {
      hero.style.setProperty('--pp-fold-a', b.a); hero.style.setProperty('--pp-fold-c', b.c); hero.style.setProperty('--pp-fold-ink', b.ink);
      duo.querySelectorAll<HTMLImageElement>('[data-pp-face]').forEach((im) => { if (b.face) im.src = b.face; });
      duo.querySelector('[data-pp-you]')!.textContent = `You, ${b.play.who.toLowerCase()}`;
      duo.querySelector('[data-pp-role]')!.textContent = b.play.who;
      duo.querySelector('[data-pp-who]')!.textContent = `${b.name} the ${b.kind}`;
      duo.querySelectorAll('.pp-tk-av.pp-fold, .pp-pb-fold, .pp-pb-photo > .pp-fold').forEach((el) => { el.innerHTML = b.svg; });
      reply.textContent = `Got it. That’s your playbook now. I’ll ${b.play.run}, and bring step 3 back to you.`;
      const p = b.play;
      duo.querySelector('[data-pp-sheet]')!.innerHTML = `<span class="pp-pb-crumb">${esc(p.area)} / playbook.md</span><h3>${esc(p.title)}</h3><p class="pp-pb-for">${p.client ? 'For ' + esc(p.client) : 'For every client'}</p><ol class="pp-pb-steps">${p.steps.map((t, i) => `<li${i === 2 ? ' class="pp-yours"' : ''}><span>${esc(t)}<small>${i === 2 ? 'YOUR CALL' : esc(b.name.toUpperCase()) + ' DOES THIS'}</small></span></li>`).join('')}</ol>`;
    };
    const play = (b: Beat) => {
      timers.forEach(clearTimeout); clearInterval(typing); timers = [];
      const start = () => {
        fill(b); reply.classList.add('pp-wait'); said.textContent = ''; duo.dataset.act = 'talk';
        let k = 0;
        typing = window.setInterval(() => {
          said.textContent = b.play.said.slice(0, ++k);
          if (k >= b.play.said.length) {
            clearInterval(typing);
            timers.push(window.setTimeout(() => reply.classList.remove('pp-wait'), 250));
            timers.push(window.setTimeout(() => { duo.dataset.act = 'page'; }, 2300));
          }
        }, 22);
      };
      if (duo.dataset.act === 'page') { duo.dataset.act = 'out'; timers.push(window.setTimeout(start, 450)); } else start();
    };
    cast.forEach((b) => { if (b.face) new Image().src = b.face; });
    play(cast[0]);
    window.setInterval(() => { cur = (cur + 1) % cast.length; play(cast[cur]); }, Number(hero.dataset.interval));
  }
</script>
