---
// The locked home hero (operator 2026-10-30): a person says how they work,
// their Fold answers "That's your playbook now", and the chat turns into a
// taped paper playbook. It rotates through the cast. With reduced motion, or
// before the script runs, the first Fold's finished page shows as plain HTML.
// The hero mock is never the LCP element: the H1 is.
// Controls (operator 2026-10-30): previous, play/pause and next walk the beats
// (each Fold talks, then shows its page), and a Fold chip jumps to that Fold.
// They appear once the script runs; with reduced motion nothing plays by itself.
// The served HTML holds the finished page (no JS, reduced motion). When the
// hero will play, a tiny inline script flips it to the empty chat before the
// first paint, so the page never flashes in and then gives way to the chat.
// Pacing (operator 2026-10-30): every beat is held for its own words at an
// adult's silent reading rate, 250 words a minute (Brysbaert 2019: 238 for
// non-fiction, 260 for fiction), plus a short glance to find the new text.
// Feature demo (operator 2026-10-31): each beat shows one Flow feature (cast
// HERO), and the ask types 25% faster than reading pace.
import Fold from './Fold.astro';
import Play from '@lucide/astro/icons/play';
import Pause from '@lucide/astro/icons/pause';
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import { FOLDS, foldSvg } from '../../lib/paper/folds';
import { PLAY, HERO } from '../../lib/paper/cast';
import type { FoldId } from '../../lib/paper/folds';
interface Props { faces?: Partial<Record<FoldId, string>>; ctaHref: string; ctaLabel: string; ctaNote?: string; ctaTrack?: string }
const { faces = {}, ctaHref, ctaLabel, ctaNote, ctaTrack } = Astro.props;
const first = FOLDS[0];
const p0 = PLAY[first.id];
const h0 = HERO[first.id];
const cast = FOLDS.map((f) => ({ id: f.id, name: f.name, kind: f.kind, a: f.a, c: f.c, ink: f.ink, svg: foldSvg(f, { className: 'pp-bob' }), face: faces[f.id] ?? '', play: PLAY[f.id], hero: HERO[f.id] }));
---
<section class="pp-hero" aria-label="Intro" style={`--pp-fold-a:${first.a};--pp-fold-c:${first.c};--pp-fold-ink:${first.ink}`} data-pp-hero>
  <div class="pp-hero-copy">
    <slot name="title" />
    <slot name="sub" />
    <div class="pp-hero-cta"><a class="pp-btn" href={ctaHref} data-flow-download={ctaTrack}>{ctaLabel}</a>{ctaNote && <small>{ctaNote}</small>}</div>
  </div>
  <div class="pp-hero-stage">
  <div class="pp-duo" data-act="page" aria-hidden="true">
    <div class="pp-duo-talk pp-tk">
      <div class="pp-tk-row">
        <div class="pp-tk-av">{faces[first.id] && <img data-pp-face src={faces[first.id]} alt="" width="128" height="128" />}</div>
        <div><p class="pp-tk-who" data-pp-you>You, {p0.who.toLowerCase()}</p><div class="pp-tk-b" data-pp-said>{h0.said}</div></div>
      </div>
      <div class="pp-tk-row pp-tk-row--ai">
        <Fold id={first.id} bob class="pp-tk-av" />
        <div><p class="pp-tk-who" data-pp-who>{first.name} the {first.kind}</p><div class="pp-tk-b" data-pp-reply>{h0.reply}</div></div>
      </div>
    </div>
    <div class="pp-duo-page">
      <div class="pp-pb">
        <figure class="pp-pb-photo">{faces[first.id] ? <img data-pp-face src={faces[first.id]} alt="" width="400" height="500" /> : <Fold id={first.id} />}<span data-pp-role>{p0.who}</span></figure>
        <div class="pp-pb-sheet" data-pp-sheet>
          <span class="pp-pb-crumb">{p0.area} / {h0.file}</span>
          <h3>{h0.title}</h3>
          <p class="pp-pb-for">{p0.client ? `For ${p0.client}` : 'For every client'}</p>
          <ol class="pp-pb-steps">{h0.rows.map((r, i) => <li class:list={{ 'pp-yours': i === 2 }}><span>{typeof r === 'string' ? r : r[0]}<small>{typeof r === 'string' ? 'YOUR CALL' : r[1].toUpperCase()}</small></span></li>)}</ol>
        </div>
        <Fold id={first.id} bob class="pp-pb-fold" />
        <p class="pp-pb-note" data-pp-note>{h0.note}</p>
      </div>
    </div>
  </div>
  <script is:inline>(function () { var d = document.currentScript.previousElementSibling; if (!d || matchMedia('(prefers-reduced-motion: reduce)').matches) return; d.dataset.act = 'talk'; d.querySelector('[data-pp-said]').textContent = ''; d.querySelector('[data-pp-reply]').classList.add('pp-wait'); })();</script>
  <div class="pp-hero-ctl" data-pp-ctl hidden>
    <button type="button" class="pp-ctl-btn" data-pp-prev aria-label="Previous step"><ChevronLeft size={16} /></button>
    <button type="button" class="pp-ctl-btn" data-pp-toggle aria-pressed="true" aria-label="Pause"><Pause size={15} class="pp-i-pause" /><Play size={15} class="pp-i-play" /></button>
    <button type="button" class="pp-ctl-btn" data-pp-next aria-label="Next step"><ChevronRight size={16} /></button>
    <div class="pp-ctl-folds" role="group" aria-label="Pick a Fold">
      {FOLDS.map((f, i) => <button type="button" data-pp-go={i} aria-label={`${f.name} the ${f.kind}, ${PLAY[f.id].who}`} aria-current={i === 0 ? 'true' : undefined}><Fold id={f.id} /></button>)}
    </div>
    <span class="sr-only" aria-live="polite" data-pp-status></span>
  </div>
  </div>
  <script type="application/json" data-pp-cast set:html={JSON.stringify(cast)} />
</section>

<script>
  type Beat = { id: string; name: string; kind: string; a: string; c: string; ink: string; svg: string; face: string; play: { area: string; who: string; client: string; title: string; said: string; steps: string[]; run: string }; hero: { said: string; reply: string; file: string; title: string; rows: [[string, string], [string, string], string]; note: string } };
  // Beats: Fold n talks (2n), then shows its page (2n + 1). Playing types the
  // ask, answers, turns to the page and holds it; stepping shows a beat whole.
  const hero = document.querySelector<HTMLElement>('[data-pp-hero]');
  if (hero) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cast: Beat[] = JSON.parse(hero.querySelector('[data-pp-cast]')!.textContent!);
    const duo = hero.querySelector<HTMLElement>('.pp-duo')!;
    const said = duo.querySelector<HTMLElement>('[data-pp-said]')!;
    const reply = duo.querySelector<HTMLElement>('[data-pp-reply]')!;
    const ctl = hero.querySelector<HTMLElement>('[data-pp-ctl]')!;
    const toggle = ctl.querySelector<HTMLButtonElement>('[data-pp-toggle]')!;
    const status = ctl.querySelector<HTMLElement>('[data-pp-status]')!;
    const chips = ctl.querySelectorAll<HTMLButtonElement>('[data-pp-go]');
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    // Reading pace: 250 words a minute, plus a 0.6 s glance per new block.
    // The ask types 25% faster than reading pace (operator 2026-10-31).
    const WPM = 250, TYPE_WPM = WPM * 1.25, GLANCE = 600, REVEAL = 1500;
    const words = (t: string) => t.trim().split(/\s+/).length;
    const readMs = (t: string) => GLANCE + (words(t) * 60000) / WPM;
    const replyText = (b: Beat) => b.hero.reply;
    const rowText = (r: string | [string, string]) => (typeof r === 'string' ? r : r[0]);
    const pageText = (b: Beat) => [b.hero.title, b.play.client ? `For ${b.play.client}` : 'For every client', ...b.hero.rows.map(rowText), b.hero.note].join(' ');
    const total = cast.length * 2;
    let beat = duo.dataset.act === 'talk' ? 0 : 1, playing = false, inView = false, started = false, timers: number[] = [], typing = 0;
    const clear = () => { timers.forEach(clearTimeout); timers = []; clearInterval(typing); };
    const later = (ms: number, fn: () => void) => { timers.push(window.setTimeout(fn, ms)); };
    const fill = (b: Beat) => {
      hero.style.setProperty('--pp-fold-a', b.a); hero.style.setProperty('--pp-fold-c', b.c); hero.style.setProperty('--pp-fold-ink', b.ink);
      duo.querySelectorAll<HTMLImageElement>('[data-pp-face]').forEach((im) => { if (b.face) im.src = b.face; });
      duo.querySelector('[data-pp-you]')!.textContent = `You, ${b.play.who.toLowerCase()}`;
      duo.querySelector('[data-pp-role]')!.textContent = b.play.who;
      duo.querySelector('[data-pp-who]')!.textContent = `${b.name} the ${b.kind}`;
      duo.querySelectorAll('.pp-tk-av.pp-fold, .pp-pb-fold, .pp-pb-photo > .pp-fold').forEach((el) => { el.innerHTML = b.svg; });
      reply.textContent = replyText(b);
      const p = b.play, h = b.hero;
      duo.querySelector('[data-pp-sheet]')!.innerHTML = `<span class="pp-pb-crumb">${esc(p.area)} / ${esc(h.file)}</span><h3>${esc(h.title)}</h3><p class="pp-pb-for">${p.client ? 'For ' + esc(p.client) : 'For every client'}</p><ol class="pp-pb-steps">${h.rows.map((r, i) => `<li${i === 2 ? ' class="pp-yours"' : ''}><span>${esc(rowText(r))}<small>${typeof r === 'string' ? 'YOUR CALL' : esc(r[1].toUpperCase())}</small></span></li>`).join('')}</ol>`;
      duo.querySelector('[data-pp-note]')!.textContent = h.note;
    };
    const mark = () => {
      const f = Math.floor(beat / 2), b = cast[f];
      chips.forEach((c, i) => { if (i === f) c.setAttribute('aria-current', 'true'); else c.removeAttribute('aria-current'); });
      status.textContent = `${b.name} the ${b.kind}, ${beat % 2 ? 'the playbook' : 'the conversation'}. Step ${beat + 1} of ${total}.`;
    };
    // Show a beat. animate: type the ask and let the beat run on by itself.
    const show = (n: number, animate: boolean) => {
      clear();
      const prev = Math.floor(beat / 2);
      beat = (n + total) % total;
      const f = Math.floor(beat / 2), b = cast[f];
      const enter = () => {
        if (f !== prev || duo.dataset.act === 'out') fill(b);
        mark();
        if (beat % 2) { duo.dataset.act = 'page'; if (animate) later(REVEAL + readMs(pageText(b)), () => show(beat + 1, true)); return; }
        duo.dataset.act = 'talk';
        if (!animate) { said.textContent = b.hero.said; reply.classList.remove('pp-wait'); return; }
        said.textContent = ''; reply.classList.add('pp-wait');
        // The ask types a little faster than reading pace; the eye still follows the cursor.
        let k = 0;
        const perChar = (words(b.hero.said) * 60000) / TYPE_WPM / b.hero.said.length;
        typing = window.setInterval(() => {
          said.textContent = b.hero.said.slice(0, ++k);
          if (k < b.hero.said.length) return;
          clearInterval(typing);
          later(250, () => reply.classList.remove('pp-wait'));
          later(250 + readMs(replyText(b)), () => show(beat + 1, true));
        }, perChar);
      };
      if (f !== prev && duo.dataset.act === 'page') { duo.dataset.act = 'out'; later(animate ? 450 : 200, enter); } else enter();
    };
    const setPlaying = (on: boolean) => {
      playing = on;
      toggle.setAttribute('aria-pressed', String(on));
      toggle.setAttribute('aria-label', on ? 'Pause' : 'Play');
      if (on && inView) { started = true; show(beat % 2 ? beat + 1 : beat, true); } else clear();
    };
    ctl.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest('button');
      if (!t) return;
      if (t.hasAttribute('data-pp-toggle')) return setPlaying(!playing);
      playing = false; toggle.setAttribute('aria-pressed', 'false'); toggle.setAttribute('aria-label', 'Play');
      if (t.hasAttribute('data-pp-next')) show(beat + 1, false);
      else if (t.hasAttribute('data-pp-prev')) show(beat - 1, false);
      else if (t.dataset.ppGo) show(Number(t.dataset.ppGo) * 2, false);
    });
    cast.forEach((b) => { if (b.face) new Image().src = b.face; });
    ctl.hidden = false;
    mark();
    // Play while the hero is on screen; never by itself with reduced motion.
    new IntersectionObserver(([en]) => {
      inView = en.isIntersecting;
      if (!inView) clear();
      else if (playing) show(started ? (beat % 2 ? beat + 1 : beat) : 0, true);
      started = true;
    }, { threshold: 0.3 }).observe(duo);
    if (!reduce) { playing = true; toggle.setAttribute('aria-pressed', 'true'); } else { toggle.setAttribute('aria-pressed', 'false'); toggle.setAttribute('aria-label', 'Play'); }
  }
</script>
