---
// One Fold, drawn at build time. Decorative unless given a label.
import { foldById, foldSvg, type FoldId } from '../../lib/paper/folds';
interface Props { id: FoldId; bob?: boolean; label?: string; class?: string; fit?: boolean }
const { id, bob = false, label, class: cls = '', fit = false } = Astro.props;
const svg = foldSvg(foldById[id], { label, fit });
---
<div class:list={['pp-fold', cls, { 'pp-bob': bob, 'pp-fold--fit': fit }]} set:html={svg} />
