---
// A mock Flow window: the Playbook's files on the left, the open document on the
// right, ending in a sign-off the reader can press. With tabs, one window
// switches between Playbooks; each tab carries its own Fold's colors.
import { foldById, type FoldId } from '../../lib/paper/folds';
export interface FlowWindowDoc { id: string; label: string; fold: FoldId; files: string[]; doc: string; title: string; body: string; bars?: number[]; sign: string }
// `named` puts the Fold in the window and the byline. The /flow/ hero turns it
// off: Fold claims wait for the app release that carries them (D8).
// `level` keeps the outline whole: a hero window sits under the H1, so its
// document titles are h2.
interface Props { docs: FlowWindowDoc[]; named?: boolean; level?: 'h2' | 'h3' }
const { docs, named = true, level = 'h3' } = Astro.props;
const Title = level;
---
<div class="pp-flow-window" data-pp-window>
  {docs.length > 1 && (
    <div class="pp-tabs" role="tablist">
      {docs.map((d, i) => <button role="tab" type="button" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`pp-win-${d.id}`} data-pp-tab={d.id}>{d.label}</button>)}
    </div>
  )}
  {docs.map((d, i) => {
    const f = foldById[d.fold];
    return (
      <div class="pp-window" id={`pp-win-${d.id}`} role={docs.length > 1 ? 'tabpanel' : undefined} hidden={i > 0} style={`--pp-fold-a:${f.a}`}>
        <aside>
          <b>{d.label}</b>
          {d.files.map((x) => <span class:list={{ 'pp-on': x === d.doc }}>{x}</span>)}
          {named && <><b style="margin-top:14px">Fold</b><span>{f.name} the {f.kind}</span></>}
        </aside>
        <div class="pp-doc">
          <span class="pp-kicker">{d.label.toUpperCase()} / {d.doc.toUpperCase()}.MD</span>
          <Title class="pp-doc-title">{d.title}</Title>
          <p>{d.body}</p>
          {d.bars && <div class="pp-bars" aria-hidden="true">{d.bars.map((h) => <i style={`height:${h}%`} />)}</div>}
          <div class="pp-signoff">
            <div><b>{d.sign}</b><small>{named ? `${f.name} drafted this.` : 'Flow drafted this.'} It waits for your yes.</small></div>
            <button type="button" aria-pressed="false" data-pp-approve>Approve</button>
          </div>
        </div>
      </div>
    );
  })}
</div>
<style is:global>
  .pp-window[hidden] { display: none; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-pp-window]').forEach((w) => {
    w.querySelectorAll<HTMLButtonElement>('[data-pp-tab]').forEach((t) => t.addEventListener('click', () => {
      w.querySelectorAll('[data-pp-tab]').forEach((b) => b.setAttribute('aria-selected', String(b === t)));
      w.querySelectorAll<HTMLElement>('.pp-window').forEach((p) => { p.hidden = p.id !== `pp-win-${t.dataset.ppTab}`; });
    }));
    w.querySelectorAll<HTMLButtonElement>('[data-pp-approve]').forEach((b) => b.addEventListener('click', () => {
      const on = b.getAttribute('aria-pressed') !== 'true';
      b.setAttribute('aria-pressed', String(on)); b.textContent = on ? 'Approved' : 'Approve';
    }));
  });
</script>
