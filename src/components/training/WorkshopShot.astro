---
import shots from '../../data/training-workshop-shots.json';

interface Props {
  id: keyof typeof shots;
  alt: string;
  class?: string;
}

const { id, alt, class: className } = Astro.props;
const shot = shots[id];
if (!shot) throw new Error(`WorkshopShot: unknown screenshot id "${id}".`);
const sizes = '(min-width: 1280px) 680px, (min-width: 768px) calc(100vw - 8rem), calc(100vw - 3rem)';
---

<div class:list={['relay-shot', className]} style={`aspect-ratio:${shot.ratio};`}>
  <img
    class="relay-shot__image"
    width={shot.width}
    height={shot.height}
    alt={alt}
    loading="lazy"
    decoding="async"
    fetchpriority="low"
    sizes={sizes}
    src={shot.light.src}
    srcset={shot.light.srcset}
    data-no-zoom
  />
</div>
