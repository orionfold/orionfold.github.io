---
// TrustPage — the shared renderer for the on-site /trust/ pages (2026-07-03).
// One data-driven layout (mirrors promise.astro): a hero with a plain summary +
// a "short version" card, a sticky aside pointing at the canonical repo, then
// the sections (prose, bullets, tables, and muted notes). Content comes from
// src/data/trust-pages.ts; each route file passes one TrustPageData in. Voice
// keeps the technical specifics; the plain framing follows website-copy-style.
// R7a (G-146): rendered as the Paper long-form page (PaperLongform), with the
// "check it yourself" pointer and the sibling pages in the rail.
import PaperLayout from '../../layouts/PaperLayout.astro';
import PaperLongform from '../paper/PaperLongform.astro';
import '../../styles/living-in-paper.css';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { SITE, PUBLISHER } from '../../data/seo';
import { RELAY_REPO, trustPagesInOrder, type TrustPageData } from '../../data/trust-pages';

interface Props {
  page: TrustPageData;
}
const { page } = Astro.props;

// Sibling trust pages for the "more trust pages" tail (everything but this one).
const others = trustPagesInOrder().filter((p) => p.slug !== page.slug);
const canonical = `${RELAY_REPO}/blob/main/docs/trust/${page.slug}.md`;
// Data flow opens with its own "The short version" section; skip the callout there.
const hasShortSection = page.sections[0]?.title === 'The short version';
const slugify = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<PaperLayout
  title={`${page.title} · Orionfold`}
  description={page.summary}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: `${page.title} · Orionfold`,
      url: `${SITE.url}/trust/${page.slug}/`,
      inLanguage: 'en',
      publisher: PUBLISHER,
      description: page.summary,
      dateModified: page.lastUpdated,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Trust', item: `${SITE.url}/trust/` },
        { '@type': 'ListItem', position: 3, name: page.title, item: `${SITE.url}/trust/${page.slug}/` },
      ],
    },
  ]}
>
  <Nav />
  <main id="main" class="pp-page">
    <PaperLongform crumb={{ href: '/trust/', label: 'Trust' }} kicker={page.eyebrow} title={page.title} dek={page.summary} author={{ name: 'Orionfold', href: '/about/' }} updated={new Date(page.lastUpdated)} headings={page.sections.map((s) => ({ depth: 2, slug: slugify(s.title), text: s.title }))} magnet={false}>
      {!hasShortSection && (
        <aside class="pp-callout" aria-label="The short version">
          <p class="pp-kicker">The short version</p>
          <p>{page.shortVersion}</p>
        </aside>
      )}
      {page.sections.map((section) => (
        <Fragment>
          <h2 id={slugify(section.title)}>{section.title}</h2>
          {section.lead && <p>{section.lead}</p>}
          {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          {section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
          {section.table && (
            <div class="table-scroll"><table>
              <thead><tr>{section.table.head.map((h) => <th>{h}</th>)}</tr></thead>
              <tbody>{section.table.rows.map((row) => <tr>{row.map((cell, i) => i === 0 ? <td><strong>{cell}</strong></td> : <td>{cell}</td>)}</tr>)}</tbody>
            </table></div>
          )}
          {section.note && <aside class="pp-callout" aria-label="Note"><p>{section.note}</p></aside>}
        </Fragment>
      ))}
      <p>Ready to run it? <a href="/relay/">Get Orionfold Relay</a>. The engine is free and open. A license only adds the premium packs you own.</p>
      <div slot="rail" class="pp-rail-block">
        <p class="pp-kicker">Check it yourself</p>
        <p class="pp-rail-text">Every claim here is backed by open-source code you can read. This page mirrors the canonical trust doc in the Relay repository.</p>
        <a class="pp-link" href={canonical} target="_blank" rel="noopener">Read it in the repo →</a>
      </div>
      <nav slot="rail" class="pp-rail-block" aria-label="More trust pages">
        <p class="pp-kicker">More trust pages</p>
        <ul>{others.map((o) => <li><a href={`/trust/${o.slug}/`}>{o.title}</a></li>)}</ul>
      </nav>
    </PaperLongform>
  </main>
  <Footer showDownload={false} />
</PaperLayout>
