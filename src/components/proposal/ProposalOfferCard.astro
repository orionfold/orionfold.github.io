---
// One product card on /proposal/. Shared by the Flow section and the
// capability matrix so both render the same checkbox, quantity and price shape.
// The price comes from the shared catalog through the offer; nothing here types a
// number. Styled by src/styles/proposal.css (prop-card).
import { formatUsd, type ConsultingOffer } from '../../../supabase/functions/_shared/consulting-proposal';

interface Props {
  offer: ConsultingOffer;
  maxQuantity: number;
  /** A bento lead tile: spans both columns and lays its facts out in three. */
  featured?: boolean;
}
const { offer, maxQuantity, featured = false } = Astro.props;
---
<article class:list={["prop-card", featured && "prop-card-featured"]} data-offer-card={offer.id}>
  <input
    id={`offer-${offer.id}`}
    type="checkbox"
    name="selectedOffers"
    value={offer.id}
    class="prop-card-check prop-sr-only"
    aria-label={`Add ${offer.label} to proposal`}
  />
  <label for={`offer-${offer.id}`} class="prop-card-hit" aria-hidden="true"></label>
  <div class="prop-card-head">
    <div>
      <p class="prop-card-term">{offer.term}</p>
      <h3>{offer.label}</h3>
    </div>
    <label for={`offer-${offer.id}`} class="prop-add">
      <span class="prop-add-box" aria-hidden="true"></span>
      <span class="prop-add-off">Add</span>
      <span class="prop-add-on">Selected</span>
    </label>
  </div>
  <dl>
    <div><dt>Job</dt><dd>{offer.job}</dd></div>
    <div><dt>Choose it when</dt><dd>{offer.chooseWhen}</dd></div>
    <div><dt>What it contributes</dt><dd>{offer.contributes}</dd></div>
    <div><dt>Works with</dt><dd>{offer.worksWith}</dd></div>
    <div><dt>Do not choose it for</dt><dd>{offer.notFor}</dd></div>
    <div><dt>Included</dt><dd>{offer.includes}</dd></div>
  </dl>
  {offer.freeBoundary && <p class="prop-card-note">{offer.freeBoundary}</p>}
  <div class="prop-card-foot">
    <a class="ls-text-link prop-card-link" href={offer.href}>Review product details</a>
    <div class="prop-card-buy">
      <label class="prop-qty">
        <span>Quantity · {offer.unitLabel}</span>
        <input
          type="number"
          name={`quantity-${offer.id}`}
          data-offer-quantity={offer.id}
          value="1"
          min="1"
          max={maxQuantity}
          step="1"
          inputmode="numeric"
          disabled
          aria-label={`Number of ${offer.unitLabel} for ${offer.label}`}
        />
      </label>
      <p class="prop-price">
        {formatUsd(offer.amountCents)}
        <small>each{offer.mode === 'subscription' ? ' · per year' : ''}</small>
      </p>
    </div>
  </div>
</article>
