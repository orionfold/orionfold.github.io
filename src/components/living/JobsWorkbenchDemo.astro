---
import '../../styles/jobs-workbench.css';
import { JOBS_SCENARIOS } from '../../scripts/jobs-workbench.js';
interface Props { scenario?: 'customer' | 'portfolio'; mode?: 'full' | 'review'; compact?: boolean; instanceId?: string; disclosure?: boolean }
const { scenario = 'customer', mode = 'full', compact = false, instanceId, disclosure = true } = Astro.props;
const sample = JOBS_SCENARIOS[scenario];
const portfolio = scenario === 'portfolio';
const review = mode === 'review';
const id = instanceId || `jobs-${scenario}-${mode}-${compact ? 'compact' : 'full'}`;
---
<div class:list={['jw-demo', { 'jw-demo--compact': compact, 'jw-demo--review': review }]} data-jobs-demo data-scenario={scenario} data-mode={mode}>
  <div class="jw-caption">{!compact && disclosure && <span><i aria-hidden="true"></i> INTERACTIVE PRODUCT WALKTHROUGH</span>}<button type="button" data-action="reset">Reset <span aria-hidden="true">↺</span></button></div>
  <div class="jw-window">
    <div class="jw-titlebar"><span class="jw-traffic" aria-hidden="true"><i></i><i></i><i></i></span><span><img src="/logos/orionfold-mark-3d-32.png" alt="" width="20" height="20" />{sample.title}</span><span class="jw-titlebar-end">Flow 1.7</span></div>
    <div class="jw-workspace">
      <div class="jw-document">
        <div class="jw-document-meta"><span>{sample.folder}</span><span>.md</span></div>
        <h3>{sample.title}</h3>
        <p class="jw-document-dek">{portfolio ? 'Coverage first. Then the picture of what you hold.' : 'A small study. A clearer next question.'}</p>
        <p class="jw-sample-note">{portfolio ? 'Illustrative holdings · retained 2 Sep 2026 quotes · USD. Not current prices or an investment recommendation.' : disclosure ? 'Fictional discovery study · one primary need per person.' : 'One primary need per person.'}</p>
        <div class="jw-segment jw-document-view" data-review-view-toggle hidden={!review} aria-label="Review representation">
          <button type="button" data-action="view" data-value="document" aria-pressed="true">Document</button>
          <button type="button" data-action="view" data-value="exact" aria-pressed="false">Exact changes</button>
        </div>
        <div data-doc-view>
          <button class="jw-output jw-chart" type="button" data-part="chart" data-action="select" data-value="chart" disabled={!review} aria-label={`Inspect ${sample.partLabels.chart}`}>
            <span class="jw-output-heading"><strong>{sample.chartTitle}</strong><span class="jw-part-status" data-part-status="chart">{review ? 'Changed' : 'Saved view'}</span></span>
            {portfolio ? <>
              <span class="jw-kpi-label">Portfolio value, including cash</span>
              <span class="jw-kpi" data-chart-value>{review ? sample.chartAfter : sample.chartBefore}</span>
              <span class="jw-kpi-foot">Same securities. Same retained quote inputs.</span>
            </> : <>
              <span class="jw-chart-note">People · n = <span data-interview-count>{review ? '12' : '11'}</span></span>
              <span class="jw-lollipops">
                <span class="jw-lollipop"><span>Approval record</span><span class="jw-lollipop-track"><i style="width:100%"></i></span><b>5</b></span>
                <span class="jw-lollipop jw-lollipop--highlight"><span>Portable files</span><span class="jw-lollipop-track"><i data-portable-line style={`width:${review ? 80 : 60}%`}></i></span><b data-chart-value>{review ? '4' : '3'}</b></span>
                <span class="jw-lollipop"><span>Faster review</span><span class="jw-lollipop-track"><i style="width:40%"></i></span><b>2</b></span>
                <span class="jw-lollipop"><span>Local access</span><span class="jw-lollipop-track"><i style="width:20%"></i></span><b>1</b></span>
              </span>
            </>}
          </button>
          <button class="jw-output jw-finding" type="button" data-part="summary" data-action="select" data-value="summary" disabled={!review} aria-label={`Inspect ${sample.partLabels.summary}`}>
            <span class="jw-output-heading"><strong>{sample.summaryTitle}</strong><span class="jw-part-status" data-part-status="summary">{review ? 'Changed' : 'Saved view'}</span></span>
            {portfolio ? <span class="jw-cash-row"><span class="jw-donut" data-allocation style={`--cash:${review ? '12.2%' : '11.8%'}`} aria-hidden="true"></span><span><strong data-summary-value>{review ? sample.summaryAfter : sample.summaryBefore}</strong><small><span data-cash-percent>{review ? '12.2%' : '11.8%'}</span> of portfolio value</small></span></span> : <>
              <span class="jw-finding-row"><strong data-summary-value>{review ? sample.summaryAfter : sample.summaryBefore}</strong><span>Which export or handover failed last time?</span></span>
              <span class="jw-finding-foot">A research question, not a claim about the whole market.</span>
            </>}
          </button>
          <p class="jw-authored-note">{portfolio ? 'A $500 cash edit changes the total and allocation. Gains on the stocks do not change.' : 'Approval records still lead this small, biased sample. The chart updates its numbers; the interpretation remains yours.'}</p>
        </div>
        <div class="jw-exact" data-exact-view hidden>
          <span class="jw-micro">SELECTED PART</span><h4 data-selected-title>{sample.partLabels.chart}</h4>
          <div class="jw-diff-line jw-diff-before"><span aria-hidden="true">−</span><span data-diff-before>{sample.chartBefore}</span></div>
          <div class="jw-diff-line jw-diff-after"><span aria-hidden="true">+</span><span data-diff-after>{sample.chartAfter}</span></div>
          <p>The original and applied values for this part. Reverting restores its original value.</p>
        </div>
        <div class="jw-document-bottom"><span aria-hidden="true">↳</span><span data-source-note>Your source stays beside the document.</span></div>
      </div>
      <aside class="jw-workbench" aria-label={`Jobs Workbench for ${sample.title}`}>
        <div class="jw-workbench-title"><span aria-hidden="true">◫</span><strong>{review ? 'Review changes' : 'Jobs Workbench'}</strong><span class="jw-local">{portfolio ? 'Sample' : 'Local'}</span></div>
        {!review && <div class="jw-tabs" role="tablist" aria-label="Jobs Workbench">
          {['Edit', 'Run', 'Relations'].map((label, index) => <button type="button" id={`${id}-${label.toLowerCase()}-tab`} role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`${id}-${label.toLowerCase()}`} tabindex={index === 0 ? 0 : -1} data-action="tab" data-value={label.toLowerCase()}>{label}</button>)}
        </div>}
        <div class="jw-panel" data-panel="edit" hidden={review} id={`${id}-edit`} role={!review ? 'tabpanel' : undefined} aria-labelledby={!review ? `${id}-edit-tab` : undefined}>
          <p class="jw-micro">SAVED WORK</p>
          <div class="jw-job-choices" aria-label="Inspect saved Jobs">
            <button type="button" data-action="definition" data-value="gather" aria-pressed="true"><span class="jw-job-icon" aria-hidden="true">↓</span><span><strong>Gather</strong><small>{sample.definition}</small></span><span aria-hidden="true">›</span></button>
            <button type="button" data-action="definition" data-value="watch" aria-pressed="false"><span class="jw-job-icon" aria-hidden="true">↻</span><span><strong>Keep sources fresh</strong><small>Declared files</small></span><span aria-hidden="true">›</span></button>
          </div>
          <div class="jw-definition" data-definition="gather">
            <dl><div><dt>Read</dt><dd>{sample.source}</dd></div><div><dt>Jobs</dt><dd>{portfolio ? 'Value holdings · include cash' : 'Group by need · sum mentions'}</dd></div><div><dt>Write</dt><dd>{sample.output}</dd></div></dl>
            <p>{portfolio ? 'This walkthrough replays the retained quote inputs. A real live Gather reads the endpoints in its definition.' : 'A saved calculation. No model or web service required.'}</p>
          </div>
          <div class="jw-definition" data-definition="watch" hidden>
            <dl><div><dt>Watch</dt><dd>{sample.source}</dd></div><div><dt>Also</dt><dd>{portfolio ? 'data/' : 'Visit Notes.md'}</dd></div><div><dt>Scope</dt><dd>Files named by this document</dd></div></dl>
            <p>Declared relationships make the inputs inspectable. A link between documents does not schedule a run.</p>
          </div>
          <div class="jw-input-card"><span class="jw-micro">TRY ONE INPUT CHANGE</span><div><strong data-input-value>{review ? sample.inputAfter : sample.inputBefore}</strong><span data-input-new hidden={!review}>Saved</span></div><p>{sample.inputDescription}</p><button class="jw-secondary" type="button" data-action="input">{sample.inputAction}</button></div>
          <button class="jw-primary" type="button" data-action="run" disabled><span data-run-label>{portfolio ? 'Replay sample run' : 'Run Jobs'}</span><span aria-hidden="true">→</span></button>
        </div>
        <div class="jw-panel" data-panel="relations" hidden id={`${id}-relations`} role={!review ? 'tabpanel' : undefined} aria-labelledby={!review ? `${id}-relations-tab` : undefined}>
          <p class="jw-micro">DECLARED INPUTS & OUTPUTS</p>
          <div class="jw-segment" aria-label="Relationship view"><button type="button" data-action="relations" data-value="map" aria-pressed="true">Jobs map</button><button type="button" data-action="relations" data-value="list" aria-pressed="false">List</button></div>
          <div class="jw-map" data-relations-view="map" role="img" aria-label={`${sample.source} is read by ${sample.definition}, which writes ${sample.output} for ${sample.title}.`}>
            <div class="jw-map-node"><span>INPUT</span><strong>{sample.source}</strong></div><span class="jw-map-arrow" aria-hidden="true">↓ reads</span><div class="jw-map-node jw-map-node--method"><span>SAVED DEFINITION</span><strong>{sample.definition}</strong></div><span class="jw-map-arrow" aria-hidden="true">↓ writes</span><div class="jw-map-node"><span>DATED OUTPUT</span><strong>{sample.output}</strong></div><span class="jw-map-arrow" aria-hidden="true">↓ used by</span><div class="jw-map-owner"><strong>{sample.title}</strong><span>Table + chart</span></div>
          </div>
          <dl class="jw-relation-list" data-relations-view="list" hidden><div><dt>Reads from</dt><dd>{sample.source}</dd></div><div><dt>Uses definition</dt><dd>{sample.definition}</dd></div><div><dt>Writes to</dt><dd>{sample.output}</dd></div><div><dt>Refreshes</dt><dd>{sample.title}</dd></div></dl>
          <p class="jw-panel-note">The map explains the saved Jobs. Run Jobs starts the work.</p>
        </div>
        <div class="jw-panel" data-panel="run" hidden={!review} id={`${id}-run`} role={!review ? 'tabpanel' : undefined} aria-labelledby={!review ? `${id}-run-tab` : undefined}>
          <div data-run-ready hidden={review}><p class="jw-micro">ONE BOUNDED RUN</p><h4>Refresh this document.</h4><p class="jw-panel-note">{portfolio ? 'Replay the saved quote snapshot with one cash edit. Nothing is fetched or traded.' : 'Add I12 in Edit, then let the saved Jobs refresh the needs chart and finding table.'}</p><ol class="jw-run-steps"><li>Read the declared input</li><li>Run the saved calculation</li><li>Apply changes for your review</li></ol><button class="jw-primary" type="button" data-action="run" disabled><span data-run-label>Run Jobs</span><span aria-hidden="true">→</span></button></div>
          <div class="jw-running" data-run-progress hidden><span class="jw-running-icon" aria-hidden="true">↓</span><h4>Gather is running.</h4><p>Read input → calculate → refresh</p><div class="jw-progress" aria-hidden="true"><span></span></div><p class="jw-panel-note">{disclosure ? 'Illustrated run. The next decision is yours.' : 'The next decision is yours.'}</p></div>
          <div data-review-active hidden={!review}><p class="jw-micro">APPLIED CHANGES · <span data-pending-count>2</span> TO REVIEW</p><h4>What should stay?</h4><p class="jw-panel-note">Select a changed part in the document. Inspect it, then decide.</p><div class="jw-review-parts">
            <button type="button" data-part="chart" data-action="select" data-value="chart" aria-pressed="true"><span>{sample.partLabels.chart}</span><span data-part-status="chart">Changed</span></button>
            <button type="button" data-part="summary" data-action="select" data-value="summary" aria-pressed="false"><span>{sample.partLabels.summary}</span><span data-part-status="summary">Changed</span></button>
          </div><div class="jw-selected-summary"><strong data-selected-title>{sample.partLabels.chart}</strong><span data-selected-status>Applied · awaiting your decision</span></div><div class="jw-review-actions"><button class="jw-primary" type="button" data-action="keep">Keep selected <span aria-hidden="true">✓</span></button><button class="jw-secondary" type="button" data-action="revert">Revert selected</button></div><button type="button" class="jw-later" data-action="later">Later <span aria-hidden="true">→</span></button><p class="jw-panel-note jw-review-note">Keep records your decision. Revert restores this part. Later leaves the remaining changes applied.</p></div>
          <div class="jw-resolution" data-review-later hidden><span class="jw-resolution-icon" aria-hidden="true">◷</span><h4>Come back to it.</h4><p>Your remaining changes are still applied. The review is waiting.</p><button class="jw-primary" type="button" data-action="resume">Resume review <span aria-hidden="true">→</span></button></div>
          <div class="jw-resolution" data-review-complete hidden><span class="jw-resolution-icon" aria-hidden="true">✓</span><h4>Your decision is kept.</h4><p data-complete-summary></p><p class="jw-panel-note">The source input is unchanged by review. A future run can refresh the outputs again.</p><button class="jw-secondary" type="button" data-action="reset">{disclosure ? 'Try the walkthrough again' : 'Try again'} <span aria-hidden="true">↺</span></button></div>
        </div>
      </aside>
    </div>
    <div class="jw-status" role="status" aria-live="polite" aria-atomic="true"><span aria-hidden="true"></span><p data-status>{review ? '2 applied changes to review. You decide what stays.' : 'Inspect the Jobs, then make one change.'}</p></div>
  </div>
  {disclosure && <p class="jw-disclosure">{portfolio ? 'Interactive illustration using a retained sample. No live prices, account access, or trades.' : 'Interactive illustration based on Flow’s bundled Customer Research documents. Changes stay in this demo.'}</p>}
  <noscript><p class="jw-disclosure">Enable JavaScript to run this interactive walkthrough.</p></noscript>
</div>
<script>
  import { initJobsWorkbenchDemos } from '../../scripts/jobs-workbench.js';
  initJobsWorkbenchDemos();
  document.addEventListener('astro:page-load', () => initJobsWorkbenchDemos());
</script>
