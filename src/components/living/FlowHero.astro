---
// Approved Living Systems composition; native Astro, no client framework.
// The hero pitches Flow Elements (operator 2026-10-27); its button is always
// Download Flow Now.
import FlowHeroElementsMock from '../flow/mocks/FlowHeroElementsMock.astro';
import { ORIONFOLD_FLOW_LIVE } from '../../data/launch.ts';
import { FLOW_DMG_URL } from '../../data/flow-pricing.ts';
// Match the artwork's overflow width, tablet cap and desktop grid. The full
// approved image remains available when the rendered width and DPR need it.
const artSizes = '(max-width: 700px) calc(155vw - 62px), (max-width: 1100px) min(1050px, calc(125vw - 80px)), (max-width: 1200px) calc(88.45vw - 74.298px), calc(min(87.139423vw, 1254.807692px) - 6.09976vw - 27.884615px)';
---
<section class="ls-hero ls-hero-flow">
<div class="ls-hero-inner">
<div class="ls-hero-copy">
<p class="ls-eyebrow">MEET FLOW / ELEMENTS</p>
<h1 id="flow-landing-title">PRESS ⌘5.<br/>SEE IT<br/>
<span class="ls-stroke">DRAWN.</span>
</h1>
<p class="ls-hero-description">Elements opens beside your document with 100 cards: blocks, actions, skills and chart kinds, each with a small drawing. Ideas reads your sections and names the card that fits each one. In our walk, a figure drawn to scale was waiting in Review about a minute later, and nothing changed until we kept it.</p>
<div class="ls-hero-ctas">
<a class="ls-button" href={ORIONFOLD_FLOW_LIVE ? FLOW_DMG_URL : '#get-flow'} data-flow-download={ORIONFOLD_FLOW_LIVE ? 'flow-hero' : undefined}>Download Flow Now<svg aria-hidden="true" class="lucide lucide-arrow-right" fill="none" height="18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg">
<path d="M5 12h14">
</path>
<path d="m12 5 7 7-7 7">
</path>
</svg>
</a>
<a class="ls-text-link" href="#how-it-works">See how it works<svg aria-hidden="true" class="lucide lucide-arrow-down" fill="none" height="15" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="15" xmlns="http://www.w3.org/2000/svg">
<path d="M12 5v14">
</path>
<path d="m19 12-7 7-7-7">
</path>
</svg>
</a>
</div>
</div>
<div class="ls-hero-media">
<picture class="ls-paper-art">
<source sizes={artSizes} srcset="/assets/living-systems/hero-flow-paper-planes-640.webp 640w, /assets/living-systems/hero-flow-paper-planes-960.webp 960w, /assets/living-systems/hero-flow-paper-planes-1152.webp 1152w, /assets/living-systems/hero-flow-paper-planes.webp 1642w" type="image/webp"/>
<img alt="" fetchpriority="high" height="958" src="/assets/living-systems/hero-flow-paper-planes.png" width="1642"/>
</picture><div class="ls-hero-workbench"><FlowHeroElementsMock /></div></div>
</div>
</section>
