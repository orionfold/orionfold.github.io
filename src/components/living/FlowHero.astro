---
// Approved Living Systems composition; native Astro, no client framework.
import ProductDemo from './ProductDemo.astro';
---
<section class="ls-hero ls-hero-flow">
<div class="ls-hero-inner">
<div class="ls-hero-copy">
<p class="ls-eyebrow">MEET FLOW 1.6 / LIVING DOCUMENTS</p>
<h1 id="flow-landing-title">GIVE YOUR<br/>WORK A<br/>
<span class="ls-stroke">NIGHT SHIFT.</span>
</h1>
<p class="ls-hero-description">Sources that stay in view. Data that redraws the page. A Morning Briefing that brings you back to what changed.</p>
<div class="ls-hero-ctas">
<a class="ls-button" href="#get-flow">Download Flow Now<svg aria-hidden="true" class="lucide lucide-arrow-right" fill="none" height="18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg">
<path d="M5 12h14">
</path>
<path d="m12 5 7 7-7 7">
</path>
</svg>
</a>
<a class="ls-text-link" href="#how-it-works">See how it works<svg aria-hidden="true" class="lucide lucide-arrow-down" fill="none" height="15" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="15" xmlns="http://www.w3.org/2000/svg">
<path d="M12 5v14">
</path>
<path d="m19 12-7 7-7-7">
</path>
</svg>
</a>
</div>
</div>
<div class="ls-hero-media">
<picture class="ls-paper-art">
<source srcset="/assets/living-systems/hero-flow-paper-planes.webp" type="image/webp"/>
<img alt="" fetchpriority="high" height="958" src="/assets/living-systems/hero-flow-paper-planes.png" width="1642"/>
</picture><ProductDemo /></div>
</div>
<div class="ls-hero-foot">
<span>Free Base · 10 Pro Days · No credit card</span>
<span>Native to your Mac</span>
<span>Readable Markdown files</span>
<span>Receipted. Reversible.</span>
</div>
</section>
