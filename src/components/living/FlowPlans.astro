---
// Approved Living Systems composition; native Astro, no client framework.
import FlowDownloadCta from '../flow/FlowDownloadCta.astro';
import { FLOW_COUNTS } from '../../lib/flow/flow-counts';
import FlowEnterpriseContact from '../flow/FlowEnterpriseContact.astro';
import { FLOW, formatUsd } from '../../data/commerce';
import { ORIONFOLD_FLOW_LIVE } from '../../data/launch';
import { FLOW_CANCEL_TERMS, FLOW_TRIAL_TERMS, FLOW_ADDONS, FLOW_ADDON_TERMS } from '../../data/flow-pricing';
// `bare` drops the heading for a page that frames the plans itself (Paper, R4).
interface Props { bare?: boolean }
const { bare = false } = Astro.props;
const baseItems = ['Write, search, organize and chart Markdown', 'Markdown, tables, pictures and diagrams', 'Deterministic Jobs and Night Shift', 'Morning Briefing and Keep/Revert review', 'Elements, Skills and the canvas, and any Domain you bring in from GitHub', `${FLOW_COUNTS.livingDocuments} Living Documents and ${FLOW_COUNTS.paths} paths to start from`];
const proItems = ['Everything in Base', 'Local Overnight notes on changed work', 'Model-assisted data-definition drafts', 'Model-powered Ideas actions, daytime Agency and analysis', 'Chat on a folder or a Domain, and Suggest Ideas', 'The door for your own agents in Terminal', 'Local or configured cloud models; provider usage is separate'];
// Paper (bare): each list waits behind "What … includes", as the home's plans do.
---
<span id="pricing-heading" class="ls-anchor-alias" aria-hidden="true"></span>
<span id="flow-page-waitlist-heading" class="ls-anchor-alias" aria-hidden="true"></span>

<section class="ls-container ls-plans" id="get-flow">
<span class="ls-anchor-alias" id="pricing">
</span>
<span class="ls-anchor-alias" id="waitlist">
</span>
{bare ? <p class="ls-trial-note">{FLOW_TRIAL_TERMS} A Pro Day counts when you use a paid feature. No credit card.</p> : <div class="ls-section-heading">
<p class="ls-eyebrow">START WITH THE ROUTINE</p>
<h2>ADD THE<br/>
<span class="ls-stroke">INTERPRETATION.</span>
</h2>
<p>Keep data current for free. Add model-powered work with Pro.</p>
<p class="ls-trial-note">{FLOW_TRIAL_TERMS} A Pro Day counts when you use a paid feature. No credit card.</p>
</div>}
<div class="ls-plan-grid">
<article data-plan="base">
<span class="ls-eyebrow">FLOW BASE</span>
<h3>A useful place<br/>to begin.</h3>
<p class="ls-plan-price">Free forever<small>No account. No expiry. No private format.</small>
</p>
{bare ? <details class="ls-plan-more"><summary>What Base includes <em>{baseItems.length}</em></summary><ul>{baseItems.map((i) => <li>{i}</li>)}</ul></details> : <ul>{baseItems.map((i) => <li>{i}</li>)}</ul>}
<div class="ls-plan-actions"><FlowDownloadCta source="flow-living-documents" /></div>
</article>
<article data-plan="pro">
<span class="ls-eyebrow">FLOW PRO</span>
<h3>Intelligence for<br/>the continuing work.</h3>
{ORIONFOLD_FLOW_LIVE && <p class="ls-plan-price">{formatUsd(FLOW.monthly.amount)} / month<small>Or {formatUsd(FLOW.annual.amount)} / year · one person, your own Macs</small>
</p>}
{bare ? <details class="ls-plan-more"><summary>What Pro includes <em>{proItems.length}</em></summary><ul>{proItems.map((i) => <li>{i}</li>)}</ul></details> : <ul>{proItems.map((i) => <li>{i}</li>)}</ul>}
<div class="ls-plan-actions"><div class="ls-plan-buttons"><FlowEnterpriseContact /><a class="ls-plan-rfp" href="/proposal/#flow" data-flow-rfp><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /><path d="M14 2v4a2 2 0 0 0 2 2h4" /><path d="M10 9H8" /><path d="M16 13H8" /><path d="M16 17H8" /></svg>Request for proposal</a></div><p class="ls-plan-payment-note">Or pay in-app when ready. A proposal puts Flow seats on one itemized document for a purchase order.</p></div>
</article>
</div>
{bare ? <details class="ls-plan-more ls-plan-terms"><summary>Add-ons and terms</summary><div class="ls-plan-addons">
<h3>Add-ons to Flow Pro</h3>
{FLOW_ADDONS.map((addon) => <p><strong>{addon.name}</strong> — {addon.description}</p>)}
<p>{FLOW_ADDON_TERMS}</p>
</div>
<p class="ls-plan-note">Night Shift model work stays on your Mac. Configured cloud models remain a separate choice for daytime work.</p>
<p class="ls-offer-footnote">{FLOW_CANCEL_TERMS} When Pro ends, model-powered actions stop. Your Markdown files stay readable and editable. Import and Publish require their add-ons after the trial. Read receipts remain accessible. <a href="/promise/">Read our promise</a> and <a href="/flow/specifications/#plans">licensing details</a>.</p></details> : <Fragment><div class="ls-plan-addons">
<h3>Add-ons to Flow Pro</h3>
{FLOW_ADDONS.map((addon) => <p><strong>{addon.name}</strong> — {addon.description}</p>)}
<p>{FLOW_ADDON_TERMS}</p>
</div>
<p class="ls-plan-note">Night Shift model work stays on your Mac. Configured cloud models remain a separate choice for daytime work.</p>
<p class="ls-offer-footnote">{FLOW_CANCEL_TERMS} When Pro ends, model-powered actions stop. Your Markdown files stay readable and editable. Import and Publish require their add-ons after the trial. Read receipts remain accessible. <a href="/promise/">Read our promise</a> and <a href="/flow/specifications/#plans">licensing details</a>.</p></Fragment>}
</section>

<style>
/* Two asks side by side on the Pro card: the enquiry dialog and the proposal
   builder's Flow section. Same white button shape as the enterprise trigger;
   they wrap to one per row below 700px. */
.ls-plan-buttons { display: flex; flex-wrap: wrap; gap: 10px; }
.ls-plan-rfp {
  display: inline-flex; align-items: center; justify-content: center; gap: 10px;
  min-height: 52px; padding: 14px 23px; border: 1px solid #b5c3bf;
  border-radius: 5px; background: #fff; color: #152a2d;
  font: 700 15px/1.4 var(--font-body); text-decoration: none;
}
.ls-plan-rfp:hover { background: #e9f0ed; border-color: #7d918a; color: #152a2d; }
.ls-plan-addons { margin-top: 1.5rem; padding: 1.5rem; border: 1px solid var(--line); border-radius: 1rem; }
.ls-plan-addons h3 { margin: 0 0 1rem; font-size: 1.2rem; }
.ls-plan-addons p { margin: .75rem 0 0; line-height: 1.6; }
</style>
