---
// Approved Living Systems composition; native Astro, no client framework.
// The hero pitches Flow Domains (operator 2026-10-27); its button is always
// Download Flow Now.
import HomeHeroDomainMock from '../flow/mocks/HomeHeroDomainMock.astro';
import { ORIONFOLD_FLOW_LIVE } from '../../data/launch.ts';
import { FLOW_DMG_URL } from '../../data/flow-pricing.ts';
// Match the artwork's overflow width, tablet cap and desktop grid (including
// the 1440px container cap). Density selection must not soften Retina art.
const artSizes = '(max-width: 700px) calc(150vw - 60px), (max-width: 1100px) min(1050px, calc(125vw - 80px)), (max-width: 1200px) calc(79.3vw - 66.612px), calc(min(78.125vw, 1125px) - 5.46875vw - 25px)';
---
<section class="ls-hero">
<div class="ls-hero-inner">
<div class="ls-hero-copy">
<p class="ls-eyebrow">ORIONFOLD FLOW / DOMAINS</p>
<h1 id="flow-launch-home-title">WRITE HOW<br/>YOU WORK.<br/><span class="ls-hero-last-line">AI <span class="ls-stroke">RUNS IT.</span></span></h1>
<p class="ls-hero-description">A Flow Domain is the method you use with clients, as a folder of living documents. Write it with the AI you already use, then publish it to GitHub. Readers bring it in with one address, and each update reaches them as a change to review.</p>
<div class="ls-hero-ctas">
<a class="ls-button" href={ORIONFOLD_FLOW_LIVE ? FLOW_DMG_URL : '/flow/#get-flow'} data-flow-download={ORIONFOLD_FLOW_LIVE ? 'home-hero' : undefined}>Download Flow Now<svg aria-hidden="true" class="lucide lucide-arrow-right" fill="none" height="18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg">
<path d="M5 12h14">
</path>
<path d="m12 5 7 7-7 7">
</path>
</svg>
</a>
<a class="ls-text-link" href="/domains/">See Flow Domains<svg aria-hidden="true" class="lucide lucide-arrow-right" fill="none" height="15" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="15" xmlns="http://www.w3.org/2000/svg">
<path d="M5 12h14">
</path>
<path d="m12 5 7 7-7 7">
</path>
</svg>
</a>
</div>
</div>
<div class="ls-hero-media">
<picture class="ls-paper-art">
<source sizes={artSizes} srcset="/assets/living-systems/hero-home-paper-planes-640.webp 640w, /assets/living-systems/hero-home-paper-planes-960.webp 960w, /assets/living-systems/hero-home-paper-planes-1152.webp 1152w, /assets/living-systems/hero-home-paper-planes.webp 1642w" type="image/webp"/>
<img alt="" fetchpriority="low" height="958" src="/assets/living-systems/hero-home-paper-planes.png" width="1642"/>
</picture><div class="ls-hero-workbench"><HomeHeroDomainMock /></div></div>
</div>
</section>
