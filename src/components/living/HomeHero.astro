---
// Approved Living Systems composition; native Astro, no client framework.
import HomeKnowledgeDemo from './HomeKnowledgeDemo.astro';
// Match the artwork's overflow width, tablet cap and desktop grid (including
// the 1440px container cap). Density selection must not soften Retina art.
const artSizes = '(max-width: 700px) calc(150vw - 60px), (max-width: 1100px) min(1050px, calc(125vw - 80px)), (max-width: 1200px) calc(79.3vw - 66.612px), calc(min(78.125vw, 1125px) - 5.46875vw - 25px)';
---
<section class="ls-hero">
<div class="ls-hero-inner">
<div class="ls-hero-copy">
<p class="ls-eyebrow">ORIONFOLD / KNOWLEDGE IN MOTION</p>
<h1 id="flow-launch-home-title">MAKE<br/>KNOWLEDGE<br/><span class="ls-hero-last-line">A <span class="ls-stroke">LIVING</span> THING.</span></h1>
<p class="ls-hero-description">Give your documents useful work. Keep the judgment that makes it yours. Flow for Mac drafts with a source on every claim and waits for your yes. A cited client brief took 43 seconds on a MacBook.</p>
<div class="ls-hero-ctas">
<a class="ls-button" href="/flow/">Meet Flow<svg aria-hidden="true" class="lucide lucide-arrow-right" fill="none" height="18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg">
<path d="M5 12h14">
</path>
<path d="m12 5 7 7-7 7">
</path>
</svg>
</a>
<a class="ls-text-link" href="/essays/the-work-we-want-to-keep/">The work we want to keep<svg aria-hidden="true" class="lucide lucide-arrow-down" fill="none" height="15" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="15" xmlns="http://www.w3.org/2000/svg">
<path d="M12 5v14">
</path>
<path d="m19 12-7 7-7-7">
</path>
</svg>
</a>
</div>
</div>
<div class="ls-hero-media">
<picture class="ls-paper-art">
<source sizes={artSizes} srcset="/assets/living-systems/hero-home-paper-planes-640.webp 640w, /assets/living-systems/hero-home-paper-planes-960.webp 960w, /assets/living-systems/hero-home-paper-planes-1152.webp 1152w, /assets/living-systems/hero-home-paper-planes.webp 1642w" type="image/webp"/>
<img alt="" fetchpriority="low" height="958" src="/assets/living-systems/hero-home-paper-planes.png" width="1642"/>
</picture><HomeKnowledgeDemo /></div>
</div>
</section>
