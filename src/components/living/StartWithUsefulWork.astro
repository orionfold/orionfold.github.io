---
import catalogue from '../../data/flow-starting-documents.json';
import '../../styles/flow-starting-documents.css';
const { documents, categories } = catalogue;
const first = documents.find(document => document.featured)!;
const categoryName = (id: string) => categories.find(category => category.id === id)?.label;
---
<div class="ls-starting-documents ls-container" data-starting-documents>
  <div class="ls-starting-window">
    <header class="ls-starting-heading">
      <div><p>START WITH USEFUL WORK</p><h3>Make a Living Document yours.</h3></div>
      <span>FLOW 1.7 / INTERACTIVE ILLUSTRATION</span>
    </header>
    <div class="ls-starting-layout">
      <div class="ls-starting-browser">
        <div class="ls-starting-filters">
          <label for="starting-document-search">Find your starting point</label>
          <input id="starting-document-search" type="search" placeholder="Search 24 documents" autocomplete="off" data-starting-search />
          <label for="starting-document-category">Explore</label>
          <select id="starting-document-category" data-starting-filter>
            <option value="featured">Five featured documents</option>
            <option value="all">All 24 documents</option>
            {categories.map(category => <option value={category.id}>{category.label}</option>)}
          </select>
        </div>
        <p class="ls-starting-count" data-starting-count role="status">5 featured of 24 documents</p>
        <div class="ls-starting-list" role="group" aria-label="Choose a Living Document">
          {documents.map(document => (
            <button type="button" data-starting-document={document.id} data-category={document.category} data-featured={String(document.featured)} data-name={document.name} data-summary={document.summary} aria-pressed={String(document.id === first.id)} aria-controls={`starting-preview-${document.id}`} hidden={!document.featured}>
              <span class="ls-starting-name">{document.name}<span aria-hidden="true">›</span></span>
              <small>{categoryName(document.category)}</small>
            </button>
          ))}
        </div>
        <p class="ls-starting-empty" data-starting-empty hidden>No document matches. Try another word or category.</p>
        <button class="ls-starting-reset" type="button" data-starting-reset>Back to featured</button>
      </div>
      <div class="ls-starting-previews">
        {documents.map(document => (
          <article id={`starting-preview-${document.id}`} class="ls-starting-preview" data-starting-panel={document.id} aria-labelledby={`starting-title-${document.id}`} hidden={document.id !== first.id}>
            <div class="ls-starting-document-title">
              <p>{categoryName(document.category)}{document.featured && <span>FEATURED</span>}</p>
              <h4 id={`starting-title-${document.id}`}>{document.title}</h4>
              <p>{document.summary}</p>
            </div>
            <div data-starting-original>
              <div class="ls-starting-excerpt">
                <span>INSIDE THIS EXAMPLE</span>
                <p>{document.excerpt}</p>
              </div>
              <div class="ls-starting-inside">
                <div><h5>In the document</h5><ul>{document.headings.map(heading => <li>{heading}</li>)}</ul></div>
                <div><h5>Saved Jobs</h5>{document.jobs.length > 0 ? <ol>{document.jobs.map(job => <li>{job.label}</li>)}</ol> : <p>This entry is a reference. Explore its linked pages and examples.</p>}</div>
              </div>
              <details class="ls-starting-files">
                <summary>Look inside the folder</summary>
                <p>The document travels with its inputs and supporting files. A few from this example:</p>
                <ul><li>{document.entry.split('/').at(-1)}</li>{document.files.map(file => <li>{file}</li>)}</ul>
              </details>
              <div class="ls-starting-copy-form">
                <label for={`starting-copy-name-${document.id}`}>Name your sample copy</label>
                <div><input id={`starting-copy-name-${document.id}`} data-starting-copy-name maxlength="80" value={`${document.name} copy`} /><button type="button" data-starting-copy={document.id}>Create my copy <span aria-hidden="true">→</span></button></div>
              </div>
            </div>
            <div class="ls-starting-copy-preview" data-starting-copy-preview hidden>
              <span class="ls-starting-copy-status">COPY PREVIEW / READY TO INSPECT</span>
              <h5 data-starting-copy-title>{document.name} copy</h5>
              <p>In Flow, you choose a folder on your Mac. The independent copy includes the document and its inputs and assets.</p>
              <div class="ls-starting-copy-parts">
                <div><span>YOUR DOCUMENT</span><strong>{document.entry.split('/').at(-1)}</strong><p>Replace the sample inputs with your work.</p></div>
                <div><span>JOBS / NOT RUN</span><strong>{document.jobs.length ? `${document.jobs.length} saved ${document.jobs.length === 1 ? 'step' : 'steps'}` : 'Reference document'}</strong><p>{document.jobs.length ? 'Inspect the scope in the Workbench before you run it.' : 'Start with the linked pages and their examples.'}</p></div>
              </div>
              <div class="ls-starting-copy-actions">
                <button type="button" data-starting-back>Inspect this example again</button>
                {document.richPreview && <a href="#curated-document-previews" data-starting-rich={document.richPreview}>Explore its illustrated preview <span aria-hidden="true">↓</span></a>}
              </div>
            </div>
          </article>
        ))}
        <div class="ls-starting-no-selection" data-starting-no-selection hidden><p>Try “research”, “budget” or a category.</p><span>The library has 24 starting points. Choose one to see its own contents.</span></div>
      </div>
    </div>
    <footer class="ls-starting-footer"><p data-starting-status role="status">Explore a sample, then try the copy step.</p><span>Illustration only. No files created or Jobs run.</span></footer>
  </div>
</div>
<script>
  import { initStartingDocuments } from '../../scripts/flow-starting-documents.js';
  document.querySelectorAll('[data-starting-documents]').forEach(root => initStartingDocuments(root));
</script>
