---
// /flow/ product toolbar under the hero: jumps to sections on this page, a
// divider, then the other Flow pages. Lucide icons (the site's one icon set).
import Play from '@lucide/astro/icons/play';
import Route from '@lucide/astro/icons/route';
import LibraryBig from '@lucide/astro/icons/library-big';
import FileText from '@lucide/astro/icons/file-text';
import Bot from '@lucide/astro/icons/bot';
import ArrowLeftRight from '@lucide/astro/icons/arrow-left-right';
import Compass from '@lucide/astro/icons/compass';
import Cpu from '@lucide/astro/icons/cpu';
import Building from '@lucide/astro/icons/building';

// In the order the sections appear as you scroll.
const onPage = [
  { href: '#paths-home', label: 'Paths', Icon: Route },
  { href: '#jobs-workbench', label: 'Try Jobs', Icon: Play },
  { href: '#how-it-works', label: 'Living Documents', Icon: FileText },
  { href: '#agents-reviewed', label: 'Agents', Icon: Bot },
  { href: '#import-publish', label: 'Import and Publish', Icon: ArrowLeftRight },
  { href: '#living-library', label: 'Library', Icon: LibraryBig },
];
const pages = [
  { href: '/flow/tour/', label: 'Tour', Icon: Compass },
  { href: '/flow/specifications/', label: 'Tech specs', Icon: Cpu },
  { href: '/flow/enterprise/', label: 'Enterprise', Icon: Building },
];
---
<span id="flow-capability-ticker-title" class="ls-anchor-alias" aria-hidden="true"></span>

<nav aria-label="Flow product navigation" class="ls-product-subnav">
  <div class="ls-subnav-bar">
    <div class="ls-subnav-group" aria-label="On this page" role="group">
      {onPage.map(({ href, label, Icon }) => <a href={href}><Icon size={16} stroke-width={1.9} aria-hidden="true" /><span>{label}</span></a>)}
    </div>
    <span class="ls-subnav-divider" aria-hidden="true"></span>
    <div class="ls-subnav-group" aria-label="More Flow pages" role="group">
      {pages.map(({ href, label, Icon }) => <a href={href}><Icon size={16} stroke-width={1.9} aria-hidden="true" /><span>{label}</span></a>)}
    </div>
  </div>
</nav>
