<g data-knowledge-source="notes"><rect x="9" y="10" width="88" height="38" rx="6" fill="#f3f5f2" stroke="#acbfb5"/><text x="53" y="34">Notes</text></g>
<g data-knowledge-source="reading"><rect x="127" y="10" width="88" height="38" rx="6" fill="#f3f5f2" stroke="#acbfb5"/><text x="171" y="34">Reading</text></g>
