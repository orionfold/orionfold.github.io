<svg aria-hidden="true" class="lucide lucide-file-text" fill="none" height="14" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="14" xmlns="http://www.w3.org/2000/svg">
<path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z">
</path>
<path d="M14 2v5a1 1 0 0 0 1 1h5">
</path>
<path d="M10 9H8">
</path>
<path d="M16 13H8">
