<circle cx="12" cy="12" r="10">
</circle>
<path d="M12 6v6h4">
</path>
</svg>
</span>
</div>
<div class="ls-window-body">
<aside class="ls-product-sidebar">
<div class="ls-app-identity">
<img alt="" height="24" src="/logos/orionfold-mark-3d-32.png" width="24"/>
<b>Flow</b>
</div>
<span class="ls-sidebar-label">MY DOCUMENTS</span>
<span>
<svg aria-hidden="true" class="lucide lucide-folder" fill="none" height="14" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="14" xmlns="http://www.w3.org/2000/svg">
<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z">
</path>
</svg>Studio</span>
