---
import { getImage, Image } from 'astro:assets';
import blueprintWide from '../../assets/flow/launch/flow-race-blueprint-wide.webp';
import blueprintPortrait from '../../assets/flow/launch/flow-race-blueprint-portrait.webp';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const portraitWidths = [480, 720, 960, 1200];
const portraitImages = await Promise.all(
  portraitWidths.map((width) => getImage({ src: blueprintPortrait, width, format: 'webp', quality: 82 })),
);
const portraitSrcset = portraitImages
  .map((image, index) => `${image.src} ${portraitWidths[index]}w`)
  .join(', ');
---

<picture class:list={['flow-race-blueprint', className]} aria-hidden="true">
  <source
    media="(max-width: 699px)"
    srcset={portraitSrcset}
    sizes="100vw"
  />
  <Image
    src={blueprintWide}
    alt=""
    widths={[768, 1152, 1600, 2200]}
    sizes="100vw"
    loading="lazy"
    decoding="async"
    class="flow-race-blueprint__image"
  />
</picture>

<style>
  .flow-race-blueprint {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    pointer-events: none;
  }

  .flow-race-blueprint__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>
