---
// A Domain's life between two Macs, in four steps: the author builds it in
// Flow, publishes the folder to GitHub, a reader brings it in, and the next
// version reaches the reader as an update to review. Every label is from the
// AI Consulting Starter walk (commits 352c49b and 43344f4, the New from
// GitHub sheet, the update sheet). Steps advance while in view; a step tab
// takes over by hand. Reduced motion rests on the last step.
import Check from '@lucide/astro/icons/check';
import Github from '@lucide/astro/icons/git-branch';
import Laptop from '@lucide/astro/icons/laptop';
import FileText from '@lucide/astro/icons/file-text';
import Folder from '@lucide/astro/icons/folder';
import GitCommit from '@lucide/astro/icons/git-commit-horizontal';

const STEPS = ['Build in Flow', 'Publish to GitHub', 'A reader brings it in', 'An update arrives'];
const FILES = ['README', 'Mechanisms Primer', 'Amazon Mechanisms and Practices', 'Press Release FAQ for AI project', 'Pilot to Scale', 'Flow PR-FAQ'];
---
<figure class="dj" data-dj aria-label="A Flow Domain between two Macs: built in Flow, published to GitHub, brought in by a reader, and updated">
  <div class="dj-tabs" role="tablist" aria-label="Steps">
    {STEPS.map((s, i) => (
      <button type="button" role="tab" class="dj-tab" data-dj-go={i} aria-selected={i === 0 ? 'true' : 'false'}>
        <span class="dj-tab-n"><i class="dj-ring" aria-hidden="true"></i>{i + 1}</span><span>{s}</span>
      </button>
    ))}
  </div>

  <div class="dj-stage" aria-hidden="true">
    <!-- The author's Mac -->
    <div class="dj-mac">
      <p class="dj-who"><Laptop size={14} />The author's Flow</p>
      <p class="dj-folder"><Folder size={13} />ai-consulting-starter</p>
      <ul class="dj-files">
        {FILES.map((f, i) => (
          <li class="dj-f" style={`--i:${i}`}><FileText size={12} /><span>{f}</span>{i === 0 && <em class="dj-edit" data-dj-only="3">licence added</em>}<Check size={12} stroke-width={3} class="dj-ok" /></li>
        ))}
      </ul>
      <p class="dj-note" data-dj-only="0">Chat writes, Skills draw, you keep each change in Review.</p>
      <p class="dj-btn" data-dj-from="1">Publish ▸ GitHub Repository</p>
    </div>

    <div class="dj-wire dj-wire--a"><i></i><i></i><i></i></div>

    <!-- GitHub -->
    <div class="dj-hub">
      <p class="dj-who"><Github size={14} />GitHub</p>
      <p class="dj-path">orionfold/flow<br /><b>flow-domains/ai-consulting-starter</b></p>
      <ul class="dj-commits">
        <li data-dj-from="1"><GitCommit size={13} /><span><b>352c49b</b> Publish ai-consulting-starter from Flow</span><small>6 files sent</small></li>
        <li data-dj-from="3"><GitCommit size={13} /><span><b>43344f4</b> Publish ai-consulting-starter from Flow</span><small>licence: CC BY 4.0</small></li>
      </ul>
      <p class="dj-empty" data-dj-only="0">Nothing here yet.</p>
    </div>

    <div class="dj-wire dj-wire--b"><i></i><i></i><i></i></div>

    <!-- The reader's Mac -->
    <div class="dj-mac dj-mac--reader">
      <p class="dj-who"><Laptop size={14} />A reader's Flow</p>
      <p class="dj-empty" data-dj-only="0 1">File ▸ New from GitHub… waits for an address.</p>
      <div class="dj-sheet" data-dj-only="2">
        <p class="dj-sheet-t">New from GitHub</p>
        <p>orionfold/flow · flow-domains/ai-consulting-starter</p>
        <p><b>6 files</b> · the latest version of main</p>
        <p class="dj-quiet">No licence stated</p>
        <span class="dj-add">Add</span>
      </div>
      <div class="dj-pulled" data-dj-from="2">
        <p class="dj-folder"><Folder size={13} />AI Consulting Starter<i class="dj-dot" data-dj-only="3" title="Update available"></i></p>
        <ul class="dj-files dj-files--mini">
          {FILES.slice(0, 3).map((f) => <li class="dj-f"><FileText size={12} /><span>{f}</span></li>)}
          <li class="dj-more">+ 3 more</li>
        </ul>
      </div>
      <div class="dj-sheet dj-sheet--update" data-dj-only="3">
        <p class="dj-sheet-t">Update AI Consulting Starter</p>
        <p><b>README</b> · Updated</p>
        <p class="dj-quiet">You have not changed this one, so replacing it loses nothing.</p>
        <span class="dj-add">Update Selected</span>
      </div>
    </div>
  </div>
  <figcaption class="dj-cap">From the AI Consulting Starter walk, October 25 and 26: the commits, the sheets and their words are the real ones. <a href="/domains/ai-consulting-starter/">Read how it was built</a>.</figcaption>
</figure>

<script>
  const STEP_MS = [5200, 4800, 5000, 6200];
  function init() {
    for (const el of document.querySelectorAll<HTMLElement>('[data-dj]:not([data-dj-ready])')) {
      el.dataset.djReady = '';
      const tabs = [...el.querySelectorAll<HTMLButtonElement>('[data-dj-go]')];
      const last = tabs.length - 1;
      let step = 0;
      let timer: number | undefined;
      let manual = false;
      const set = (n: number) => {
        step = n;
        el.dataset.step = String(n);
        el.querySelectorAll<HTMLElement>('[data-dj-only]').forEach((x) => { x.hidden = !x.dataset.djOnly!.split(' ').includes(String(n)); });
        el.querySelectorAll<HTMLElement>('[data-dj-from]').forEach((x) => { x.hidden = n < Number(x.dataset.djFrom); });
        tabs.forEach((t, i) => { t.setAttribute('aria-selected', String(i === n)); t.classList.toggle('is-past', i < n); });
        el.style.setProperty('--dj-ms', `${STEP_MS[n]}ms`);
        el.classList.remove('is-tick');
        void el.offsetWidth;
        el.classList.add('is-tick');
      };
      const play = () => {
        if (manual || timer) return;
        timer = window.setTimeout(function tick() {
          set(step === last ? 0 : step + 1);
          timer = window.setTimeout(tick, STEP_MS[step]);
        }, STEP_MS[step]);
      };
      const pause = () => { window.clearTimeout(timer); timer = undefined; };
      tabs.forEach((t, i) => t.addEventListener('click', () => { manual = true; el.classList.add('is-manual'); pause(); set(i); }));
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        el.classList.add('is-manual');
        set(last);
        continue;
      }
      set(0);
      new IntersectionObserver((entries) => { for (const e of entries) e.isIntersecting ? play() : pause(); }, { threshold: 0.35 }).observe(el);
    }
  }
  init();
  document.addEventListener('astro:after-swap', init);
</script>
