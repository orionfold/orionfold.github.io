---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import appIcon from '../../assets/flow/flow-app-icon-512.png';
import ollamaLogo from '../../assets/flow/providers/ollama-logo.svg';

// Provider marks come from the providers' first-party brand surfaces. OpenAI
// and Anthropic match their official glyphs; OpenRouter is the mark isolated
// from /brand/v2/openrouter-dark.svg so its full wordmark is not crushed into
// the ticker. Ollama and LM Studio use imported first-party assets above.
const brandPaths = {
  openai: 'M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.872zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654l2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997Z',
  anthropic: 'M17.3041 3.541h-3.6718l6.696 16.918H24Zm-10.6082 0L0 20.459h3.7442l1.3693-3.5527h7.0052l1.3693 3.5528h3.7442L10.5363 3.5409Zm-.3712 10.2232 2.2914-5.9456 2.2914 5.9456Z',
  openrouter: 'M303.9475 17.19926c42.79734 0 77.48933 34.69327 77.48933 77.48933s-34.69199 77.48933-77.48933 77.48933l76.86166 76.86244c9.76367 9.76313 2.84903 26.45667-10.95697 26.45667H148.96884c-71.32686 0-129.14889-57.82202-129.14889-129.14889S77.64197 17.19926 148.96884 17.19926H303.9475ZM148.96884 68.85881c-42.79607 0-77.48933 34.69327-77.48933 77.48933s34.69327 77.48933 77.48933 77.48933 77.48933-34.69327 77.48933-77.48933-34.69327-77.48933-77.48933-77.48933Z',
};

const brandIcons: Record<string, string> = {
  // Monochrome vector rendition of LM Studio's first-party stacked-bar app
  // mark. Using currentColor keeps it crisp and gray beside the other logos.
  lmstudio: '<rect x="4" y="3" width="11" height="2.5" rx="1.25"/><rect x="7" y="6.8" width="12" height="2.5" rx="1.25"/><rect x="5" y="10.6" width="11" height="2.5" rx="1.25"/><rect x="3" y="14.4" width="12" height="2.5" rx="1.25"/><rect x="8" y="18.2" width="12" height="2.5" rx="1.25"/>',
};

const lineIcons: Record<string, string> = {
  markdown: '<path d="M6 3h9l3 3v15H6z"/><path d="M15 3v4h4"/><path d="M9 11v5m0-5 2 3 2-3v5"/>',
  chart: '<path d="M3 3v18h18"/><rect x="6" y="13" width="3" height="5" rx=".5"/><rect x="11" y="9" width="3" height="9" rx=".5"/><rect x="16" y="5" width="3" height="13" rx=".5"/>',
  table: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 9v11M15 9v11M3 14h18"/>',
  image: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9" r="1.5"/><path d="m5 18 5-5 3 3 2-2 4 4"/>',
  search: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/>',
  benchmark: '<path d="M4 18a8 8 0 1 1 16 0"/><path d="m12 14 4-5"/><path d="M7 18h10"/>',
  routing: '<circle cx="5" cy="12" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="19" cy="18" r="2"/><path d="M7 12h3a4 4 0 0 0 4-4 2 2 0 0 1 2-2h1M7 12h3a4 4 0 0 1 4 4 2 2 0 0 0 2 2h1"/>',
  guardrails: '<path d="M12 3 20 6v5c0 5-3.2 8.5-8 10-4.8-1.5-8-5-8-10V6z"/><path d="m8.5 12 2.2 2.2 4.8-5"/>',
  cost: '<circle cx="12" cy="12" r="9"/><path d="M15 8.5c-.7-.7-1.6-1-2.8-1-1.6 0-2.7.8-2.7 2s1 1.8 2.8 2.2c1.8.4 2.7 1 2.7 2.3s-1.2 2.2-3 2.2c-1.2 0-2.3-.4-3-1.1M12 5.5v13"/>',
  evidence: '<path d="M6 3h9l3 3v15H6z"/><path d="M15 3v4h4"/><path d="m9 14 2 2 4-4"/>',
  receipt: '<path d="M5 3h14v18l-2.3-1.5-2.4 1.5-2.3-1.5L9.7 21l-2.4-1.5L5 21z"/><path d="M9 8h6M9 12h6M9 16h3"/>',
  review: '<path d="M3 12s3.2-5 9-5 9 5 9 5-3.2 5-9 5-9-5-9-5z"/><circle cx="12" cy="12" r="2.5"/>',
};

interface TickerItem {
  name: string;
  path?: string;
  viewBox?: string;
  image?: ImageMetadata;
  brandIcon?: string;
  mark?: string;
  icon?: string;
}

interface TickerGroup {
  label: string;
  items: TickerItem[];
}

const groups: TickerGroup[] = [
  {
    label: 'Cloud models',
    items: [
      { name: 'OpenAI', path: brandPaths.openai },
      { name: 'Anthropic', path: brandPaths.anthropic },
      { name: 'OpenRouter', path: brandPaths.openrouter, viewBox: '0 0 400 293.72' },
    ],
  },
  {
    label: 'Local models',
    items: [
      { name: 'Flow Runtime', image: appIcon },
      { name: 'Ollama', image: ollamaLogo },
      { name: 'LM Studio', brandIcon: 'lmstudio' },
    ],
  },
  {
    label: 'AI subscriptions',
    items: [
      { name: 'Codex CLI', path: brandPaths.openai },
      { name: 'Claude Code', path: brandPaths.anthropic },
    ],
  },
  {
    label: 'Everyday work',
    items: [
      { name: 'Markdown', icon: 'markdown' },
      { name: 'Charts + diagrams', icon: 'chart' },
      { name: 'Tables', icon: 'table' },
      { name: 'Images', icon: 'image' },
    ],
  },
  {
    label: 'Agency',
    items: [
      { name: 'Search', icon: 'search' },
      { name: 'Benchmarks', icon: 'benchmark' },
      { name: 'Routing', icon: 'routing' },
      { name: 'Guardrails', icon: 'guardrails' },
    ],
  },
  {
    label: 'Govern',
    items: [
      { name: 'Cost', icon: 'cost' },
      { name: 'Evidence', icon: 'evidence' },
      { name: 'Receipts', icon: 'receipt' },
      { name: 'Reviews', icon: 'review' },
    ],
  },
];
---

<div class="flow-capability-ticker" aria-labelledby="flow-capability-ticker-title">
  <p id="flow-capability-ticker-title" class="flow-capability-ticker__title">Flow works with the AI you choose</p>
  <div class="flow-capability-ticker__viewport">
    <div class="flow-capability-ticker__track">
      {[0, 1].map((copy) => (
        <div class="flow-capability-ticker__half" aria-hidden={copy === 1 ? 'true' : undefined}>
          {groups.map((group, groupIndex) => (
            <>
              {groupIndex > 0 && <span class="flow-capability-ticker__divider" aria-hidden="true"></span>}
              <span class="flow-capability-ticker__category">{group.label}</span>
              {group.items.map((item) => (
                <span class="flow-capability-ticker__item">
                  {item.image ? (
                    <Image src={item.image} alt="" width={30} height={30} class="flow-capability-ticker__provider-logo" />
                  ) : item.path ? (
                    <svg class="flow-capability-ticker__brand-icon" viewBox={item.viewBox ?? '0 0 24 24'} aria-hidden="true"><path d={item.path} /></svg>
                  ) : item.brandIcon ? (
                    <svg class="flow-capability-ticker__brand-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={brandIcons[item.brandIcon]}></svg>
                  ) : item.icon ? (
                    <svg class="flow-capability-ticker__line-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={lineIcons[item.icon]}></svg>
                  ) : (
                    <span class="flow-capability-ticker__brand-mark" aria-hidden="true">{item.mark}</span>
                  )}
                  <span>{item.name}</span>
                </span>
              ))}
            </>
          ))}
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .flow-capability-ticker {
    position: relative;
    padding: 0.72rem 0 0.78rem;
    overflow: hidden;
    border-top: 1px solid rgba(8, 127, 123, 0.2);
    border-bottom: 1px solid rgba(8, 127, 123, 0.16);
    background: rgba(247, 251, 248, 0.72);
    backdrop-filter: blur(12px);
  }
  .flow-capability-ticker__title {
    margin: 0 0 0.58rem;
    color: rgba(20, 52, 59, 0.62);
    font: 700 0.58rem/1 var(--font-mono);
    letter-spacing: 0.16em;
    text-align: center;
    text-transform: uppercase;
  }
  .flow-capability-ticker__viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }
  .flow-capability-ticker__track {
    display: flex;
    width: max-content;
    animation: flow-capability-scroll 58s linear infinite;
    will-change: transform;
  }
  .flow-capability-ticker__half {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: clamp(1.35rem, 2.2vw, 2.5rem);
    padding-right: clamp(1.35rem, 2.2vw, 2.5rem);
  }
  .flow-capability-ticker__category {
    flex-shrink: 0;
    border: 1px solid rgba(8, 127, 123, 0.28);
    border-radius: 999px;
    padding: 0.36rem 0.62rem;
    color: #087f7b;
    background: rgba(8, 127, 123, 0.07);
    font: 700 0.58rem/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .flow-capability-ticker__item {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.52rem;
    color: rgba(16, 39, 46, 0.72);
    font-size: 0.88rem;
    font-weight: 650;
    white-space: nowrap;
  }
  .flow-capability-ticker__item svg,
  .flow-capability-ticker__brand-mark,
  :global(.flow-capability-ticker__provider-logo) {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
  }
  .flow-capability-ticker__brand-icon { fill: currentColor; }
  .flow-capability-ticker__line-icon {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .flow-capability-ticker__brand-mark {
    display: inline-grid;
    place-items: center;
    color: #087f7b;
    font: 800 0.7rem/1 var(--font-mono);
    letter-spacing: -0.05em;
  }
  :global(.flow-capability-ticker__provider-logo) {
    border-radius: 0.3rem;
    object-fit: contain;
  }
  .flow-capability-ticker__divider {
    width: 1px;
    height: 1.5rem;
    flex-shrink: 0;
    background: rgba(8, 127, 123, 0.2);
  }
  @keyframes flow-capability-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-capability-ticker__track { animation-play-state: paused; }
  }
</style>
