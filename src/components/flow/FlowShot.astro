---
// Framed Orionfold Flow product shot. The captures are real Retina windows of
// the running development build over the synthetic flow-demo library (every
// name and number in the demo documents is invented for marketing use). One
// shared frame keeps every shot consistent: rounded window, soft border,
// primary-tinted shadow, optional caption bar.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  priority?: boolean;
  /** Crop to a shorter band (16/9-ish) instead of showing the full window. */
  crop?: boolean;
  /** Responsive sizes hint. Default fits a full-width max-w-6xl figure. Pass a
   *  smaller value for side-by-side layouts so retina screens don't fetch and
   *  decode the 2000px variant for a ~650px slot (scroll-jank source). */
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  caption,
  priority = false,
  crop = false,
  sizes = '(min-width: 1024px) 64rem, 100vw',
  class: className,
} = Astro.props;
---
<figure class:list={['flow-shot overflow-hidden rounded-2xl border border-primary/25 bg-surface shadow-xl shadow-primary/10', className]}>
  <div class:list={[crop ? 'aspect-[16/9] sm:aspect-[16/8]' : 'aspect-[2560/1400]', 'w-full overflow-hidden']}>
    <Image
      src={src}
      alt={alt}
      widths={[720, 1080, 1440, 2000]}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
      data-no-zoom
      class="block h-full w-full object-cover object-top"
    />
  </div>
  {caption && (
    <figcaption class="border-t border-primary/15 bg-surface-raised/60 px-5 py-3 text-center text-sm text-text-muted">
      {caption}
    </figcaption>
  )}
</figure>
