---
import FlowWorkbenchIllustration from './FlowWorkbenchIllustration.astro';

interface Props {
  class?: string;
  href?: string;
  linkLabel?: string;
}

const {
  class: className,
  href,
  linkLabel = 'Explore Orionfold Flow',
} = Astro.props;

const Root = href ? 'a' : 'div';
---

<Root
  href={href}
  aria-label={href ? linkLabel : undefined}
  class:list={['flow-hero-creative', href && 'flow-hero-creative--linked', className]}
>
  <FlowWorkbenchIllustration priority />
</Root>

<style>
  .flow-hero-creative {
    position: relative;
    display: grid;
    min-width: 0;
    place-items: center;
  }

  :global(.flow-hero-creative .flow-workbench) {
    width: min(100%, 45rem);
  }

  .flow-hero-creative--linked {
    border-radius: 2rem;
  }

  .flow-hero-creative--linked:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 5px;
  }

  @media (max-width: 1023px) {
    :global(.flow-hero-creative .flow-workbench) {
      width: min(100%, 38rem);
    }
  }
</style>
