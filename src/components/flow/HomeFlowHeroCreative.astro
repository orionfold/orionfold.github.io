---
import { Image } from 'astro:assets';
import heroCreative from '../../assets/story/limitless-without-the-pill/hero.png';

interface Props {
  class?: string;
  href?: string;
  linkLabel?: string;
}

const {
  class: className,
  href,
  linkLabel = 'Explore Orionfold Flow',
} = Astro.props;

const Root = href ? 'a' : 'figure';
const alt = 'A knowledge worker at a laptop conducts a luminous constellation of research, code, strategy, art, and scientific ideas across a deep blue night sky.';
---

<Root
  href={href}
  aria-label={href ? linkLabel : undefined}
  class:list={['home-flow-hero-creative', href && 'home-flow-hero-creative--linked', className]}
>
  <div class="home-flow-hero-creative__plane of-surface">
    <Image
      src={heroCreative}
      alt={alt}
      widths={[640, 960, 1280, 1672]}
      sizes="(min-width: 1280px) 52vw, (min-width: 1024px) 54vw, calc(100vw - 3rem)"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      quality={90}
      data-no-zoom
      class="home-flow-hero-creative__image"
    />
  </div>
</Root>

<style>
  .home-flow-hero-creative {
    position: relative;
    display: block;
    min-width: 0;
    margin: 0;
    border-radius: 1.75rem;
  }

  .home-flow-hero-creative::before {
    position: absolute;
    z-index: -1;
    inset: 8% 5% -4%;
    border-radius: 999px;
    background: color-mix(in oklch, var(--color-primary) 20%, transparent);
    filter: blur(70px);
    content: '';
    opacity: 0.62;
    pointer-events: none;
  }

  .home-flow-hero-creative__plane {
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in oklch, var(--color-primary) 24%, var(--color-border));
    border-radius: 1.75rem;
    padding: 0.45rem;
    background: color-mix(in oklch, var(--color-primary) 5%, var(--color-surface-raised));
    box-shadow: 0 36px 92px -52px rgb(3 13 31 / 0.82);
  }

  .home-flow-hero-creative__plane::after {
    position: absolute;
    inset: 0.45rem;
    border-radius: 1.32rem;
    background: linear-gradient(135deg, rgb(255 255 255 / 0.08), transparent 34%, transparent 70%, rgb(91 141 239 / 0.08));
    content: '';
    pointer-events: none;
  }

  .home-flow-hero-creative__image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 1.32rem;
    object-fit: cover;
  }

  .home-flow-hero-creative--linked:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 5px;
  }

  @media (min-width: 1024px) {
    .home-flow-hero-creative { perspective: 1500px; }
    .home-flow-hero-creative__plane {
      transform: rotateX(21deg) rotateZ(-4deg) scale(0.94);
      animation: home-flow-hero-perspective-drift 14s ease-in-out infinite alternate;
      will-change: transform;
    }
  }

  @keyframes home-flow-hero-perspective-drift {
    from { transform: rotateX(21deg) rotateZ(-4deg) scale(0.94); }
    to { transform: rotateX(27deg) rotateZ(3deg) scale(0.98); }
  }

  @media (max-width: 1023px) {
    .home-flow-hero-creative__plane { transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-flow-hero-creative__plane {
      animation: none;
      will-change: auto;
    }
  }
</style>
