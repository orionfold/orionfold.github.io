---
// Flow Elements on the homepage: one plain plan, drawn up in five steps. The
// document is the Elements tour's own (Harbor Close Plan, a fictional plan
// written for the walk, orionfold-flow articles/19 to 21). Ideas' five
// suggestions, the Field-Notes figure and the Next steps table are what Flow
// made in that walk; the options chart is drawn from the numbers the plan
// itself states (Visualize ran on "Where the time goes" in the walk), and the
// caption says so. Steps advance on their own while in view; a step tab takes
// over by hand. Reduced motion rests on the last step.
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Check from '@lucide/astro/icons/check';
import Lightbulb from '@lucide/astro/icons/lightbulb';
import Sparkles from '@lucide/astro/icons/sparkles';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import Laptop from '@lucide/astro/icons/laptop';
import { ELEMENT_CATEGORIES, elementDrawing, elementArticleHref } from '../../lib/flow/elements';

interface Props { id?: string }
const { id = 'flow-elements' } = Astro.props;

const ALL = ELEMENT_CATEGORIES.flatMap((c) => c.items);
const card = (key: string) => {
  const hit = ALL.find((i) => i.card === key);
  if (!hit) throw new Error(`FlowElementsShowcase: no element ${key}`);
  return { ...hit, svg: elementDrawing(key) };
};

const STEPS = [
  { tab: 'Your plan, in words' },
  { tab: 'Ideas suggests' },
  { tab: 'A chart' },
  { tab: 'A drawn figure' },
  { tab: 'A table, from a list' },
];

// Ideas' five suggestions in the walk, one per section, in the plan's order.
const IDEAS = [
  { skill: card('skill-delegation-map'), section: 'How the monthly close works', why: 'Priya, Tomás and Dana each in a lane, with the hand-offs.' },
  { skill: card('skill-field-notes-diagram'), section: 'Where the time goes', why: 'Four step timings that add to 312 hours.' },
  { skill: card('skill-option-comparison'), section: 'Options for chasing receipts', why: 'Email, the portal and Receiptly side by side.' },
  { skill: card('skill-register'), section: 'Risks', why: 'Three risks, each with an owner and a check.' },
  { skill: card('skill-roadmap'), section: 'Next steps', why: 'Four dated steps, 7 November to February.' },
];

const SKILLS = ['skill-decision-brief', 'skill-delegation-map', 'skill-field-notes-diagram', 'skill-option-comparison', 'skill-register', 'skill-roadmap'].map(card);
const AGENCY = ['agency-proofread', 'agency-summarize', 'agency-text-to-table', 'agency-visualize', 'agency-sign-off'].map(card);
const KINDS = ['kind-bar-chart', 'kind-grouped-bar-chart', 'kind-stacked-bar-chart', 'kind-lollipop-chart', 'kind-bullet-chart', 'kind-kpi-card'].map(card);
const visualize = card('agency-visualize');
const fieldNotes = card('skill-field-notes-diagram');
const toTable = card('agency-text-to-table');

// The four groups, as links into their articles.
const GROUPS = [
  { slug: 'components', n: 15, label: 'Components', line: 'blocks a document can hold', on: [] as number[], icon: card('component-approval-card') },
  { slug: 'agency', n: 12, label: 'Agency', line: 'actions on your words', on: [4], icon: toTable },
  { slug: 'skills', n: 19, label: 'Skills', line: 'methods that draw your case', on: [1, 3], icon: fieldNotes },
  { slug: 'chart-kinds', n: 54, label: 'Chart and diagram kinds', line: 'switch kinds, keep the data', on: [2], icon: card('kind-bar-chart') },
];
const icon = (c: { svg: string; tint: string }, size = 22) => `<span class="fx-ic" style="--fx-t:${c.tint};--fx-s:${size}px">${c.svg}</span>`;
---
<section id={id} class="fx ls-container" aria-labelledby={`${id}-title`}>
  <div class="fx-head">
    <div>
      <p class="ls-eyebrow fx-eyebrow">Flow Elements</p>
      <h2 id={`${id}-title`}>WRITE IT IN WORDS.<br /><span class="ls-stroke">SEE IT DRAWN.</span></h2>
    </div>
    <div class="fx-dek">
      <p>Press ⌘5 and Elements opens beside your document. It holds a card for every block, action, skill and chart kind Flow can add, each with a small drawing.</p>
      <p>You don't have to know which one fits. Ideas reads your sections and names one for each. Whatever a card adds waits in Review Changes until you keep it.</p>
    </div>
  </div>

  <figure class="fx-mock" data-fx aria-label="Flow Elements on a plain plan: Ideas suggests a skill for each section, then a chart, a drawn figure and a table are added from the plan's own text, each waiting for review">
    <div class="fx-tabs" role="tablist" aria-label="Steps of the Elements walk">
      {STEPS.map((s, i) => (
        <button type="button" role="tab" class="fx-tab" data-fx-go={i} aria-selected={i === 0 ? 'true' : 'false'}>
          <span class="fx-tab-n"><i class="fx-tab-ring" aria-hidden="true"></i>{i + 1}</span>
          <span class="fx-tab-t">{s.tab}</span>
        </button>
      ))}
    </div>

    <div class="fx-window">
      <div class="fx-bar" aria-hidden="true">
        <span class="fx-lights"><i></i><i></i><i></i></span>
        <span class="fx-title">Harbor Close Plan</span>
        <span class="fx-pill" data-fx-from="2"><i></i>1 change to review</span>
      </div>

      <div class="fx-panes">
        <!-- Elements (⌘5) -->
        <aside class="fx-el" aria-hidden="true">
          <p class="fx-el-h">Elements <kbd>⌘5</kbd></p>
          <div data-fx-show="0 1 3">
            <p class="fx-grp"><ChevronRight size={12} />Components <b>15</b></p>
            <p class="fx-grp"><ChevronRight size={12} />Agency <b>12</b></p>
            <p class="fx-grp is-open"><ChevronDown size={12} />Skills <b>19</b></p>
            {SKILLS.map((s) => (
              <p class:list={['fx-card', s.card === fieldNotes.card && 'fx-card--fn', IDEAS.some((x) => x.skill.card === s.card) && 'fx-card--idea']}>
                <Fragment set:html={icon(s)} /><span><b>{s.name}</b><small>{s.line}</small></span>
              </p>
            ))}
          </div>
          <div data-fx-show="2">
            <p class="fx-grp is-open"><ChevronDown size={12} />Comparison and ranking</p>
            {KINDS.map((k, i) => (
              <p class:list={['fx-card', i === 0 && 'is-on']}>
                <Fragment set:html={icon(k)} /><span><b>{k.name}</b></span>{i === 0 && <Check size={13} stroke-width={3} class="fx-tick" />}
              </p>
            ))}
            <p class="fx-grp"><ChevronRight size={12} />Change over time</p>
            <p class="fx-grp"><ChevronRight size={12} />Part of a whole</p>
          </div>
          <div data-fx-show="4">
            <p class="fx-grp"><ChevronRight size={12} />Components <b>15</b></p>
            <p class="fx-grp is-open"><ChevronDown size={12} />Agency <b>12</b></p>
            <p class="fx-el-route">27 words · selection · Claude subscription</p>
            {AGENCY.map((a) => (
              <p class:list={['fx-card', a.card === toTable.card && 'is-on']}>
                <Fragment set:html={icon(a)} /><span><b>{a.name}</b><small>{a.line}</small></span>
              </p>
            ))}
          </div>
        </aside>

        <!-- The plan -->
        <div class="fx-doc" aria-hidden="true">
          <div class="fx-page" data-fx-page>
            <p class="fx-h1">Harbor Close Plan</p>
            <p class="fx-p fx-muted">A fictional four-person firm that closes the books for thirty small clients each month.</p>

            <div class="fx-sec" data-fx-sec="0">
              <p class="fx-h2"><span>How the monthly close works</span><Fragment set:html={icon(IDEAS[0].skill, 18)} /></p>
              <p class="fx-p">Priya reconciles the bank and card lines against the ledger, then Tomás chases any receipt that is missing. Priya drafts the summary, and Dana reviews it and sends it by the fifth working day.</p>
            </div>

            <div class="fx-sec" data-fx-sec="1" data-fx-target="3">
              <p class="fx-h2"><span>Where the time goes</span><Fragment set:html={icon(IDEAS[1].skill, 18)} /></p>
              <p class="fx-p fx-sel" data-fx-sel="3">Last quarter the team logged 312 hours on closes. Reconciliation took 140 hours, chasing receipts took 96 hours, drafting summaries took 48 hours and review took 28 hours. Chasing receipts is the step clients complain about most.</p>
              <div class="fx-add fx-fig" data-fx-from="3">
                <svg viewBox="0 0 600 330" role="img" aria-label="">
                  <text class="fx-fig-eye" x="24" y="40">HOURS ON CLOSES · LAST QUARTER</text>
                  <g class="fx-fig-s1">
                    <text class="fx-fig-l" x="24" y="98">Reconciliation</text><rect class="fx-fig-b" x="190" y="79" width="300" height="28" /><text class="fx-fig-v" x="500" y="98">140 hours</text>
                    <text class="fx-fig-l" x="24" y="198">Drafting</text><rect class="fx-fig-b" x="190" y="179" width="102.86" height="28" style="--d:1" /><text class="fx-fig-v" x="302.86" y="198">48 hours</text>
                    <text class="fx-fig-l" x="24" y="248">Review</text><rect class="fx-fig-b" x="190" y="229" width="60" height="28" style="--d:2" /><text class="fx-fig-v" x="260" y="248">28 hours</text>
                  </g>
                  <g class="fx-fig-s2">
                    <rect class="fx-fig-wash" x="12" y="123" width="576" height="40" />
                    <text class="fx-fig-l fx-fig-thesis" x="24" y="148">Chasing</text><rect class="fx-fig-b fx-fig-bt" x="190" y="129" width="205.71" height="28" /><text class="fx-fig-v" x="405.71" y="148">96 hours</text>
                    <text class="fx-fig-v fx-fig-cap" x="24" y="300">CHASING RECEIPTS: 96 OF 312 HOURS, THE MOST COMPLAINTS</text>
                  </g>
                </svg>
                <span class="fx-add-tag"><Fragment set:html={icon(fieldNotes, 14)} /><span>Field-Notes Diagram · step <b class="fx-fig-step"></b> of 2 · proposed</span></span>
              </div>
            </div>

            <div class="fx-sec" data-fx-sec="2" data-fx-target="2">
              <p class="fx-h2"><span>Options for chasing receipts</span><Fragment set:html={icon(IDEAS[2].skill, 18)} /></p>
              <p class="fx-p fx-sel" data-fx-sel="2">Keep email, which stays at about 96 hours a quarter. Use the client portal, which needs a week of setup and should halve the chase. Or buy Receiptly at $12 a client a month, which should cut the chase by three quarters.</p>
              <div class="fx-add fx-chart" data-fx-from="2">
                <p class="fx-chart-t">Chase hours a quarter, by option</p>
                <div class="fx-bars">
                  <span class="fx-bar-row" style="--v:96;--d:0"><b>Email</b><i></i><em>about 96</em></span>
                  <span class="fx-bar-row" style="--v:48;--d:1"><b>Portal</b><i></i><em>about 48</em></span>
                  <span class="fx-bar-row fx-bar-row--hi" style="--v:24;--d:2"><b>Receiptly</b><i></i><em>about 24</em></span>
                </div>
                <span class="fx-add-tag"><Fragment set:html={icon(visualize, 14)} /><span>Visualize · bar chart · proposed</span></span>
              </div>
            </div>

            <div class="fx-sec" data-fx-sec="3">
              <p class="fx-h2"><span>Risks</span><Fragment set:html={icon(IDEAS[3].skill, 18)} /></p>
              <p class="fx-p">Two of the largest clients have never logged in to the portal. Receiptly is a young company. Any change during the January close lands on the busiest month.</p>
            </div>

            <div class="fx-sec" data-fx-sec="4" data-fx-target="4">
              <p class="fx-h2"><span>Next steps</span><Fragment set:html={icon(IDEAS[4].skill, 18)} /></p>
              <ol class="fx-ol fx-sel" data-fx-sel="4">
                <li>Dana asks the five largest clients which option they would use, by 7 November.</li>
                <li>Tomás sets up the portal for two pilot clients in the week of 10 November.</li>
                <li>Priya measures the chase hours for those two clients in the November close.</li>
                <li>The team decides on 1 December and switches everyone over in February.</li>
              </ol>
              <div class="fx-add" data-fx-from="4">
                <table class="fx-table">
                  <thead><tr><th>Step</th><th>Who</th><th>Action</th><th>When</th></tr></thead>
                  <tbody>
                    <tr style="--d:0"><td>1</td><td>Dana</td><td>Asks the five largest clients which option they would use</td><td>By 7 November</td></tr>
                    <tr style="--d:1"><td>2</td><td>Tomás</td><td>Sets up the portal for two pilot clients</td><td>Week of 10 November</td></tr>
                    <tr style="--d:2"><td>3</td><td>Priya</td><td>Measures the chase hours</td><td>November close</td></tr>
                    <tr style="--d:3"><td>4</td><td>The team</td><td>Decides, then switches everyone over</td><td>1 December, February</td></tr>
                  </tbody>
                </table>
                <span class="fx-add-tag"><Fragment set:html={icon(toTable, 14)} /><span>Convert Text to Table · proposed</span></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Ideas, then Review Changes -->
        <div class="fx-side" aria-live="polite">
          <div class="fx-side-tabs" aria-hidden="true">
            <span class="fx-side-tab" data-fx-show="0 1"><Lightbulb size={13} />Ideas <kbd>⌘3</kbd></span>
            <span class="fx-side-tab" data-fx-show="2 3 4"><Check size={13} />Review Changes</span>
          </div>

          <div class="fx-pane" data-fx-show="0">
            <div class="fx-notice fx-in">
              <p class="fx-k">What Flow noticed</p>
              <p class="fx-notice-t">Find skills for 5 sections of Harbor Close Plan</p>
              <p class="fx-notice-p">They have the points, numbers or dates a skill works from. Nothing changes until you run one.</p>
              <span class="fx-btn fx-btn--press"><Sparkles size={13} />Suggest Ideas</span>
            </div>
            <p class="fx-note fx-in" style="--d:2"><Laptop size={12} />Counted on this Mac, before any model ran.</p>
          </div>

          <div class="fx-pane" data-fx-show="1">
            <p class="fx-run fx-in"><Sparkles size={12} />5 ideas · about 18 s · Claude subscription, no extra cost</p>
            {IDEAS.map((x, i) => (
              <div class="fx-idea fx-in" style={`--d:${i + 1}`}>
                <Fragment set:html={icon(x.skill, 26)} />
                <span><b>Run {x.skill.name}</b> on “{x.section}”<small>{x.why}</small></span>
              </div>
            ))}
          </div>

          <div class="fx-pane" data-fx-show="2">
            <div class="fx-rev fx-in">
              <p class="fx-k">Visualize · Agency</p>
              <p class="fx-rev-t">Adds a bar chart with 3 data rows after the selected text.</p>
              <p class="fx-rev-p">Drawn from the plan's own numbers. Switch it to any of the chart kinds in Elements and the data comes along.</p>
            </div>
            <div class="fx-decide fx-in" style="--d:2"><span class="fx-state">Proposed</span><span class="fx-btn fx-btn--ghost">Discard</span><span class="fx-btn fx-btn--keep">Keep</span></div>
          </div>

          <div class="fx-pane" data-fx-show="3">
            <div class="fx-idea fx-idea--run fx-in">
              <Fragment set:html={icon(fieldNotes, 26)} />
              <span><b>Run Field-Notes Diagram</b> on “Where the time goes”</span>
            </div>
            <ul class="fx-checks fx-in" style="--d:1">
              <li><Check size={12} stroke-width={3} />46 words to read</li>
              <li><Check size={12} stroke-width={3} />5 numbers to work with</li>
              <li><Check size={12} stroke-width={3} />Included in your subscription</li>
            </ul>
            <div class="fx-rev fx-in" style="--d:3">
              <p class="fx-rev-t">Adds Field-Notes Diagram after the selected text. It holds 1 figure.</p>
              <p class="fx-rev-p">Every bar drawn to its value, built in two steps. Ready in about 50 s.</p>
            </div>
            <div class="fx-decide fx-in" style="--d:4"><span class="fx-state">Proposed</span><span class="fx-btn fx-btn--ghost">Discard</span><span class="fx-btn fx-btn--keep">Keep</span></div>
          </div>

          <div class="fx-pane" data-fx-show="4">
            <div class="fx-rev fx-in">
              <p class="fx-k">Convert Text to Table · Agency</p>
              <p class="fx-rev-t">A table with the columns the list implied: Step, Who, Action, When.</p>
              <p class="fx-rev-p">The four numbered steps become four rows. A paragraph with no rows in it says so before you press the card.</p>
            </div>
            <div class="fx-decide fx-in" style="--d:2"><span class="fx-state">Proposed</span><span class="fx-btn fx-btn--ghost">Discard</span><span class="fx-btn fx-btn--keep">Keep</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="fx-groups">
      {GROUPS.map((g) => (
        <a class="fx-group" href={elementArticleHref(g.slug)} data-fx-on={g.on.join(' ')}>
          <Fragment set:html={icon(g.icon, 30)} />
          <span><b>{g.n} {g.label.toLowerCase()}</b><small>{g.line}</small></span>
        </a>
      ))}
    </div>
    <figcaption class="fx-cap">Drawn from our Elements walk on a fictional plan. Ideas' five suggestions, the figure and the table are what Flow made in the walk; the chart is drawn here from the plan's own numbers. Text shortened. <a href={elementArticleHref('tour')}>Read the walk, with every number labelled</a>.</figcaption>
  </figure>

  <div class="fx-links">
    <a class="ls-button" href="/flow/elements/">See all 100 elements<ArrowRight size={18} /></a>
    <a class="ls-text-link" href={elementArticleHref('tour')}>The Elements tour<ArrowRight size={17} /></a>
  </div>
</section>

<script>
  const STEP_MS = [4600, 6200, 5600, 7000, 6000];

  function init(root: ParentNode = document) {
    for (const el of root.querySelectorAll<HTMLElement>('[data-fx]:not([data-fx-ready])')) {
      el.dataset.fxReady = '';
      const tabs = [...el.querySelectorAll<HTMLButtonElement>('[data-fx-go]')];
      const doc = el.querySelector<HTMLElement>('.fx-doc')!;
      const page = el.querySelector<HTMLElement>('[data-fx-page]')!;
      const last = tabs.length - 1;
      let step = 0;
      let timer: number | undefined;
      let manual = false;

      // Scroll the plan to the step's section: its heading near the top, or
      // far enough down that what the card added is fully in view.
      const focus = (n: number) => {
        const target = page.querySelector<HTMLElement>(`[data-fx-target="${n}"]`);
        const max = Math.max(0, page.scrollHeight - doc.clientHeight);
        let y = 0;
        if (target) {
          y = target.offsetTop - 18;
          const added = target.querySelector<HTMLElement>(`[data-fx-from="${n}"]`);
          if (added) {
            // Both offsets are measured from the pane (.fx-doc is the positioned parent).
            const top = added.offsetTop;
            const bottom = top + added.offsetHeight;
            y = added.offsetHeight + 36 > doc.clientHeight ? top - 12 : Math.max(y, bottom + 18 - doc.clientHeight);
          }
        }
        page.style.transform = `translateY(${-Math.min(max, Math.max(0, y))}px)`;
      };

      const set = (n: number) => {
        step = n;
        el.dataset.step = String(n);
        el.querySelectorAll<HTMLElement>('[data-fx-show]').forEach((x) => { x.hidden = !x.dataset.fxShow!.split(' ').includes(String(n)); });
        el.querySelectorAll<HTMLElement>('[data-fx-from]').forEach((x) => { x.hidden = n < Number(x.dataset.fxFrom); });
        el.querySelectorAll<HTMLElement>('[data-fx-sel]').forEach((x) => x.classList.toggle('is-sel', x.dataset.fxSel === String(n)));
        el.querySelectorAll<HTMLElement>('[data-fx-on]').forEach((x) => x.classList.toggle('is-on', x.dataset.fxOn!.split(' ').includes(String(n))));
        tabs.forEach((t, i) => {
          t.setAttribute('aria-selected', String(i === n));
          t.classList.toggle('is-past', i < n);
        });
        el.style.setProperty('--fx-ms', `${STEP_MS[n]}ms`);
        el.classList.remove('is-tick');
        void el.offsetWidth;
        el.classList.add('is-tick');
        requestAnimationFrame(() => focus(n));
      };

      const play = () => {
        if (manual || timer) return;
        timer = window.setTimeout(function tick() {
          set(step === last ? 0 : step + 1);
          timer = window.setTimeout(tick, STEP_MS[step]);
        }, STEP_MS[step]);
      };
      const pause = () => { window.clearTimeout(timer); timer = undefined; };

      tabs.forEach((t, i) => t.addEventListener('click', () => {
        manual = true;
        el.classList.add('is-manual');
        pause();
        set(i);
      }));
      addEventListener('resize', () => focus(step));

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced || !('IntersectionObserver' in window)) {
        el.classList.add('is-manual');
        set(last);
        continue;
      }
      set(0);
      new IntersectionObserver((entries) => {
        for (const e of entries) e.isIntersecting ? play() : pause();
      }, { threshold: 0.35 }).observe(el);
    }
  }
  init();
  document.addEventListener('astro:after-swap', () => init());
</script>

<style>
  .fx { padding-block: 92px 84px; border-bottom: 1px solid var(--line); }
  .fx-head { display: grid; grid-template-columns: 1.1fr 1fr; gap: 56px; align-items: end; margin-bottom: 40px; }
  .fx-eyebrow { display: flex; align-items: center; gap: 12px; }
  .fx h2 { font: 700 clamp(42px, 5vw, 76px)/.95 'Barlow Condensed', Arial, sans-serif; letter-spacing: -.018em; margin: 18px 0 0; }
  .fx-dek { font-size: 16px; color: var(--muted); max-width: 560px; }
  .fx-dek p + p { margin-top: .8rem; }

  /* A card's drawing, in its tint */
  .fx :global(.fx-ic) { flex: none; display: grid; place-items: center; width: var(--fx-s); height: var(--fx-s); border-radius: calc(var(--fx-s) * .26); color: var(--fx-t); background: color-mix(in srgb, var(--fx-t) 10%, #fff); }
  .fx :global(.fx-ic svg) { width: 68%; height: 68%; overflow: visible; }

  /* Step tabs */
  .fx-mock { margin: 0; }
  .fx-tabs { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; margin-bottom: 14px; }
  .fx-tab { position: relative; display: flex; align-items: center; gap: 9px; padding: 11px 12px 14px; border: 1px solid var(--line); border-radius: 8px; background: #fff; color: var(--muted); font-size: 14px; font-weight: 700; text-align: left; cursor: pointer; overflow: hidden; transition: border-color .2s, color .2s, background .2s; }
  .fx-tab:hover { border-color: var(--ink); color: var(--ink); }
  .fx-tab:focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }
  .fx-tab-n { position: relative; display: grid; place-items: center; flex: none; width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid currentColor; font-size: 12px; }
  /* The step's time runs as a ring round its number, never as a bar on one
     edge of the tab (no one-edge accents: operator 2026-10-27). */
  @property --fx-p { syntax: '<percentage>'; inherits: false; initial-value: 0%; }
  .fx-tab-ring { position: absolute; inset: -5px; border-radius: 50%; background: conic-gradient(var(--red) var(--fx-p), transparent 0); -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2.5px), #000 calc(100% - 2px)); mask: radial-gradient(farthest-side, transparent calc(100% - 2.5px), #000 calc(100% - 2px)); }
  .fx-tab-t { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
