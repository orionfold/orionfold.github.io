---
import BrandMark from '../ui/BrandMark.astro';
import tunePoster from '../../assets/flow/launch/flow-ideas-pit-stop-tune-poster.webp';
import releasePoster from '../../assets/flow/launch/flow-ideas-release-exit-poster.webp';

const acts = [
  {
    id: 'tune',
    label: 'Act 01 · Pit / tune · 5.625 seconds',
    title: 'The crew works. Release stays held.',
    body: 'Specialists inspect the staged idea, work their narrow stations, and report back. The driver keeps the release.',
    video: '/video/flow/flow-ideas-pit-stop-tune.mp4',
    poster: tunePoster.src,
    playLabel: 'Play pit and tune',
    brandLabel: 'PIT / TUNE',
    telemetry: [
      ['System health', '99%'],
      ['Specialists', '06 ready'],
      ['Driver control', 'Release held'],
    ],
    caption: 'Driver control: release held. Illustrative, not product evidence.',
  },
  {
    id: 'release',
    label: 'Act 02 · Release · 1.5 seconds',
    title: 'Your call puts Flow back on track.',
    body: 'The crew clears only after the decision. The user releases, and Flow carries the work forward.',
    video: '/video/flow/flow-ideas-release-exit.mp4',
    poster: releasePoster.src,
    playLabel: 'Play release',
    brandLabel: 'RELEASE CAM',
    telemetry: [
      ['Release', 'User confirmed'],
      ['Track status', 'Clear'],
      ['Flow state', 'Moving'],
    ],
    caption: 'The crew clears. The user releases. Flow moves. Illustrative, not product evidence.',
  },
] as const;
---

<section id="flow-race-sequence" class="flow-race" aria-labelledby="flow-race-title">
  <div class="flow-race__shell">
    <header class="flow-race__header">
      <p class="flow-race__eyebrow" data-animate="rise">Two acts · one driver</p>
      <h2 id="flow-race-title" data-animate="lead">Pit. Tune. Release.</h2>
      <p data-animate="rise">
        Specialists tune the staged idea. Release stays held until you say go.
      </p>
    </header>

    <ol class="flow-race__acts" aria-label="Two-act Flow Ideas race sequence">
      {acts.map((act) => (
        <li class="flow-race__act" data-race-act={act.id} data-animate="rise">
          <div class="flow-race__act-copy">
            <p class="flow-race__act-label">{act.label}</p>
            <h3>{act.title}</h3>
            <p>{act.body}</p>
          </div>

          <figure class="flow-race__frame" data-race-film>
            <div class="flow-race__media">
              <video
                class="flow-race__video"
                data-race-video
                src={act.video}
                poster={act.poster}
                muted
                playsinline
                preload="metadata"
                aria-describedby={`flow-race-${act.id}-caption`}
              ></video>

              <div class="flow-race__brand" aria-hidden="true">
                <BrandMark size={22} />
                <span>ORION<span>FOLD</span></span>
                <strong>{act.brandLabel}</strong>
              </div>
            </div>

            <div class="flow-race__console">
              <div class="flow-race__telemetry" aria-hidden="true">
                {act.telemetry.map(([label, value]) => (
                  <div class="flow-race__screen">
                    <span>{label}</span>
                    <strong>{value}</strong>
                    <i><b></b></i>
                  </div>
                ))}
              </div>
              <button
                class="flow-race__toggle"
                data-race-control={act.id}
                data-play-label={act.playLabel}
                type="button"
                aria-label={act.playLabel}
              >
                {act.playLabel}
              </button>
            </div>

            <figcaption id={`flow-race-${act.id}-caption`}>
              {act.caption}
            </figcaption>
          </figure>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('[data-race-video]'));

  document.querySelectorAll<HTMLElement>('[data-race-film]').forEach((root) => {
    if (root.dataset.raceReady === 'true') return;
    const video = root.querySelector<HTMLVideoElement>('[data-race-video]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-race-control]');
    if (!video || !toggle) return;
    root.dataset.raceReady = 'true';

    const playLabel = toggle.dataset.playLabel || 'Play motion';
    const update = () => {
      const label = video.ended
        ? playLabel.replace('Play', 'Replay')
        : video.paused
          ? playLabel
          : playLabel.replace('Play', 'Pause');
      toggle.textContent = label;
      toggle.setAttribute('aria-label', label);
    };

    toggle.addEventListener('click', () => {
      if (video.paused) {
        for (const peer of videos) {
          if (peer !== video) peer.pause();
        }
        if (video.ended) video.currentTime = 0;
        void video.play().catch(() => {});
      } else {
        video.pause();
      }
    });
    video.addEventListener('play', update);
    video.addEventListener('pause', update);
    video.addEventListener('ended', update);
    update();
  });
</script>

<style>
  .flow-race {
    position: relative;
    overflow: hidden;
    scroll-margin-top: 7rem;
    padding: clamp(4.5rem, 9vw, 8rem) 1.5rem;
    color: #f3fbfb;
    background:
      radial-gradient(circle at 72% 36%, color-mix(in oklch, var(--color-primary) 15%, transparent), transparent 25rem),
      linear-gradient(145deg, #071115 0%, #0d2024 54%, #081317 100%);
  }
  .flow-race__shell { width: min(100%, 76rem); margin-inline: auto; }
  .flow-race__header { max-width: 52rem; }
  .flow-race__eyebrow,
  .flow-race__act-label {
    color: color-mix(in oklch, var(--color-primary) 82%, white);
    font: 700 0.68rem/1 var(--font-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .flow-race__header h2 {
    margin-top: 1rem;
    color: #f3fbfb;
    font: 700 clamp(2.7rem, 7vw, 6.1rem)/0.94 var(--font-display);
    letter-spacing: -0.06em;
    text-wrap: balance;
  }
  .flow-race__header > p:last-child {
    max-width: 42rem;
    margin-top: 1.4rem;
    color: rgba(235,247,247,0.76);
    font-size: clamp(1.02rem, 1.7vw, 1.24rem);
    line-height: 1.65;
  }
  .flow-race__acts {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    margin-top: clamp(3rem, 7vw, 5.5rem);
    padding: 0;
    list-style: none;
  }
  .flow-race__act { display: grid; gap: 1.4rem; align-content: start; }
  .flow-race__act-copy { max-width: 31rem; }
  .flow-race__act-copy h3 {
    margin-top: 0.75rem;
    font: 700 clamp(1.5rem, 3vw, 2.3rem)/1.08 var(--font-display);
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .flow-race__act-copy > p:last-child {
    margin-top: 0.85rem;
    color: rgba(226,243,242,0.62);
    line-height: 1.65;
  }
  .flow-race__frame {
    width: min(100%, 26rem);
    overflow: hidden;
    border: 1px solid rgba(170,245,241,0.2);
    border-radius: clamp(1.25rem, 3vw, 2rem);
    background: #061014;
    box-shadow: 0 2rem 6rem rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.025) inset;
  }
  .flow-race__media {
    position: relative;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: #061014;
  }
  .flow-race__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .flow-race__brand {
    position: absolute;
    z-index: 2;
    top: 1rem;
    left: 1rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid rgba(203,250,246,0.22);
    border-radius: 999px;
    padding: 0.45rem 0.65rem 0.45rem 0.45rem;
    background: rgba(4,13,16,0.9);
    font: 700 0.62rem/1 var(--font-display);
  }
  .flow-race__brand > span:nth-child(2) > span { color: color-mix(in oklch, var(--color-primary) 82%, white); }
  .flow-race__brand strong {
    margin-left: 0.25rem;
    color: color-mix(in oklch, var(--color-primary) 82%, white);
    font-family: var(--font-mono);
    letter-spacing: 0.09em;
  }
  .flow-race__console { padding: 0.75rem; border-top: 1px solid rgba(170,245,241,0.14); background: #071519; }
  .flow-race__telemetry { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 0.38rem; }
  .flow-race__screen { min-width: 0; border: 1px solid rgba(160,246,239,0.16); border-radius: 0.42rem; padding: 0.55rem; background: rgba(3,14,18,0.9); }
  .flow-race__screen span,
  .flow-race__screen strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .flow-race__screen span { color: rgba(226,247,246,0.54); font: 600 0.48rem/1 var(--font-mono); letter-spacing: 0.09em; text-transform: uppercase; }
  .flow-race__screen strong { margin-top: 0.4rem; color: #f5ffff; font: 700 0.62rem/1 var(--font-mono); }
  .flow-race__screen i { display: block; height: 2px; margin-top: 0.45rem; overflow: hidden; background: rgba(207,248,245,0.11); }
  .flow-race__screen b { display: block; width: 82%; height: 100%; background: color-mix(in oklch, var(--color-primary) 82%, white); }
  .flow-race__toggle {
    width: 100%;
    min-height: 2.8rem;
    margin-top: 0.65rem;
    border: 1px solid rgba(203,250,246,0.22);
    border-radius: 999px;
    padding: 0.72rem 0.9rem;
    color: #071416;
    background: color-mix(in oklch, var(--color-primary) 82%, white);
    font: 750 0.68rem/1 var(--font-mono);
    letter-spacing: 0.04em;
  }
  .flow-race__toggle:focus-visible { outline: 2px solid white; outline-offset: 4px; }
  .flow-race__frame figcaption {
    padding: 0.85rem 1rem 1rem;
    color: rgba(221,241,240,0.54);
    font: 500 0.68rem/1.55 var(--font-mono);
  }
  @media (min-width: 800px) {
    .flow-race__acts { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .flow-race__frame { margin-top: auto; }
  }
  @media (max-width: 799px) {
    .flow-race__act { justify-items: center; }
    .flow-race__act-copy { width: min(100%, 26rem); }
  }
  @media (max-width: 480px) {
    .flow-race { padding-inline: 1rem; }
    .flow-race__header h2 { font-size: clamp(2.7rem, 15vw, 4.1rem); }
    .flow-race__brand strong { display: none; }
  }
</style>
