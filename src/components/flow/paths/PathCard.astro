---
// One Flow path as a card. `lead` is the large featured card, `card` the grid
// card, `mini` the compact row used beside a lead card.
import { Image } from 'astro:assets';
import { pathHref, pathShot, type PathEntry } from '../../../lib/flow/paths';
import '../../../styles/flow-paths.css';

interface Props { entry: PathEntry; variant?: 'lead' | 'card' | 'mini'; headingLevel?: 'h2' | 'h3'; }
const { entry, variant = 'card', headingLevel = 'h3' } = Astro.props;
const { chip, persona, title, path, summary, stat, steps, cardShot } = entry.data;
const shot = pathShot(entry.id, cardShot);
const H = headingLevel;
const alt = `${path}: a Flow 2.0 screen from the walkthrough`;
---
{variant === 'mini' ? (
  <a class="fp-mini" href={pathHref(entry.id)}>
    <figure><Image src={shot} alt="" widths={[200, 300]} sizes="150px" loading="lazy" /></figure>
    <div>
      <p class="fp-meta">{chip} · {path}</p>
      <H class="fp-title">{title}</H>
    </div>
  </a>
) : (
  <a class:list={['fp-card', variant === 'lead' && 'fp-card--lead']} href={pathHref(entry.id)}>
    <figure><Image src={shot} alt={alt} widths={variant === 'lead' ? [640, 960, 1280] : [480, 720]} sizes={variant === 'lead' ? '(max-width: 1000px) 100vw, 720px' : '(max-width: 1000px) 100vw, 400px'} loading="lazy" /></figure>
    <div class="fp-card-body">
      <p class="fp-meta">{chip}{persona !== chip && ` · ${persona}`}</p>
      <H class="fp-title">{title}</H>
      <p>{summary}</p>
      {variant === 'lead' && <ol class="fp-steps">{steps.map((s) => <li>{s}</li>)}</ol>}
      <p class="fp-stat"><b>{stat.value}</b>{stat.label}</p>
    </div>
  </a>
)}
