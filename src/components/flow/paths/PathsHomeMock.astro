---
// The Flow 2.0 Home screen ("What are you working on?"), drawn natively.
// One chip per published path; choosing a chip swaps the featured path: its
// steps, its before → Flow → after diagram and a live mock of the document
// it ends with (charts, tables, a diff, a picture), which plays Flow's review
// loop. Add-on copy follows Flow 2.0.3.
import { publishedPaths, pathHref } from '../../../lib/flow/paths';
import { SHOWCASE, HUE } from '../../../data/flow-path-showcase';
import PathDiagram from '../mocks/PathDiagram.astro';
import { ArrowRightIcon } from '../../../lib/flow-icons';
import DocMock from '../mocks/DocMock.astro';
import '../../../styles/flow-paths.css';
import '../../../styles/flow-mocks.css';

const paths = (await publishedPaths()).filter((p) => SHOWCASE[p.id]);
const lead = paths.find((p) => p.data.featured) ?? paths[0];
const ADDONS = [
  { name: 'Flow Pro', body: 'Flow thinks with you. Ask, Jobs, Night Shift and Smart Routing, on the models you choose, on this Mac or hosted.', price: '$10 a month or $96 a year' },
  { name: 'Flow Import', body: 'Turn Word, Excel, PowerPoint and PDFs into documents you can edit, search and keep current.', price: '$10 a month or $96 a year · Needs Flow Pro' },
  { name: 'Flow Publish', body: 'Publish as a PDF, website, ebook, Word, Excel or PowerPoint file, with charts and pictures.', price: '$10 a month or $96 a year · Needs Flow Pro' },
];
---
{lead && (
  <section id="paths-home" class="fp-section ls-container" aria-labelledby="paths-home-heading">
    <div class="fp-head">
      <div class="fp-heading">
        <p class="ls-eyebrow">FLOW 2.0 / START FROM A PATH</p>
        <h2 id="paths-home-heading">What are you<br /><span class="ls-stroke">working on?</span></h2>
        <p>Flow 2.0 opens on Paths: ready folders for real jobs. Pick one to see where it starts, then read the walkthrough with every screen.</p>
      </div>
      <a class="fp-all" href="/flow/paths/">All paths<ArrowRightIcon class="lk-arrow" size={14} stroke-width={2.25} aria-hidden="true" /></a>
    </div>
    <div class="fp-app" data-paths-home>
      <div class="fp-app-bar"><span aria-hidden="true"><i></i><i></i><i></i></span><span>Welcome to Flow</span></div>
      <div class="fp-app-body">
        <div class="fp-app-side" aria-hidden="true"><p>Recents</p><span class="on">Home</span><span>Client Brief</span><span>Market Watch</span><p>Folders</p><span>Flow Guide</span><span>Agent Desk</span><span>Product Launch</span><span>Campaign</span></div>
        <div class="fp-app-main">
          <p class="fp-app-title">What are you working on?</p>
          <p class="fp-app-hint">Take a path, or go straight to a Living Document.</p>
          <div class="fp-chips" role="group" aria-label="Paths by kind of work">
            {paths.map((p) => <button type="button" data-chip={p.id} aria-pressed={String(p === lead)}>{p.data.chip || SHOWCASE[p.id].chip}</button>)}
          </div>
          {paths.map((p) => {
            const show = SHOWCASE[p.id];
            return (
              <div class="fp-feat" data-panel={p.id} hidden={p !== lead} style={`--ps-tint:${HUE[show.hue]}`}>
                <div class="fp-feat-copy">
                  <p class="fp-feat-name">{show.title}</p>
                  <p class="fp-feat-per">{show.persona}</p>
                  <ol class="ps-steps">{show.steps.map((s) => <li>{s}</li>)}</ol>
                  <div class="ps-pills">{show.benefits.map((b) => <span>{b}</span>)}</div>
                  {p.data.stat.value && <p class="ps-stat"><b>{p.data.stat.value}</b>{p.data.stat.label}</p>}
                  <a class="fp-feat-read" href={pathHref(p.id)}>Read the walkthrough<ArrowRightIcon class="lk-arrow" size={14} stroke-width={2.25} aria-hidden="true" /></a>
                </div>
                <div class="fp-feat-media">
                  <PathDiagram path={show} compact />
                  <DocMock path={show} size="panel" />
                </div>
              </div>
            );
          })}
          <div class="fp-addons">
            {ADDONS.map((a) => <div><b>{a.name}</b>{a.body}<small>{a.price}</small></div>)}
          </div>
        </div>
      </div>
    </div>
  </section>
)}
<script>
  import { initPathsHome } from '../../../scripts/paths-home.js';
  import { initFlowMocks } from '../../../scripts/flow-mocks.js';
  initPathsHome();
  initFlowMocks();
  document.addEventListener('astro:after-swap', () => { initPathsHome(); initFlowMocks(); });
</script>
