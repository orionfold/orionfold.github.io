---
// "Paths" band for the homepage and /flow/: the featured path as a lead card,
// the next four as mini rows, then the Compare band.
import PathShowcase from '../mocks/PathShowcase.astro';
import { FLOW_VERSION } from '../../../lib/flow/flow-release';
import CompareBand from './CompareBand.astro';
import { publishedPaths, publishedCompare } from '../../../lib/flow/paths';
import '../../../styles/flow-paths.css';
import { ArrowRightIcon } from '../../../lib/flow-icons';

interface Props { id?: string; eyebrow?: string; showFor?: boolean; }
const { id = 'flow-paths', eyebrow = `FLOW ${FLOW_VERSION} / PATHS`, showFor = true } = Astro.props;
const paths = await publishedPaths();
const lead = paths.find((p) => p.data.featured) ?? paths[0];
const rest = paths.filter((p) => p !== lead).slice(0, 3);
const hasCompare = showFor && (await publishedCompare()).length > 0;
---
{lead && (
  <section id={id} class="fp-section ls-container" aria-labelledby={`${id}-heading`}>
    <div class="fp-head">
      <div class="fp-heading">
        <p class="ls-eyebrow">{eyebrow}</p>
        <h2 id={`${id}-heading`}>Real work.<br /><span class="ls-stroke">Walked end to end.</span></h2>
        <p>Each path is a real job done in Flow on a Mac, one step at a time. You see the time it took, what it cost, and what we could not check.</p>
      </div>
      <a class="fp-all" href="/flow/paths/">All paths<ArrowRightIcon class="lk-arrow" size={14} stroke-width={2.25} aria-hidden="true" /></a>
    </div>
    <PathShowcase entry={lead} variant="hero" />
    {rest.length > 0 && <div class="ps-grid">{rest.map((p) => <PathShowcase entry={p} />)}</div>}
    {hasCompare && (
      <>
        <h3 class="fp-sub">Coming from another tool?</h3>
        <CompareBand />
      </>
    )}
  </section>
)}
