---
import FlowShot from '../FlowShot.astro';
import FlowDetail from '../FlowDetail.astro';
import shotOrganizer from '../../../assets/flow/shots/flow-organizer-shot.webp';
import detailGrid from '../../../assets/flow/details/detail-grid.webp';
---
<section class="border-t border-border/60 bg-surface-raised/30 px-6 py-14 sm:py-20" aria-labelledby="tour-files">
  <div>
    <div class="mx-auto max-w-3xl text-center">
      <p class="of-eyebrow" data-animate="rise">Your files</p>
      <h3 id="tour-files" class="of-display scroll-mt-28 mt-4 text-[clamp(1.85rem,3.4vw,2.75rem)]" data-animate="lead">No import. No library. No silent overwrite.</h3>
      <p class="of-lede mx-auto mt-5" data-animate="rise">Open ordinary folders and Markdown files. Flow is sandboxed to the folders you choose, refuses name collisions, and sends deleted files to the system Trash. It deliberately does not delete folders.</p>
    </div>
    <div class="of-stage of-stage--pad-top mt-12" data-animate="plate">
      <FlowShot src={shotOrganizer} alt="Two documents side by side in Flow over a folder of ordinary Markdown files and local pictures." sizes="(min-width: 1280px) 78rem, (min-width: 1024px) 64rem, 100vw" />
      <FlowDetail class="of-stage__detail of-stage__detail--tl" src={detailGrid} alt="A Markdown table open in Flow's grid while the underlying file remains plain text." caption="A richer view over an ordinary file" sizes="(min-width: 1280px) 30rem, (min-width: 1024px) 27rem, calc(100vw - 3rem)" animate />
    </div>
  </div>
</section>
