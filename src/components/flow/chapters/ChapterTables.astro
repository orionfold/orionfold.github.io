---
import FlowShot from '../FlowShot.astro';
import FlowDetail from '../FlowDetail.astro';
import shotTables from '../../../assets/flow/shots/flow-table-editor-shot.webp';
import detailGrid from '../../../assets/flow/details/detail-grid.webp';
---
<section class="border-t border-border/60 px-6 py-14 sm:py-20" aria-labelledby="tour-tables">
  <div class="mx-auto max-w-3xl lg:ml-auto lg:mr-0">
    <p class="of-eyebrow" data-animate="rise">Tables</p>
    <h3 id="tour-tables" class="of-display scroll-mt-28 mt-4 text-[clamp(1.85rem,3.4vw,2.75rem)]" data-animate="lead">Edit the cell. Keep the Markdown.</h3>
    <p class="of-lede mt-5" data-animate="rise">Flow gives a Markdown table a spreadsheet-style grid. Edit one cell and only that cell changes; the rest keeps its spacing and alignment character for character. Saving is still ⌘S, and any text editor can read the result.</p>
  </div>
  <div class="of-stage of-stage--pad-top mt-12" data-animate="plate">
    <FlowShot src={shotTables} alt="The same Markdown table rendered in a document and open in Flow's spreadsheet-style grid." sizes="(min-width: 1280px) 78rem, (min-width: 1024px) 64rem, 100vw" />
    <FlowDetail class="of-stage__detail of-stage__detail--tr" src={detailGrid} alt="A Markdown table open in Flow's grid with one cell selected and named in the editor bar." caption="One grid over one plain-text table" sizes="(min-width: 1280px) 30rem, (min-width: 1024px) 27rem, calc(100vw - 3rem)" animate />
  </div>
</section>
