---
import FlowShot from '../FlowShot.astro';
import FlowDetail from '../FlowDetail.astro';
import shotSearch from '../../../assets/flow/shots/flow-search-shot.webp';
import detailSearch from '../../../assets/flow/details/detail-search.webp';
---
<section class="border-t border-border/60 bg-surface-raised/30 px-6 py-14 sm:py-20" aria-labelledby="tour-search">
  <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
    <div>
      <p class="of-eyebrow" data-animate="rise">Search</p>
      <h3 id="tour-search" class="of-display scroll-mt-28 mt-4 text-[clamp(1.85rem,3.4vw,2.75rem)]" data-animate="lead">A result you can trace to the line.</h3>
      <p class="of-lede mt-5" data-animate="rise">Every result carries a path and an anchor into the exact bytes you wrote. Open it and Flow re-checks the passage before highlighting it. Moved text is found again. Missing text is reported, never replaced with the wrong match.</p>
      <ul class="flow-list mt-5">
        <li>22.3 ms at the 95th percentile across 10,000 notes; first full index in 1.1 seconds.</li>
        <li>Open, unsaved edits win over the on-disk copy.</li>
        <li>Everything stays on-device.</li>
      </ul>
    </div>
    <div class="flow-search-media" data-animate="plate">
      <FlowShot src={shotSearch} alt="Flow search across a demo library, with results and match reasons beside two open documents." crop sizes="(min-width: 1024px) 30rem, 100vw" />
      <FlowDetail src={detailSearch} alt="Flow search results with abstracts, folder-qualified paths, and the exact matching line." caption="Path, passage, and match reason · On every result" sizes="(min-width: 1024px) 14rem, 45vw" />
    </div>
  </div>
</section>
