---
import FlowShot from '../FlowShot.astro';
import FlowDetail from '../FlowDetail.astro';
import shotToolbar from '../../../assets/flow/shots/flow-editor-toolbar-shot.webp';
import detailToolbarBlocked from '../../../assets/flow/details/detail-toolbar-blocked.webp';
---
<section class="border-t border-border/60 px-6 py-14 sm:py-20" aria-labelledby="tour-toolbar">
  <div>
    <div class="mx-auto max-w-3xl">
      <p class="of-eyebrow" data-animate="rise">The tool strip</p>
      <h3 id="tour-toolbar" class="of-display scroll-mt-28 mt-4 text-[clamp(1.85rem,3.4vw,2.75rem)]" data-animate="lead">AI belongs beside the work.</h3>
      <p class="of-lede mt-5" data-animate="rise">Seven actions sit beside bold and italic. Ready actions stay in colour. An action that cannot run stays visible, names the reason, and shows no invented model or cost.</p>
    </div>
    <div class="of-stage of-stage--pad-top mt-12" data-animate="plate">
      <FlowShot src={shotToolbar} alt="Orionfold Flow with writing controls and five visible AI marks in the document tool strip, with Proofread showing scope, cost, and model." crop sizes="(min-width: 1280px) 78rem, (min-width: 1024px) 64rem, 100vw" />
      <FlowDetail class="of-stage__detail of-stage__detail--tl" src={detailToolbarBlocked} alt="Convert Text to Table unavailable because the document already contains a table, with the document scope still shown." caption="Unavailable, and why · No phantom price or route" sizes="(min-width: 1280px) 30rem, (min-width: 1024px) 27rem, calc(100vw - 3rem)" animate />
    </div>
  </div>
</section>
