---
import { getImage, Image } from 'astro:assets';
import pitStopDaylightWide from '../../assets/flow/launch/flow-ideas-pit-stop-daylight-wide.webp';
import pitStopDaylightPortrait from '../../assets/flow/launch/flow-ideas-pit-stop-daylight-portrait.webp';
import { FLOW_STORYBOARD_MEASUREMENTS } from '../../data/flow-measurements.ts';
import LineIcon from '../ui/LineIcon.astro';
import FlowRaceBlueprint from './FlowRaceBlueprint.astro';

interface Props {
  id?: string;
  variant?: 'home' | 'flow' | 'story';
  /** When set, a small pill in the top-right corner of the racing creative links
   *  to the launch story that walks the same driver / car / crew / record order. */
  storyHref?: string;
}

const {
  id = 'flow-ideas-pit-stop',
  variant = 'flow',
  storyHref,
} = Astro.props;
const isStory = variant === 'story';

// The portrait artwork is true mobile art direction, not a crop of the wide
// frame. Build a density-aware source set so high-fidelity phones get detail
// without every handset downloading the full 1536px source.
const portraitWidths = [480, 720, 960, 1280];
const portraitImages = await Promise.all(
  portraitWidths.map((width) => getImage({ src: pitStopDaylightPortrait, width, format: 'webp', quality: 82 })),
);
const portraitSrcset = portraitImages
  .map((image, index) => `${image.src} ${portraitWidths[index]}w`)
  .join(', ');

const roles = [
  {
    number: '01',
    label: 'Driver',
    title: 'You set the line.',
    body: 'The destination, the decisions, and the release stay yours.',
  },
  {
    number: '02',
    label: 'Car',
    title: 'Flow carries the work.',
    body: 'Your document, context, rules, and evidence travel together.',
  },
  {
    number: '03',
    label: 'Pit stop',
    title: 'Ideas stages the work.',
    body: 'One outcome becomes a visible plan before anything runs.',
  },
  {
    number: '04',
    label: 'Specialist crew',
    title: 'Narrow experts propose.',
    body: 'Each specialist works one station. None of them takes the wheel.',
  },
];

const storyboard = [
  {
    number: '01',
    label: 'Control',
    title: 'Approve every change.',
    href: '#home-race-act-01',
  },
  {
    number: '02',
    label: 'Craft',
    title: 'Make the document useful.',
    href: '#home-race-act-02',
  },
  {
    number: '03',
    label: 'Routing',
    title: 'Choose where AI runs.',
    href: '#home-race-act-03',
  },
  {
    number: '04',
    label: 'Governance',
    title: 'Keep the record.',
    href: '#home-race-control',
  },
];

const mediaAlt =
  'Flow capabilities storyboard: a driver brings the Flow race car into an Orionfold pit stop while four panels show measured search speed, a billed AI run, first indexing time, and the Agency catalog.';
---

<section
  id={id}
  class:list={['flow-pit', `flow-pit--${variant}`, 'flow-pit--light']}
  aria-labelledby={`${id}-title`}
>
  <div class="flow-pit__atmosphere" aria-hidden="true">
    <FlowRaceBlueprint class="flow-pit__blueprint" placement="pit-stop" />
  </div>
  <div class="flow-pit__shell">
    <header class="flow-pit__header">
      <div>
        <p class="flow-pit__eyebrow" data-animate="rise">Flow Capabilities . The Pit Stop</p>
        {variant === 'story' ? (
          <h1 id={`${id}-title`} class="flow-pit__title" data-animate="lead">
            You drive. Flow brings the pit crew.
          </h1>
        ) : (
          <h2 id={`${id}-title`} class="flow-pit__title" data-animate="lead">
            You drive. Flow brings the pit crew.
          </h2>
        )}
      </div>
      <p class="flow-pit__lede" data-animate="rise">
        Ideas turns the work in front of you into clear, inspectable moves.
        You choose what runs, what changes, and when the document is ready.
      </p>
    </header>

    <figure class="flow-pit__frame" data-animate="plate">
      <div class="flow-pit__media">
        <picture class="flow-pit__picture">
          <source
            media="(max-width: 699px)"
            srcset={portraitSrcset}
            sizes="calc(100vw - 2rem)"
          />
          <Image
            class="flow-pit__asset"
            src={pitStopDaylightWide}
            alt={mediaAlt}
            widths={[768, 1152, 1600, 2048]}
            sizes="(min-width: 1480px) 1408px, calc(100vw - 3rem)"
            loading={isStory ? 'eager' : 'lazy'}
            fetchpriority={isStory ? 'high' : undefined}
            decoding="async"
          />
        </picture>

        {storyHref && (
          <a class="flow-pit__story-link" href={storyHref}>
            Read the launch story <span aria-hidden="true">→</span>
          </a>
        )}

        <dl class="flow-pit__telemetry" aria-label="Measured Flow capabilities">
          {FLOW_STORYBOARD_MEASUREMENTS.map((measurement) => (
            <div class:list={['flow-pit__screen', `flow-pit__screen--${measurement.tone}`]}>
              <dt>
                <LineIcon name={measurement.icon} class="flow-pit__screen-icon" strokeWidth={1.6} />
                <span>{measurement.label}</span>
              </dt>
              <dd>{measurement.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </figure>

    {variant === 'flow' && (
      <ol class="flow-pit__roles" aria-label="The Flow Ideas racing metaphor" data-animate-stagger="slow">
        {roles.map((role) => (
          <li data-animate="rise">
            <div class="flow-pit__role-topline">
              <span>{role.number}</span>
              <strong>{role.label}</strong>
            </div>
            <h3>{role.title}</h3>
            <p>{role.body}</p>
          </li>
        ))}
      </ol>
    )}

    {variant === 'home' && (
      <nav class="flow-pit__storyboard" aria-label="Flow capability storyboard" data-animate="rise">
        <ol>
          {storyboard.map((card) => (
            <li>
              <a href={card.href}>
                <span>{card.number} · {card.label}</span>
                <strong>{card.title}</strong>
                <i aria-hidden="true">↓</i>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}
  </div>
</section>

<style>
  .flow-pit {
    --pit-teal: color-mix(in oklch, var(--color-primary) 82%, white);
    --pit-teal-dim: color-mix(in oklch, var(--color-primary) 48%, #09272a);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(4rem, 8vw, 7.5rem) 1.5rem;
    color: #f3fbfb;
    background:
      radial-gradient(circle at 76% 18%, color-mix(in oklch, var(--pit-teal) 16%, transparent), transparent 28rem),
      radial-gradient(circle at 12% 82%, color-mix(in oklch, var(--color-warn) 9%, transparent), transparent 24rem),
      linear-gradient(155deg, #081317 0%, #0c1c20 52%, #071014 100%);
  }

  /* On the concept route this section is the page hero, so it must clear the
     fixed navigation and its optional launch bar at every viewport. Embedded
     Home and Flow placements sit deep in the document and keep normal rhythm. */
  .flow-pit--story {
    padding-top: clamp(9rem, 14vw, 11rem);
  }

  .flow-pit__atmosphere {
    position: absolute;
    inset: 0;
    z-index: -1;
    mask-image: linear-gradient(to bottom, black, transparent 82%);
    pointer-events: none;
  }
  .flow-pit__atmosphere :global(.flow-pit__blueprint) { opacity: 0.13; }

  .flow-pit__shell { width: min(100%, 88rem); margin-inline: auto; }
  .flow-pit__header {
    display: grid;
    gap: 1.5rem 4rem;
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .flow-pit__eyebrow {
    color: var(--pit-teal);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .flow-pit__title {
    max-width: 15ch;
    margin-top: 0.8rem;
    color: #f3fbfb;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5.2vw, 4.8rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }
  .flow-pit__lede {
    max-width: 39rem;
    color: rgba(235, 247, 247, 0.74);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    line-height: 1.65;
  }

  .flow-pit__frame {
    overflow: hidden;
    border: 1px solid rgba(170, 245, 241, 0.2);
    border-radius: clamp(1.2rem, 2.6vw, 2.25rem);
    background: #071115;
    box-shadow: 0 2rem 7rem rgba(0, 0, 0, 0.52), 0 0 0 1px rgba(255,255,255,0.025) inset;
  }
  .flow-pit__media {
    position: relative;
    aspect-ratio: 2752 / 1536;
    overflow: hidden;
  }
  .flow-pit__picture {
    position: absolute;
    inset: 0;
    display: block;
    background: #071115;
  }
  .flow-pit__asset {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .flow-pit__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(4, 12, 15, 0.08), transparent 42%, rgba(3, 9, 12, 0.48) 100%),
      linear-gradient(90deg, rgba(3, 10, 13, 0.28), transparent 34% 76%, rgba(3, 10, 13, 0.14));
    pointer-events: none;
  }

  .flow-pit__story-link {
    position: absolute;
    z-index: 5;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 999px;
    background: rgba(7, 20, 23, 0.66);
    color: #f2fbfa;
    font: 700 0.66rem/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .flow-pit__story-link:hover,
  .flow-pit__story-link:focus-visible {
    background: rgba(7, 20, 23, 0.84);
    transform: translateY(-1px);
  }
  .flow-pit__story-link span { transition: transform 0.2s ease; }
  .flow-pit__story-link:hover span { transform: translateX(2px); }
  .flow-pit__telemetry {
    position: absolute;
    z-index: 4;
    inset: auto 1rem 1rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.55rem;
    margin: 0;
  }
  .flow-pit__screen {
    min-width: 0;
    border: 1px solid rgba(160,246,239,0.2);
    border-radius: 0.65rem;
    padding: 0.75rem 0.8rem;
    background: rgba(3,14,18,0.9);
    box-shadow: 0 0.7rem 2rem rgba(0,0,0,0.32);
    backdrop-filter: blur(10px);
  }
  .flow-pit__screen dt {
    display: flex;
    align-items: flex-start;
    gap: 0.48rem;
    min-height: 2.45em;
    color: rgba(226,247,246,0.68);
    font: 650 clamp(0.46rem,0.72vw,0.59rem)/1.25 var(--font-mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .flow-pit__screen dt span { text-wrap: balance; }
  :global(.flow-pit__screen-icon) {
    width: 1rem;
    height: 1rem;
    flex: none;
    color: var(--pit-teal);
  }
  .flow-pit__screen--money :global(.flow-pit__screen-icon) { color: #9ee6bd; }
  .flow-pit__screen--craft :global(.flow-pit__screen-icon) { color: #f6b078; }
  .flow-pit__screen dd {
    margin: 0.48rem 0 0;
    color: #f5ffff;
    font: 760 clamp(0.72rem,1.35vw,1.05rem)/1 var(--font-mono);
    white-space: nowrap;
  }

  .flow-pit__roles { display: grid; gap: 1px; margin-top: 1px; overflow: hidden; border: 1px solid rgba(170,245,241,0.14); border-radius: 1.1rem; padding: 0; background: rgba(170,245,241,0.14); list-style: none; }
  .flow-pit__roles li { min-width: 0; padding: 1.25rem; background: rgba(8,23,27,0.96); }
  .flow-pit__role-topline { display: flex; align-items: center; gap: 0.65rem; color: var(--pit-teal); font: 700 0.62rem/1 var(--font-mono); letter-spacing: 0.15em; text-transform: uppercase; }
  .flow-pit__role-topline span { color: rgba(223,246,244,0.42); }
  .flow-pit__roles h3 { margin-top: 1rem; color: #f3fbfb; font: 700 1.05rem/1.2 var(--font-display); letter-spacing: -0.02em; }
  .flow-pit__roles p { margin-top: 0.55rem; color: rgba(226,243,242,0.66); font-size: 0.88rem; line-height: 1.55; }

  .flow-pit__storyboard { margin-top: 1rem; }
  .flow-pit__storyboard ol {
    display: grid;
    gap: 1px;
    overflow: hidden;
    border: 1px solid rgba(170,245,241,0.14);
    border-radius: 1.1rem;
    padding: 0;
    background: rgba(170,245,241,0.14);
    list-style: none;
  }
  .flow-pit__storyboard a {
    position: relative;
    display: grid;
    min-height: 8.2rem;
    padding: 1.15rem 2.4rem 1.15rem 1.15rem;
    color: #f3fbfb;
    background: rgba(8,23,27,0.96);
    transition: background-color 160ms ease, color 160ms ease;
  }
  .flow-pit__storyboard a > span {
    color: var(--pit-teal);
    font: 700 0.59rem/1.2 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .flow-pit__storyboard a > strong {
    align-self: end;
    max-width: 18ch;
    margin-top: 1rem;
    font: 700 1rem/1.18 var(--font-display);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .flow-pit__storyboard a > i {
    position: absolute;
    right: 1.1rem;
    bottom: 1.05rem;
    color: var(--pit-teal);
    font: 700 1rem/1 var(--font-mono);
    font-style: normal;
    transition: transform 160ms ease;
  }
  .flow-pit__storyboard a:hover { background: rgba(12,34,39,0.98); }
  .flow-pit__storyboard a:hover > i { transform: translateY(0.2rem); }
  .flow-pit__storyboard a:focus-visible { z-index: 1; outline: 2px solid white; outline-offset: -3px; }

  @media (min-width: 780px) {
    .flow-pit__header { grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.75fr); }
    .flow-pit__roles { grid-template-columns: repeat(4, 1fr); }
    .flow-pit__storyboard ol { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 779px) {
    .flow-pit__media { aspect-ratio: 4 / 5; }
    .flow-pit__asset { object-position: center; }
    .flow-pit__telemetry { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .flow-pit__story-link { top: 0.65rem; right: 0.65rem; padding: 0.5rem 0.75rem; font-size: 0.6rem; }
    .flow-pit { padding-inline: 1rem; }
    .flow-pit__title { font-size: clamp(2.1rem, 12vw, 3.15rem); }
    .flow-pit__screen { padding: 0.62rem; }
    .flow-pit__screen strong { font-size: 0.67rem; }
    .flow-pit__screen dt { min-height: 3.4em; }
    .flow-pit__screen dd { font-size: 0.67rem; }
  }

  .flow-pit--light {
    --pit-teal: #087f7b;
    --pit-teal-dim: #b8dfdb;
    color: #173138;
    background:
      radial-gradient(circle at 76% 18%, rgba(35, 163, 156, 0.11), transparent 28rem),
      radial-gradient(circle at 12% 82%, rgba(229, 111, 54, 0.075), transparent 24rem),
      linear-gradient(155deg, #edf4f1 0%, #f7f9f6 52%, #eef4f1 100%);
  }
  .flow-pit--light .flow-pit__atmosphere {
    mask-image: linear-gradient(to bottom, black 0 58%, transparent 92%);
  }
  .flow-pit--light .flow-pit__atmosphere :global(.flow-pit__blueprint) { opacity: 0.17; }
  .flow-pit--light .flow-pit__eyebrow { color: #087f7b; }
  .flow-pit--light .flow-pit__title { color: #10272e; }
  .flow-pit--light .flow-pit__lede { color: rgba(29, 57, 63, 0.72); }
  .flow-pit--light .flow-pit__frame {
    border-color: rgba(8, 127, 123, 0.22);
    background: white;
    box-shadow: 0 2rem 7rem rgba(35, 76, 79, 0.18), 0 0 0 1px rgba(255,255,255,0.7) inset;
  }
  .flow-pit--light .flow-pit__roles {
    border-color: rgba(8, 127, 123, 0.16);
    background: rgba(8, 127, 123, 0.14);
  }
  .flow-pit--light .flow-pit__roles li { background: rgba(255, 255, 255, 0.88); }
  .flow-pit--light .flow-pit__role-topline { color: #087f7b; }
  .flow-pit--light .flow-pit__role-topline span { color: rgba(29, 57, 63, 0.48); }
  .flow-pit--light .flow-pit__roles h3 { color: #10272e; }
  .flow-pit--light .flow-pit__roles p { color: rgba(29, 57, 63, 0.68); }
  .flow-pit--light .flow-pit__storyboard ol {
    border-color: rgba(8, 127, 123, 0.16);
    background: rgba(8, 127, 123, 0.14);
  }
  .flow-pit--light .flow-pit__storyboard a { color: #10272e; background: rgba(255, 255, 255, 0.88); }
  .flow-pit--light .flow-pit__storyboard a > span,
  .flow-pit--light .flow-pit__storyboard a > i { color: #087f7b; }
  .flow-pit--light .flow-pit__storyboard a:hover { background: white; }
  .flow-pit--light .flow-pit__storyboard a:focus-visible { outline-color: #087f7b; }
  @media (prefers-reduced-motion: reduce) {
    .flow-pit__storyboard a,
    .flow-pit__storyboard a > i { transition: none; }
  }
</style>
