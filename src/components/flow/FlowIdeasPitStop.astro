---
import Origami from '../ui/Origami.astro';
import { FLOW_STORYBOARD_MEASUREMENTS } from '../../data/flow-measurements';
interface Props { id?: string; variant?: 'home'|'flow'|'story'; storyHref?: string; }
const { id = 'flow-ideas-pit-stop', variant = 'flow', storyHref } = Astro.props;
const roles = [
  ['01','Frame','Name the outcome.','Your goal and boundaries give the work direction.'],
  ['02','Organize','Keep the context together.','The document carries its sources, rules, and evidence.'],
  ['03','Leave','Make the next move visible.','Ideas stages a plan you can inspect before it runs.'],
  ['04','Develop','Return with more to build on.','Review the proposal, approve the change, and keep the record.'],
];
---
<section id={id} class="living-ideas" aria-labelledby={`${id}-title`}>
 <div class="living-ideas__inner">
  <p class="living-eyebrow">Flow capabilities · A living practice</p>
  {variant === 'story' ? <h1 id={`${id}-title`}>Give the next idea<br />somewhere to land.</h1> : <h2 id={`${id}-title`}>Give the next idea<br />somewhere to land.</h2>}
  <p class="living-ideas__lede">Ideas turns the work in front of you into clear, inspectable moves. You choose what runs, what changes, and when the document is ready.</p>
  <div class="living-ideas__stage">
   <Origami variant="book" />
   <ol class="living-ideas__steps">{roles.map(([number,label,title,body]) => <li><span>{number} / {label}</span><h3>{title}</h3><p>{body}</p></li>)}</ol>
  </div>
  <dl class="living-ideas__metrics">{FLOW_STORYBOARD_MEASUREMENTS.map(m => <div><dt>{m.label}</dt><dd>{m.value}</dd></div>)}</dl>
  {storyHref && <a class="of-text-action" href={storyHref}>Read the original launch story <span aria-hidden="true"> →</span></a>}
 </div>
</section>
<style>
 .living-ideas {padding:150px 24px 80px;background:#f3f5f3;overflow:hidden;}
 .living-ideas__inner {max-width:1120px;margin:auto;}
 .living-ideas h1,.living-ideas h2 {font-size:clamp(48px,8vw,98px);line-height:.96;text-transform:uppercase;}
 .living-ideas__lede {max-width:660px;margin:24px 0 40px;}
 .living-ideas__stage {position:relative;min-height:440px;isolation:isolate;}
 .living-ideas__stage :global(.living-origami) {position:absolute;inset:0 -8% 0 35%;z-index:-1;}
 .living-ideas__steps {list-style:none;display:grid;grid-template-columns:1fr 1fr;max-width:720px;gap:24px;padding:25px 0;}
 .living-ideas__steps li {padding:24px;background:#ffffffd9;border:1px solid #d6dedd;border-radius:12px;backdrop-filter:blur(12px);}
 .living-ideas__steps span {font:700 11px var(--font-body);color:#0a7b77;text-transform:uppercase;}
 .living-ideas__steps h3 {font-size:29px;line-height:1.1;margin:12px 0;}
 .living-ideas__steps p {font-size:14px;line-height:1.7;}
 .living-ideas__metrics {display:grid;grid-template-columns:repeat(4,1fr);gap:20px;border-top:1px solid #d6dedd;padding:30px 0;}
 .living-ideas__metrics dt {font-size:12px;}.living-ideas__metrics dd {font:700 28px var(--font-display);}
 @media(max-width:640px){.living-ideas__steps,.living-ideas__metrics{grid-template-columns:1fr 1fr;gap:12px;}.living-ideas__steps li{padding:18px;}.living-ideas__stage :global(.living-origami){inset:0 -45% 0 0;opacity:.5;}}
 @media(prefers-reduced-motion:reduce){.living-ideas__steps li{backdrop-filter:none;}}
</style>
