---
import { getImage, Image } from 'astro:assets';
import pitStopWide from '../../assets/flow/launch/flow-ideas-pit-stop-wide.webp';
import pitStopPortrait from '../../assets/flow/launch/flow-ideas-pit-stop-portrait.webp';
import BrandMark from '../ui/BrandMark.astro';

interface Props {
  id?: string;
  variant?: 'home' | 'flow' | 'story';
  videoSrc?: string;
  showStoryLink?: boolean;
}

const {
  id = 'flow-ideas-pit-stop',
  variant = 'flow',
  videoSrc,
  showStoryLink = true,
} = Astro.props;
const isStory = variant === 'story';

// The portrait artwork is true mobile art direction, not a crop of the wide
// frame. Build a density-aware source set so high-fidelity phones get detail
// without every handset downloading the full 1536px source.
const portraitWidths = [480, 720, 960, 1280];
const portraitImages = await Promise.all(
  portraitWidths.map((width) => getImage({ src: pitStopPortrait, width, format: 'webp', quality: 82 })),
);
const portraitSrcset = portraitImages
  .map((image, index) => `${image.src} ${portraitWidths[index]}w`)
  .join(', ');

const roles = [
  {
    number: '01',
    label: 'Driver',
    title: 'You set the line.',
    body: 'The destination, the decisions, and the release stay yours.',
  },
  {
    number: '02',
    label: 'Car',
    title: 'Flow carries the work.',
    body: 'Your document, context, rules, and evidence travel together.',
  },
  {
    number: '03',
    label: 'Pit stop',
    title: 'Ideas stages the work.',
    body: 'One outcome becomes a visible plan before anything runs.',
  },
  {
    number: '04',
    label: 'Specialist crew',
    title: 'Narrow experts propose.',
    body: 'Each specialist works one station. None of them takes the wheel.',
  },
];

const mediaAlt =
  'Campaign concept for Orionfold Flow Ideas: the user drives a Flow race car into an Orionfold pit stop, where a specialist crew works around the car while active telemetry monitors show timing, system health, review status, and driver control.';
---

<section
  id={id}
  class:list={['flow-pit', `flow-pit--${variant}`]}
  aria-labelledby={`${id}-title`}
>
  <div class="flow-pit__atmosphere" aria-hidden="true"></div>
  <div class="flow-pit__shell">
    <header class="flow-pit__header">
      <div>
        <p class="flow-pit__eyebrow" data-animate="rise">Campaign preview · Flow Ideas</p>
        {variant === 'story' ? (
          <h1 id={`${id}-title`} class="flow-pit__title" data-animate="lead">
            You drive. Flow brings the pit crew.
          </h1>
        ) : (
          <h2 id={`${id}-title`} class="flow-pit__title" data-animate="lead">
            You drive. Flow brings the pit crew.
          </h2>
        )}
      </div>
      <p class="flow-pit__lede" data-animate="rise">
        Flow is the car. Ideas is the pit stop. A specialist crew inspects one idea,
        proposes the work, and waits for your call. You choose what runs and when to release it.
      </p>
    </header>

    <figure class="flow-pit__frame" data-animate="plate">
      <div class="flow-pit__media">
        {videoSrc && (
          <>
            <video
              class="flow-pit__asset flow-pit__video"
              src={videoSrc}
              poster={pitStopWide.src}
              muted
              loop
              autoplay
              playsinline
              preload="metadata"
              aria-label={mediaAlt}
            ></video>
            <button class="flow-pit__motion-toggle" type="button" aria-label="Pause campaign motion">
              Pause motion
            </button>
          </>
        )}

        <picture class:list={['flow-pit__picture', videoSrc && 'flow-pit__picture--video-fallback']}>
          <source
            media="(max-width: 699px)"
            srcset={portraitSrcset}
            sizes="calc(100vw - 2rem)"
          />
          <Image
            class="flow-pit__asset"
            src={pitStopWide}
            alt={mediaAlt}
            widths={[768, 1152, 1600, 2048]}
            sizes="(min-width: 1480px) 1408px, calc(100vw - 3rem)"
            loading={isStory ? 'eager' : 'lazy'}
            fetchpriority={isStory ? 'high' : undefined}
            decoding="async"
          />
        </picture>

        <div class="flow-pit__brand" aria-hidden="true">
          <BrandMark size={24} />
          <span>ORION<span>FOLD</span></span>
          <strong>FLOW</strong>
        </div>

        <div class="flow-pit__telemetry" aria-hidden="true">
          <div class="flow-pit__screen flow-pit__screen--lap">
            <span>Lap time</span>
            <strong>00:22.3</strong>
            <i><b style="width: 78%"></b></i>
          </div>
          <div class="flow-pit__screen flow-pit__screen--health">
            <span>System health</span>
            <strong>99%</strong>
            <i><b style="width: 99%"></b></i>
          </div>
          <div class="flow-pit__screen flow-pit__screen--crew">
            <span>Specialists</span>
            <strong>06 ready</strong>
            <i><b style="width: 84%"></b></i>
          </div>
          <div class="flow-pit__screen flow-pit__screen--control">
            <span>Driver control</span>
            <strong>Release held</strong>
            <i><b style="width: 64%"></b></i>
          </div>
        </div>
      </div>
      <figcaption>
        Campaign telemetry is illustrative. The product tour keeps the proof on real Flow screens and recorded runs.
      </figcaption>
    </figure>

    {variant === 'flow' && (
      <ol class="flow-pit__roles" aria-label="The Flow Ideas racing metaphor" data-animate-stagger="slow">
        {roles.map((role) => (
          <li data-animate="rise">
            <div class="flow-pit__role-topline">
              <span>{role.number}</span>
              <strong>{role.label}</strong>
            </div>
            <h3>{role.title}</h3>
            <p>{role.body}</p>
          </li>
        ))}
      </ol>
    )}

    <div class="flow-pit__actions" data-animate="rise">
      {showStoryLink && (
        <a class="flow-pit__primary" href="/flow/ideas-in-motion/">
          Enter the Ideas Pit Stop <span aria-hidden="true">→</span>
        </a>
      )}
      <a class="flow-pit__secondary" href="/flow/">
        See the real Flow product <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('.flow-pit__media:has(.flow-pit__video)').forEach((media) => {
    const video = media.querySelector<HTMLVideoElement>('.flow-pit__video');
    const toggle = media.querySelector<HTMLButtonElement>('.flow-pit__motion-toggle');
    if (!video || !toggle) return;

    let userPaused = false;
    const updateToggle = () => {
      const label = video.paused ? 'Play motion' : 'Pause motion';
      toggle.textContent = label;
      toggle.setAttribute('aria-label', label === 'Play motion' ? 'Play campaign motion' : 'Pause campaign motion');
    };
    const syncMotion = () => {
      if (reducedMotion.matches || userPaused) video.pause();
      else void video.play().catch(() => {});
    };
    toggle.addEventListener('click', () => {
      userPaused = !video.paused;
      syncMotion();
    });
    video.addEventListener('play', updateToggle);
    video.addEventListener('pause', updateToggle);
    syncMotion();
    updateToggle();
    reducedMotion.addEventListener('change', syncMotion);
  });
</script>

<style>
  .flow-pit {
    --pit-teal: color-mix(in oklch, var(--color-primary) 82%, white);
    --pit-teal-dim: color-mix(in oklch, var(--color-primary) 48%, #09272a);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(4rem, 8vw, 7.5rem) 1.5rem;
    color: #f3fbfb;
    background:
      radial-gradient(circle at 76% 18%, color-mix(in oklch, var(--pit-teal) 16%, transparent), transparent 28rem),
      radial-gradient(circle at 12% 82%, color-mix(in oklch, var(--color-warn) 9%, transparent), transparent 24rem),
      linear-gradient(155deg, #081317 0%, #0c1c20 52%, #071014 100%);
  }

  /* On the concept route this section is the page hero, so it must clear the
     fixed navigation and its optional launch bar at every viewport. Embedded
     Home and Flow placements sit deep in the document and keep normal rhythm. */
  .flow-pit--story {
    padding-top: clamp(9rem, 14vw, 11rem);
  }

  .flow-pit__atmosphere {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.34;
    background-image:
      linear-gradient(110deg, transparent 0 36%, rgba(255,255,255,0.035) 36.2% 36.35%, transparent 36.55% 100%),
      radial-gradient(circle, rgba(255,255,255,0.15) 0 0.7px, transparent 0.9px);
    background-size: auto, 5px 5px;
    mask-image: linear-gradient(to bottom, black, transparent 82%);
    pointer-events: none;
  }

  .flow-pit__shell { width: min(100%, 88rem); margin-inline: auto; }
  .flow-pit__header {
    display: grid;
    gap: 1.5rem 4rem;
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .flow-pit__eyebrow {
    color: var(--pit-teal);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .flow-pit__title {
    max-width: 15ch;
    margin-top: 0.8rem;
    color: #f3fbfb;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5.2vw, 4.8rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }
  .flow-pit__lede {
    max-width: 39rem;
    color: rgba(235, 247, 247, 0.74);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    line-height: 1.65;
  }

  .flow-pit__frame {
    overflow: hidden;
    border: 1px solid rgba(170, 245, 241, 0.2);
    border-radius: clamp(1.2rem, 2.6vw, 2.25rem);
    background: #071115;
    box-shadow: 0 2rem 7rem rgba(0, 0, 0, 0.52), 0 0 0 1px rgba(255,255,255,0.025) inset;
  }
  .flow-pit__media {
    position: relative;
    aspect-ratio: 2752 / 1536;
    overflow: hidden;
  }
  .flow-pit__picture {
    position: absolute;
    inset: 0;
    display: block;
    background: #071115;
  }
  .flow-pit__asset {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .flow-pit__video {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .flow-pit__motion-toggle {
    position: absolute;
    z-index: 5;
    top: 1.25rem;
    right: 1.25rem;
    min-height: 2.25rem;
    border: 1px solid rgba(203,250,246,0.24);
    border-radius: 999px;
    padding: 0.5rem 0.75rem;
    color: #eefafa;
    background: rgba(4,13,16,0.88);
    font: 700 0.62rem/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .flow-pit__motion-toggle:focus-visible { outline: 2px solid white; outline-offset: 4px; }
  .flow-pit__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(4, 12, 15, 0.08), transparent 42%, rgba(3, 9, 12, 0.48) 100%),
      linear-gradient(90deg, rgba(3, 10, 13, 0.28), transparent 34% 76%, rgba(3, 10, 13, 0.14));
    pointer-events: none;
  }

  .flow-pit__brand { position: absolute; z-index: 3; top: 1.25rem; left: 1.25rem; display: flex; align-items: center; gap: 0.7rem; border: 1px solid rgba(203,250,246,0.2); border-radius: 999px; padding: 0.5rem 0.75rem 0.5rem 0.55rem; background: rgba(4,13,16,0.88); font: 800 clamp(0.62rem,1vw,0.78rem)/1 var(--font-display); letter-spacing: -0.025em; box-shadow: 0 0.7rem 2rem rgba(0,0,0,0.25); }
  .flow-pit__brand > span:nth-child(2) > span { color: var(--pit-teal); }
  .flow-pit__brand strong { margin-left: 0.4rem; color: var(--pit-teal); font-family: var(--font-mono); letter-spacing: 0.12em; }

  .flow-pit__telemetry { position: absolute; z-index: 4; inset: auto 1rem 1rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.55rem; }
  .flow-pit__screen { min-width: 0; border: 1px solid rgba(160,246,239,0.2); border-radius: 0.55rem; padding: 0.7rem 0.8rem; background: rgba(3,14,18,0.9); box-shadow: 0 0.7rem 2rem rgba(0,0,0,0.32); }
  .flow-pit__screen span { display: block; overflow: hidden; color: rgba(226,247,246,0.6); font: 600 clamp(0.47rem,0.8vw,0.62rem)/1 var(--font-mono); letter-spacing: 0.12em; text-overflow: ellipsis; text-transform: uppercase; white-space: nowrap; }
  .flow-pit__screen strong { display: block; margin-top: 0.42rem; overflow: hidden; color: #f5ffff; font: 700 clamp(0.65rem,1.25vw,0.95rem)/1 var(--font-mono); text-overflow: ellipsis; white-space: nowrap; }
  .flow-pit__screen i { display: block; height: 2px; margin-top: 0.55rem; overflow: hidden; background: rgba(207,248,245,0.11); }
  .flow-pit__screen b { display: block; height: 100%; background: var(--pit-teal); box-shadow: 0 0 0.7rem var(--pit-teal); }
  .flow-pit__frame figcaption { padding: 0.75rem 1.1rem 0.9rem; color: rgba(221,241,240,0.56); font: 500 0.68rem/1.5 var(--font-mono); letter-spacing: 0.02em; }

  .flow-pit__roles { display: grid; gap: 1px; margin-top: 1px; overflow: hidden; border: 1px solid rgba(170,245,241,0.14); border-radius: 1.1rem; padding: 0; background: rgba(170,245,241,0.14); list-style: none; }
  .flow-pit__roles li { min-width: 0; padding: 1.25rem; background: rgba(8,23,27,0.96); }
  .flow-pit__role-topline { display: flex; align-items: center; gap: 0.65rem; color: var(--pit-teal); font: 700 0.62rem/1 var(--font-mono); letter-spacing: 0.15em; text-transform: uppercase; }
  .flow-pit__role-topline span { color: rgba(223,246,244,0.42); }
  .flow-pit__roles h3 { margin-top: 1rem; color: #f3fbfb; font: 700 1.05rem/1.2 var(--font-display); letter-spacing: -0.02em; }
  .flow-pit__roles p { margin-top: 0.55rem; color: rgba(226,243,242,0.66); font-size: 0.88rem; line-height: 1.55; }

  .flow-pit__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; margin-top: 2rem; }
  .flow-pit__primary, .flow-pit__secondary { display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem; min-height: 3rem; border-radius: 999px; padding: 0.75rem 1.1rem; font-size: 0.88rem; font-weight: 750; transition: transform 160ms ease, background-color 160ms ease, border-color 160ms ease; }
  .flow-pit__primary { color: #071416; background: var(--pit-teal); box-shadow: 0 0.8rem 2.5rem color-mix(in oklch, var(--pit-teal) 16%, transparent); }
  .flow-pit__secondary { border: 1px solid rgba(196,243,239,0.22); color: #eefafa; background: rgba(255,255,255,0.035); }
  .flow-pit__primary:hover, .flow-pit__secondary:hover { transform: translateY(-2px); }
  .flow-pit__primary:focus-visible, .flow-pit__secondary:focus-visible { outline: 2px solid white; outline-offset: 4px; }

  @media (min-width: 780px) {
    .flow-pit__header { grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.75fr); }
    .flow-pit__roles { grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 779px) {
    .flow-pit__media { aspect-ratio: 4 / 5; }
    .flow-pit__asset { object-position: center; }
    .flow-pit__telemetry { grid-template-columns: repeat(2, 1fr); }
    .flow-pit__brand { top: 0.8rem; left: 0.8rem; }
    .flow-pit__motion-toggle { top: 0.8rem; right: 0.8rem; }
  }
  @media (max-width: 480px) {
    .flow-pit { padding-inline: 1rem; }
    .flow-pit__title { font-size: clamp(2.1rem, 12vw, 3.15rem); }
    .flow-pit__screen { padding: 0.62rem; }
    .flow-pit__screen strong { font-size: 0.67rem; }
    .flow-pit__actions { align-items: stretch; flex-direction: column; }
    .flow-pit__primary, .flow-pit__secondary { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-pit__primary, .flow-pit__secondary { transition: none; }
  }
</style>
