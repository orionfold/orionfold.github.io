---
// The Living Documents, Night Shift and Settings pages, in Paper since R4
// (G-143): hero with the tour's crop, one row of jumps, the page's sections as
// sheets, and one closing action (culling rubric, operator 2026-10-30).
import PaperLayout from '../../layouts/PaperLayout.astro';
import { FLOW_VERSION } from '../../lib/flow/flow-release';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import PageNav from '../paper/PageNav.astro';
import Fold from '../paper/Fold.astro';
import FlowDetail from './FlowDetail.astro';
import { ORIONFOLD_FLOW_LIVE } from '../../data/launch';
import { FLOW_DMG_URL, FLOW_SYSTEM_REQUIREMENT } from '../../data/flow-pricing';
import { SITE } from '../../data/seo';
import { ogMeta } from '../../data/og';
import { FLOW_V16_TOURS } from '../../data/flow-v16';
import '../../styles/flow.css';
import '../../styles/living-base.css';
import '../../styles/living-in-paper.css';
interface Props { slug: 'living-documents' | 'night-shift' | 'settings'; title: string; description: string; }
const { slug, title, description } = Astro.props;
const tour = FLOW_V16_TOURS.find((item) => item.slug === slug)!;
const href = `/flow/${slug}/`;
const og = ogMeta(href);
const breadcrumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
  { '@type': 'ListItem', position: 2, name: 'Flow', item: `${SITE.url}/flow/` },
  { '@type': 'ListItem', position: 3, name: tour.label, item: `${SITE.url}${href}` },
] };
---
<PaperLayout title={title} description={description} ogImage={og.image} ogImageAlt={og.alt} jsonLd={[breadcrumbs]}>
  <Nav />
  <main id="main" class="pp-page flow-page flow-page--category flow-feature-page">
    <section class="pp-hero pp-hero--inner" aria-labelledby="flow-feature-title">
      <div class="pp-hero-copy">
        <span class="pp-kicker">Flow {FLOW_VERSION} · {tour.label}</span>
        <h1 id="flow-feature-title" class="pp-h1">{tour.title}</h1>
        <p class="pp-sub">{tour.description}</p>
      </div>
      <div class="pp-hero-stage tw-in-paper">
        <FlowDetail src={tour.image} alt={tour.alt} caption={tour.caption} sizes="(min-width: 1024px) 34rem, calc(100vw - 2rem)" />
      </div>
    </section>

    <PageNav label="Living Documents feature tours" pages={[
      { href: '/flow/', label: 'Overview' },
      ...FLOW_V16_TOURS.map((item) => ({ href: `/flow/${item.slug}/`, label: item.label, current: item.slug === slug })),
      { href: '/flow/tour/', label: 'Tour' },
      { href: '/flow/specifications/', label: 'Tech Specs' },
    ]} />

    <div class="tw-in-paper pp-chapters">
      <slot />
    </div>

    <section class="pp-closing" data-cta-placement="closing" aria-labelledby="flow-feature-closing">
      <Fold id="tally" bob class="pp-closing-fold" />
      <h2 id="flow-feature-closing">Start with one recurring document.</h2>
      <p>Choose Start with useful work, make your own copy, and look at its Jobs before you run them.</p>
      <a class="pp-btn" href={ORIONFOLD_FLOW_LIVE ? FLOW_DMG_URL : '/#waitlist'} data-flow-download={ORIONFOLD_FLOW_LIVE ? `flow-${slug}` : undefined}>{ORIONFOLD_FLOW_LIVE ? 'Download Flow for Mac' : 'Join the waitlist'}</a>
      <small>{FLOW_SYSTEM_REQUIREMENT}</small>
    </section>
  </main>
  <Footer showDownload={false} />
</PaperLayout>
<style is:global>
  .flow-feature-section { padding: 4.5rem 1.5rem; border-top: 1px solid var(--color-border); }
  .flow-feature-section:nth-of-type(even) { background: color-mix(in oklch, var(--color-surface-raised) 35%, transparent); }
  .flow-feature-inner { max-width: 72rem; margin-inline: auto; }
  .flow-feature-grid { display: grid; align-items: center; gap: 2.5rem; }
  .flow-feature-section h2 { margin-top: .8rem; font-size: clamp(2rem,3.5vw,3rem); line-height: 1.1; }
  .flow-feature-copy p { margin-top: 1.25rem; color: var(--color-text-muted); font-size: 1.08rem; line-height: 1.7; }
  .flow-feature-copy ul { margin-top: 1.25rem; display: grid; gap: .85rem; color: var(--color-text-muted); line-height: 1.6; }
  .flow-feature-copy li { padding-left: 1.2rem; position: relative; }
  .flow-feature-copy li::before { content: '→'; position: absolute; left: 0; color: var(--color-primary); }
  .flow-feature-copy strong { color: var(--color-text); }
  .flow-feature-card { border: 1px solid var(--color-border); border-radius: 1rem; padding: 1.5rem; background: var(--color-surface); }
  @media (min-width: 1024px) { .flow-feature-grid { grid-template-columns: .9fr 1.1fr; gap: 4rem; } .flow-feature-grid--reverse > :first-child { order: 2; } }
</style>
