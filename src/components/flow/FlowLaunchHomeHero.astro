---
import { getImage, Image } from 'astro:assets';
import pitStopDaylightWide from '../../assets/flow/launch/flow-ideas-pit-stop-daylight-wide.webp';
import pitStopDaylightPortrait from '../../assets/flow/launch/flow-ideas-pit-stop-daylight-portrait.webp';
import shotExpandHoverPanel from '../../assets/flow/shots/flow-expand-hover-panel-shot.webp';
import appIcon from '../../assets/flow/flow-app-icon-512.png';
import { ORIONFOLD_FLOW_LIVE } from '../../data/launch.ts';
import { FLOW_CONSENT_TEXT } from '../../data/flow-consent.ts';
import WaitlistForm from '../ui/WaitlistForm.astro';
import FlowCapabilityTicker from './FlowCapabilityTicker.astro';
import FlowDownloadCta from './FlowDownloadCta.astro';
import FlowShot from './FlowShot.astro';
const portraitWidths = [480, 720, 960, 1280];
const portraitImages = await Promise.all(
  portraitWidths.map((width) => getImage({ src: pitStopDaylightPortrait, width, format: 'webp', quality: 84 })),
);
const portraitSrcset = portraitImages
  .map((image, index) => `${image.src} ${portraitWidths[index]}w`)
  .join(', ');

---

<section class="flow-launch-hero flow-launch-hero--light" aria-labelledby="flow-launch-home-title">
  <div class="flow-launch-hero__key-art" aria-hidden="true">
    <picture>
      <source media="(max-width: 919px)" srcset={portraitSrcset} sizes="100vw" />
      <Image
        src={pitStopDaylightWide}
        alt=""
        widths={[768, 1152, 1600, 2048]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        class="flow-launch-hero__key-image"
      />
    </picture>
  </div>
  <div class="flow-launch-hero__veil" aria-hidden="true"></div>

  <div class="flow-launch-hero__shell">
    <div class="flow-launch-hero__meta-row">
      <p class="flow-launch-hero__eyebrow">
        For creators, builders, and authors. <span>Anyone whose name is on the document.</span>
      </p>
      <div class="flow-launch-hero__chips">
        <span class="flow-launch-hero__chip">
          <Image src={appIcon} alt="" width={40} height={40} class="flow-launch-hero__app-icon" loading="eager" />
          Orionfold Flow
        </span>
        <span class="flow-launch-hero__chip flow-launch-hero__chip--accent">Native Mac app</span>
        <span class="flow-launch-hero__chip">Patent pending</span>
      </div>
    </div>

    <div class="flow-launch-hero__poster-grid">
      <div class="flow-launch-hero__copy">
        <h1 id="flow-launch-home-title">
          You drive the work. <em>Flow tunes AI to your needs.</em>
        </h1>
        <p class="flow-launch-hero__founder">
          <span>&ldquo;I stay in the driver&rsquo;s seat. Flow tunes AI to the work in front of me, runs it where I choose, and changes nothing until I approve.&rdquo;</span>
          Manav Sehgal, who is building Flow after nine years at Amazon.
        </p>

        <div class="flow-launch-hero__actions">
          {ORIONFOLD_FLOW_LIVE ? (
            <FlowDownloadCta source="home-hero" size="large" />
          ) : (
            <>
              <WaitlistForm
                id="home-hero-waitlist"
                source="home-hero-waitlist"
                offer="flow-waitlist"
                buttonText="Join the waitlist"
                successMessage="Check your inbox to confirm."
                consentText={FLOW_CONSENT_TEXT}
              />
              <p class="flow-launch-hero__caption">
                Free to join · Double opt-in · One email a week, no more
              </p>
            </>
          )}
        </div>
      </div>

      <aside class="flow-launch-hero__product home-hero__shot" aria-label="Real Flow product proof">
        <div class="flow-launch-hero__product-window">
          <div class="home-hero__shot-frame">
            <FlowShot
              src={shotExpandHoverPanel}
              alt="Orionfold Flow showing a Market Landscape document beside its receipt timeline, with selected text and the Expand with Sources action open in the document toolbar."
              natural
              sizes="(min-width: 1280px) 54rem, (min-width: 920px) 48rem, calc(100vw - 2rem)"
            />
            <span class="home-hero__sheen" aria-hidden="true"></span>
          </div>
        </div>
      </aside>
    </div>

  </div>
  <div class="flow-launch-hero__ticker"><FlowCapabilityTicker /></div>
</section>

<style>
  .flow-launch-hero {
    --race-teal: #75eee7;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(7.5rem, 12vw, 10rem) 1rem 0;
    color: #f3fbfb;
    background: #061114;
  }

  .flow-launch-hero__key-art,
  .flow-launch-hero__key-art picture,
  .flow-launch-hero__veil {
    position: absolute;
    inset: 0;
  }
  .flow-launch-hero__key-art { z-index: -3; }
  .flow-launch-hero__key-art picture { display: block; }
  .flow-launch-hero__key-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .flow-launch-hero__veil {
    z-index: -2;
    background:
      linear-gradient(90deg, rgba(3, 11, 14, 0.97) 0%, rgba(3, 11, 14, 0.82) 35%, rgba(3, 11, 14, 0.24) 68%, rgba(3, 11, 14, 0.58) 100%),
      linear-gradient(0deg, #061114 0%, rgba(6, 17, 20, 0.04) 42%, rgba(5, 14, 17, 0.34) 100%);
  }
  .flow-launch-hero__shell {
    width: min(100%, 88rem);
    margin-inline: auto;
  }
  .flow-launch-hero__poster-grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }
  .flow-launch-hero__copy { max-width: 48rem; }
  .flow-launch-hero__meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: clamp(1.25rem, 2vw, 2rem);
  }
  .flow-launch-hero__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.55rem;
  }
  .flow-launch-hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid rgba(187, 246, 242, 0.22);
    border-radius: 999px;
    padding: 0.42rem 0.78rem;
    color: rgba(232, 248, 247, 0.72);
    background: rgba(3, 12, 15, 0.82);
    font: 650 0.62rem/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .flow-launch-hero__chip--accent {
    border-color: rgba(117, 238, 231, 0.48);
    color: var(--race-teal);
  }
  .flow-launch-hero__app-icon { width: 1.2rem; height: 1.2rem; border-radius: 0.3rem; }
  .flow-launch-hero__eyebrow {
    flex-shrink: 0;
    margin: 0;
    color: var(--race-teal);
    font: 700 0.66rem/1.55 var(--font-mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .flow-launch-hero__eyebrow span {
    color: rgba(225, 244, 243, 0.52);
  }
  .flow-launch-hero h1 {
    max-width: 11ch;
    margin-top: 0;
    opacity: 0.9;
    color: #f5fbfb;
    font: 850 clamp(3.15rem, 7.5vw, 7rem)/0.87 var(--font-display);
    letter-spacing: -0.07em;
    text-wrap: balance;
    text-shadow: 0 0.08em 0.42em rgba(0, 0, 0, 0.62);
  }
  .flow-launch-hero h1 em {
    display: block;
    margin-top: 0.08em;
    color: var(--race-teal);
    font-style: normal;
  }
  .flow-launch-hero__founder {
    max-width: 42rem;
    margin-top: 1.6rem;
    color: rgba(226, 243, 242, 0.62);
    font-size: 0.98rem;
    line-height: 1.6;
  }
  .flow-launch-hero__founder span {
    color: rgba(247, 252, 252, 0.9);
    font-style: italic;
  }
  .flow-launch-hero__actions { max-width: 31.5rem; margin-top: 2rem; }
  .flow-launch-hero__caption {
    margin-top: 0.75rem;
    color: rgba(224, 242, 241, 0.46);
    font: 600 0.58rem/1.5 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .flow-launch-hero__product {
    width: min(100%, 43rem);
    min-width: 0;
    margin-inline: auto;
    align-self: center;
  }
  .flow-launch-hero__product-window { position: relative; }
  .flow-launch-hero__product-window :global(.flow-shot) { opacity: 0.9; }

  .flow-launch-hero__ticker { margin: clamp(1.5rem, 2.8vw, 2.5rem) -1rem 0; }

  @media (min-width: 920px) {
    .flow-launch-hero { padding-inline: 1.5rem; }
    .flow-launch-hero__ticker { margin-inline: -1.5rem; }
    .flow-launch-hero__poster-grid { grid-template-columns: minmax(0, 0.92fr) minmax(30rem, 1.08fr); }
    .flow-launch-hero__product-window {
      --flow-product-edge-bleed: max(1.5rem, calc((100vw - 88rem) / 2));
      width: calc(100% + var(--flow-product-edge-bleed));
    }
  }
  @media (min-width: 1280px) {
    .flow-launch-hero__meta-row { gap: 0.75rem; }
    .flow-launch-hero__chips { flex-wrap: nowrap; gap: 0.45rem; }
    .flow-launch-hero__product-window > .home-hero__shot-frame {
      width: 110%;
      margin-left: -10%;
    }
  }
  @media (max-width: 919px) {
    .flow-launch-hero__meta-row { align-items: flex-start; flex-direction: column; }
    .flow-launch-hero__chips { justify-content: flex-start; }
    .flow-launch-hero__key-image { object-position: center top; }
    .flow-launch-hero__veil {
      background: linear-gradient(0deg, #061114 0%, rgba(4, 13, 16, 0.76) 58%, rgba(4, 13, 16, 0.52) 100%);
    }
  }
  @media (max-width: 520px) {
    .flow-launch-hero { padding-inline: 0.75rem; }
    .flow-launch-hero h1 { font-size: clamp(3rem, 15.8vw, 4.5rem); }
    .flow-launch-hero__eyebrow { max-width: 32rem; }
    .flow-launch-hero__ticker { margin-inline: -0.75rem; }
  }

  .flow-launch-hero--light {
    --race-teal: #087f7b;
    color: #112a31;
    background: #eef4f1;
  }
  .flow-launch-hero--light .flow-launch-hero__key-art {
    inset: 0 0 auto;
    height: clamp(58rem, 118vh, 72rem);
    -webkit-mask-image: linear-gradient(#000 0%, #000 86%, transparent 100%);
    mask-image: linear-gradient(#000 0%, #000 86%, transparent 100%);
  }
  .flow-launch-hero--light .flow-launch-hero__veil {
    background:
      linear-gradient(90deg, rgba(244, 247, 245, 0.98) 0%, rgba(244, 247, 245, 0.9) 30%, rgba(244, 247, 245, 0.36) 55%, rgba(238, 244, 241, 0.05) 76%, rgba(238, 244, 241, 0.13) 100%),
      linear-gradient(0deg, #eef4f1 0%, rgba(238, 244, 241, 0.03) 36%, rgba(239, 245, 242, 0.08) 100%);
  }
  .flow-launch-hero--light .flow-launch-hero__chip {
    border-color: rgba(12, 102, 101, 0.24);
    color: rgba(20, 49, 56, 0.76);
    background: rgba(255, 255, 255, 0.76);
    box-shadow: 0 0.5rem 1.5rem rgba(40, 78, 79, 0.08);
  }
  .flow-launch-hero--light .flow-launch-hero__chip--accent {
    border-color: rgba(8, 127, 123, 0.46);
    color: #087f7b;
  }
  .flow-launch-hero--light .flow-launch-hero__eyebrow {
    color: #066c68;
    font-size: 0.7rem;
  }
  .flow-launch-hero--light .flow-launch-hero__eyebrow span { color: rgba(25, 57, 63, 0.58); }
  .flow-launch-hero--light h1 {
    color: #10272e;
    text-shadow: 0 0.08em 0.28em rgba(255, 255, 255, 0.76);
  }
  .flow-launch-hero--light h1 em { color: #087f7b; }
  .flow-launch-hero--light .flow-launch-hero__founder { color: rgba(25, 57, 63, 0.7); }
  .flow-launch-hero--light .flow-launch-hero__founder span { color: #16343b; }
  .flow-launch-hero--light .flow-launch-hero__caption { color: rgba(25, 57, 63, 0.52); }
  @media (min-width: 920px) {
    .flow-launch-hero--light { padding-top: clamp(5rem, 6.5vw, 6rem); }
    .flow-launch-hero--light h1 { font-size: clamp(3.15rem, 6.5vw, 5.8rem); }
    .flow-launch-hero--light .flow-launch-hero__founder { margin-top: 1.35rem; }
    .flow-launch-hero--light .flow-launch-hero__actions { margin-top: 1.5rem; }
  }

  @media (max-width: 919px) {
    .flow-launch-hero--light .flow-launch-hero__key-art {
      height: clamp(70rem, 180vh, 88rem);
    }
    .flow-launch-hero--light .flow-launch-hero__key-image { object-position: center 44%; }
    .flow-launch-hero--light .flow-launch-hero__veil {
      background: linear-gradient(0deg, #eef4f1 0%, rgba(241, 246, 243, 0.84) 52%, rgba(244, 247, 245, 0.34) 100%);
    }
  }
</style>
