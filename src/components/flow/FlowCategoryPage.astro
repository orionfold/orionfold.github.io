---
// Shared shell for the four /flow/<category>/ pages (2026-08-20 split), in
// Paper since R4 (G-143). Renders the site nav, a hero with the category's
// cover crop, one row of jumps (this page's chapters, then the tour's other
// pages), the chapters passed in the slot, a pager to the neighbouring
// categories, and the Flow waitlist as the one closing action (culling rubric,
// operator 2026-10-30). Copy for each category
// lives in src/data/flow-categories.ts so the overview cards and these pages
// agree; the cover crop lives in src/data/flow-category-shots.ts for the same
// reason.
//
// Chapters are numbered 1 to 13 ACROSS the four pages (content-masterclass
// review, 2026-08-20): a numbered series reads as one set to complete, and the
// pager says which chapters come next.
import PaperLayout from '../../layouts/PaperLayout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import PageNav from '../paper/PageNav.astro';
import FlowDetail from './FlowDetail.astro';
import FlowWaitlist from '../sections/FlowWaitlist.astro';
import { SITE } from '../../data/seo';
import { ogMeta } from '../../data/og';
import { FLOW_CATEGORIES, flowCategoryHref } from '../../data/flow-categories';
import { FLOW_CATEGORY_SHOTS } from '../../data/flow-category-shots';
import '../../styles/flow.css';
import '../../styles/living-base.css';
import '../../styles/living-in-paper.css';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const index = FLOW_CATEGORIES.findIndex((c) => c.slug === slug);
if (index < 0) throw new Error(`Unknown Flow category ${slug}`);
const cat = FLOW_CATEGORIES[index];
const prev = FLOW_CATEGORIES[index - 1];
const next = FLOW_CATEGORIES[index + 1];
const href = flowCategoryHref(cat.slug);
const og = ogMeta(href);
const cover = FLOW_CATEGORY_SHOTS[cat.slug];
const flowStoryHref = '/story/limitless-without-the-pill/';
const totalChapters = FLOW_CATEGORIES.reduce((n, c) => n + c.chapters.length, 0);
const firstChapter = FLOW_CATEGORIES.slice(0, index).reduce((n, c) => n + c.chapters.length, 0) + 1;
const lastChapter = firstChapter + cat.chapters.length - 1;
const nextHref = next ? flowCategoryHref(next.slug) : '/flow/enterprise/';
const nextLabel = next ? `${next.label} (chapters ${lastChapter + 1} to ${lastChapter + next.chapters.length})` : 'Flow for enterprise AI owners';
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Flow', item: `${SITE.url}/flow/` },
    { '@type': 'ListItem', position: 3, name: cat.label, item: `${SITE.url}${href}` },
  ],
};
---
<PaperLayout title={cat.pageTitle} description={cat.description} ogImage={og.image} ogImageAlt={og.alt} jsonLd={[breadcrumbs]}>
  <Nav />
  <main id="main" class="pp-page flow-page flow-page--category">
    <section class="pp-hero pp-hero--inner" aria-labelledby="flow-category-title">
      <div class="pp-hero-copy">
        <span class="pp-kicker">Product tour · Part {index + 1} of {FLOW_CATEGORIES.length}</span>
        <h1 id="flow-category-title" class="pp-h1">{cat.title}</h1>
        <p class="pp-sub">{cat.blurb}</p>
        <p class="pp-proof"><b>The proof</b> {cat.proof}</p>
      </div>
      <!-- The same real product crop that introduced this part on the tour home. -->
      <div class="pp-hero-stage tw-in-paper">
        <FlowDetail src={cover.src} alt={cover.alt} caption={cover.caption} sizes="(min-width: 1024px) 40rem, calc(100vw - 2rem)" />
      </div>
    </section>

    <PageNav label="Flow tour" onPage={cat.chapters.map((ch, i) => ({ href: `#${ch.id}`, label: `${firstChapter + i} ${ch.label}` }))} pages={[
      { href: '/flow/', label: 'Overview' },
      { href: '/flow/tour/', label: 'Tour' },
      ...FLOW_CATEGORIES.map((c) => ({ href: flowCategoryHref(c.slug), label: c.label, current: c.slug === cat.slug })),
      { href: '/flow/specifications/', label: 'Tech Specs' },
      { href: '/flow/enterprise/', label: 'Enterprise' },
    ]} />

    <div class="tw-in-paper pp-chapters">
      <slot />
    </div>

    <nav class="pp-pager" aria-label="More of the tour">
      {prev ? (
        <a href={flowCategoryHref(prev.slug)} data-dir="prev"><small>← Previous · Part {index}</small><b>{prev.label}</b></a>
      ) : (
        <a href="/flow/tour/" data-dir="prev"><small>← Back to</small><b>Product tour</b></a>
      )}
      {next ? (
        <a href={flowCategoryHref(next.slug)} data-dir="next"><small>Next → Part {index + 2} · Chapters {lastChapter + 1} to {lastChapter + next.chapters.length}</small><b>{next.label}</b></a>
      ) : (
        <a href="/flow/enterprise/" data-dir="next"><small>Next → After the tour</small><b>Flow for enterprise AI owners</b></a>
      )}
    </nav>

    <!-- The category pages reuse the `flow-mid` placement (inside the tour,
         same offer, same consent text) so signups here stay separable from
         the overview's hero and foot forms in conversion data. The continue
         link goes to the NEXT part, never to an anchor this page lacks. -->
    <div id="waitlist" class="ls ls-in-paper pp-waitlist">
      <FlowWaitlist placement="flow-mid" storyHref={flowStoryHref} nextHref={nextHref} nextLabel={nextLabel} />
    </div>
  </main>
  <Footer showDownload={false} />
</PaperLayout>
