---
import type { ImageMetadata } from 'astro';
import FlowDetail from './FlowDetail.astro';
import FlowRaceBlueprint from './FlowRaceBlueprint.astro';
import FlowShot from './FlowShot.astro';

interface CapabilityRow {
  kicker: string;
  title: string;
  body: string;
  href: string;
  shot: ImageMetadata;
  alt: string;
  detail: ImageMetadata;
  detailAlt: string;
  detailCaption: string;
  stage: string;
}

interface Props {
  number: string;
  label: string;
  title: string;
  body: string;
  rows: CapabilityRow[];
}

const { number, label, title, body, rows } = Astro.props;
const actId = `home-race-act-${number}`;
const blueprintPlacement = number === '01' ? 'driver' : number === '02' ? 'crew' : 'release';
---

<section id={actId} class="home-race-act home-race-act--light" aria-labelledby={`${actId}-title`}>
  <FlowRaceBlueprint class="home-race-act__blueprint" placement={blueprintPlacement} />
  <div class="home-race-act__shell">
    <header class="home-race-act__header">
      <div class="home-race-act__number" aria-hidden="true">{number}</div>
      <div>
        <p data-animate="rise">Race act {number} · {label}</p>
        <h2 id={`${actId}-title`} data-animate="lead">{title}</h2>
      </div>
      <p class="home-race-act__lede" data-animate="rise">{body}</p>
    </header>

    <div class="home-race-act__features">
      {rows.map((row, index) => (
        <article class:list={['home-race-act__feature', index % 2 === 1 && 'home-race-act__feature--reverse']}>
          <div class="home-race-act__copy">
            <p class="home-race-act__station"><span>{number}.{String(index + 1).padStart(2, '0')}</span>{row.kicker}</p>
            <h3 data-animate="lead">{row.title}</h3>
            <p class="home-race-act__body" data-animate="rise">{row.body}</p>
            <a href={row.href} data-animate="rise">
              See it in the tour <span aria-hidden="true">→</span>
            </a>
          </div>

          <div
            class:list={['of-stage home-race-act__stage', row.stage.startsWith('t') ? 'of-stage--pad-top' : 'of-stage--pad-bottom']}
            data-animate="plate"
          >
            <FlowShot
              src={row.shot}
              alt={row.alt}
              crop
              sizes="(min-width: 1200px) 48rem, (min-width: 920px) 55vw, calc(100vw - 2rem)"
            />
            <FlowDetail
              class={`of-stage__detail of-stage__detail--${row.stage}`}
              src={row.detail}
              alt={row.detailAlt}
              caption={row.detailCaption}
              sizes="(min-width: 1200px) 24rem, (min-width: 920px) 22rem, calc(100vw - 3rem)"
              animate
            />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .home-race-act {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-top: 1px solid rgba(131, 236, 229, 0.14);
    padding: clamp(5rem, 10vw, 9rem) 1rem;
    color: #f2fbfa;
    background: #071417;
    scroll-margin-top: 6rem;
  }
  :global(.home-race-act__blueprint) {
    z-index: -1;
    opacity: 0.085;
  }
  .home-race-act__shell {
    width: min(100%, 82rem);
    margin-inline: auto;
  }
  .home-race-act__header {
    display: grid;
    gap: 1rem clamp(2rem, 7vw, 6rem);
    align-items: end;
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }
  .home-race-act__number {
    color: rgba(117, 238, 231, 0.14);
    font: 850 clamp(6rem, 18vw, 14rem)/0.62 var(--font-display);
    letter-spacing: -0.09em;
  }
  .home-race-act__header > div:nth-child(2) > p {
    color: #75eee7;
    font: 700 0.66rem/1 var(--font-mono);
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }
  .home-race-act__header h2 {
    max-width: 12ch;
    margin-top: 0.8rem;
    color: #f3fbfb;
    font: 820 clamp(2.7rem, 6vw, 5.7rem)/0.92 var(--font-display);
    letter-spacing: -0.062em;
    text-wrap: balance;
  }
  .home-race-act__lede {
    max-width: 36rem;
    color: rgba(228, 245, 244, 0.64);
    font-size: clamp(1rem, 1.7vw, 1.2rem);
    line-height: 1.65;
  }
  .home-race-act__features { display: grid; gap: clamp(5rem, 11vw, 10rem); }
  .home-race-act__feature {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .home-race-act__copy { max-width: 34rem; }
  .home-race-act__station {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: #75eee7;
    font: 700 0.64rem/1 var(--font-mono);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .home-race-act__station span {
    border: 1px solid rgba(154, 241, 235, 0.25);
    border-radius: 999px;
    padding: 0.42rem 0.55rem;
    color: rgba(228, 247, 246, 0.54);
  }
  .home-race-act__copy h3 {
    margin-top: 1.1rem;
    color: #f4fbfb;
    font: 760 clamp(2rem, 4.2vw, 3.7rem)/0.98 var(--font-display);
    letter-spacing: -0.052em;
    text-wrap: balance;
  }
  .home-race-act__body {
    margin-top: 1.25rem;
    color: rgba(226, 243, 242, 0.66);
    font-size: 1rem;
    line-height: 1.7;
  }
  .home-race-act__copy > a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.5rem;
    color: #75eee7;
    font-size: 0.82rem;
    font-weight: 750;
  }
  .home-race-act__stage { min-width: 0; }

  @media (min-width: 920px) {
    .home-race-act { padding-inline: 1.5rem; }
    .home-race-act__header { grid-template-columns: auto minmax(0, 0.8fr) minmax(22rem, 0.62fr); }
    .home-race-act__feature { grid-template-columns: minmax(19rem, 0.6fr) minmax(0, 1.4fr); }
    .home-race-act__feature--reverse { grid-template-columns: minmax(0, 1.4fr) minmax(19rem, 0.6fr); }
    .home-race-act__feature--reverse .home-race-act__copy { order: 2; justify-self: end; }
    .home-race-act__feature--reverse .home-race-act__stage { order: 1; }
  }
  @media (max-width: 919px) {
    .home-race-act__number { margin-bottom: 1rem; }
    .home-race-act__header { align-items: start; }
  }

  .home-race-act--light {
    border-color: rgba(15, 118, 116, 0.15);
    color: #173138;
    background: #f4f7f5;
  }
  .home-race-act--light :global(.home-race-act__blueprint) { opacity: 0.17; }
  .home-race-act--light :global(.flow-race-blueprint--driver) { opacity: 0.21; }
  .home-race-act--light :global(.flow-race-blueprint--crew) { opacity: 0.19; }
  .home-race-act--light :global(.flow-race-blueprint--release) { opacity: 0.16; }
  .home-race-act--light .home-race-act__number { color: rgba(8, 127, 123, 0.12); }
  .home-race-act--light .home-race-act__header > div:nth-child(2) > p,
  .home-race-act--light .home-race-act__station,
  .home-race-act--light .home-race-act__copy > a { color: #087f7b; }
  .home-race-act--light .home-race-act__header h2,
  .home-race-act--light .home-race-act__copy h3 { color: #10272e; }
  .home-race-act--light .home-race-act__lede,
  .home-race-act--light .home-race-act__body { color: rgba(29, 57, 63, 0.7); }
  .home-race-act--light .home-race-act__station span {
    border-color: rgba(8, 127, 123, 0.25);
    color: rgba(29, 57, 63, 0.54);
    background: rgba(255, 255, 255, 0.64);
  }
</style>
