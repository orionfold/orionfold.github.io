---
// Homepage hero: a Flow Domain's whole round trip, from the AI Consulting
// Starter walk (src/content/domains/ai-consulting-starter.md), in five quick
// steps you can click or let play. You write the README with Chat (788 words,
// 2 claims marked to check), a Visual Explainer draws "Good intentions don't
// work; mechanisms do" into Review, Publish ▸ GitHub Repository sends the 6
// files (75 KB) to GitHub, your client brings the folder in with File ▸ New
// from GitHub… (CC BY 4.0), and your next publish reaches them as an update
// they review. The files fly between the windows so the payload is seen to
// travel. The walk's reader is shown as "your client"; every label is its own.
import '../../../styles/flow-mocks.css';
import '../../../styles/hero-story.css';
import Folder from '@lucide/astro/icons/folder';
import FileText from '@lucide/astro/icons/file-text';
import ArrowUp from '@lucide/astro/icons/arrow-up';
import Check from '@lucide/astro/icons/check';
import MessageSquareText from '@lucide/astro/icons/message-square-text';
import FileCheck from '@lucide/astro/icons/file-check';
import Upload from '@lucide/astro/icons/upload';
import Globe from '@lucide/astro/icons/globe';
import Github from '@lucide/astro/icons/folder-git-2';
import BookOpen from '@lucide/astro/icons/book-open';
import Presentation from '@lucide/astro/icons/presentation';
import FileType from '@lucide/astro/icons/file-type';
import Play from '@lucide/astro/icons/play';
import Pause from '@lucide/astro/icons/pause';

const FILES = ['README', 'Mechanisms Primer', 'Amazon Mechanisms and Practices', 'Press Release FAQ for AI project', 'Pilot to Scale', 'Flow PR-FAQ'];
const FORMATS = [
  { name: 'PDF', Icon: FileType },
  { name: 'GitHub Pages', Icon: Globe },
  { name: 'GitHub Repository', Icon: Github, on: true },
  { name: 'EPUB', Icon: BookOpen },
  { name: 'Word', Icon: FileText },
  { name: 'PowerPoint', Icon: Presentation },
];
const DEST = 'orionfold/flow/flow-domains/ai-consulting-starter';
const BOXES = ['Good intentions', 'A tool', 'Adoption', 'Inspection'];
// The README as you wrote it. Your client's copy renders from the same words
// and the same figure, because the Domain arrives exactly as published.
const P1 = 'I spent nine years at Amazon helping teams adopt AI at scale. This Domain is what I would hand someone starting that job today.';
const P2 = 'It is for a consultant who wants a repeatable way to do it <span class="hd-check">check</span> and for a leader asked to “do something with AI” <span class="hd-check">check</span>';
const FIG = "Good intentions don't work; mechanisms do.";
const STEPS = ['Write with AI', 'A skill draws', 'Publish', 'Client brings it in', 'Update arrives'];
const DURATIONS = [3800, 4400, 5200, 6800, 5600];
---
<div class="hs hd-story" data-story data-durations={DURATIONS.join(',')} data-auto="4:update:2600" data-story-scene="0">
<figure class="dm dm--hero hd" style="--dm-tint:#0e9e98" aria-label="A Flow Domain's round trip: you write AI Consulting Starter with Chat, a skill draws its figure, you publish six files to GitHub, your client brings the folder in with one address, and your next update reaches them as a change to review">
  <div class="hd-stage">
    <!-- Your Flow -->
    <div class="dm-window hd-win hd-you" aria-hidden="true">
      <div class="dm-bar">
        <span class="dm-lights"><i></i><i></i><i></i></span>
        <span class="dm-title"><img src="/logos/orionfold-mark-3d-32.png" alt="" width="16" height="16" />README.md</span>
        <span class="hd-bar-r"><span class="hd-who">You</span><span class="hd-pill"><i></i><span class="p0">2 claims to check</span><span class="p1">1 change to review</span><span class="p2">Published</span></span></span>
      </div>
      <div class="hd-panes">
        <aside class="hd-side">
          <p class="hd-folder"><Folder size={12} /><span>ai-consulting-starter</span></p>
          <ul class="hd-files">
            {FILES.map((f, i) => <li class:list={[i === 0 && 'is-open']} style={`--i:${i}`}><FileText size={11} /><span>{f}</span></li>)}
          </ul>
        </aside>
        <div class="hd-doc">
          <p class="hd-eyebrow">FLOW DOMAIN</p>
          <p class="hd-h">AI Consulting Starter</p>
          <p class="hd-p hd-type">{P1}</p>
          <p class="hd-p hd-type2" set:html={P2} />
          <div class="hd-fig">
            <p class="hd-fig-h">{FIG}</p>
            <svg viewBox="0 0 300 78" role="presentation">
              <defs><marker id="hd-arr" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0 6 3 0 6" fill="none" stroke="#56635e" /></marker></defs>
              {BOXES.map((b, i) => (
                <g class="hd-box" style={`--i:${i}`}>
                  <rect x={4 + i * 74} y="6" width="64" height="32" rx="6" pathLength="100" />
                  <text x={36 + i * 74} y="26" text-anchor="middle">{b}</text>
                  {i < 3 && <path d={`M${69 + i * 74} 22 H${77 + i * 74}`} marker-end="url(#hd-arr)" />}
                </g>
              ))}
              <path class="hd-loop" d="M258 39 V58 Q258 66 250 66 H44 Q36 66 36 58 V41" marker-end="url(#hd-arr)" />
            </svg>
            <p class="hd-fig-f"><span>Previous</span><span>Play</span><span>Next</span><em>Step 4 of 4</em></p>
          </div>
        </div>
        <aside class="hd-wb">
          <div class="hd-wb-p hd-wb-0">
            <p class="hd-tab"><MessageSquareText size={11} />Chat</p>
            <p class="hd-msg hd-me">Write a README for this Domain, about 600 words.</p>
            <p class="hd-dots"><i></i><i></i><i></i></p>
            <p class="hd-msg hd-ai">Wrote <b>788 words</b>. <b>2 claims</b> are marked to check before you publish.</p>
            <p class="hd-route">Claude Code › Claude subscription</p>
          </div>
          <div class="hd-wb-p hd-wb-1">
            <p class="hd-tab"><FileCheck size={11} />Review</p>
            <p class="hd-chg">Visual Explainer adds a figure after “Amazon Mechanisms, briefly”.<small>About 1 minute · Proposed</small></p>
            <p class="hd-btns"><span class="hd-btn hd-keep">Keep</span><span class="hd-later">Undo</span></p>
            <p class="hd-kept"><Check size={11} stroke-width={3} />Kept</p>
          </div>
          <div class="hd-wb-p hd-wb-2">
            <p class="hd-tab"><Upload size={11} />Publish</p>
            {FORMATS.map(({ name, Icon, on }, i) => <p class:list={['hd-fmt', on && 'is-on']} style={`--i:${i}`}><Icon size={11} /><span>{name}</span>{on && <Check size={11} stroke-width={3} />}</p>)}
            <p class="hd-dest"><span>{DEST}</span></p>
            <p class="hd-btn hd-pub">Publish to GitHub</p>
          </div>
          <div class="hd-wb-p hd-wb-4">
            <p class="hd-tab"><Upload size={11} />Publish</p>
            <p class="hd-sent"><Check size={11} stroke-width={3} />Published again · README</p>
            <p class="hd-route">Others get it as an update to review.</p>
          </div>
        </aside>
      </div>
      <span class="hd-key hd-key--chat">Chat</span>
      <span class="hd-key hd-key--pub">Publish ▸ GitHub</span>
    </div>

    <!-- GitHub, between the two Flows -->
    <p class="hd-hub" aria-hidden="true"><span class="hd-hub-ic"><Github size={15} /></span><span><b>GitHub</b><em class="hd-hub-n">6 files · 75 KB</em></span></p>
    <!-- The files in flight -->
    <span class="hd-fly" aria-hidden="true">
      {FILES.map((_, i) => <i style={`--i:${i}`}><FileText size={12} /></i>)}
    </span>

    <!-- Your client's Flow -->
    <div class="dm-window hd-win hd-them">
      <div class="dm-bar" aria-hidden="true">
        <span class="dm-lights"><i></i><i></i><i></i></span>
        <span class="dm-title"><img src="/logos/orionfold-mark-3d-32.png" alt="" width="16" height="16" />README.md · from GitHub</span>
        <span class="hd-bar-r"><span class="hd-who">Your client</span><span class="hd-pill"><i></i><span class="p3">Added</span><span class="p4">1 update</span><span class="p5">Up to date</span></span></span>
      </div>
      <div class="hd-panes hd-panes--two">
        <aside class="hd-side" aria-hidden="true">
          <p class="hd-folder"><Folder size={12} /><span>AI Consulting Starter</span><i class="hd-dot"><ArrowUp size={9} stroke-width={3} /></i></p>
          <ul class="hd-files">
            {FILES.map((f, i) => <li class:list={[i === 0 && 'is-open']} style={`--i:${i}`}><FileText size={11} /><span>{f}</span></li>)}
          </ul>
        </aside>
        <div class="hd-doc">
          <div aria-hidden="true">
            <p class="hd-eyebrow">FLOW DOMAIN</p>
            <p class="hd-h">AI Consulting Starter</p>
            <p class="hd-p">{P1}</p>
            <p class="hd-p" set:html={P2} />
            <div class="hd-fig">
              <p class="hd-fig-h">{FIG}</p>
              <svg viewBox="0 0 300 78" role="presentation">
                <defs><marker id="hd-arr-c" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0 6 3 0 6" fill="none" stroke="#56635e" /></marker></defs>
                {BOXES.map((b, i) => (
                  <g class="hd-box" style={`--i:${i}`}>
                    <rect x={4 + i * 74} y="6" width="64" height="32" rx="6" pathLength="100" />
                    <text x={36 + i * 74} y="26" text-anchor="middle">{b}</text>
                    {i < 3 && <path d={`M${69 + i * 74} 22 H${77 + i * 74}`} marker-end="url(#hd-arr-c)" />}
                  </g>
                ))}
                <path class="hd-loop" d="M258 39 V58 Q258 66 250 66 H44 Q36 66 36 58 V41" marker-end="url(#hd-arr-c)" />
              </svg>
              <p class="hd-fig-f"><span>Previous</span><span>Play</span><span>Next</span><em>Step 4 of 4</em></p>
            </div>
          </div>
          <div class="hd-sheet hd-get" aria-hidden="true">
            <p class="hd-sheet-h">New from GitHub…</p>
            <p class="hd-dest"><span>github.com/{DEST}</span></p>
            <p class="hd-read">orionfold/flow · flow-domains/ai-consulting-starter<br /><b>6 files · 75 KB · Licence: CC BY 4.0</b></p>
            <p class="hd-btns"><span class="hd-btn hd-add">Add</span><span class="hd-later">Cancel</span></p>
          </div>
          <div class="hd-sheet hd-upd">
            <p class="hd-sheet-h"><ArrowUp size={11} stroke-width={3} />Update AI Consulting Starter</p>
            <p class="hd-row"><Check size={11} stroke-width={3} /><span><b>README</b> · Updated. You have not changed this one, so replacing it loses nothing.</span></p>
            <p class="hd-btns"><button type="button" class="hd-btn" data-story-act="update">Update Selected</button><button type="button" class="hd-later" data-story-act="later">Not now</button></p>
            <p class="hd-out hd-out-update"><Check size={11} stroke-width={3} />README updated. Nothing else changed.</p>
            <p class="hd-out hd-out-later">Nothing changed. The update waits for you.</p>
          </div>
        </div>
      </div>
      <span class="hd-key hd-key--get" aria-hidden="true">New from GitHub…</span>
      <span class="hd-key hd-key--same" aria-hidden="true">Exactly as you published it</span>
    </div>
  </div>
</figure>
<div class="hs-controls">
  <button type="button" class="hs-play" data-story-toggle aria-pressed="false" aria-label="Play the story"><Play size={14} class="hs-i-play" /><Pause size={14} class="hs-i-pause" /></button>
  <div class="hs-steps" role="group" aria-label="Story steps">
    {STEPS.map((s, i) => <button type="button" class="hs-step" data-story-go={i}><b>0{i + 1}</b><span>{s}</span></button>)}
  </div>
  <span class="sr-only" data-story-status aria-live="polite"></span>
</div>
<p class="hs-note">Labels and numbers are from the AI Consulting Starter walk. Click a step, or answer the update.</p>
</div>

<script>
  import '../../../scripts/hero-story.js';
</script>

<style>
  .hd-stage { position: relative; height: 420px; }
  .hd-win { position: absolute; transition: transform .6s cubic-bezier(.2,.8,.2,1), opacity .45s ease, filter .45s ease; }
  .hd-you { right: 7%; top: 0; width: 80%; height: 344px; z-index: 2; }
  .hd-them { right: 0; top: 76px; width: 74%; height: 344px; z-index: 1; opacity: 0; transform: translateX(48px) scale(.96); pointer-events: none; }
  .hs:is([data-story-scene="3"], [data-story-scene="4"]) .hd-them { z-index: 3; opacity: 1; transform: none; pointer-events: auto; }
  .hs:is([data-story-scene="3"], [data-story-scene="4"]) .hd-you { transform: scale(.95) translate(-3%, -2%); filter: saturate(.6); opacity: .7; }

  /* Title bar: who it is and what state the Domain is in */
  .hd-bar-r { display: inline-flex; align-items: center; gap: 6px; min-width: 0; }
  .hd-who { padding: 2px 8px; border-radius: 99px; background: #171c1a; color: #fff; font-size: .6rem; font-weight: 700; letter-spacing: .04em; white-space: nowrap; }
  .hd-them .hd-who { background: #2f6fed; }
  .hd-pill { display: inline-flex; align-items: center; gap: 5px; padding: 2px 8px; border-radius: 99px; background: #fdf0d9; color: #a35c00; font-size: .6rem; font-weight: 700; white-space: nowrap; }
  .hd-pill i { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .hd-pill > span { display: none; }
  .hs[data-story-scene="0"] .hd-you .p0, .hs[data-story-scene="1"] .hd-you .p1, .hs:is([data-story-scene="2"], [data-story-scene="3"], [data-story-scene="4"]) .hd-you .p2 { display: inline; }
  .hs:is([data-story-scene="2"], [data-story-scene="3"], [data-story-scene="4"]) .hd-you .hd-pill { background: #e3f4ea; color: #15835c; }
  .hs[data-story-scene="0"] .hd-you .hd-pill { animation: hd-pop-in .4s ease 2.5s both; }
  .hs[data-story-scene="1"] .hd-you .hd-pill { animation: hd-pop-in .4s ease 2.4s both; }
  .hs[data-story-scene="2"] .hd-you .hd-pill { animation: hd-pop-in .4s ease 3.9s both; }
  .hd-them .hd-pill { background: #e3f4ea; color: #15835c; }
  .hs[data-story-scene="3"] .hd-them .p3, .hs[data-story-scene="4"]:not([data-choice="update"]) .hd-them .p4, .hs[data-story-scene="4"][data-choice="update"] .hd-them .p5 { display: inline; }
  .hs[data-story-scene="3"] .hd-them .hd-pill { animation: hd-pop-in .4s ease 3.9s both; }
  .hs[data-story-scene="4"]:not([data-choice="update"]) .hd-them .hd-pill { background: #e3ecfd; color: #1f4fb8; animation: hd-pop-in .4s ease .9s both; }
  .hs[data-story-scene="4"][data-choice="update"] .hd-them .hd-pill { animation: hd-pop-in .4s ease both; }
  @keyframes hd-pop-in { 0% { opacity: 0; transform: scale(.6); } 70% { opacity: 1; transform: scale(1.12); } 100% { opacity: 1; transform: none; } }

  .hd-panes { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(0, 9.6em) minmax(0, 1fr) minmax(0, 11.4em); }
  .hd-panes--two { grid-template-columns: minmax(0, 10em) minmax(0, 1fr); }
  .hd-side { padding: 10px 8px; border-right: 1px solid #e3e7e4; background: #f8f9f8; font-size: .62rem; overflow: hidden; }
  :global(.ls) .hd-side p, :global(.ls) .hd-side ul { margin: 0; }
  .hd-folder { display: flex; align-items: center; gap: 5px; padding: 3px 3px 6px; font-weight: 700; color: #2b3431; }
  .hd-folder span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hd-dot { flex: none; display: none; place-items: center; width: 15px; height: 15px; margin-left: auto; border-radius: 50%; background: #2f6fed; color: #fff; }
  .hd-files { display: grid; gap: 1px; padding: 0 0 0 10px !important; list-style: none; }
  .hd-files li { display: flex; align-items: center; gap: 5px; min-width: 0; padding: 3px 5px; border-radius: 5px; color: #3b4541; }
  .hd-files li :global(svg) { flex: none; }
  .hd-files li span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hd-files li.is-open { background: #e3eeed; color: #0b6f6b; font-weight: 500; }
  /* Your folder holds the README until the Domain is done; the client's fills on Add. */
  .hs:is([data-story-scene="0"], [data-story-scene="1"]) .hd-you .hd-files li:not(.is-open) { display: none; }
  .hs[data-story-scene="2"] .hd-you .hd-files li { animation: hd-slot .3s ease both; animation-delay: calc(.4s + var(--i) * 70ms); }
  .hs[data-story-scene="3"] .hd-them .hd-files li { animation: hd-slot .3s ease both; animation-delay: calc(3.1s + var(--i) * 90ms); }
  @keyframes hd-slot { from { opacity: 0; transform: translateX(-8px); background: #d9e6fd; } 60% { opacity: 1; transform: none; background: #d9e6fd; } }

  .hd-doc { position: relative; display: grid; align-content: start; gap: 7px; min-width: 0; padding: 14px 16px; overflow: hidden; background: #fff; }
  :global(.ls) .hd-doc p { margin: 0; }
  .hd-eyebrow { font-size: .56rem; font-weight: 700; letter-spacing: .12em; color: #0b6f6b; }
  .hd-h { font: 700 1.08rem/1.15 'Geist Sans', Arial, sans-serif; color: #171c1a; }
  .hd-p { font-size: .66rem; line-height: 1.5; color: #3b4541; }
  .hd-p :global(.hd-check) { display: inline-block; padding: 0 5px; border-radius: 99px; background: #fdebd3; color: #a35c00; font-size: .54rem; font-weight: 700; }
  .hs[data-story-scene="0"] .hd-type { animation: hd-write 1s steps(16) .9s both; }
  .hs[data-story-scene="0"] .hd-type2 { animation: hd-write 1s steps(16) 1.8s both; }
  .hs[data-story-scene="0"] .hd-p :global(.hd-check) { animation: hd-pop-in .4s ease 2.5s both; }
  @keyframes hd-write { from { clip-path: inset(0 100% 100% 0); } 50% { clip-path: inset(0 0 50% 0); } to { clip-path: inset(0 0 0 0); } }

  /* The figure the Visual Explainer drew: each box draws its own outline. */
  .hd-fig { display: none; gap: 5px; padding: 9px 10px 7px; border: 2px solid #2f6fed; border-radius: 8px; }
  .hs:is([data-story-scene="1"], [data-story-scene="2"]) .hd-you .hd-fig { display: grid; }
  .hs[data-story-scene="2"] .hd-fig { border-color: #e3e7e4; }
  .hs[data-story-scene="1"] .hd-fig { animation: hs-in .35s ease .3s both; }
  /* Your client's copy: the same figure, drawn again in their Flow, with no model run. */
  .hs:is([data-story-scene="3"], [data-story-scene="4"]) .hd-them .hd-fig { display: grid; border-color: #e3e7e4; }
  .hs[data-story-scene="3"] .hd-them .hd-box rect { stroke-dasharray: 100; animation: hd-outline .5s ease both, hd-fill .3s ease both; animation-delay: calc(4s + var(--i) * .3s), calc(4.3s + var(--i) * .3s); }
  .hs[data-story-scene="3"] .hd-them .hd-box :is(text, path) { animation: hs-in .3s ease both; animation-delay: calc(4.2s + var(--i) * .3s); }
  .hs[data-story-scene="3"] .hd-them .hd-loop { animation: hd-dash 1s linear 5.2s both; }
  .hs[data-story-scene="3"] .hd-them .hd-fig { animation: hd-match 1.2s ease 5.4s both; }
  @keyframes hd-match { 0% { box-shadow: 0 0 0 0 #15835c00; border-color: #e3e7e4; } 40% { box-shadow: 0 0 0 5px #15835c33; border-color: #15835c; } 100% { box-shadow: 0 0 0 0 #15835c00; border-color: #e3e7e4; } }
  .hd-fig-h { font-size: .66rem; font-weight: 700; color: #171c1a; }
  .hd-fig svg { width: 100%; height: auto; overflow: visible; }
  .hd-box rect { fill: #eef3fe; stroke: #7d97e8; stroke-width: 1.2; }
  .hd-box:nth-child(4) rect, .hd-box:last-of-type rect { fill: #e5f4f1; stroke: #0e8a85; }
  .hd-box text { font: 500 7.5px 'Geist Sans', Arial, sans-serif; fill: #2b3431; }
  .hd-box path, .hd-loop { fill: none; stroke: #56635e; stroke-width: 1; }
  .hd-loop { stroke-dasharray: 3 3; }
  .hs[data-story-scene="1"] .hd-box rect { stroke-dasharray: 100; animation: hd-outline .5s ease both, hd-fill .3s ease both; animation-delay: calc(.6s + var(--i) * .38s), calc(.95s + var(--i) * .38s); }
  .hs[data-story-scene="1"] .hd-box :is(text, path) { animation: hs-in .3s ease both; animation-delay: calc(.9s + var(--i) * .38s); }
  .hs[data-story-scene="1"] .hd-loop { animation: hd-dash 1.2s linear 2.2s both; }
  @keyframes hd-outline { from { stroke-dashoffset: 100; } to { stroke-dashoffset: 0; } }
  @keyframes hd-fill { from { fill-opacity: 0; } to { fill-opacity: 1; } }
  @keyframes hd-dash { from { opacity: 0; stroke-dashoffset: 24; } 15% { opacity: 1; } to { opacity: 1; stroke-dashoffset: 0; } }
  .hd-fig-f { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: .5rem; color: #3b4541; }
  .hd-fig-f span { padding: 2px 6px; border-radius: 99px; background: #eef0ef; }
  .hd-fig-f em { margin-left: 3px; font-style: normal; color: #6b7672; }

  /* Your Workbench: Chat, Review, Publish */
  .hd-wb { min-width: 0; border-left: 1px solid #e3e7e4; background: #fbfbfa; font-size: .6rem; overflow: hidden; }
  :global(.ls) .hd-wb p { margin: 0; }
  .hd-wb-p { display: none; align-content: start; gap: 6px; padding: 9px 8px; }
  .hs[data-story-scene="0"] .hd-wb-0, .hs[data-story-scene="1"] .hd-wb-1, .hs[data-story-scene="2"] .hd-wb-2, .hs:is([data-story-scene="3"], [data-story-scene="4"]) .hd-wb-4 { display: grid; }
  .hd-tab { display: inline-flex; justify-self: start; align-items: center; gap: 4px; padding: 2px 7px; border-radius: 5px; background: #2f6fed; color: #fff; font-weight: 700; }
  .hd-msg { padding: 6px 7px; border-radius: 8px; line-height: 1.4; }
  .hd-me { justify-self: end; max-width: 92%; background: #2f6fed; color: #fff; }
  .hd-ai { background: #fff; border: 1px solid #e3e7e4; color: #2b3431; }
  .hd-ai b { color: #171c1a; }
  .hd-dots { display: none; gap: 3px; padding: 6px 8px; justify-self: start; border-radius: 8px; background: #fff; border: 1px solid #e3e7e4; }
