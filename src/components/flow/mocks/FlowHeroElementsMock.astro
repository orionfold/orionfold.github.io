---
// /flow/ hero: the Elements tour's own walk (orionfold-flow articles/19), in
// five steps you can click or let play. ⌘5 opens Elements; Ideas reads the five
// sections of Harbor Close Plan (a fictional plan) and names a skill for each
// in about 18 s; Field-Notes Diagram runs on "Where the time goes" (46 words,
// 5 numbers); about 50 s later its figure waits in Review Changes, drawn to
// scale (300, 205.71, 102.86 and 60 wide for 140, 96, 48 and 28 hours) in two
// steps; Keep or Undo decides it. Every label is the walk's own.
import '../../../styles/flow-mocks.css';
import '../../../styles/hero-story.css';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import Lightbulb from '@lucide/astro/icons/lightbulb';
import Search from '@lucide/astro/icons/search';
import FileCheck from '@lucide/astro/icons/file-check';
import Check from '@lucide/astro/icons/check';
import Undo2 from '@lucide/astro/icons/undo-2';
import Play from '@lucide/astro/icons/play';
import Pause from '@lucide/astro/icons/pause';
import { ELEMENT_CATEGORIES, elementDrawing } from '../../../lib/flow/elements';

const ALL = ELEMENT_CATEGORIES.flatMap((c) => c.items);
const card = (key: string) => {
  const hit = ALL.find((i) => i.card === key);
  if (!hit) throw new Error(`FlowHeroElementsMock: no element ${key}`);
  return { ...hit, svg: elementDrawing(key) };
};
// The five skills Ideas named, one per section, in the plan's order.
const IDEAS = [
  { key: 'skill-delegation-map', section: 'How the monthly close works' },
  { key: 'skill-field-notes-diagram', section: 'Where the time goes' },
  { key: 'skill-option-comparison', section: 'Options for chasing receipts' },
  { key: 'skill-register', section: 'Risks' },
  { key: 'skill-roadmap', section: 'Next steps' },
].map((i) => ({ ...i, ...card(i.key) }));
const fieldNotes = IDEAS[1];
const HOURS = [
  { label: 'Reconciliation', h: 140 },
  { label: 'Chasing', h: 96, hi: true },
  { label: 'Drafting', h: 48 },
  { label: 'Review', h: 28 },
];
const STEPS = ['Press ⌘5', 'Ideas reads', 'Run the skill', 'Drawn to scale', 'Your call'];
const DURATIONS = [3800, 5600, 4200, 7200, 5600];
const icon = (c: { svg: string; tint: string }, size = 20) => `<span class="fe-ic" style="--fe-t:${c.tint};--fe-s:${size}px">${c.svg}</span>`;
---
<div class="hs fe-story" data-story data-durations={DURATIONS.join(',')} data-auto="4:keep:1700" data-story-scene="0">
<figure class="dm dm--hero fe" style="--dm-tint:#0e9e98" aria-label="Flow Elements, step by step: press ⌘5 to open Elements beside Harbor Close Plan, Ideas names a skill for each of its five sections, Field-Notes Diagram draws where the hours go to scale, and the figure waits in Review Changes until you keep it">
  <div class="dm-window">
    <div class="dm-bar" aria-hidden="true">
      <span class="dm-lights"><i></i><i></i><i></i></span>
      <span class="dm-title"><img src="/logos/orionfold-mark-3d-32.png" alt="" width="16" height="16" />Harbor Close Plan.md</span>
      <span class="fe-pill"><i></i><span class="fe-pill-a">Reader</span><span class="fe-pill-b">1 change to review</span><span class="fe-pill-c">Changes reviewed</span></span>
    </div>
    <div class="fe-panes">
      <aside class="fe-el" aria-hidden="true">
        <p class="fe-search"><Search size={11} />Search</p>
        <p class="fe-el-h">Elements <kbd>⌘5</kbd></p>
        <p class="fe-grp"><ChevronRight size={12} />Components <b>15</b></p>
        <p class="fe-grp"><ChevronRight size={12} />Agency <b>12</b></p>
        <p class="fe-grp"><ChevronDown size={12} />Skills <b>19</b></p>
        {IDEAS.map((s, i) => (
          <p class:list={['fe-card', s.card === fieldNotes.card && 'is-pick']} style={`--i:${i}`}>
            <Fragment set:html={icon(s)} /><span><b>{s.name}</b></span>
          </p>
        ))}
        <p class="fe-grp"><ChevronRight size={12} />Chart kinds <b>54</b></p>
      </aside>

      <div class="fe-doc" aria-hidden="true">
        <div class="fe-scroll">
          <p class="fe-crumb">Reader · 349 words</p>
          <p class="dm-h">Harbor Close Plan</p>
          <p class="fe-h2">How the monthly close works <span class="fe-idea" style="--i:0"><Lightbulb size={10} />{IDEAS[0].name}</span></p>
          <p class="fe-lines"><i style="--w:96%"></i><i style="--w:72%"></i></p>
          <div class="fe-sec">
            <p class="fe-h2">Where the time goes <span class="fe-idea" style="--i:1"><Lightbulb size={10} />{fieldNotes.name}</span></p>
            <p class="fe-p">Last quarter the team logged 312 hours on closes. Reconciliation took 140, chasing receipts 96, drafting summaries 48 and review 28.</p>
          </div>
          <div class="fe-fig">
            <p class="fe-fig-h">HOURS ON CLOSES · LAST QUARTER</p>
            {HOURS.map((r, i) => (
              <div class:list={['fe-row', r.hi && 'is-hi']} style={`--w:${((r.h / 140) * 100).toFixed(2)}%;--i:${i}`}>
                <span>{r.label}</span><span class="fe-track"><i></i></span><b>{r.h} hours</b>
              </div>
            ))}
            <p class="fe-cap">CHASING RECEIPTS: 96 OF 312 HOURS</p>
            <p class="fe-stepper"><span>Previous</span><span>Play</span><span>Next</span><em class="fe-s1">Step 1 of 2</em><em class="fe-s2">Step 2 of 2</em></p>
          </div>
          <p class="fe-h2">Options for chasing receipts <span class="fe-idea" style="--i:2"><Lightbulb size={10} />{IDEAS[2].name}</span></p>
          <p class="fe-lines"><i style="--w:90%"></i><i style="--w:84%"></i><i style="--w:40%"></i></p>
          <p class="fe-h2">Risks <span class="fe-idea" style="--i:3"><Lightbulb size={10} />{IDEAS[3].name}</span></p>
          <p class="fe-lines"><i style="--w:88%"></i></p>
          <p class="fe-h2">Next steps <span class="fe-idea" style="--i:4"><Lightbulb size={10} />{IDEAS[4].name}</span></p>
        </div>
        <span class="fe-key">⌘5</span>
      </div>

      <aside class="fe-wb">
        <p class="fe-wb-tabs" aria-hidden="true"><span class="t-ideas"><Lightbulb size={12} />Ideas</span><span class="t-review"><FileCheck size={12} />Review</span></p>
        <div class="fe-wb-p fe-wb-0" aria-hidden="true">
          <p class="fe-wb-h">What Flow noticed</p>
          <p class="fe-wb-t">Find skills for 5 sections of Harbor Close Plan</p>
          <p class="fe-wb-s">They have the points, numbers or dates a skill works from. Nothing changes until you run one.</p>
          <p class="fe-btn">Suggest Ideas</p>
        </div>
        <div class="fe-wb-p fe-wb-1" aria-hidden="true">
          <p class="fe-wb-h">5 ideas <em>in about 18 s</em></p>
          {IDEAS.map((s, i) => (
            <p class="fe-sug" style={`--i:${i}`}><Fragment set:html={icon(s, 16)} /><span>Run <b>{s.name}</b> on “{s.section}”</span></p>
          ))}
        </div>
        <div class="fe-wb-p fe-wb-2" aria-hidden="true">
          <p class="fe-wb-sk"><Fragment set:html={icon(fieldNotes, 26)} /><span><b>{fieldNotes.name}</b>A figure in Review Changes</span></p>
          <p class="fe-kv"><span>Your selection</span><b>46 words</b></p>
          <p class="fe-kv"><span>Ready to run</span><b>5 numbers</b></p>
          <p class="fe-kv"><span>Cost</span><b>Included</b></p>
          <p class="fe-btn fe-btn-press">Run Skill</p>
        </div>
        <div class="fe-wb-p fe-wb-3" aria-hidden="true">
          <p class="fe-wb-h">Review Changes <em>about 50 s</em></p>
          <p class="fe-chg"><Fragment set:html={icon(fieldNotes, 16)} /><span>Adds Field-Notes Diagram after the selected text. It holds 1 figure.<small>Run by Claude Code</small></span><em>Proposed</em></p>
          <p class="fe-wb-s">Every bar is drawn to its value. Step 2 adds the number the passage stresses, in color.</p>
        </div>
        <div class="fe-wb-p fe-wb-4">
          <p class="fe-wb-h">Review Changes</p>
          <p class="fe-chg"><Fragment set:html={icon(fieldNotes, 16)} /><span>Adds Field-Notes Diagram after the selected text.<small>Run by Claude Code</small></span></p>
          <p class="fe-decide"><button type="button" class="fe-keep" data-story-act="keep"><Check size={12} stroke-width={3} />Keep</button><button type="button" class="fe-undo" data-story-act="undo"><Undo2 size={12} />Undo</button></p>
          <p class="fe-out fe-out-keep"><Check size={12} stroke-width={3} />Kept. The plan carries the figure as text, so it opens in any editor.</p>
          <p class="fe-out fe-out-undo"><Undo2 size={12} />Undone. The plan is as it was.</p>
        </div>
      </aside>
    </div>
  </div>
</figure>
<div class="hs-controls">
  <button type="button" class="hs-play" data-story-toggle aria-pressed="false" aria-label="Play the story"><Play size={14} class="hs-i-play" /><Pause size={14} class="hs-i-pause" /></button>
  <div class="hs-steps" role="group" aria-label="Story steps">
    {STEPS.map((s, i) => <button type="button" class="hs-step" data-story-go={i}><b>0{i + 1}</b><span>{s}</span></button>)}
  </div>
  <span class="sr-only" data-story-status aria-live="polite"></span>
</div>
<p class="hs-note">The plan, labels and numbers are from our Elements walk on a fictional plan. Click a step, or press Keep or Undo.</p>
</div>

<script>
  import '../../../scripts/hero-story.js';
</script>

<style>
  /* The window: Elements, the document and the Workbench, as in Flow. */
  .fe .dm-window { height: 430px; }
  .fe-pill { display: inline-flex; align-items: center; gap: 6px; padding: 2px 9px; border-radius: 99px; background: #eef1ef; color: #56635e; font-size: .66rem; font-weight: 700; white-space: nowrap; transition: background .3s, color .3s; }
  .fe-pill i { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .fe-pill-b, .fe-pill-c { display: none; }
  .hs[data-story-scene="3"] .fe-pill, .hs[data-story-scene="4"]:not([data-choice]) .fe-pill { background: #fdf0d9; color: #a35c00; }
  .hs[data-story-scene="3"] .fe-pill-a, .hs[data-story-scene="4"] .fe-pill-a { display: none; }
  .hs[data-story-scene="3"] .fe-pill-b, .hs[data-story-scene="4"]:not([data-choice]) .fe-pill-b { display: inline; }
  .hs[data-story-scene="4"][data-choice] .fe-pill { background: #e3f4ea; color: #15835c; }
  .hs[data-story-scene="4"][data-choice] .fe-pill-c { display: inline; }
  .fe-panes { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(0, 11.4em) minmax(0, 1fr) minmax(0, 12.6em); }

  /* Elements */
  .fe-el { display: grid; gap: 3px; align-content: start; padding: 10px 8px; border-right: 1px solid #e3e7e4; background: #f8f9f8; font-size: .66rem; overflow: hidden; }
  :global(.ls) .fe-el p { margin: 0; }
  .fe-search { display: flex; align-items: center; gap: 5px; padding: 4px 7px; margin-bottom: 4px !important; border-radius: 6px; background: #eceeed; color: #8a948f; }
  .fe-el-h { display: flex; justify-content: space-between; align-items: center; margin-bottom: 3px !important; font-weight: 700; color: #2b3431; }
  .fe-el-h kbd { padding: 1px 5px; border: 1px solid #d8ddda; border-radius: 4px; background: #fff; font: 500 .6rem/1.4 var(--font-mono, ui-monospace, monospace); color: #56635e; }
  .fe-grp { display: flex; align-items: center; gap: 4px; padding: 3px 2px; color: #3b4541; font-weight: 500; }
  .fe-grp b { margin-left: auto; font-weight: 500; color: #8a948f; }
  .fe-card { display: flex; align-items: center; gap: 6px; padding: 4px 5px; margin-left: 8px !important; border: 1px solid #e3e7e4; border-radius: 7px; background: #fff; color: #2b3431; transition: border-color .3s, background .3s, opacity .3s; }
  .fe-card span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fe-card b { font-weight: 500; }
  .hs[data-story-scene="0"] .fe-el > * { animation: hs-in .4s ease both; }
  .hs[data-story-scene="0"] .fe-el > :nth-child(n+3) { animation-delay: .7s; }
  .hs[data-story-scene="0"] .fe-card { animation-delay: calc(.9s + var(--i) * 90ms) !important; }
  .hs[data-story-scene="0"] .fe-el { animation: fe-slide .55s cubic-bezier(.2,.8,.2,1) .35s both; }
  .hs[data-story-scene="1"] .fe-card { border-color: #f1e3a8; background: #fffbea; }
  .hs[data-story-scene="2"] .fe-card:not(.is-pick), .hs[data-story-scene="3"] .fe-card:not(.is-pick) { opacity: .55; }
  .hs[data-story-scene="2"] .fe-card.is-pick, .hs[data-story-scene="3"] .fe-card.is-pick { border-color: var(--dm-tint); background: color-mix(in srgb, var(--dm-tint) 10%, #fff); }
  @keyframes fe-slide { from { transform: translateX(-100%); opacity: 0; } to { transform: none; opacity: 1; } }
  .fe :global(.fe-ic) { flex: none; display: inline-grid; place-items: center; width: var(--fe-s); height: var(--fe-s); border-radius: calc(var(--fe-s) * .26); color: var(--fe-t); background: color-mix(in srgb, var(--fe-t) 11%, #fff); }
  .fe :global(.fe-ic svg) { width: 70%; height: 70%; overflow: visible; }

  /* The document */
  .fe-doc { position: relative; min-width: 0; overflow: hidden; background: #fff; }
  .fe-doc::after { content: ''; position: absolute; inset: auto 0 0 0; height: 40px; background: linear-gradient(#fff0, #fff); pointer-events: none; }
  .fe-scroll { display: grid; gap: 7px; padding: 16px 18px; transition: transform .8s cubic-bezier(.2,.8,.2,1); }
  :global(.ls) .fe-scroll p { margin: 0; }
  .hs[data-story-scene="3"] .fe-scroll, .hs[data-story-scene="4"] .fe-scroll { transform: translateY(-74px); }
  .fe-crumb { font-size: .6rem; color: #8a948f; }
  :global(.ls) .fe .dm-h { font-size: 1.22rem; margin-bottom: 2px !important; }
  .fe-h2 { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: .76rem; font-weight: 700; color: #2b3431; }
  .fe-p { font-size: .69rem; line-height: 1.5; color: #3b4541; }
  .fe-lines { display: grid; gap: 5px; padding: 2px 0 4px; }
  .fe-lines i { display: block; height: 6px; width: var(--w); border-radius: 3px; background: #eceeed; }
  .fe-sec { display: grid; gap: 5px; margin: 0 -6px; padding: 4px 6px; border-radius: 6px; transition: background .3s; }
  .hs[data-story-scene="2"] .fe-sec { background: #d9e6fd; animation: fe-select .5s ease both; }
  @keyframes fe-select { from { background: #d9e6fd00; } }
  .fe-idea { display: none; align-items: center; gap: 3px; padding: 1px 6px; border: 1px solid #f1e3a8; border-radius: 99px; background: #fff9e0; font-size: .56rem; font-weight: 500; color: #6b5608; }
  .hs[data-story-scene="1"] .fe-idea { display: inline-flex; animation: hs-in .35s ease both; animation-delay: calc(1.1s + var(--i) * 260ms); }
  .hs[data-story-scene="2"] .fe-sec .fe-idea { display: inline-flex; }

  /* The figure, as Field-Notes Diagram draws it */
  .fe-fig { display: none; gap: 6px; padding: 12px 12px 8px; border: 2px solid #2f6fed; border-radius: 8px; background: #fff; font-family: var(--font-mono, ui-monospace, Menlo, monospace); }
  .hs[data-story-scene="3"] .fe-fig, .hs[data-story-scene="4"] .fe-fig { display: grid; }
  .hs[data-story-scene="3"] .fe-fig { animation: hs-in .45s ease both; }
  .hs[data-story-scene="4"][data-choice="keep"] .fe-fig { border-color: #e3e7e4; transition: border-color .4s; }
  .hs[data-story-scene="4"][data-choice="undo"] .fe-fig { display: none; }
  .fe-fig-h { font-size: .58rem; letter-spacing: .12em; color: #3b4541; }
  .fe-row { display: grid; grid-template-columns: 7.6em 1fr 4.8em; align-items: center; gap: 7px; padding: 2px 4px; margin: 0 -4px; border-radius: 3px; font-size: .62rem; color: #2b3431; }
  .fe-row > span:first-child { font-weight: 700; }
  .fe-row b { font-weight: 400; color: #56635e; white-space: nowrap; }
  .fe-track { height: 11px; }
  .fe-track i { display: block; height: 100%; width: var(--w); border: 1px solid #7180e3; background: #cbd1f7; transform-origin: left; }
  .hs[data-story-scene="3"] .fe-row:not(.is-hi) .fe-track i { animation: hs-grow .8s cubic-bezier(.2,.8,.2,1) both; animation-delay: calc(.4s + var(--i) * 120ms); }
  .fe-row.is-hi .fe-track i { border-color: #0e8a85; background: #9fd8cf; }
  .fe-row.is-hi { background: #e5f4f1; }
  .fe-row.is-hi > span:first-child { color: #0b7a74; }
  /* Step 1 of 2 leaves the chased hours out; step 2 adds them in color. */
  .hs[data-story-scene="3"] .fe-row.is-hi { animation: fe-step2 .5s ease 2.9s both; }
  .hs[data-story-scene="3"] .fe-row.is-hi .fe-track i { animation: hs-grow .8s cubic-bezier(.2,.8,.2,1) 3.1s both; }
  @keyframes fe-step2 { from { opacity: 0; max-height: 0; padding-block: 0; } to { opacity: 1; max-height: 20px; } }
  .fe-cap { font-size: .58rem; letter-spacing: .05em; color: #2b3431; overflow: hidden; white-space: nowrap; }
  .hs[data-story-scene="3"] .fe-cap { animation: hs-type 1.2s steps(32) 3.4s both; }
  .fe-stepper { display: flex; align-items: center; gap: 4px; justify-content: center; font: 500 .52rem/1 'Geist Sans', Arial, sans-serif; color: #3b4541; }
  .fe-stepper span { padding: 3px 6px; border-radius: 99px; background: #eef0ef; }
  .fe-stepper em { margin-left: 4px; color: #6b7672; }
  .fe-stepper em { overflow: hidden; white-space: nowrap; }
  .fe-s1 { max-width: 0; margin-left: 0 !important; }
  .hs[data-story-scene="3"] .fe-s1 { animation: fe-s1 0s 2.9s both; }
  .hs[data-story-scene="3"] .fe-s2 { animation: fe-s2 0s 2.9s both; }
  @keyframes fe-s1 { from { max-width: 8em; margin-left: 4px; } to { max-width: 0; margin-left: 0; } }
  @keyframes fe-s2 { from { max-width: 0; margin-left: 0; } to { max-width: 8em; margin-left: 4px; } }

  /* ⌘5 */
  .fe-key { position: absolute; left: 50%; top: 38%; padding: 10px 16px; border-radius: 12px; background: #171c1ae6; color: #fff; font: 700 1.5rem/1 'Geist Sans', Arial, sans-serif; letter-spacing: .02em; opacity: 0; pointer-events: none; box-shadow: 0 10px 30px #0004; }
  .hs[data-story-scene="0"] .fe-key { animation: hs-pop 1.5s ease both .1s; }

  /* The Workbench */
  .fe-wb { display: grid; grid-template-rows: auto 1fr; min-width: 0; border-left: 1px solid #e3e7e4; background: #fbfbfa; font-size: .64rem; overflow: hidden; }
  :global(.ls) .fe-wb p { margin: 0; }
  .fe-wb-tabs { display: flex; gap: 4px; padding: 7px 8px; border-bottom: 1px solid #e3e7e4; }
  .fe-wb-tabs span { display: inline-flex; align-items: center; gap: 4px; padding: 3px 7px; border-radius: 6px; color: #6b7672; font-weight: 500; }
  .hs:is([data-story-scene="0"], [data-story-scene="1"], [data-story-scene="2"]) .t-ideas, .hs:is([data-story-scene="3"], [data-story-scene="4"]) .t-review { background: #2f6fed; color: #fff; }
  .fe-wb-p { display: none; align-content: start; gap: 7px; padding: 10px 9px; }
  .hs[data-story-scene="0"] .fe-wb-0, .hs[data-story-scene="1"] .fe-wb-1, .hs[data-story-scene="2"] .fe-wb-2, .hs[data-story-scene="3"] .fe-wb-3, .hs[data-story-scene="4"] .fe-wb-4 { display: grid; animation: hs-in .35s ease both; }
  .hs[data-story-scene="0"] .fe-wb-0 { animation-delay: 1.4s; }
  .fe-wb-h { display: flex; justify-content: space-between; gap: 4px; font-weight: 700; color: #2b3431; }
  .fe-wb-h em { font-style: normal; font-weight: 500; color: #6b7672; }
  .fe-wb-t { font-size: .7rem; font-weight: 700; line-height: 1.35; color: #171c1a; }
  .fe-wb-s { line-height: 1.45; color: #56635e; }
  .fe-btn { justify-self: start; padding: 5px 10px; border-radius: 6px; background: #2f6fed; color: #fff; font-weight: 700; }
  .hs[data-story-scene="0"] .fe-btn { animation: hs-press 1s ease 2.8s both; }
  .hs[data-story-scene="2"] .fe-btn-press { animation: hs-press 1s ease 2.6s both; }
  .fe-sug { display: flex; gap: 6px; align-items: flex-start; padding: 6px; border: 1px solid #e3e7e4; border-radius: 7px; background: #fff; line-height: 1.35; color: #3b4541; }
  .fe-sug b { color: #171c1a; }
  .hs[data-story-scene="1"] .fe-sug { animation: hs-in .35s ease both; animation-delay: calc(1s + var(--i) * 260ms); }
  .fe-wb-sk { display: flex; gap: 8px; align-items: center; }
  .fe-wb-sk span { display: grid; color: #6b7672; }
  .fe-wb-sk b { font-size: .72rem; color: #171c1a; }
  .fe-kv { display: flex; justify-content: space-between; gap: 6px; padding: 5px 0; border-bottom: 1px solid #eceeed; color: #56635e; }
  .fe-kv b { color: #171c1a; }
  .hs[data-story-scene="2"] .fe-kv { animation: hs-in .3s ease both; }
  .hs[data-story-scene="2"] .fe-kv:nth-of-type(3) { animation-delay: .5s; }
  .hs[data-story-scene="2"] .fe-kv:nth-of-type(4) { animation-delay: .9s; }
  .hs[data-story-scene="2"] .fe-kv:nth-of-type(5) { animation-delay: 1.3s; }
  .fe-chg { display: flex; gap: 6px; align-items: flex-start; padding: 7px; border: 1px solid #c9d8fb; border-radius: 7px; background: #eef3fe; line-height: 1.35; color: #2b3431; }
