---
// Shared Flow conversion surface. Every placement uses the same named offer,
// consent, and live double-opt-in component; only the narrative context and
// attribution source differ.
//
// Copy rewritten 2026-08-20 (content-masterclass review): the ask names the
// exchange (what arrives for the address) instead of "updates", and offers the
// free book as a second, immediate magnet. Both are true today: the waitlist
// sends development notes and the launch note; the book page delivers the PDF
// and EPUB on confirm.
import WaitlistForm from '../ui/WaitlistForm.astro';
import { FLOW_CONSENT_TEXT } from '../../data/flow-consent';
import { magnetHref } from '../../data/magnet';
import { ORIONFOLD_FLOW_LIVE } from '../../data/launch.ts';
import { FLOW_DOWNLOAD_READY, FLOW_DMG_URL, FLOW_SYSTEM_REQUIREMENT } from '../../data/flow-pricing.ts';

interface Props {
  /**
   * Which surface this instance sits on. Each value seeds its own formId (five
   * derived DOM ids plus the section's aria-labelledby, so two instances
   * sharing one would emit duplicate ids) and its own `source`, which the
   * subscribe endpoint stores and GA4/Meta report. `flow-mid` closes each
   * /flow/<category>/ page; `flow-enterprise` closes /flow/enterprise/.
   */
  placement: 'home' | 'flow' | 'flow-mid' | 'flow-enterprise';
  storyHref?: string;
  /** Where the mid-tour panel sends a reader who wants to keep reading. */
  nextHref?: string;
  nextLabel?: string;
}

const { placement, storyHref, nextHref, nextLabel } = Astro.props;
const isHome = placement === 'home';
const isMid = placement === 'flow-mid';
const isEnterprise = placement === 'flow-enterprise';
const formId = isHome ? 'home-flow-waitlist' : isMid ? 'flow-mid-waitlist' : isEnterprise ? 'flow-enterprise-waitlist' : 'flow-page-waitlist';
const source = formId;
const consentText = FLOW_CONSENT_TEXT;

// Two states, one component. Pre-launch the offer is the waitlist; once
// ORIONFOLD_FLOW_LIVE is on the offer is the app itself and the email capture
// becomes the secondary ask rather than the only one. Keeping both in one
// component means the funnel, the consent text and the attribution sources do
// not fork on launch day.
const live = ORIONFOLD_FLOW_LIVE;
const eyebrow = live
  ? (isHome
      ? 'Free to use · Built for Mac'
      : isMid
        ? 'Seen enough? · Download Flow'
        : isEnterprise
          ? 'For enterprise AI owners · Built for Mac'
          : 'Built for Mac · Free to use')
  : (isHome
      ? 'Flow waitlist · Launching soon'
      : isMid
        ? 'Seen enough? · Flow waitlist'
        : isEnterprise
          ? 'For enterprise AI owners · Flow waitlist'
          : 'Built for Mac · Flow waitlist');
const heading = live
  ? (isHome
      ? 'Approve your first change in Flow today.'
      : isMid
        ? 'Want this on your Mac?'
        : isEnterprise
          ? 'Bring the receipt to your documents.'
          : 'Download Flow and open a folder.')
  : (isHome
      ? 'Be first to approve a change in Flow.'
      : isMid
        ? 'Want this on your Mac?'
        : isEnterprise
          ? 'Bring the receipt to your documents.'
          : 'Be first to approve a change in Flow.');
const continueHref = isHome ? '/flow/' : isMid ? (nextHref ?? '/flow/') : storyHref;
const continueLabel = isHome ? 'Take the product tour' : isMid ? (nextLabel ? `Next: ${nextLabel}` : 'Back to the Flow overview') : 'Read the story';
---
<section
  class:list={['flow-waitlist px-6 py-16 sm:py-24', isHome && 'flow-waitlist--home']}
  aria-labelledby={`${formId}-heading`}
>
  <div class="flow-waitlist__panel mx-auto grid max-w-6xl items-center gap-10 overflow-hidden rounded-[2rem] border border-primary/25 px-6 py-10 sm:px-10 sm:py-14 lg:grid-cols-[1.02fr_0.98fr] lg:gap-16 lg:px-14">
    <div class="relative z-10 max-w-2xl">
      <p class="font-mono text-[0.68rem] uppercase tracking-[0.23em] text-primary">{eyebrow}</p>
      <h2 id={`${formId}-heading`} class="mt-4 text-balance text-4xl font-bold leading-[1.03] sm:text-5xl">{heading}</h2>
      {live ? (
        <>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-text-muted">
            Reading, writing, searching and exporting your documents are free forever. Flow's
            AI is the part you subscribe to, and you can try it before you decide.
          </p>
          <ul class="flow-list mt-4 max-w-xl">
            <li>Works on ordinary folders of Markdown files you already own.</li>
            <li>Every AI change arrives as an exact diff you approve or reject.</li>
            <li>If you ever stop paying, your documents stay open and editable.</li>
          </ul>
        </>
      ) : (
        <>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-text-muted">
            Flow is pre-launch, offered as a freemium subscription when it ships. Here is what
            your address gets you, and nothing else:
          </p>
          <ul class="flow-list mt-4 max-w-xl">
            <li>The launch note the day Flow ships for Mac.</li>
            <li>Development notes with the measured numbers and their dates, one email a week at most.</li>
            <li>The weekly AI For Everyone digest, which you can stop any time.</li>
          </ul>
        </>
      )}
      <p class="mt-5 max-w-xl text-sm leading-relaxed text-text-muted">
        Want something to read today? <a href={magnetHref('flow-waitlist')} class="of-text-action underline underline-offset-2">The AI Native Business book is free</a>, PDF and EPUB, the method Flow turns into an app.
      </p>
      {continueHref && (
        <a href={continueHref} class="of-text-action mt-6 inline-flex items-center gap-2">
          {continueLabel} <span aria-hidden="true">→</span>
        </a>
      )}
    </div>

    <div class="flow-waitlist__form relative z-10 rounded-2xl border border-border/80 bg-surface/85 p-5 backdrop-blur sm:p-7">
      {live && (
        /* The download leads once Flow ships. FLOW_DOWNLOAD_READY is false while
           the URL is a placeholder, and a dependency that is not active must
           never be dressed as a working action -- so the button is disabled and
           says so truthfully rather than linking somewhere dead. */
        <div class="mb-6">
          {FLOW_DOWNLOAD_READY ? (
            <a href={FLOW_DMG_URL} class="of-primary-action w-full justify-center" data-flow-download>
              Download Flow for Mac
            </a>
          ) : (
            <>
              <span class="of-primary-action w-full cursor-not-allowed justify-center opacity-60" aria-disabled="true" role="link">
                Download Flow for Mac
              </span>
              <p class="mt-2 text-center font-mono text-[0.62rem] uppercase tracking-[0.16em] text-text-dim">
                Download link not live yet
              </p>
            </>
          )}
          <p class="mt-3 text-center text-xs leading-relaxed text-text-dim">
            {FLOW_SYSTEM_REQUIREMENT}. Free to use, no account needed.
          </p>
          <p class="mt-4 border-t border-border/60 pt-4 text-center text-sm text-text-muted">
            Or get the release notes by email
          </p>
        </div>
      )}
      <WaitlistForm
        id={formId}
        source={source}
        offer="flow-waitlist"
        buttonText={live ? 'Email me Flow updates' : 'Join the waitlist'}
        successMessage="Check your inbox to confirm."
        consentText={consentText}
      />
      {/* One caption, the same line as the Home hero CTA. The full consent
          scope is recorded on submit (consentText), not shown. */}
      <p class="of-waitlist-caption mt-3 font-mono uppercase text-text-dim">
        Free to join · Double opt-in · One email a week, no more
      </p>
    </div>
  </div>
</section>

<style>
  .flow-waitlist { position: relative; overflow: hidden; }
  .flow-waitlist--home {
    border-bottom: 1px solid color-mix(in oklch, var(--color-primary) 14%, var(--color-border));
    background: color-mix(in oklch, var(--color-primary) 3%, var(--color-surface-raised));
  }
  .flow-waitlist__panel {
    position: relative;
    background:
      linear-gradient(135deg, color-mix(in oklch, var(--color-primary) 10%, var(--color-surface)) 0%, var(--color-surface-raised) 58%),
      var(--color-surface-raised);
    box-shadow: 0 32px 90px rgb(13 24 48 / 0.09);
  }
  .flow-waitlist__panel::before,
  .flow-waitlist__panel::after {
    content: '';
    position: absolute;
    /* Token-driven rings so they follow the accent in both themes. */
    border: 1px solid color-mix(in oklch, var(--color-primary) 24%, transparent);
    border-radius: 999px;
    pointer-events: none;
  }
  .flow-waitlist__panel::before { width: 24rem; height: 24rem; right: -10rem; top: -15rem; }
  .flow-waitlist__panel::after { width: 8rem; height: 8rem; left: 46%; bottom: -6rem; }
  .flow-waitlist__form { box-shadow: 0 20px 55px rgb(13 24 48 / 0.08); }
  .flow-waitlist__form :global(form) { max-width: none; }
  @media (max-width: 640px) {
    .flow-waitlist__panel::before { width: 15rem; height: 15rem; right: -8rem; top: -9rem; }
    .flow-waitlist__panel::after { display: none; }
  }
</style>
