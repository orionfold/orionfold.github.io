---
// Shared Flow conversion surface. Both placements use the same named offer,
// consent, and live double-opt-in component; only the narrative context and
// attribution source differ.
import WaitlistForm from '../ui/WaitlistForm.astro';

interface Props {
  /**
   * Which surface this instance sits on. `flow-mid` is the SAME offer repeated
   * part-way down the long /flow/ tour so a reader who is convinced at the
   * halfway mark does not have to scroll to the end to act.
   *
   * It is a distinct value rather than a second `flow`, and that is
   * load-bearing twice over: `formId` seeds five derived DOM ids (the form, its
   * email input, error, success, and success-text nodes) plus the section's
   * aria-labelledby, so two instances sharing it would emit duplicate ids and
   * break the label association; and `source` is what the subscribe endpoint
   * stores and what GA4/Meta report, so sharing it would make the mid-page and
   * end-of-page CTAs indistinguishable in conversion data.
   */
  placement: 'home' | 'flow' | 'flow-mid';
  storyHref?: string;
}

const { placement, storyHref } = Astro.props;
const isHome = placement === 'home';
const isMid = placement === 'flow-mid';
const formId = isHome ? 'home-flow-waitlist' : isMid ? 'flow-mid-waitlist' : 'flow-page-waitlist';
const source = formId;
const consentText = 'By joining the Flow waitlist, you agree to receive Flow development and launch updates plus the AI For Everyone digest, one email a week, no more. You can unsubscribe any time. See our privacy policy.';
---
<section
  class:list={['flow-waitlist px-6 py-16 sm:py-24', isHome && 'flow-waitlist--home']}
  aria-labelledby={`${formId}-heading`}
>
  <div class="flow-waitlist__panel mx-auto grid max-w-6xl items-center gap-10 overflow-hidden rounded-[2rem] border border-primary/25 px-6 py-10 sm:px-10 sm:py-14 lg:grid-cols-[1.02fr_0.98fr] lg:gap-16 lg:px-14">
    <div class="relative z-10 max-w-2xl">
      <p class="font-mono text-[0.68rem] uppercase tracking-[0.23em] text-primary">
        {isHome ? 'Flow waitlist · In development' : isMid ? 'Seen enough? · Flow waitlist' : 'Built for Mac · Flow waitlist'}
      </p>
      <h2 id={`${formId}-heading`} class="mt-4 text-balance text-4xl font-bold leading-[1.03] sm:text-5xl">
        {isHome ? 'Join the Flow waitlist.' : isMid ? 'Want this on your Mac?' : 'Conduct your first document with Flow.'}
      </h2>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-text-muted">
        {isMid
          ? "Flow is in development, offered through a freemium subscription. Join now for meaningful updates and the launch note when it is ready, or keep reading: the rest of the tour covers where your work runs, search, tables, and what Flow costs to run."
          : "Flow is in development as Orionfold's first closed-source commercial app, offered through a freemium subscription. Join for meaningful updates as self-improving intelligence and AI agency move into the document, plus the launch note when Flow is ready."}
      </p>
      {/* The mid-page link keeps the reader ON the tour. Sending them to the
          story here would end the page half-read; the closer at the bottom is
          the right place for that exit. */}
      <a href={isHome ? '/flow/' : isMid ? '#tour-domains' : storyHref} class="of-text-action mt-6 inline-flex items-center gap-2">
        {isHome ? 'Explore Orionfold Flow' : isMid ? 'Keep reading the tour' : 'Read the story'} <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="flow-waitlist__form relative z-10 rounded-2xl border border-border/80 bg-surface/85 p-5 backdrop-blur sm:p-7">
      <WaitlistForm
        id={formId}
        source={source}
        offer="flow-waitlist"
        buttonText="Join the waitlist"
        successMessage="Check your inbox to confirm."
        consentText={consentText}
      />
      {/* One caption, the same line as the Home hero CTA. The full consent
          scope is recorded on submit (consentText), not shown. */}
      <p class="of-waitlist-caption mt-3 font-mono uppercase text-text-dim">
        Free to join · Double opt-in · One email a week, no more
      </p>
    </div>
  </div>
</section>

<style>
  .flow-waitlist { position: relative; overflow: hidden; }
  .flow-waitlist--home {
    border-bottom: 1px solid color-mix(in oklch, var(--color-primary) 14%, var(--color-border));
    background: color-mix(in oklch, var(--color-primary) 3%, var(--color-surface-raised));
  }
  .flow-waitlist__panel {
    position: relative;
    background:
      linear-gradient(135deg, color-mix(in oklch, var(--color-primary) 10%, var(--color-surface)) 0%, var(--color-surface-raised) 58%),
      var(--color-surface-raised);
    box-shadow: 0 32px 90px rgb(13 24 48 / 0.09);
  }
  .flow-waitlist__panel::before,
  .flow-waitlist__panel::after {
    content: '';
    position: absolute;
    /* Was a hardcoded rgb(91 141 239) — indigo left over from the pre-cyan
       design system, so these rings drifted off-accent in both themes and did
       not follow the dark remap at all. Token-driven now. */
    border: 1px solid color-mix(in oklch, var(--color-primary) 24%, transparent);
    border-radius: 999px;
    pointer-events: none;
  }
  .flow-waitlist__panel::before { width: 24rem; height: 24rem; right: -10rem; top: -15rem; }
  .flow-waitlist__panel::after { width: 8rem; height: 8rem; left: 46%; bottom: -6rem; }
  .flow-waitlist__form { box-shadow: 0 20px 55px rgb(13 24 48 / 0.08); }
  .flow-waitlist__form :global(form) { max-width: none; }
  @media (max-width: 640px) {
    .flow-waitlist__panel::before { width: 15rem; height: 15rem; right: -8rem; top: -9rem; }
    .flow-waitlist__panel::after { display: none; }
  }
</style>
