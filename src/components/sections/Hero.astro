---
// Flow-led homepage hero. The product is in development, so the visual keeps
// the operator-supplied story creative rather than an unfinished product shot.
import HomeFlowHeroCreative from '../flow/HomeFlowHeroCreative.astro';
---
<section class="home-flow relative overflow-x-clip">
  <div class="home-flow__grid" aria-hidden="true"></div>
  <div class="home-flow__glow home-flow__glow--copy" aria-hidden="true"></div>
  <div class="home-flow__glow home-flow__glow--art" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto grid max-w-[90rem] items-center gap-12 px-6 pb-20 pt-28 sm:pt-32 lg:min-h-[calc(100dvh-100px)] lg:grid-cols-[0.82fr_1.18fr] lg:gap-14 lg:pb-24 lg:pt-32">
    <div class="text-center lg:text-left">
      <p class="font-mono text-[0.68rem] uppercase leading-relaxed tracking-[0.22em] text-primary">
        Flow leads the Orionfold line · Join the Waitlist
      </p>
      <h1 class="hero-gradient-text mx-auto mt-6 max-w-none font-display text-[clamp(2rem,9vw,3rem)] font-extrabold leading-[1.16] tracking-[-0.055em] lg:mx-0 lg:text-[clamp(3rem,3.4vw,3.4rem)]">
        <span class="block whitespace-nowrap">Conduct beautiful</span>
        <span class="mt-[0.02em] block whitespace-nowrap">documents with AI</span>
        <span class="mt-[0.02em] block whitespace-nowrap">agency built in</span>
      </h1>
      <p class="mx-auto mt-7 max-w-xl text-balance text-lg leading-relaxed text-text-muted sm:text-xl lg:mx-0">
        Orionfold Flow creates documents with self-improving intelligence built in and AI agency enabled to get work done.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-2 lg:justify-start">
        <span class="home-flow__chip">Native Mac app</span>
        <span class="home-flow__chip">Self-improving intelligence</span>
        <span class="home-flow__chip">Agency with your approval</span>
      </div>
      <div class="mt-9 flex flex-wrap justify-center gap-3 lg:justify-start">
        <a href="/flow/" class="of-primary-action group">
          Explore Orionfold Flow
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="#orionfold-line" class="of-secondary-action">Meet the product line</a>
      </div>
    </div>

    <HomeFlowHeroCreative href="/flow/" />
  </div>
</section>

<style>
  .home-flow {
    isolation: isolate;
    border-bottom: 1px solid color-mix(in oklch, var(--color-primary) 16%, var(--color-border));
    background: linear-gradient(145deg, color-mix(in oklch, var(--color-primary) 5%, var(--color-surface)) 0%, var(--color-surface) 56%);
  }
  .home-flow__grid {
    position: absolute; inset: 0;
    background-image: linear-gradient(rgb(91 141 239 / 0.055) 1px, transparent 1px), linear-gradient(90deg, rgb(91 141 239 / 0.055) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: radial-gradient(circle at 67% 48%, #000, transparent 78%);
  }
  .home-flow__glow { position: absolute; border-radius: 999px; background: rgb(91 141 239 / 0.11); filter: blur(110px); pointer-events: none; }
  .home-flow__glow--copy { left: -12rem; bottom: -8rem; width: 35rem; height: 28rem; }
  .home-flow__glow--art { right: -10rem; top: 6rem; width: 48rem; height: 42rem; }
  .home-flow__chip { border: 1px solid color-mix(in oklch, var(--color-primary) 24%, var(--color-border)); border-radius: 999px; background: color-mix(in oklch, var(--color-primary) 7%, var(--color-surface)); padding: 0.5rem 0.78rem; font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.08em; color: var(--color-text-muted); }
</style>
