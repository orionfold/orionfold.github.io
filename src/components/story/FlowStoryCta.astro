---
// FlowStoryCta — the Flow block on story pages, in two placements.
//
// 1. Mid-article, for a launch story that authors a `::flow-cta` directive: the
//    story page renders it once, hidden, and a tiny inline script relocates it
//    into the slot at the authored midpoint.
// 2. Story footer, on every other story, between the prev/next rail and the
//    subscribe form (operator 2026-08-26: the book magnet and the Proof / Relay /
//    Arena product band left the story footer; Flow is the one next step).
//
// Either way it spans the full viewport width and reuses the
// homepage capability acts' surface: the light racing canvas with the car-parts
// blueprint watermark (FlowRaceBlueprint), so the story's "car" block reads as
// the same world as Home 01–04. The image is the point here, so it takes the
// wider column and carries no border, only a soft shadow.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FlowRaceBlueprint from '../flow/FlowRaceBlueprint.astro';
import FlowDownloadCta from '../flow/FlowDownloadCta.astro';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  eyebrow: string;
  title: string;
  description: string;
  ctaText: string;
  href: string;
  /** Attribution surface for the shared Download click hook (Layout). Omit
   *  for the launch-dark waitlist variant, which is not a download. */
  downloadSource?: string;
  caption: string;
  /** `article`: injected into the 42rem prose column, so it breaks out to the
   *  viewport width. `footer`: already a full-width sibling of <main>, so it
   *  keeps normal flow (a 100vw box there adds a horizontal scrollbar). */
  placement?: 'article' | 'footer';
}

const { image, imageAlt, eyebrow, title, description, ctaText, href, downloadSource, caption, placement = 'article' } = Astro.props;
---
<aside class:list={['flow-story-cta', 'not-prose', `flow-story-cta--${placement}`]} aria-label="Orionfold Flow for Mac">
  <FlowRaceBlueprint class="flow-story-cta__blueprint" placement="crew" />
  <div class="flow-story-cta__shell">
    <div class="flow-story-cta__copy">
      <p class="flow-story-cta__eyebrow">{eyebrow}</p>
      <h2 class="flow-story-cta__title">{title}</h2>
      <p class="flow-story-cta__body">{description}</p>
      {downloadSource ? (
        // Live: the exact home-hero download bar (one label, one URL, one
        // caption, same glow and sheen), attributed to this story surface.
        <div class="flow-story-cta__download">
          <FlowDownloadCta source={downloadSource} size="large" />
        </div>
      ) : (
        // Before release: a plain waitlist ask, never a download.
        <>
          <a href={href} class="flow-story-cta__button">
            {ctaText}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <p class="flow-story-cta__caption">{caption}</p>
        </>
      )}
    </div>

    <div class="flow-story-cta__stage">
      <!-- The whole picture opens the Flow landing page (same target as the tour
           pill); aria-hidden + tabindex=-1 so it is not a second stop for
           keyboard/screen-reader users. -->
      <a href="/flow/" class="flow-story-cta__figure" tabindex="-1" aria-hidden="true">
        <Image
          src={image}
          alt={imageAlt}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1200px) 52rem, (min-width: 920px) 58vw, calc(100vw - 2rem)"
          loading="lazy"
          decoding="async"
          data-no-zoom
          class="flow-story-cta__image"
        />
      </a>
      <!-- Same pill as the homepage racing creative, pointing the other way:
           from a story into the Flow landing page and its tour. -->
      <a href="/flow/" class="flow-story-cta__tour">
        Flow Product Tour <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</aside>

<style>
  /* Full bleed out of the 42rem article column. The story <main> clips
     horizontal overflow so the 100vw width never adds a page scrollbar. */
  .flow-story-cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100vw;
    margin-block: clamp(3rem, 7vw, 5rem);
    margin-inline: calc(50% - 50vw);
    border-block: 1px solid rgba(15, 118, 116, 0.15);
    padding: clamp(3rem, 7vw, 6rem) 1rem;
    color: #173138;
    background: #f4f7f5;
  }
  .flow-story-cta--footer {
    width: auto;
    margin: 0;
    border-bottom: 0;
  }
  /* Same watermark weight as the homepage light acts (Home 01–04). */
  :global(.flow-story-cta__blueprint) {
    z-index: -1;
    opacity: 0.19;
  }
  .flow-story-cta__shell {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: center;
    width: min(100%, 82rem);
    margin-inline: auto;
  }
  .flow-story-cta__copy { max-width: 34rem; }
  .flow-story-cta__eyebrow {
    color: #087f7b;
    font: 700 0.66rem/1 var(--font-mono);
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }
  .flow-story-cta__title {
    margin-top: 0.9rem;
    color: #10272e;
    font: 760 clamp(1.9rem, 3.6vw, 3rem)/1 var(--font-display);
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .flow-story-cta__body {
    margin-top: 1.1rem;
    color: rgba(29, 57, 63, 0.72);
    font-size: 1.02rem;
    line-height: 1.65;
  }
  /* The mid-article placement is injected into .story-prose, whose `a` rule
     (underline, primary color) outranks the DS action classes. Reassert the
     hero bar's own colors so both placements look identical. */
  .flow-story-cta__download { margin-top: 1.5rem; }
  .flow-story-cta :global(a.of-primary-action) {
    color: var(--color-accent-text);
    text-decoration: none;
  }
  .flow-story-cta :global(a.of-primary-action:hover) { color: var(--color-accent-text); }
  /* The story prose block styles every <a> as an underlined primary link;
     this block is injected into it, so the button sets its own colors. */
  .flow-story-cta__button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    border-radius: 0.65rem;
    padding: 0.85rem 1.25rem;
    background: var(--color-primary);
    color: var(--color-surface);
    font-weight: 650;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .flow-story-cta__button:hover { background: color-mix(in oklch, var(--color-primary) 90%, black); transform: translateY(-1px); }
  .flow-story-cta__caption {
    margin-top: 0.85rem;
    color: rgba(29, 57, 63, 0.58);
    font: 600 0.66rem/1.5 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .flow-story-cta__stage {
    position: relative;
    min-width: 0;
  }
  .flow-story-cta__tour {
    position: absolute;
    z-index: 2;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 999px;
    background: rgba(7, 20, 23, 0.66);
    color: #f2fbfa;
    font: 700 0.66rem/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .flow-story-cta__tour:hover,
  .flow-story-cta__tour:focus-visible {
    background: rgba(7, 20, 23, 0.84);
    transform: translateY(-1px);
  }
  .flow-story-cta__tour span { transition: transform 0.2s ease; }
  .flow-story-cta__tour:hover span { transform: translateX(2px); }
  .flow-story-cta__figure {
    display: block;
    min-width: 0;
    border-radius: 1.1rem;
    overflow: hidden;
    box-shadow: 0 30px 80px -40px rgba(7, 20, 23, 0.55);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .flow-story-cta__figure:hover {
    transform: translateY(-3px);
    box-shadow: 0 38px 90px -40px rgba(7, 20, 23, 0.6);
  }
  .flow-story-cta__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2752 / 1536;
    object-fit: cover;
  }

  @media (min-width: 920px) {
    .flow-story-cta { padding-inline: 1.5rem; }
    .flow-story-cta__shell { grid-template-columns: minmax(19rem, 0.62fr) minmax(0, 1.38fr); }
  }
  @media (max-width: 480px) {
    .flow-story-cta__tour { top: 0.65rem; right: 0.65rem; padding: 0.5rem 0.75rem; font-size: 0.6rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-story-cta__button,
    .flow-story-cta__figure,
    .flow-story-cta__tour { transition: none; }
    .flow-story-cta__button:hover,
    .flow-story-cta__figure:hover,
    .flow-story-cta__tour:hover { transform: none; }
  }
</style>
