---
import type { ImageMetadata } from 'astro';
import PaperCta from '../ui/PaperCta.astro';
interface Props {
  image: ImageMetadata;
  imageAlt: string;
  eyebrow: string;
  title: string;
  description: string;
  ctaText: string;
  href: string;
  /** Attribution surface for the shared Download click hook (Layout). Omit
   *  for the launch-dark waitlist variant, which is not a download. */
  downloadSource?: string;
  caption: string;
  /** `article`: contained inside the prose column. `footer`: full-width closing band. */
  placement?: 'article' | 'footer';
}

const { image, imageAlt, eyebrow, title, description, ctaText, href, downloadSource, caption, placement = 'article' } = Astro.props;
---
<div class:list={['living-story-download', 'not-prose', placement === 'article' && 'living-story-download--article']}>
  <PaperCta source={downloadSource ?? 'story-download'} tone={placement === 'footer' ? 'yellow' : 'gray'} layout={placement === 'article' ? 'article' : 'wide'}
    eyebrow={downloadSource ? undefined : eyebrow}
    href={downloadSource ? undefined : href} label={downloadSource ? undefined : ctaText}
    heading={downloadSource ? undefined : title}
    description={downloadSource ? undefined : description} />
</div>
