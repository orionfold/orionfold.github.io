---
import type { ImageMetadata } from 'astro';
import Origami from '../ui/Origami.astro';
interface Props {
  thumb: ImageMetadata;
  thumbAlt: string;
  title: string;
  description: string;
  ctaText?: string;
  href?: string;
  /** Small label above the title. Defaults to the Proof cluster wording. */
  eyebrow?: string;
  ariaLabel?: string;
  /** Set when the button is a Flow download, so the click is attributed per
   *  surface like every other Download CTA (Layout's data-flow-download hook). */
  downloadSource?: string;
  /** One line under the button, e.g. the shared Flow download caption. */
  caption?: string;
}

const {
  thumb,
  thumbAlt,
  title,
  description,
  ctaText = 'See Orionfold Proof',
  href = '/proof/',
  eyebrow = 'The product behind this',
  ariaLabel = 'More about Orionfold Proof',
  downloadSource,
  caption,
} = Astro.props;
---
<aside class="living-paper-cta proof-cta not-prose" aria-label={ariaLabel}>
  <Origami variant="planes" />
  <div class="living-paper-cta__copy">
    <p class="living-eyebrow">{eyebrow}</p>
    <h2>{title}</h2><p>{description}</p>
    <a href={href} data-proof-cta-btn data-flow-download={downloadSource} class="of-primary-action">{ctaText}<span aria-hidden="true"> →</span></a>
    {caption && <p class="living-caption">{caption}</p>}
  </div>
</aside>
