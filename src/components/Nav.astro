---
// Shared navigation: Living Documents first, then Story and Books after a dot.
// Download intent, launch gating, and sticky-bar consent mechanics stay shared.
import Wordmark from './ui/Wordmark.astro';
// `divider: true` renders a separator immediately BEFORE that link.
const links = [
  { href: '/flow/', label: 'Flow', divider: false },
  { href: '/essay/', label: 'Essay', divider: false },
  { href: '/manifesto/', label: 'The Manifesto', divider: false },
  { href: '/story/', label: 'Story', divider: true },
  { href: '/learn/', label: 'Books', divider: false },
];
import { ORIONFOLD_FLOW_LIVE } from '../data/launch.ts';
import { FLOW_DMG_URL } from '../data/flow-pricing.ts';

// 2026-08-22 launch switch. Once ORIONFOLD_FLOW_LIVE is on, all three nav calls
// to action point straight at the download instead of the waitlist: the sticky
// bar, the desktop pill and the mobile pill. The sticky bar is the operator's
// named priority, since it is the one that follows a reader down every page.
//
// OPERATOR DECISION 2026-08-22 20:47, reaffirmed 2026-08-25: the launched
// rehearsal keeps the direct Download Flow intent everywhere, including the
// sticky, desktop and mobile nav calls to action. The conspicuous placeholder
// URL remains a release blocker, not a reason for the navigation to advertise
// a different action from the rest of the launch surface.
const flowLive = ORIONFOLD_FLOW_LIVE;
const flowDownloadHref = flowLive ? FLOW_DMG_URL : '/flow/#waitlist';
const navCtaLabel = flowLive ? 'Download Flow' : 'Join the waitlist';
const stickyCtaLabel = navCtaLabel;

---
<div id="nav-wrapper" class="fixed top-0 left-0 right-0 z-40 transition-[background-color,backdrop-filter] duration-300">
  <!-- Post-confirm welcome bar (success state). Takes the SAME top slot as the
       waitlist magnet bar and replaces it after a confirmed signup (the magnet
       bar controller suppresses itself while this is showing). Hidden by
       default; ConfirmBanner's script reveals it (session-persistent via
       sessionStorage). See src/components/ui/ConfirmBanner.astro. -->
  <div id="confirm-bar" role="status" aria-live="polite" class="hidden border-b border-primary/20 bg-primary/[0.07] text-text">
    <div class="mx-auto flex max-w-7xl items-center justify-center gap-3 px-6 py-1.5">
      <svg class="shrink-0 text-primary" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
      <p class="text-center text-sm leading-tight">
        <span id="confirm-bar-text" class="font-semibold">You're subscribed.</span>
        <span id="confirm-bar-detail" class="text-text-muted">Thanks for joining Orionfold.</span>
      </p>
      <a
        id="confirm-bar-cta"
        href="/flow/"
        class="group shrink-0 font-mono text-sm text-primary transition-colors hover:text-primary"
        data-astro-prefetch
      >Explore Flow <span class="inline-block transition-transform duration-300 group-hover:translate-x-0.5" aria-hidden="true">&rarr;</span></a>
      <button
        id="confirm-bar-close"
        type="button"
        aria-label="Dismiss"
        class="-mr-1 shrink-0 cursor-pointer rounded p-0.5 text-text-dim transition-colors hover:text-text"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>
    </div>
  </div>
  <!-- Persistent Flow waitlist sticky bar. Hidden by default; the controller
       script reveals it unless dismissed (localStorage) or the post-confirm
       welcome bar is active (the welcome bar owns this slot then). -->
  <div id="magnet-bar" class="hidden border-b border-primary/20 bg-primary/[0.07] text-text">
    <div class="mx-auto flex max-w-7xl items-center justify-center gap-3 px-6 py-1.5">
      <a
        href={flowDownloadHref}
        class="group inline-flex items-center gap-2 text-center text-sm leading-tight transition-colors hover:text-primary"
        data-flow-download={flowLive ? 'nav-sticky-bar' : undefined}
      >
        <svg class="shrink-0 text-primary" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2h9l4 4v16H6zM15 2v5h4M9 12h6M9 16h3"/><path d="M13 17l2 2 4-5"/></svg>
        {flowLive ? (
          <span><span class="font-semibold">Orionfold Flow for Mac</span> <span class="text-text-muted">· Base is free forever. 10 Pro days included.</span></span>
        ) : (
          <span><span class="font-semibold">Orionfold Flow is coming to Mac</span> <span class="text-text-muted">· patent-pending AI agency for documents</span></span>
        )}
        <span class="font-mono text-primary transition-transform duration-300 group-hover:translate-x-0.5" aria-hidden="true">{stickyCtaLabel} &rarr;</span>
      </a>
      <button
        id="magnet-bar-close"
        type="button"
        aria-label="Dismiss"
        class="-mr-1 shrink-0 cursor-pointer rounded p-0.5 text-text-dim transition-colors hover:text-text"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>
    </div>
  </div>
  <nav id="main-nav" aria-label="Main navigation" class="border-b border-transparent transition-[border-color] duration-300">
  <div class="living-nav-shell mx-auto py-5 flex items-center justify-between">
    <Wordmark />

    <!-- Desktop nav -->
    <div class="living-nav-links items-center">
      {links.map((link) => (
        <Fragment>
          {link.divider && <span class="living-nav-divider" aria-hidden="true">·</span>}
          <a
            href={link.href}
            aria-current={Astro.url.pathname === link.href ? "page" : undefined}
            class="living-nav-link text-text-muted hover:text-primary transition-colors"
            data-astro-prefetch
          >
            {link.label}
          </a>
        </Fragment>
      ))}

    </div>

    <!-- Right cluster: primary action + mobile hamburger -->
    <div class="living-nav-actions flex items-center">
      <a
        href={flowDownloadHref}
        class="living-nav-cta living-nav-cta--desktop items-center justify-center rounded-full bg-primary text-accent-text transition-colors hover:bg-primary/90"
        data-astro-prefetch={flowLive ? undefined : true}
        data-flow-download={flowLive ? 'nav-desktop' : undefined}
      >{flowLive && (<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v12m-5-5 5 5 5-5M5 16v4a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-4" /></svg>)}<span>{navCtaLabel}</span></a>
      <!-- Mobile hamburger — CSS-only disclosure. A visually-hidden checkbox is
           the real control; the <label> below toggles it. The menu open/close and
           the icon swap are driven purely by `#main-nav:has(...:checked)` CSS
           (style block at the bottom), so tapping works the instant the HTML
           paints — no wait for the deferred module bundle to execute, which is
           what made the menu feel laggy to open on slow mobile. JS is no longer
           required for the menu. -->
      <input id="mobile-menu-toggle" type="checkbox" class="sr-only" aria-label="Toggle menu" />
      <label
        for="mobile-menu-toggle"
        id="mobile-menu-btn"
        class="text-text-muted hover:text-primary transition-colors cursor-pointer"
      >
        <svg id="hamburger-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="hidden">
          <path d="M18 6L6 18M6 6l12 12" />
        </svg>
      </label>
    </div>
  </div>

  <!-- Mobile menu — opaque bg (no backdrop-blur). The blur was a GPU cost paid
       on every paint of the dropdown, which made it feel slow to open on real
       phones; a solid surface paints instantly. Shadow restores the depth the
       translucency used to give. Opened by the CSS at the bottom. -->
  <div id="mobile-menu" class="hidden border-t border-border bg-surface shadow-xl">
    <div class="living-mobile-links px-6 py-4 flex flex-col gap-3">
      {links.map((link) => (
        <Fragment>
          {link.divider && <span class="living-nav-divider" aria-hidden="true">·</span>}
          <a href={link.href} class="living-nav-link text-text-muted hover:text-primary transition-colors py-2" data-astro-prefetch>{link.label}</a>
        </Fragment>
      ))}
      <a href={flowDownloadHref} class="living-nav-cta mt-2 inline-flex items-center justify-center rounded-full bg-primary text-accent-text transition-colors hover:bg-primary/90" data-astro-prefetch={flowLive ? undefined : true} data-flow-download={flowLive ? 'nav-mobile' : undefined}>{flowLive && (<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v12m-5-5 5 5 5-5M5 16v4a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-4" /></svg>)}<span>{navCtaLabel}</span></a>
    </div>
  </div>
</nav>
</div>

<style is:global>
  /* CSS-only mobile menu (see the markup above). The hidden checkbox's state
     opens the dropdown and swaps the hamburger/close icons with no JavaScript,
     so the menu responds the moment the page paints. Scoped to the mobile
     breakpoint so the desktop nav (1100px and up) is never affected even if the
     checkbox is left checked when the viewport is resized. */
  @media (max-width: 1099.98px) {
    #main-nav:has(#mobile-menu-toggle:checked) #mobile-menu { display: block; }
    #main-nav:has(#mobile-menu-toggle:checked) #hamburger-icon { display: none; }
    #main-nav:has(#mobile-menu-toggle:checked) #close-icon { display: block; }
  }
</style>

<script>
  let disposeNav: (() => void) | undefined;
  function initNav() {
    disposeNav?.();
    // The mobile menu is a pure-CSS disclosure. This script owns the scroll blur
    // and the persistent Flow callout bar.
    const nav = document.getElementById('main-nav');
    const navWrapper = document.getElementById('nav-wrapper');
    if (!nav || !navWrapper) return;
    const updateOffset = () => {
      const menu = document.getElementById('mobile-menu');
      const menuHeight = menu && getComputedStyle(menu).display !== 'none' ? menu.getBoundingClientRect().height : 0;
      document.documentElement.style.setProperty('--of-nav-height', `${Math.ceil(navWrapper.getBoundingClientRect().height - menuHeight)}px`);
    };
    const resizeObserver = new ResizeObserver(updateOffset);

    // Scroll-triggered blur
    let scrolled = false;
    function onScroll() {
      const isScrolled = window.scrollY > 40;
      if (isScrolled !== scrolled) {
        scrolled = isScrolled;
        if (scrolled) {
          navWrapper.classList.add('bg-surface/80', 'backdrop-blur-md');
          nav.classList.add('border-border');
          nav.classList.remove('border-transparent');
        } else {
          navWrapper.classList.remove('bg-surface/80', 'backdrop-blur-md');
          nav.classList.remove('border-border');
          nav.classList.add('border-transparent');
        }
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    disposeNav = () => {
      window.removeEventListener('scroll', onScroll);
      resizeObserver.disconnect();
    };

    // Persistent Flow waitlist bar: reveal unless the user dismissed it
    // (localStorage, persists across sessions) or the post-confirm welcome bar
    // is showing (they already converted, so don't stack two bars). New key for
    // the Flow era so old book-bar dismissals don't suppress it.
    const magnetBar = document.getElementById('magnet-bar');
    if (magnetBar) {
      const DISMISSED = 'of-flow-bar-dismissed';
      let dismissed = false;
      try { dismissed = localStorage.getItem(DISMISSED) === '1'; } catch (e) {}
      // The converted state can arrive two ways depending on script order: the
      // fresh ?confirmed=1 URL (this controller may run before ConfirmBanner
      // stores it and cleans the URL) or the sessionStorage flag ConfirmBanner
      // persisted on an earlier load. Honor both, else the two bars stack.
      // A converted visitor never sees the signup pitch again this session,
      // even after dismissing or acting on the welcome bar.
      const converted =
        (() => { try {
          return new URLSearchParams(location.search).get('confirmed') === '1'
            || sessionStorage.getItem('of-confirm-welcome') === '1';
        } catch (e) { return false; } })();
      if (!dismissed && !converted) {
        magnetBar.classList.remove('hidden');
        const closeBtn = document.getElementById('magnet-bar-close');
        closeBtn && closeBtn.addEventListener('click', () => {
          try { localStorage.setItem(DISMISSED, '1'); } catch (e) {}
          magnetBar.classList.add('hidden');
        });
      }
    }
    // Reserve the settled notice state on the first measurement. Measuring
    // while its bar is still hidden briefly collapses the reserved hero gap.
    resizeObserver.observe(navWrapper);
    updateOffset();
  }

  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>
