---
// The site shell's top (G-140, Paper R1, operator 2026-10-30): the announce
// bar (back by decision D6; removed 2026-10-28), then the Paper nav with its
// menu panels. Every page body below it is unchanged in R1.
// Kept from the Living nav, because the rest of the site depends on them:
// #nav-wrapper and the --of-nav-height it writes (page bodies pad by it),
// #nav-notice-slot with the confirmation bar (ConfirmBanner.astro owns its
// script), and #main-nav. Menus, ≤5 items per group then "All", live in
// src/components/paper/PaperNav.astro.
import '../styles/paper/tokens.css';
import '../styles/paper/shell.css';
import AnnounceBar from './paper/AnnounceBar.astro';
import PaperNav from './paper/PaperNav.astro';
import { FLOW_VERSION } from '../lib/flow/flow-release';
---
<div id="nav-wrapper" class="paper pp-shell">
  <div id="nav-notice-slot">
  <!-- Post-confirm welcome bar (success state). Takes the top notice slot after
       a confirmed signup. Hidden by default; ConfirmBanner's script reveals it
       (session-persistent via sessionStorage). See src/components/ui/ConfirmBanner.astro. -->
  <div id="confirm-bar" role="status" aria-live="polite" class="hidden border-b border-primary/20 bg-primary/[0.07] text-text">
    <div class="mx-auto flex max-w-7xl items-center justify-center gap-3 px-6 py-1.5">
      <svg class="shrink-0 text-primary" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
      <p class="text-center text-sm leading-tight">
        <span id="confirm-bar-text" class="font-semibold">You're subscribed.</span>
        <span id="confirm-bar-detail" class="text-text-muted">Thanks for joining Orionfold.</span>
      </p>
      <a
        id="confirm-bar-cta"
        href="/flow/"
        class="group shrink-0 font-mono text-sm text-primary transition-colors hover:text-primary"
        data-astro-prefetch
      >Explore Flow <span class="inline-block transition-transform duration-300 group-hover:translate-x-0.5" aria-hidden="true">&rarr;</span></a>
      <button
        id="confirm-bar-close"
        type="button"
        aria-label="Dismiss"
        class="-mr-1 shrink-0 cursor-pointer rounded p-0.5 text-text-dim transition-colors hover:text-text"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>
    </div>
  </div>
  </div>
  <AnnounceBar href="/playbooks/" linkLabel="See how →">Flow {FLOW_VERSION} is out. Share your playbook with your clients.</AnnounceBar>
  <PaperNav />
</div>

<style is:global>
  #nav-notice-slot { position: relative; }
  #confirm-bar[data-confirmation-state] { display: flex; align-items: center; justify-content: center; min-height: 34px; }
  #confirm-bar[data-confirmation-state="1"],
  #confirm-bar[data-confirmation-state="already"] { background-color: #ecfccb; border-color: #d9f99d; }
  #confirm-bar[data-confirmation-state] > div { width: 100%; }
  #confirm-bar[data-confirmation-state] p { min-width: 0; text-wrap: balance; }
</style>

<script>
  // Page bodies pad by --of-nav-height; keep it equal to the visible header.
  let disposeNav: (() => void) | undefined;
  function initNav() {
    disposeNav?.();
    const navWrapper = document.getElementById('nav-wrapper');
    if (!navWrapper) return;
    const updateOffset = () => {
      document.documentElement.style.setProperty('--of-nav-height', `${Math.ceil(navWrapper.getBoundingClientRect().height)}px`);
    };
    const resizeObserver = new ResizeObserver(updateOffset);
    disposeNav = () => resizeObserver.disconnect();
    resizeObserver.observe(navWrapper);
    updateOffset();
  }

  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>

<script>
  // Scrolled state for the frosted band behind the nav (shell.css). One passive
  // listener, batched to a frame; the attribute only flips at the threshold.
  const shell = document.getElementById('nav-wrapper');
  if (shell) {
    let queued = false;
    const sync = () => { queued = false; shell.toggleAttribute('data-pp-scrolled', window.scrollY > 8); };
    window.addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(sync); } }, { passive: true });
    sync();
  }
</script>
